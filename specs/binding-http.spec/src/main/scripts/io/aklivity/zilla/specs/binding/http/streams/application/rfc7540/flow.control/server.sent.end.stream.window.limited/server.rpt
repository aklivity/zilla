accept "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "GET")
                           .header(":scheme", "http")
                           .header(":path", "/")
                           .header(":authority", "localhost:8080")
                           .build()}
connected

read closed

write zilla:begin.ext ${http:beginEx()
                              .typeId(zilla:id("http"))
                              .header(":status", "200")
                              .build()}
write flush
write notify FIRST_HEADERS_SENT

write await SECOND_HEADERS_SENT
write "y"
write flush

write close
write notify FIRST_RESPONSE_CLOSED

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "GET")
                           .header(":scheme", "http")
                           .header(":path", "/")
                           .header(":authority", "localhost:8080")
                           .build()}
connected

read closed

write await FIRST_HEADERS_SENT
write zilla:begin.ext ${http:beginEx()
                              .typeId(zilla:id("http"))
                              .header(":status", "200")
                              .build()}
write flush
write notify SECOND_HEADERS_SENT

write await FIRST_RESPONSE_CLOSED
write "z"
write flush
write notify SECOND_DATA_SENT

write await THIRD_HEADERS_SENT
write close
write notify SECOND_RESPONSE_CLOSED

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "GET")
                           .header(":scheme", "http")
                           .header(":path", "/")
                           .header(":authority", "localhost:8080")
                           .build()}
connected

read closed

write await SECOND_DATA_SENT
write zilla:begin.ext ${http:beginEx()
                              .typeId(zilla:id("http"))
                              .header(":status", "200")
                              .build()}
write flush
write notify THIRD_HEADERS_SENT

write await SECOND_RESPONSE_CLOSED
write close
