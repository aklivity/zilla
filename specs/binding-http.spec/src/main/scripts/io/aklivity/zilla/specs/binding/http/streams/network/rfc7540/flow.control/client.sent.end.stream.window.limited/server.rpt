accept "zilla://streams/net0"
       option zilla:window 248
       option zilla:update "none"
       option zilla:transmission "duplex"
accepted
connected

read option zilla:ack 0

read "PRI * HTTP/2.0\r\n"
     "\r\n"
     "SM\r\n"
     "\r\n"

read [0x00 0x00 0x0c]                                      # length = 12
     [0x04]                                                # HTTP2 SETTINGS frame
     [0x00]                                                # flags = 0x00
     [0x00 0x00 0x00 0x00]                                 # stream_id = 0
     [0x00 0x03 0x00 0x00 0x00 0x64]                       # SETTINGS_MAX_CONCURRENT_STREAMS(0x03) = 100
     [0x00 0x04 0x00 0x00 0xff 0xff]                       # SETTINGS_INITIAL_WINDOW_SIZE(0x04) = 65535

read [0x00 0x00 0x04]                                      # length
     [0x08]                                                # WINDOW_UPDATE frame
     [0x00]                                                # no flags
     [0x00 0x00 0x00 0x00]                                 # stream_id=0
     [0x7f 0xff 0x00 0x00]                                 # window size increment = 2147418112

write [0x00 0x00 0x12]                                     # length = 18
      [0x04]                                               # HTTP2 SETTINGS frame
      [0x00]                                               # flags = 0x00
      [0x00 0x00 0x00 0x00]                                # stream_id = 0
      [0x00 0x03 0x00 0x00 0x00 0x64]                      # SETTINGS_MAX_CONCURRENT_STREAMS(0x03) = 100
      [0x00 0x04 0x00 0x00 0x00 0x00]                      # SETTINGS_INITIAL_WINDOW_SIZE(0x04) = 0
      [0x00 0x06 0x00 0x00 0x20 0x00]                      # SETTINGS_MAX_HEADER_LIST_SIZE(0x06) = 8192

write [0x00 0x00 0x04]                                     # length
      [0x08]                                               # WINDOW_UPDATE frame
      [0x00]                                               # no flags
      [0x00 0x00 0x00 0x00]                                # stream_id=0
      [0x7f 0xff 0x00 0x00]                                # window size increment = 2147418112

write [0x00 0x00 0x00]                                     # length = 0
      [0x04]                                               # HTTP2 SETTINGS frame
      [0x01]                                               # ACK
      [0x00 0x00 0x00 0x00]                                # stream_id = 0
write flush

read [0x00 0x00 0x2e]                                      # length = 46
     [0x01]                                                # HEADERS frame
     [0x04]                                                # END_HEADERS
     [0x00 0x00 0x00 0x01]                                 # stream_id = 1
     [0x83]                                                # :method: POST
     [0x86]                                                # :scheme: http
     [0x84]                                                # :path: /
     [0x01] [0x0e] "localhost:8080"                        # :authority: localhost:8080
     [0x0f 0x10] [0x18] "text/plain;charset=UTF-8"         # content-type

read [0x00 0x00 0x00]                                      # length = 0
     [0x04]                                                # HTTP2 SETTINGS frame
     [0x01]                                                # ACK
     [0x00 0x00 0x00 0x00]                                 # stream_id = 0

write notify HTTP2_SETTINGS_ACK_RECEIVED

read [0x00 0x00 0x32]                                      # length = 50
     [0x01]                                                # HEADERS frame
     [0x04]                                                # END_HEADERS
     [0x00 0x00 0x00 0x03]                                 # stream_id = 3
     [0x83]                                                # :method: POST
     [0x86]                                                # :scheme: http
     [0x84]                                                # :path: /
     [0x01] [0x0e] "localhost:8080"                        # :authority: localhost:8080
     [0x0f 0x10] [0x18] "text/plain;charset=UTF-8"         # content-type
     [0x0f 0x0d] [0x01] "1"                                # content-length

write [0x00 0x00 0x04]                                     # length
      [0x08]                                               # WINDOW_UPDATE frame
      [0x00]                                               # no flags
      [0x00 0x00 0x00 0x03]                                # stream_id=3
      [0x00 0x00 0x00 0x0a]                                # window size increment = 10
write flush

write notify SECOND_REQUEST_WINDOW_SENT

read [0x00 0x00 0x32]                                      # length = 50
     [0x01]                                                # HEADERS frame
     [0x05]                                                # END_STREAM | END_HEADERS
     [0x00 0x00 0x00 0x05]                                 # stream_id = 5
     [0x83]                                                # :method: POST
     [0x86]                                                # :scheme: http
     [0x84]                                                # :path: /
     [0x01] [0x0e] "localhost:8080"                        # :authority: localhost:8080
     [0x0f 0x10] [0x18] "text/plain;charset=UTF-8"         # content-type
     [0x0f 0x0d] [0x01] "0"                                # content-length

write notify THIRD_HEADERS_RECEIVED

# the 248 byte window ends 8 bytes into the first stream's END_STREAM frame,
# the second stream's DATA and the fourth stream's HEADERS are queued behind it
read await FOURTH_REQUEST_STARTED
read option zilla:ack 248

read [0x00 0x00 0x01]                                      # length = 1
     [0x00]                                                # HTTP2 DATA frame
     [0x01]                                                # END_STREAM
     [0x00 0x00 0x00 0x03]                                 # stream_id = 3
     "y"

read [0x00 0x00 0x00]                                      # length = 0
     [0x00]                                                # HTTP2 DATA frame
     [0x01]                                                # END_STREAM
     [0x00 0x00 0x00 0x01]                                 # stream_id = 1

read option zilla:ack 259

read [0x00 0x00 0x32]                                      # length = 50
     [0x01]                                                # HEADERS frame
     [0x05]                                                # END_STREAM | END_HEADERS
     [0x00 0x00 0x00 0x07]                                 # stream_id = 7
     [0x83]                                                # :method: POST
     [0x86]                                                # :scheme: http
     [0x84]                                                # :path: /
     [0x01] [0x0e] "localhost:8080"                        # :authority: localhost:8080
     [0x0f 0x10] [0x18] "text/plain;charset=UTF-8"         # content-type
     [0x0f 0x0d] [0x01] "0"                                # content-length

write [0x00 0x00 0x01]                                     # length = 1
      [0x01]                                               # HEADERS frame
      [0x05]                                               # END_STREAM | END_HEADERS
      [0x00 0x00 0x00 0x01]                                # stream_id = 1
      [0x89]                                               # :status: 204

write [0x00 0x00 0x01]                                     # length = 1
      [0x01]                                               # HEADERS frame
      [0x05]                                               # END_STREAM | END_HEADERS
      [0x00 0x00 0x00 0x03]                                # stream_id = 3
      [0x89]                                               # :status: 204

write [0x00 0x00 0x01]                                     # length = 1
      [0x01]                                               # HEADERS frame
      [0x05]                                               # END_STREAM | END_HEADERS
      [0x00 0x00 0x00 0x05]                                # stream_id = 5
      [0x89]                                               # :status: 204

write [0x00 0x00 0x01]                                     # length = 1
      [0x01]                                               # HEADERS frame
      [0x05]                                               # END_STREAM | END_HEADERS
      [0x00 0x00 0x00 0x07]                                # stream_id = 7
      [0x89]                                               # :status: 204
write flush
