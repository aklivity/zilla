connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "duplex"

write zilla:begin.ext ${proxy:beginEx()
                             .typeId(zilla:id("proxy"))
                             .addressNone()
                               .build()
                             .build()}

connected

# client connection preface, SETTINGS and frames filling the whole 8192 byte window,
# ending part way through a frame
write "PRI * HTTP/2.0\r\n"
      "\r\n"
      "SM\r\n"
      "\r\n"
      [0x00 0x00 0x00]                                      # length = 0
      [0x04]                                                # HTTP2 SETTINGS frame
      [0x00]                                                # flags = 0x00
      [0x00 0x00 0x00 0x00]                                 # stream_id = 0
      [0x00 0x0f 0xa0]                                      # length = 4000
      [0xff]                                                # unknown frame type
      [0x00]                                                # flags = 0x00
      [0x00 0x00 0x00 0x00]                                 # stream_id = 0
      ${http:randomBytes(4000)}
      [0x00 0x1f 0x40]                                      # length = 8000
      [0xff]                                                # unknown frame type
      [0x00]                                                # flags = 0x00
      [0x00 0x00 0x00 0x00]                                 # stream_id = 0
      ${http:randomBytes(4141)}                             # first 4141 bytes of 8000
write flush

# rest of the partial frame, then frames filling another 8192 bytes
write ${http:randomBytes(3859)}                             # last 3859 bytes of 8000
      [0x00 0x10 0xe4]                                      # length = 4324
      [0xff]                                                # unknown frame type
      [0x00]                                                # flags = 0x00
      [0x00 0x00 0x00 0x00]                                 # stream_id = 0
      ${http:randomBytes(4324)}
write flush

write [0x00 0x00 0x08]                                      # length = 8
      [0x06]                                                # HTTP2 PING frame
      [0x00]                                                # flags = 0x00
      [0x00 0x00 0x00 0x00]                                 # stream_id = 0
      [0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08]             # opaque data
write flush

# server connection preface - SETTINGS frame
read [0x00 0x00 0x12]                                       # length = 18
     [0x04]                                                 # HTTP2 SETTINGS frame
     [0x00]                                                 # flags = 0x00
     [0x00 0x00 0x00 0x00]                                  # stream_id = 0
     [0x00 0x03 0x00 0x00 0x00 0x64]                        # SETTINGS_MAX_CONCURRENT_STREAMS(0x03) = 100
     [0x00 0x04 0x00 0x00 0x00 0x00]                        # SETTINGS_INITIAL_WINDOW_SIZE(0x04) = 0
     [0x00 0x06 0x00 0x00 0x10 0x00]                        # SETTINGS_MAX_HEADER_LIST_SIZE(0x06) = 4096
read [0x00 0x00 0x04]                                       # length
     [0x08]                                                 # WINDOW_UPDATE frame
     [0x00]                                                 # no flags
     [0x00 0x00 0x00 0x00]                                  # stream_id=0
     [0x7f 0xff 0x00 0x00]                                  # window size increment = 2147418112

read [0x00 0x00 0x00]                                       # length = 0
     [0x04]                                                 # HTTP2 SETTINGS frame
     [0x01]                                                 # ACK
     [0x00 0x00 0x00 0x00]                                  # stream_id = 0

read [0x00 0x00 0x08]                                       # length = 8
     [0x06]                                                 # HTTP2 PING frame
     [0x01]                                                 # ACK
     [0x00 0x00 0x00 0x00]                                  # stream_id = 0
     [0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08]              # opaque data
