accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "duplex"
accepted
connected

# client connection preface
read "PRI * HTTP/2.0\r\n"
     "\r\n"
     "SM\r\n"
     "\r\n"

read [0x00 0x00 0x0c]                                   # length = 12
     [0x04]                                             # HTTP2 SETTINGS frame
     [0x00]                                             # flags = 0x00
     [0x00 0x00 0x00 0x00]                              # stream_id = 0
     [0x00 0x03 0x00 0x00 0x00 0x64]                    # SETTINGS_MAX_CONCURRENT_STREAMS(0x03) = 100
     [0x00 0x04 0x00 0x00 0xff 0xff]                    # SETTINGS_INITIAL_WINDOW_SIZE(0x04) = 65535

# server connection preface
write [0x00 0x00 0x12]                                  # length = 18
      [0x04]                                            # HTTP2 SETTINGS frame
      [0x00]                                            # flags = 0x00
      [0x00 0x00 0x00 0x00]                             # stream_id = 0
      [0x00 0x03 0x00 0x00 0x00 0x64]                   # SETTINGS_MAX_CONCURRENT_STREAMS(0x03) = 100
      [0x00 0x04 0x00 0x00 0x00 0x00]                   # SETTINGS_INITIAL_WINDOW_SIZE(0x04) = 0
      [0x00 0x06 0x00 0x00 0x20 0x00]                   # SETTINGS_MAX_HEADER_LIST_SIZE(0x06) = 8192
write [0x00 0x00 0x04]                                  # length
      [0x08]                                            # WINDOW_UPDATE frame
      [0x00]                                            # no flags
      [0x00 0x00 0x00 0x00]                             # stream_id=0
      [0x7f 0xff 0x00 0x00]                             # window size increment = 2147418112
write flush

# ==================== HTTP2 stream-id=1  =================
read [0x00 0x00 0x13]                                   # length = 19
     [0x01]                                             # HEADERS frame
     [0x04]                                             # END_HEADERS
     [0x00 0x00 0x00 0x01]                              # stream_id = 1
     [0x83]                                             # :method: POST
     [0x86]                                             # :scheme: http
     [0x84]                                             # :path: /
     [0x01] [0x0e] "localhost:8080"                     # :authority: localhost:8080

read [0x00 0x00 0x00]                                   # length = 0
     [0x04]                                             # HTTP2 SETTINGS frame
     [0x01]                                             # ACK
     [0x00 0x00 0x00 0x00]                              # stream_id = 0

write [0x00 0x00 0x00]                                  # length = 0
      [0x04]                                            # HTTP2 SETTINGS frame
      [0x01]                                            # ACK
      [0x00 0x00 0x00 0x00]                             # stream_id = 0
write flush

# DATA beyond the stream window, then DATA and PING still in flight
read [0x00 0x00 0x0a]                                   # length = 10
     [0x00]                                             # HTTP2 DATA frame
     [0x00]                                             # no flags
     [0x00 0x00 0x00 0x01]                              # stream_id = 1
     "0123456789"
read [0x00 0x00 0x07]                                   # length = 7
     [0x00]                                             # HTTP2 DATA frame
     [0x00]                                             # no flags
     [0x00 0x00 0x00 0x01]                              # stream_id = 1
     "ABCDEFG"
read [0x00 0x00 0x08]                                   # length = 8
     [0x06]                                             # HTTP2 PING frame
     [0x00]                                             # no flags
     [0x00 0x00 0x00 0x00]                              # stream_id = 0
     [0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08]

write [0x00 0x00 0x04]                                  # length = 4
      [0x03]                                            # HTTP2 RST_STREAM frame
      [0x00]                                            # no flags
      [0x00 0x00 0x00 0x01]                             # stream_id = 1
      [0x00 0x00 0x00 0x03]                             # FLOW_CONTROL_ERROR

write [0x00 0x00 0x08]                                  # length = 8
      [0x06]                                            # HTTP2 PING frame
      [0x01]                                            # ACK
      [0x00 0x00 0x00 0x00]                             # stream_id = 0
      [0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08]
write flush

# ==================== HTTP2 stream-id=3  =================
read [0x00 0x00 0x13]                                   # length = 19
     [0x01]                                             # HEADERS frame
     [0x05]                                             # END_STREAM | END_HEADERS
     [0x00 0x00 0x00 0x03]                              # stream_id = 3
     [0x83]                                             # :method: POST
     [0x86]                                             # :scheme: http
     [0x84]                                             # :path: /
     [0x01] [0x0e] "localhost:8080"                     # :authority: localhost:8080

# DATA after END_STREAM
read [0x00 0x00 0x05]                                   # length = 5
     [0x00]                                             # HTTP2 DATA frame
     [0x00]                                             # no flags
     [0x00 0x00 0x00 0x03]                              # stream_id = 3
     "Hello"
read [0x00 0x00 0x08]                                   # length = 8
     [0x06]                                             # HTTP2 PING frame
     [0x00]                                             # no flags
     [0x00 0x00 0x00 0x00]                              # stream_id = 0
     [0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18]

write [0x00 0x00 0x04]                                  # length = 4
      [0x03]                                            # HTTP2 RST_STREAM frame
      [0x00]                                            # no flags
      [0x00 0x00 0x00 0x03]                             # stream_id = 3
      [0x00 0x00 0x00 0x05]                             # STREAM_CLOSED
write [0x00 0x00 0x08]                                  # length = 8
      [0x06]                                            # HTTP2 PING frame
      [0x01]                                            # ACK
      [0x00 0x00 0x00 0x00]                             # stream_id = 0
      [0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18]
write flush
