connect "zilla://streams/net0"
  option zilla:window 8192
  option zilla:transmission "duplex"
connected

write "GET /request1 HTTP/1.1" "\r\n"
write "Host: localhost:8080" "\r\n"
write "\r\n"

read "HTTP/1.1 503 Service Unavailable\r\n"
read "Content-Length: 0" "\r\n"
read "Retry-After: Fri, 31 Dec 2100 23:59:59 GMT" "\r\n"
read "\r\n"
read notify REQUEST_1_COMPLETED

write await RETRY_AFTER_ELAPSED
write "GET /request3 HTTP/1.1" "\r\n"
write "Host: localhost:8080" "\r\n"
write "\r\n"

read "HTTP/1.1 200 OK\r\n"
read "Content-Length: 0" "\r\n"
read "\r\n"
read notify REQUEST_3_COMPLETED
