accept "zilla://streams/net0"
       option zilla:window 32768
       option zilla:update "stream"
       option zilla:transmission "duplex"
accepted
connected

read "POST / HTTP/1.1\r\n"
     "Host: localhost:8080\r\n"
     "Content-Type: text/plain;charset=UTF-8\r\n"
     "Content-Length: 12\r\n"
     "Upgrade: h2c\r\n"
     "Connection: Upgrade, HTTP2-Settings\r\n"
     "Http2-Settings: AAMAAABkAAQAAP__\r\n"
     "\r\n"

read "Hello, world"

write "HTTP/1.1 101 Switching Protocols\r\n"
      "Connection: Upgrade\r\n"
      "Upgrade: h2c\r\n"
      "\r\n"

# server connection preface - SETTINGS frame
write [0x00 0x00 0x12]                   # length = 18
      [0x04]                             # HTTP2 SETTINGS frame
      [0x00]                             # flags = 0x00
      [0x00 0x00 0x00 0x00]              # stream_id = 0
      [0x00 0x03 0x00 0x00 0x00 0x64]    # SETTINGS_MAX_CONCURRENT_STREAMS(0x03) = 100
      [0x00 0x04 0x00 0x10 0x00 0x00]    # SETTINGS_INITIAL_WINDOW_SIZE(0x04) = 1048576
      [0x00 0x06 0x00 0x00 0x20 0x00]    # SETTINGS_MAX_HEADER_LIST_SIZE(0x06) = 8192
write flush

# client connection preface
write [0x00 0x00 0x00]                  # length = 0
      [0x04]                            # HTTP2 SETTINGS frame
      [0x01]                            # ACK
      [0x00 0x00 0x00 0x00]             # stream_id = 0
write flush

# client connection preface
read "PRI * HTTP/2.0\r\n"
     "\r\n"
     "SM\r\n"
     "\r\n"

read [0x00 0x00 0x0c]                   # length = 12
     [0x04]                             # HTTP2 SETTINGS frame
     [0x00]                             # flags = 0x00
     [0x00 0x00 0x00 0x00]              # stream_id = 0
     [0x00 0x03 0x00 0x00 0x00 0x64]    # SETTINGS_MAX_CONCURRENT_STREAMS(0x03) = 100
     [0x00 0x04 0x00 0x00 0xff 0xff]    # SETTINGS_INITIAL_WINDOW_SIZE(0x04) = 65535

read [0x00 0x00 0x04]                                      # length
     [0x08]                                                # WINDOW_UPDATE frame
     [0x00]                                                # no flags
     [0x00 0x00 0x00 0x00]                                 # stream_id=0
     [0x7f 0xff 0x00 0x00]                                 # window size increment = 2147418112

read [0x00 0x00 0x00]                   # length = 0
     [0x04]                             # HTTP2 SETTINGS frame
     [0x01]                             # ACK
     [0x00 0x00 0x00 0x00]              # stream_id = 0

write [0x00 0x00 0x58]                                      # length
      [0x01]                                                # HTTP2 HEADERS frame
      [0x04]                                                # END_HEADERS
      [0x00 0x00 0x00 0x01]                                 # stream_id=1
      [0x88]                                                # :status: 200
      [0x0f 0x27] [0x14] "CERN/3.0 libwww/2.17"             # server
      [0x0f 0x12] [0x1d] "Wed, 01 Feb 2017 19:12:46 GMT"    # date
      [0x0f 0x10] [0x18] "text/plain;charset=UTF-8"         # content-type
      [0x0f 0x0d] [0x02] "17"                               # content-length
write flush

write [0x00 0x00 0x11]                  # length = 17
      [0x00]                            # HTTP2 DATA frame
      [0x01]                            # END_STREAM
      [0x00 0x00 0x00 0x01]             # stream_id=1
      "Hello from Zilla!"
write flush

# ==================== HTTP2 stream-id=3  =================
read [0x00 0x00 0x37]                                      # length = 55
     [0x01]                                                # HEADERS frame
     [0x04]                                                # END_HEADERS
     [0x00 0x00 0x00 0x03]                                 # stream_id = 3
     [0x83]                                                # :method: POST
     [0x86]                                                # :scheme: http
     [0x84]                                                # :path: /
     [0x01] [0x0e] "localhost:8080"                        # :authority: localhost:8080
     [0x0f 0x10] [0x18] "text/plain;charset=UTF-8"         # content-type
     [0x0f 0x0d] [0x06] "100000"                           # content-length

read [0x00 0x40 0x00]                               # length = 16384
     [0x00]                         # HTTP2 DATA frame
     [0x00]                       # NO_END_STREAM
     [0x00 0x00 0x00 0x03]                           # stream_id = 3
     [0..16384]

read [0x00 0x3f 0xee]                               # length = 16366
     [0x00]                         # HTTP2 DATA frame
     [0x00]                       # NO_END_STREAM
     [0x00 0x00 0x00 0x03]                           # stream_id = 3
     [0..16366]

read [0x00 0x40 0x00]                               # length = 16384
     [0x00]                         # HTTP2 DATA frame
     [0x00]                       # NO_END_STREAM
     [0x00 0x00 0x00 0x03]                           # stream_id = 3
     [0..16384]

read [0x00 0x3f 0xee]                               # length = 16366
     [0x00]                         # HTTP2 DATA frame
     [0x00]                       # NO_END_STREAM
     [0x00 0x00 0x00 0x03]                           # stream_id = 3
     [0..16366]

# the connection window is exhausted, no further DATA until the peer grants more
write [0x00 0x00 0x08]                                  # length = 8
      [0x06]                                            # HTTP2 PING frame
      [0x00]                                            # no flags
      [0x00 0x00 0x00 0x00]                             # stream_id = 0
      [0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08]
write flush

read [0x00 0x00 0x08]                                   # length = 8
     [0x06]                                             # HTTP2 PING frame
     [0x01]                                             # ACK
     [0x00 0x00 0x00 0x00]                              # stream_id = 0
     [0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08]

write [0x00 0x00 0x04]                                  # length
      [0x08]                                            # WINDOW_UPDATE frame
      [0x00]                                            # no flags
      [0x00 0x00 0x00 0x00]                             # stream_id=0
      [0x00 0x00 0x86 0xc4]                             # window size increment = 34500
write flush

read [0x00 0x40 0x00]                               # length = 16384
     [0x00]                         # HTTP2 DATA frame
     [0x00]                       # NO_END_STREAM
     [0x00 0x00 0x00 0x03]                           # stream_id = 3
     [0..16384]

read [0x00 0x3f 0xee]                               # length = 16366
     [0x00]                         # HTTP2 DATA frame
     [0x00]                       # NO_END_STREAM
     [0x00 0x00 0x00 0x03]                           # stream_id = 3
     [0..16366]

read [0x00 0x06 0xd6]                               # length = 1750
     [0x00]                          # HTTP2 DATA frame
     [0x01]                       # END_STREAM
     [0x00 0x00 0x00 0x03]                           # stream_id = 3
     [0..1750]

write [0x00 0x00 0x18]                                  # length = 24
      [0x01]                                            # HTTP2 HEADERS frame
      [0x04]                                            # END_HEADERS
      [0x00 0x00 0x00 0x03]                             # stream_id=3
      [0x89]                                            # :status: 204
      [0x0f 0x27] [0x14] "CERN/3.0 libwww/2.17"         # server
write flush

write [0x00 0x00 0x00]                                  # length = 0
      [0x00]                                            # HTTP2 DATA frame
      [0x01]                                            # END_STREAM
      [0x00 0x00 0x00 0x03]                             # stream_id=3
write flush
