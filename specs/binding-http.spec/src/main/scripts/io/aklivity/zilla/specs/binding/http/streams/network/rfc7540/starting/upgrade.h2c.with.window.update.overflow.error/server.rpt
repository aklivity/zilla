accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "duplex"
accepted
connected

read "GET /items HTTP/1.1\r\n"
     "Host: localhost:8080\r\n"
     "Upgrade: h2c\r\n"
     "Connection: Upgrade, HTTP2-Settings\r\n"
     "Http2-Settings: AAMAAABkAAQAAP__\r\n"
     "\r\n"

write "HTTP/1.1 101 Switching Protocols\r\n"
      "Connection: Upgrade\r\n"
      "Upgrade: h2c\r\n"
      "\r\n"

# server connection preface - SETTINGS frame
write [0x00 0x00 0x12]                   # length = 18
      [0x04]                             # HTTP2 SETTINGS frame
      [0x00]                             # flags = 0x00
      [0x00 0x00 0x00 0x00]              # stream_id = 0
      [0x00 0x03 0x00 0x00 0x00 0x64]    # SETTINGS_MAX_CONCURRENT_STREAMS(0x03) = 100
      [0x00 0x04 0x00 0x00 0x00 0x00]    # SETTINGS_INITIAL_WINDOW_SIZE(0x04) = 0
      [0x00 0x06 0x00 0x00 0x20 0x00]    # SETTINGS_MAX_HEADER_LIST_SIZE(0x06) = 8192
write [0x00 0x00 0x04]                                     # length
      [0x08]                                               # WINDOW_UPDATE frame
      [0x00]                                               # no flags
      [0x00 0x00 0x00 0x00]                                # stream_id=0
      [0x7f 0xff 0x00 0x01]                                # window size increment = 2147418113, past 2^31-1 with the initial 65535
write flush

read [0x00 0x00 0x04]                                      # length
     [0x08]                                                # WINDOW_UPDATE frame
     [0x00]                                                # no flags
     [0x00 0x00 0x00 0x00]                                 # stream_id=0
     [0x7f 0xff 0x00 0x00]                                 # window size increment = 2147418112

read [0x00 0x00 0x00]                   # length = 0
     [0x04]                             # HTTP2 SETTINGS frame
     [0x01]                             # ACK
     [0x00 0x00 0x00 0x00]              # stream_id = 0

read [0x00 0x00 0x08]                          # length = 8
     [0x07]                                    # HTTP2 GO_AWAY frame
     [0x00]                                    # no flags
     [0x00 0x00 0x00 0x00]                     # stream_id=0
     [0x00 0x00 0x00 0x00]                     # Last-Stream_ID
     [0x00 0x00 0x00 0x03]                     # FLOW_CONTROL_ERROR
