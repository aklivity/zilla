[
    {
        "op": "add",
        "path": "/$defs/binding/properties/type/enum/-",
        "value": "mcp-http"
    },
    {
        "op": "add",
        "path": "/$defs/binding/allOf/-",
        "value":
        {
            "if":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "mcp-http"
                    }
                }
            },
            "then":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "mcp-http"
                    },
                    "kind":
                    {
                        "enum": [ "client", "proxy" ]
                    },
                    "vault": false,
                    "entry": false,
                    "options":
                    {
                        "properties":
                        {
                            "authorization":
                            {
                                "title": "Authorization",
                                "type": "object",
                                "patternProperties":
                                {
                                    "^[A-Za-z0-9_-]+$":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "credentials":
                                            {
                                                "title": "Credentials",
                                                "type": "object",
                                                "properties":
                                                {
                                                    "headers":
                                                    {
                                                        "title": "Headers",
                                                        "type": "object",
                                                        "patternProperties":
                                                        {
                                                            "^[A-Za-z0-9:-]+$":
                                                            {
                                                                "type": "string"
                                                            }
                                                        },
                                                        "additionalProperties": false
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "additionalProperties": false,
                                "maxProperties": 1
                            },
                            "tools":
                            {
                                "title": "Tools",
                                "type": "object",
                                "patternProperties":
                                {
                                    "^[A-Za-z0-9_-]+$":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "title":
                                            {
                                                "title": "Tool Title",
                                                "type": "string"
                                            },
                                            "description":
                                            {
                                                "title": "Tool Description",
                                                "type": "string"
                                            },
                                            "summary":
                                            {
                                                "title": "Result Summary",
                                                "type": "string"
                                            },
                                            "schemas":
                                            {
                                                "title": "Schemas",
                                                "type": "object",
                                                "properties":
                                                {
                                                    "input":
                                                    {
                                                        "title": "Input Schema",
                                                        "$ref": "#/$defs/models"
                                                    },
                                                    "output":
                                                    {
                                                        "title": "Output Schema",
                                                        "$ref": "#/$defs/models"
                                                    }
                                                },
                                                "required": [ "input" ],
                                                "additionalProperties": false
                                            },
                                            "annotations":
                                            {
                                                "title": "Annotations",
                                                "type": "object",
                                                "properties":
                                                {
                                                    "title":
                                                    {
                                                        "title": "Title",
                                                        "type": "string"
                                                    },
                                                    "readOnlyHint":
                                                    {
                                                        "title": "Read-Only Hint",
                                                        "type": "boolean"
                                                    },
                                                    "destructiveHint":
                                                    {
                                                        "title": "Destructive Hint",
                                                        "type": "boolean"
                                                    },
                                                    "idempotentHint":
                                                    {
                                                        "title": "Idempotent Hint",
                                                        "type": "boolean"
                                                    },
                                                    "openWorldHint":
                                                    {
                                                        "title": "Open-World Hint",
                                                        "type": "boolean"
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        },
                                        "required": [ "summary", "schemas" ],
                                        "additionalProperties": false
                                    }
                                },
                                "additionalProperties": false
                            },
                            "resources":
                            {
                                "title": "Resources",
                                "type": "object",
                                "patternProperties":
                                {
                                    "^[A-Za-z0-9_-]+$":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "uri":
                                            {
                                                "title": "Resource URI",
                                                "type": "string"
                                            },
                                            "description":
                                            {
                                                "title": "Resource Description",
                                                "type": "string"
                                            },
                                            "mimeType":
                                            {
                                                "title": "MIME Type",
                                                "type": "string"
                                            },
                                            "schemas":
                                            {
                                                "title": "Schemas",
                                                "type": "object",
                                                "properties":
                                                {
                                                    "output":
                                                    {
                                                        "title": "Output Schema",
                                                        "$ref": "#/$defs/models"
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        },
                                        "required": [ "uri" ],
                                        "additionalProperties": false
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "additionalProperties": false
                    },
                    "routes":
                    {
                        "title": "Routes",
                        "type": "array",
                        "items":
                        {
                            "type": "object",
                            "properties":
                            {
                                "when":
                                {
                                    "title": "When",
                                    "type": "array",
                                    "maxItems": 1,
                                    "items":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "tool":
                                            {
                                                "title": "Tool",
                                                "type": "string"
                                            },
                                            "resource":
                                            {
                                                "title": "Resource",
                                                "type": "string"
                                            }
                                        },
                                        "anyOf":
                                        [
                                            { "required": [ "tool" ] },
                                            { "required": [ "resource" ] }
                                        ],
                                        "not": { "required": [ "tool", "resource" ] },
                                        "additionalProperties": false
                                    }
                                },
                                "with":
                                {
                                    "title": "With",
                                    "type": "object",
                                    "properties":
                                    {
                                        "headers":
                                        {
                                            "title": "Headers",
                                            "type": "object",
                                            "properties":
                                            {
                                                ":scheme":
                                                {
                                                    "title": "Scheme",
                                                    "type": "string",
                                                    "enum": [ "http", "https" ]
                                                },
                                                ":authority":
                                                {
                                                    "title": "Authority",
                                                    "type": "string",
                                                    "pattern": "^[^:/]+:[0-9]+$"
                                                },
                                                ":path":
                                                {
                                                    "title": "Path",
                                                    "type": "string"
                                                }
                                            },
                                            "patternProperties":
                                            {
                                                "^[A-Za-z0-9:-]+$":
                                                {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [ ":scheme", ":authority", ":path" ],
                                            "additionalProperties": false
                                        },
                                        "cookies":
                                        {
                                            "title": "Cookies",
                                            "type": "object",
                                            "patternProperties":
                                            {
                                                "^[A-Za-z0-9_-]+$":
                                                {
                                                    "type": "string"
                                                }
                                            },
                                            "additionalProperties": false
                                        },
                                        "query":
                                        {
                                            "title": "Query Projection",
                                            "$ref": "#/$defs/models"
                                        },
                                        "body":
                                        {
                                            "title": "Body",
                                            "oneOf":
                                            [
                                                {
                                                    "$ref": "#/$defs/models"
                                                },
                                                {
                                                    "type": "object",
                                                    "properties":
                                                    {
                                                        "template":
                                                        {
                                                            "title": "Body Template",
                                                            "type": "object",
                                                            "patternProperties":
                                                            {
                                                                "^[A-Za-z0-9_-]+$":
                                                                {
                                                                    "type": "string"
                                                                }
                                                            },
                                                            "additionalProperties": false
                                                        }
                                                    },
                                                    "required": [ "template" ],
                                                    "additionalProperties": false
                                                }
                                            ]
                                        }
                                    },
                                    "required": [ "headers" ],
                                    "additionalProperties": false
                                }
                            },
                            "if":
                            {
                                "required": [ "with" ]
                            },
                            "then":
                            {
                                "required": [ "when" ],
                                "properties":
                                {
                                    "when":
                                    {
                                        "minItems": 1
                                    }
                                }
                            }
                        }
                    }
                },
                "oneOf":
                [
                    {
                        "properties":
                        {
                            "kind":
                            {
                                "const": "proxy"
                            },
                            "routes":
                            {
                                "items":
                                {
                                    "if":
                                    {
                                        "required": [ "with" ]
                                    },
                                    "then":
                                    {
                                        "required": [ "exit" ]
                                    }
                                }
                            }
                        }
                    },
                    {
                        "properties":
                        {
                            "kind":
                            {
                                "const": "client"
                            },
                            "exit": false,
                            "routes":
                            {
                                "items":
                                {
                                    "properties":
                                    {
                                        "exit": false
                                    }
                                }
                            }
                        }
                    }
                ]
            }
        }
    }
]
