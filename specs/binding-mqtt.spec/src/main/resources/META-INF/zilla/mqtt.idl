scope mqtt
{
    enum MqttSessionFlags (uint8)
    {
        CLEAN_START(1),
        WILL(2)
    }

    enum MqttSubscribeFlags (uint8)
    {
        SEND_RETAINED(0),
        RETAIN_AS_PUBLISHED(1),
        NO_LOCAL(2),
        RETAIN(3)
    }

    enum MqttQoS (uint8)
    {
        AT_MOST_ONCE(0),
        AT_LEAST_ONCE(1),
        EXACTLY_ONCE(2)
    }

    enum MqttPublishFlags (uint8)
    {
        RETAIN(0),
        DUP(1)
    }

    enum MqttPayloadFormat
    {
        BINARY,
        TEXT,
        NONE
    }

    enum MqttTime (int64)
    {
        UNKNOWN(-1L)
    }

    struct MqttBinary
    {
        int32 length;
        octets[length] bytes = null;
    }

    struct MqttUserProperty
    {
        string16 key;
        string16 value;
    }

    struct MqttTopicFilter
    {
        int32 subscriptionId = 0;
        uint8 qos = 0;
        uint8 flags = 0;
        uint8 reasonCode = 0;
        string16 pattern;
        string16 shareName = null;
    }

    struct MqttTopicFilterV2
    {
        uint32 subscriptionId = 0;
        uint8 qos = 0;
        uint8 flags = 0;
        uint8 reasonCode = 0;
        string16 pattern;
        string16 shareName = null;
    }

    struct MqttTopicFilterV1
    {
        uint32 subscriptionId = 0;
        uint8 qos = 0;
        uint8 flags = 0;
        uint8 reasonCode = 0;
        string16 pattern;
    }

    enum MqttSessionStateVersion (uint8)
    {
        V1 (1),
        V2 (2),
        V3 (3)
    }

    struct MqttSessionStateV1
    {
        MqttTopicFilterV1[] subscriptions;
    }

    struct MqttSessionStateV2
    {
        MqttTopicFilterV1[] subscriptions;
    }

    struct MqttSessionStateV3
    {
        MqttTopicFilterV2[] subscriptions;
    }

    union MqttSessionState switch (MqttSessionStateVersion)
    {
        case V1: mqtt::MqttSessionStateV1 sessionStateV1;
        case V2: mqtt::MqttSessionStateV2 sessionStateV2;
        case V3: mqtt::MqttSessionStateV3 sessionStateV3;
    }

    enum MqttPacketState (uint8)
    {
        PUBLISH_SENT (1),
        PUBREL_PENDING (2)
    }

    struct MqttPacket
    {
        uint16 packetId;
        uint8 state;
        uint8 qos;
        string16 shareName = null;
        string16 filter = null;
        MqttBinary metadata;
    }

    struct MqttMembership
    {
        string16 shareName;
        string16 filter;
    }

    enum MqttClientStateVersion (uint8)
    {
        V1 (1),
        V2 (2),
        V3 (3)
    }

    struct MqttClientStateV1
    {
        MqttMembership[] memberships;
        MqttPacket[] packets;
    }

    struct MqttClientStateV2
    {
        MqttMembership[] memberships;
        MqttPacket[] packets;
        string16 holder = null;
    }

    struct MqttClientStateV3
    {
        MqttMembership[] memberships;
        MqttPacket[] packets;
        string16 holder = null;
        MqttBinary subscriptions;
        MqttBinary inbound;
    }

    union MqttClientState switch (MqttClientStateVersion)
    {
        case V1: mqtt::MqttClientStateV1 clientStateV1;
        case V2: mqtt::MqttClientStateV2 clientStateV2;
        case V3: mqtt::MqttClientStateV3 clientStateV3;
    }

    enum MqttSessionSignalType (uint8)
    {
        WILL (0),
        EXPIRY (1),
        WILL_LONG (2),
        EXPIRY_LONG (3)
    }

    union MqttSessionSignal switch (uint8)
    {
        case 0: mqtt::MqttWillSignal will;
        case 1: mqtt::MqttExpirySignal expiry;
        case 2: mqtt::MqttWillSignalLong willLong;
        case 3: mqtt::MqttExpirySignalLong expiryLong;
    }

    struct MqttWillSignal
    {
        string16 instanceId;
        string16 clientId;
        int32 delay = 0;
        int64 deliverAt = -1;
        string16 lifetimeId = null;
        string16 willId = null;
    }

    struct MqttExpirySignal
    {
        string16 instanceId;
        string16 clientId;
        int32 delay = 0;
        int64 expireAt = -1;
    }

    struct MqttWillSignalLong
    {
        string16 instanceId;
        string16 clientId;
        int64 delay = 0;
        int64 deliverAt = -1;
        string16 lifetimeId = null;
        string16 willId = null;
    }

    struct MqttExpirySignalLong
    {
        string16 instanceId;
        string16 clientId;
        int64 delay = 0;
        int64 expireAt = -1;
    }

    struct MqttWillMessage
    {
        string16 topic = null;
        uint32 delay = 0;
        uint8 qos = 0;
        uint8 flags = 0;
        int32 expiryInterval = -1;
        string16 contentType = null;
        MqttPayloadFormat format = NONE;
        string16 responseTopic = null;
        string16 lifetimeId = null;
        string16 willId = null;
        MqttBinary correlation;
        MqttUserProperty[] properties;
        uint16 payloadSize;
    }

    scope stream
    {
        enum MqttExtensionKind (uint8)
        {
            SESSION (2),
            SUBSCRIBE (1),
            PUBLISH (0)
        }

        union MqttBeginEx switch (uint8) extends core::stream::Extension
        {
            case 0: mqtt::stream::MqttPublishBeginEx publish;
            case 1: mqtt::stream::MqttSubscribeBeginEx subscribe;
            case 2: mqtt::stream::MqttSessionBeginEx session;
        }

        enum MqttServerCapabilities (uint8)
        {
            RETAIN (0),
            WILDCARD (1),
            SUBSCRIPTION_IDS (2),
            SHARED_SUBSCRIPTIONS (3),
            REDIRECT(4),
            SHARED_GENERATION (5)
        }

        struct MqttSessionBeginEx
        {
            uint8 flags = 0;
            int32 expiry = 0;
            uint16 subscribeQosMax = 0;
            uint16 publishQosMax = 0;
            uint32 packetSizeMax = 0;
            uint8 capabilities = 0;
            string16 clientId;
            int8 length;
            int16[length] packetIds = null;
            int32 inboundLength;
            octets[inboundLength] inbound = null;
        }

        struct MqttSubscribeBeginEx
        {
            string16 clientId;
            uint8 qos = 0;
            MqttTopicFilter[] filters;
            uint32 generation = 0;
            MqttPacket[] packets;
        }

        struct MqttPublishBeginEx
        {
            string16 clientId;
            string16 topic;
            uint8 flags = 0;
            uint8 qos = 0;
        }

        union MqttDataEx switch (uint8) extends core::stream::Extension
        {
            case 0: mqtt::stream::MqttPublishDataEx publish;
            case 1: mqtt::stream::MqttSubscribeDataEx subscribe;
            case 2: mqtt::stream::MqttSessionDataEx session;
        }

        struct MqttSubscribeDataEx
        {
            int32 deferred = 0;             // INIT only (TODO: move to DATA frame)
            string16 topic = null;
            uint16 packetId = 0;
            uint8 qos = 0;
            uint8 flags = 0;
            varint32[] subscriptionIds;
            int32 expiryInterval = -1;
            string16 contentType = null;
            MqttPayloadFormat format = NONE;
            string16 responseTopic = null;
            MqttBinary correlation;
            MqttUserProperty[] properties;
            MqttBinary metadata;
        }

        struct MqttPublishDataEx
        {
            int32 deferred = 0;             // INIT only (TODO: move to DATA frame)
            uint8 qos = 0;
            uint8 flags = 0;
            uint16 packetId = 0;
            int32 expiryInterval = -1;
            string16 contentType = null;
            MqttPayloadFormat format = NONE;
            string16 responseTopic = null;
            MqttBinary correlation;
            MqttUserProperty[] properties;
        }

        enum MqttSessionDataKind
        {
            STATE,
            WILL
        }

        struct MqttSessionDataEx
        {
            int32 deferred = 0;
            MqttSessionDataKind kind;
        }

        struct MqttResetEx extends core::stream::Extension
        {
            string16 serverRef = null;
            uint8 reasonCode = 0;
            string16 reason = null;
            MqttUserProperty[] properties;
        }

        struct MqttEndEx extends core::stream::Extension
        {
            int32 expiry;
        }

        union MqttFlushEx switch (uint8) extends core::stream::Extension
        {
            case 0: mqtt::stream::MqttPublishFlushEx publish;
            case 1: mqtt::stream::MqttSubscribeFlushEx subscribe;
            case 2: mqtt::stream::MqttSessionFlushEx session;
        }

        struct MqttPublishFlushEx
        {
            uint16 packetId = 0;
            uint8 reasonCode = 0;
        }

        struct MqttSessionFlushEx
        {
            uint16 packetId = 0;
            int32 inboundLength;
            octets[inboundLength] inbound = null;
        }

        struct MqttSubscribeFlushEx
        {
            uint8 qos = 0;
            uint16 packetId = 0;
            uint8 state = 0;
            uint8 reasonCode = 0;
            MqttTopicFilter[] filters;
        }

        enum MqttOffsetStateFlags (uint8)
        {
            COMPLETE(0),
            INCOMPLETE(1),
            RECORDED(2),
            ABANDONED(3)
        }
    }

    scope event
    {
        enum MqttEventType (uint8)
        {
            CLIENT_CONNECTED (1)
        }

        struct MqttClientConnectedEx extends core::stream::Extension
        {
            string8 identity;
            string8 clientId;
        }

        union MqttEventEx switch (MqttEventType)
        {
            case CLIENT_CONNECTED: MqttClientConnectedEx clientConnected;
        }
    }
}
