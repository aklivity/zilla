accept "zilla://streams/net0"
  option zilla:window 8192
  option zilla:transmission "duplex"
  option zilla:byteorder "network"

accepted
connected

read  [0x10 0x36]                             # CONNECT
      [0x00 0x04] "MQTT"                      # protocol name
      [0x05]                                  # protocol version
      [0x06]                                  # flags = will flag, clean start
      [0x00 0x3c]                             # keep alive = 60s
      [0x00]                                  # properties = none
      [0x00 0x06] "client"                    # client id
      [0x0e]                                  # will properties
      [0x26]                                  # will user property
      [0x00 0x04] "name"                      # key
      [0x00 0x05] [0x61 0xed 0xa0 0x80 0x62]  # value = ill-formed UTF-8, U+D800 as 0xED 0xA0 0x80
      [0x00 0x09] "willTopic"                 # will topic
      [0x00 0x07] "message"                   # will payload

write [0x20 0x03]  # CONNACK
      [0x00]       # flags = none
      [0x81]       # reason = malformed packet
      [0x00]       # properties = none

write close
