connect "zilla://streams/app0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${mqtt:beginEx()
                            .typeId(zilla:id("mqtt"))
                            .session()
                              .flags("CLEAN_START")
                              .expiry(1)
                              .clientId("client")
                              .build()
                            .build()}

read zilla:begin.ext ${mqtt:matchBeginEx()
                              .typeId(zilla:id("mqtt"))
                              .session()
                                .flags("CLEAN_START")
                                .expiry(1)
                                .subscribeQosMax(2)
                                .publishQosMax(2)
                                .packetSizeMax(33792)
                                .capabilities("RETAIN", "WILDCARD", "SUBSCRIPTION_IDS", "SHARED_SUBSCRIPTIONS", "SHARED_GENERATION")
                                .clientId("client")
                                .build()
                              .build()}

connected

read zilla:data.empty

write zilla:data.ext ${mqtt:dataEx()
                             .typeId(zilla:id("mqtt"))
                             .session()
                                .kind("STATE")
                                .build()
                             .build()}
write ${mqtt:session().build()}
write flush

write zilla:data.ext ${mqtt:dataEx()
                             .typeId(zilla:id("mqtt"))
                             .session()
                                .kind("STATE")
                                .build()
                             .build()}

write ${mqtt:session()
            .sharedSubscription("consumer1", "sensor/one", 1, "AT_MOST_ONCE")
            .build()}
write flush

read ${mqtt:session()
           .sharedSubscription("consumer1", "sensor/one", 1, "AT_MOST_ONCE")
           .build()}
read notify RECEIVED_SESSION_STATE

write close
read closed


connect await RECEIVED_SESSION_STATE
        "zilla://streams/app0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${mqtt:beginEx()
                             .typeId(zilla:id("mqtt"))
                             .subscribe()
                                 .clientId("client")
                                 .qos("AT_MOST_ONCE")
                                 .sharedFilter("consumer1", "sensor/one", -1, "AT_MOST_ONCE")
                                 .generation(0)
                                 .build()
                             .build()}

connected

write close
read closed
read notify CLOSED_FIRST_SUBSCRIBE


connect await CLOSED_FIRST_SUBSCRIBE
         "zilla://streams/app0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${mqtt:beginEx()
                            .typeId(zilla:id("mqtt"))
                            .session()
                              .flags("CLEAN_START")
                              .expiry(1)
                              .clientId("client")
                              .build()
                            .build()}

read zilla:begin.ext ${mqtt:matchBeginEx()
                              .typeId(zilla:id("mqtt"))
                              .session()
                                .flags("CLEAN_START")
                                .expiry(1)
                                .subscribeQosMax(2)
                                .publishQosMax(2)
                                .packetSizeMax(33792)
                                .capabilities("RETAIN", "WILDCARD", "SUBSCRIPTION_IDS", "SHARED_SUBSCRIPTIONS", "SHARED_GENERATION")
                                .clientId("client")
                                .build()
                              .build()}

connected

read zilla:data.empty

write zilla:data.ext ${mqtt:dataEx()
                             .typeId(zilla:id("mqtt"))
                             .session()
                                .kind("STATE")
                                .build()
                             .build()}
write ${mqtt:session().build()}
write flush

write zilla:data.ext ${mqtt:dataEx()
                             .typeId(zilla:id("mqtt"))
                             .session()
                                .kind("STATE")
                                .build()
                             .build()}

write ${mqtt:session()
            .sharedSubscription("consumer1", "sensor/one", 1, "AT_MOST_ONCE")
            .build()}
write flush

read ${mqtt:session()
           .sharedSubscription("consumer1", "sensor/one", 1, "AT_MOST_ONCE")
           .build()}
read notify RECEIVED_SESSION_STATE2

write close
read closed


connect await RECEIVED_SESSION_STATE2
        "zilla://streams/app0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${mqtt:beginEx()
                             .typeId(zilla:id("mqtt"))
                             .subscribe()
                                 .clientId("client")
                                 .qos("AT_MOST_ONCE")
                                 .sharedFilter("consumer1", "sensor/one", -1, "AT_MOST_ONCE")
                                 .generation(1)
                                 .build()
                             .build()}

connected

write close
read closed
