connect "zilla://streams/app0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${mqtt:beginEx()
                            .typeId(zilla:id("mqtt"))
                            .session()
                              .flags("CLEAN_START")
                              .expiry(1)
                              .clientId("client")
                              .build()
                            .build()}

read zilla:begin.ext ${mqtt:matchBeginEx()
                              .typeId(zilla:id("mqtt"))
                              .session()
                                .flags("CLEAN_START")
                                .expiry(1)
                                .subscribeQosMax(2)
                                .publishQosMax(2)
                                .packetSizeMax(33792)
                                .capabilities("RETAIN", "WILDCARD", "SUBSCRIPTION_IDS", "SHARED_SUBSCRIPTIONS")
                                .clientId("client")
                                .build()
                              .build()}

connected

read zilla:data.empty

write zilla:data.ext ${mqtt:dataEx()
                           .typeId(zilla:id("mqtt"))
                           .session()
                              .kind("STATE")
                              .build()
                           .build()}
write ${mqtt:session().build()}
write flush

write zilla:data.ext ${mqtt:dataEx()
                           .typeId(zilla:id("mqtt"))
                           .session()
                              .kind("STATE")
                              .build()
                           .build()}

write ${mqtt:session()
            .sharedSubscription("consumer1", "sensor/one", 1, "EXACTLY_ONCE")
            .build()}
write flush

read ${mqtt:session()
           .sharedSubscription("consumer1", "sensor/one", 1, "EXACTLY_ONCE")
           .build()}
read notify RECEIVED_SESSION_STATE

write abort
read notify SENT_SESSION_ABORT


connect await RECEIVED_SESSION_STATE
        "zilla://streams/app0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${mqtt:beginEx()
                             .typeId(zilla:id("mqtt"))
                             .subscribe()
                                 .clientId("client")
                                 .qos("EXACTLY_ONCE")
                                 .sharedFilter("consumer1", "sensor/one", -1, "EXACTLY_ONCE")
                                 .build()
                             .build()}

connected

read zilla:data.ext ${mqtt:matchDataEx()
                            .typeId(zilla:id("mqtt"))
                            .subscribe()
                                 .topic("sensor/one")
                                 .packetId(1)
                                 .qos("EXACTLY_ONCE")
                                 .subscriptionId(-1)
                                 .format("TEXT")
                                 .metadata("offset-1")
                                 .build()
                            .build()}
read "message"

write advise zilla:flush ${mqtt:flushEx()
                                 .typeId(zilla:id("mqtt"))
                                 .subscribe()
                                     .qos("EXACTLY_ONCE")
                                     .packetId(1)
                                     .state("RECORDED")
                                     .build()
                                 .build()}

read abort


connect await SENT_SESSION_ABORT
         "zilla://streams/app0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${mqtt:beginEx()
                            .typeId(zilla:id("mqtt"))
                            .session()
                              .expiry(1)
                              .clientId("client")
                              .build()
                            .build()}

read zilla:begin.ext ${mqtt:matchBeginEx()
                              .typeId(zilla:id("mqtt"))
                              .session()
                                .expiry(1)
                                .subscribeQosMax(2)
                                .publishQosMax(2)
                                .packetSizeMax(33792)
                                .capabilities("RETAIN", "WILDCARD", "SUBSCRIPTION_IDS", "SHARED_SUBSCRIPTIONS")
                                .clientId("client")
                                .build()
                              .build()}

connected

read ${mqtt:session()
           .sharedSubscription("consumer1", "sensor/one", 1, "EXACTLY_ONCE")
           .build()}
read notify RECEIVED_SESSION_STATE2


connect await RECEIVED_SESSION_STATE2
        "zilla://streams/app0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${mqtt:beginEx()
                             .typeId(zilla:id("mqtt"))
                             .subscribe()
                                 .clientId("client")
                                 .qos("EXACTLY_ONCE")
                                 .sharedFilter("consumer1", "sensor/one", -1, "EXACTLY_ONCE")
                                 .sharedPacket(1, "PUBLISH_SENT", "EXACTLY_ONCE", "consumer1", "sensor/one", "offset-1")
                                 .build()
                             .build()}

connected

read zilla:data.ext ${mqtt:matchDataEx()
                            .typeId(zilla:id("mqtt"))
                            .subscribe()
                                 .topic("sensor/one")
                                 .packetId(1)
                                 .qos("EXACTLY_ONCE")
                                 .flags("DUP")
                                 .subscriptionId(-1)
                                 .format("TEXT")
                                 .metadata("offset-1")
                                 .build()
                            .build()}
read "message"

write advise zilla:flush ${mqtt:flushEx()
                                 .typeId(zilla:id("mqtt"))
                                 .subscribe()
                                     .qos("EXACTLY_ONCE")
                                     .packetId(1)
                                     .state("INCOMPLETE")
                                     .build()
                                 .build()}

read advised zilla:flush ${mqtt:flushEx()
                                 .typeId(zilla:id("mqtt"))
                                 .subscribe()
                                     .qos("EXACTLY_ONCE")
                                     .packetId(1)
                                     .state("INCOMPLETE")
                                     .build()
                                 .build()}

write advise zilla:flush ${mqtt:flushEx()
                                 .typeId(zilla:id("mqtt"))
                                 .subscribe()
                                     .qos("EXACTLY_ONCE")
                                     .packetId(1)
                                     .build()
                                 .build()}
