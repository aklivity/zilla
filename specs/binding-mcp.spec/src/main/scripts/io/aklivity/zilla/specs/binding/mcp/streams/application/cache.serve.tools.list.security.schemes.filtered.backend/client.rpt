property affinity "00000000"

connect "zilla://streams/app1"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .build()
                           .build()}

connected

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .sessionId("5ca1ab1e-c0de-4a11-feed-0001".concat(affinity))
                              .build()
                          .build()}

read notify LIFECYCLE_INITIALIZED

connect await LIFECYCLE_INITIALIZED
        "zilla://streams/app1"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .toolsList()
                               .sessionId("5ca1ab1e-c0de-4a11-feed-0001".concat(affinity))
                               .build()
                           .build()}

connected

read  '{"tools":'
        '['
          '{'
            '"name":"list_repos",'
            '"description":"List repositories",'
            '"securitySchemes":[{"type":"oauth2","scopes":["read"]}]'
          '}'
          ','
          '{'
            '"name":"delete_repo",'
            '"description":"Delete a repository",'
            '"securitySchemes":[{"type":"oauth2","scopes":["admin"]}]'
          '}'
          ','
          '{'
            '"name":"get_status",'
            '"description":"Get status"'
          '}'
        ']'
      '}'
read closed

write close
