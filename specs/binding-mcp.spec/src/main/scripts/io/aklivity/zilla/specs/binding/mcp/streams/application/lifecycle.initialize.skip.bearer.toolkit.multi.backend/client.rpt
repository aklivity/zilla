connect "zilla://streams/app1"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .build()
                           .build()}

connected

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .sessionId("5ca1ab1e-c0de-4a11-5e55-000a00000000")
                              .build()
                          .build()}

read notify APP1_LIFECYCLE

connect await APP1_LIFECYCLE
        "zilla://streams/app2"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .build()
                           .build()}

connected

read zilla:reset.ext ${mcp:matchResetEx()
                          .typeId(zilla:id("mcp"))
                          .bearer()
                              .realm("github")
                              .scopes("repo")
                              .error("INSUFFICIENT_SCOPE")
                              .build()
                          .build()}

write aborted
