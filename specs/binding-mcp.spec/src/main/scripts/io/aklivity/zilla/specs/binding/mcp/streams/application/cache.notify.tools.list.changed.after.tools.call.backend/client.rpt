property affinity "00000000"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .build()
                           .build()}

connected

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .sessionId("5ca1ab1e-c0de-4a11-feed-0001".concat(affinity))
                              .build()
                          .build()}

read notify FEED_LIFECYCLE_INITIALIZED

read advised zilla:flush ${mcp:matchFlushEx()
                               .typeId(zilla:id("mcp"))
                               .toolsListChanged()
                                   .build()
                               .build()}

connect await FEED_LIFECYCLE_INITIALIZED
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .toolsList()
                               .sessionId("5ca1ab1e-c0de-4a11-feed-0001".concat(affinity))
                               .build()
                           .build()}

connected

read '{"tools":[{"name":"get_weather"}]}'
read closed

write close

write notify FEED_TOOLS_HYDRATED

connect await FEED_TOOLS_HYDRATED
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .build()
                           .build()}

connected

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .sessionId("5ca1ab1e-c0de-4a11-b007-0001".concat(affinity))
                              .build()
                          .build()}

read notify B007_LIFECYCLE_INITIALIZED

read advised zilla:flush ${mcp:matchFlushEx()
                               .typeId(zilla:id("mcp"))
                               .toolsListChanged()
                                   .build()
                               .build()}

connect await B007_LIFECYCLE_INITIALIZED
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .toolsCall()
                               .sessionId("5ca1ab1e-c0de-4a11-b007-0001".concat(affinity))
                               .name("get_weather")
                               .contentLength(58)
                               .build()
                           .build()}

connected

write '{"name":"get_weather","arguments":{"location":"New York"}}'

read '{"content":[{"type":"text","text":"sunny"}],"isError":false}'
read closed

write close

read notify TOOLS_CALL_RETURNED

connect await TOOLS_CALL_RETURNED
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .toolsList()
                               .sessionId("5ca1ab1e-c0de-4a11-feed-0001".concat(affinity))
                               .build()
                           .build()}

connected

read '{"tools":[{"name":"get_weather"},{"name":"get_time"}]}'
read closed

write close
