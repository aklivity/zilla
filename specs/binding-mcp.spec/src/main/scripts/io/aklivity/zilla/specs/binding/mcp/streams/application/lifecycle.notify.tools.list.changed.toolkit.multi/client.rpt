property affinity "00000000"

connect "zilla://streams/app1"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .build()
                           .build()}

connected

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .sessionId("5ca1ab1e-c0de-4a11-5e55-000a".concat(affinity))
                              .build()
                          .build()}

read notify LIFECYCLE_INITIALIZED_1

read advised zilla:flush ${mcp:matchFlushEx()
                               .typeId(zilla:id("mcp"))
                               .toolsListChanged()
                                   .id("100")
                                   .build()
                               .build()}

read advised zilla:flush ${mcp:matchFlushEx()
                               .typeId(zilla:id("mcp"))
                               .toolsListChanged()
                                   .id("101")
                                   .build()
                               .build()}

connect await LIFECYCLE_INITIALIZED_1
        "zilla://streams/app1"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .toolsList()
                               .sessionId("5ca1ab1e-c0de-4a11-5e55-000a".concat(affinity))
                               .build()
                           .build()}

connected

read  '{"tools":'
        '['
          '{"name":"get_weather"}'
        ']'
      '}'
read closed

write close

write notify TOOLS_LIST_1_DONE

connect await TOOLS_LIST_1_DONE
        "zilla://streams/app2"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .build()
                           .build()}

connected

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .sessionId("5ca1ab1e-c0de-4a11-5e55-000b".concat(affinity))
                              .build()
                          .build()}

read notify LIFECYCLE_INITIALIZED_2

read advised zilla:flush ${mcp:matchFlushEx()
                               .typeId(zilla:id("mcp"))
                               .toolsListChanged()
                                   .id("200")
                                   .build()
                               .build()}

connect await LIFECYCLE_INITIALIZED_2
        "zilla://streams/app2"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .toolsList()
                               .sessionId("5ca1ab1e-c0de-4a11-5e55-000b".concat(affinity))
                               .build()
                           .build()}

connected

read  '{"tools":'
        '['
          '{"name":"get_current_time"}'
        ']'
      '}'
read closed

write close
