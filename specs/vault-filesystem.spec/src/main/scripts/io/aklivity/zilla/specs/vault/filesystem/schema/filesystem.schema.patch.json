[
    {
        "op": "add",
        "path": "/$defs/vault/properties/type/enum/-",
        "value": "filesystem"
    },
    {
        "op": "add",
        "path": "/$defs/vault/allOf/-",
        "value":
        {
            "if":
            {
               "properties":
                {
                    "type":
                    {
                        "const": "filesystem"
                    }
                }
            },
            "then":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "filesystem"
                    },
                    "options":
                    {
                        "properties":
                        {
                            "keys":
                            {
                                "title": "Keys",
                                "type": "object",
                                "properties":
                                {
                                    "store":
                                    {
                                        "type": "string"
                                    },
                                    "type":
                                    {
                                        "type": "string",
                                        "default": "pkcs12"
                                    },
                                    "password":
                                    {
                                        "type": "string"
                                    },
                                    "entries":
                                    {
                                        "title": "Entries",
                                        "type": "array",
                                        "items":
                                        {
                                            "type": "string"
                                        }
                                    }
                                },
                                "additionalProperties": false
                            },
                            "trust":
                            {
                                "title": "Trust Certificates",
                                "type": "object",
                                "properties":
                                {
                                    "store":
                                    {
                                        "type": "string"
                                    },
                                    "type":
                                    {
                                        "type": "string",
                                        "default": "pkcs12"
                                    },
                                    "password":
                                    {
                                        "type": "string"
                                    },
                                    "entries":
                                    {
                                        "title": "Entries",
                                        "type": "array",
                                        "items":
                                        {
                                            "type": "string"
                                        }
                                    }
                                },
                                "additionalProperties": false
                            },
                            "signers":
                            {
                                "title": "Signer Certificates",
                                "type": "object",
                                "properties":
                                {
                                    "store":
                                    {
                                        "type": "string"
                                    },
                                    "type":
                                    {
                                        "type": "string",
                                        "default": "pkcs12"
                                    },
                                    "password":
                                    {
                                        "type": "string"
                                    },
                                    "entries":
                                    {
                                        "title": "Entries",
                                        "type": "array",
                                        "items":
                                        {
                                            "type": "string"
                                        }
                                    }
                                },
                                "additionalProperties": false
                            },
                            "secrets":
                            {
                                "title": "Secrets",
                                "x-incubating": true,
                                "type": "object",
                                "properties":
                                {
                                    "store":
                                    {
                                        "type": "string"
                                    },
                                    "type":
                                    {
                                        "type": "string",
                                        "default": "pkcs12"
                                    },
                                    "password":
                                    {
                                        "type": "string"
                                    },
                                    "entries":
                                    {
                                        "title": "Entries",
                                        "type": "object",
                                        "additionalProperties":
                                        {
                                            "oneOf":
                                            [
                                                {
                                                    "type": "string"
                                                },
                                                {
                                                    "type": "object",
                                                    "properties":
                                                    {
                                                        "active":
                                                        {
                                                            "type": "string",
                                                            "pattern": "^[0-9]+$"
                                                        },
                                                        "versions":
                                                        {
                                                            "type": "object",
                                                            "propertyNames":
                                                            {
                                                                "pattern": "^[0-9]+$"
                                                            },
                                                            "additionalProperties":
                                                            {
                                                                "type": "string"
                                                            },
                                                            "minProperties": 1
                                                        },
                                                        "algorithm":
                                                        {
                                                            "type": "string",
                                                            "enum": [ "AES128_GCM", "AES256_GCM" ]
                                                        }
                                                    },
                                                    "required": [ "active", "versions" ],
                                                    "additionalProperties": false
                                                }
                                            ]
                                        }
                                    }
                                },
                                "additionalProperties": false
                            },
                            "revocation":
                            {
                                "title": "Revocation Method",
                                "type": "string",
                                "enum": [ "crl" ]
                            }
                        },
                        "additionalProperties": false
                    }
                }
            }
        }
    }
]
