connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .build()
                           .build()}

connected

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .sessionId("session-1")
                              .build()
                          .build()}

read notify LIFECYCLE_INITIALIZED

connect await LIFECYCLE_INITIALIZED
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .toolsList()
                               .sessionId("session-1")
                               .build()
                           .build()}

connected

# tools/list answered from the generated mcp_openapi config, without any call
# reaching Kafka Connect -- the fixed eighteen-tool set is known statically from the
# bundled spec's routes.
read  '{"tools":[{"name":"list_connectors","title":"List Connectors","description":"list_connectors","inputSchema":{"type":"object","properties":{}},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"create_connector","title":"Create Connector","description":"create_connector","inputSchema":{"type":"object","properties":{"config":{"type":"object"},"name":{"type":"string"}}},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false}},'
        '{"name":"describe_connector","title":"Describe Connector","description":"describe_connector","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"delete_connector","title":"Delete Connector","description":"delete_connector","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"describe_connector_config","title":"Describe Connector Config","description":"describe_connector_config","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"outputSchema":{"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"update_connector_config","title":"Update Connector Config","description":"update_connector_config","inputSchema":{"type":"object","properties":{"connector":{"type":"string"},"connector.class":{"type":"string"},"tasks.max":{"type":"string"}},"required":["connector"]},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"validate_connector_config","title":"Validate Connector Config","description":"validate_connector_config","inputSchema":{"type":"object","properties":{"pluginName":{"type":"string"},"connector.class":{"type":"string"},"tasks.max":{"type":"string"}},"required":["pluginName"]},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"describe_connector_status","title":"Describe Connector Status","description":"describe_connector_status","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"restart_connector","title":"Restart Connector","description":"restart_connector","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false}},'
        '{"name":"pause_connector","title":"Pause Connector","description":"pause_connector","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"resume_connector","title":"Resume Connector","description":"resume_connector","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"stop_connector","title":"Stop Connector","description":"stop_connector","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"list_connector_tasks","title":"List Connector Tasks","description":"list_connector_tasks","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"restart_connector_task","title":"Restart Connector Task","description":"restart_connector_task","inputSchema":{"type":"object","properties":{"connector":{"type":"string"},"task":{"type":"integer"}},"required":["connector","task"]},"outputSchema":{"type":"object"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false}},'
        '{"name":"describe_connector_offsets","title":"Describe Connector Offsets","description":"describe_connector_offsets","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"outputSchema":{"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"alter_connector_offsets","title":"Alter Connector Offsets","description":"alter_connector_offsets","inputSchema":{"type":"object","properties":{"connector":{"type":"string"},"offsets":{"type":"array"}},"required":["connector"]},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"reset_connector_offsets","title":"Reset Connector Offsets","description":"reset_connector_offsets","inputSchema":{"type":"object","properties":{"connector":{"type":"string"}},"required":["connector"]},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":false}},'
        '{"name":"list_connector_plugins","title":"List Connector Plugins","description":"list_connector_plugins","inputSchema":{"type":"object","properties":{}},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}}'
        ']}'
read closed

write close
