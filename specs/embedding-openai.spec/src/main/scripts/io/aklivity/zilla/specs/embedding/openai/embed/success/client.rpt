connect "http://localhost:8000/v1/embeddings"

connected

write http:method "POST"
write http:header "authorization" "Bearer test-api-key"
write http:header "content-type" "application/json"
write http:content-length

write '{"model":"text-embedding-3-small","input":["init"]}'

write close

read http:status "200" "OK"
read http:header "content-type" "application/json"

read
'{'
  '"data": ['
    '{'
      '"embedding": [0.1, 0.2, 0.3],'
      '"index": 0'
    '}'
  '],'
  '"model": "text-embedding-3-small"'
'}'

read closed
