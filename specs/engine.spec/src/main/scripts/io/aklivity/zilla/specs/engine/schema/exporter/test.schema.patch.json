                                            "type": "string"
                                        },
                                        "message":
                                        {
                                            "type": "string"
                                        }
                                    },
                                    "required":
                                    [
                                        "qname",
                                        "id",
                                        "name",
                                        "message"
                                    ]
                                }
                            },
                            "metrics":
