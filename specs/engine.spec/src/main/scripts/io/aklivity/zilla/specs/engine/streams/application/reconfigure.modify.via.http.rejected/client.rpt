connect "http://localhost:8080/zilla.yaml"
connected

write http:method "GET"
write close

read http:status "200" "OK"
read http:header "Etag" "AAAAAAA"
read '---\n'
     'name: test\n'
     'telemetry:\n'
     '  exporters:\n'
     '    exporter0:\n'
     '      type: test\n'
     '      options:\n'
     '        attributes:\n'
     '          zilla.config.etag: AAAAAAA\n'
     '        events:\n'
     '          - qname: engine:events\n'
     '            id: engine.started\n'
     '            name: ENGINE_STARTED\n'
     '            message: Engine Started.\n'
     '          - qname: engine:events\n'
     '            id: engine.config.rejected\n'
     '            name: ENGINE_CONFIG_REJECTED\n'
     '            message: Config rejected with etag BBBBBBB. [5,5][/bindings/net0] missing required [kind].\n'
read closed

connect "http://localhost:8080/zilla.yaml"
connected

write http:method "GET"
write http:header "If-None-Match" "AAAAAAA"
write http:header "Prefer" "wait=86400"
write close

read http:status "200" "OK"
read http:header "Etag" "BBBBBBB"
read '---\n'
     'name: test\n'
     'bindings:\n'
     '  net0:\n'
     '    type: test\n'
read closed

connect "http://localhost:8080/zilla.yaml"
connected

write http:method "GET"
write http:header "If-None-Match" "BBBBBBB"
write http:header "Prefer" "wait=86400"
write close
