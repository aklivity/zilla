scope core
{
    scope stream
    {
        enum Capability
        {
            CHALLENGE,
            FRAMING
        }

        struct Extension
        {
            int64 compositeId = 0;
            int32 typeId;
        }

        // Frame state semantics
        //
        // state is the sender's StreamState bitmask after applying the transition that the frame itself effects,
        // for example BEGIN carries the opening bit of its direction, END carries closing and closed, ABORT carries
        // aborting and closed, a reply WINDOW carries the reply opened bit, and RESET carries the state of the side
        // that sends it.
        // Bits are monotonic, so a set bit is reliable and a clear bit means not known to be set. For the sender's own
        // direction the value is exact as of the frame; for the opposing direction it can be stale.
        // The value is a snapshot for observers and does not replace the state held by a stream handler.
        // Every writer supplies the value; there is no default. 0 means the frame effects no stream lifecycle transition,
        // as for a SIGNAL, which is self-addressed, and for the engine's system WINDOW and FLUSH that replace a frame
        // dropped for a stream with no handler. Every other frame has at least one bit set.
        struct Frame
        {
            int64 originId;
            int64 routedId;
            int64 streamId;
            int64 sequence;
            int64 acknowledge;
            int32 state;                // see Frame state semantics
            int32 maximum;
            int64 timestamp = 0;
            int64 traceId = 0;
            int64 authorization = 0;
        }

        struct Begin extends Frame [0x00000001]
        {
            int64 affinity;
            int64 redirectedId = 0;
            int64 circuitId = 0;
            octets extension;
        }

        struct Data extends Frame [0x00000002]
        {
            uint8 flags = 3;            // 0x01 FIN, 0x02 INIT, 0x04 INCOMPLETE, 0x08 SKIP
            int64 budgetId;
            int32 reserved;
            int32 length;
            octets[length] payload = null;
            octets extension;
        }

        struct End extends Frame [0x00000003]
        {
            int64 budgetId = 0;
            int32 reserved = 0;
            octets extension;
        }

        struct Abort extends Frame [0x00000004]
        {
            octets extension;
        }

        struct Flush extends Frame [0x00000005]
        {
            int64 budgetId;
            int32 reserved = 0;
            octets extension;
        }

        struct Reset extends Frame [0x40000001]
        {
            octets extension;
        }

        struct Window extends Frame [0x40000002]
        {
            int64 budgetId;
            int32 padding;
            int32 minimum = 0;
            uint8 capabilities = 0;
        }

        struct Signal extends Frame [0x40000003]
        {
            int64 cancelId;
            int32 signalId;
            int32 contextId;
            int32 length;
            octets[length] payload = null;
        }

        struct Challenge extends Frame [0x40000004]
        {
            octets extension;
        }

        struct Redirect extends Frame [0x40000005]
        {
            int64 affinity;
            octets extension;
        }
    }

    scope event
    {
        struct Event
        {
            int32 id;
            int64 timestamp;
            int64 traceId;
            int64 namespacedId;
            octets extension;
        }

        enum EngineEventType (uint8)
        {
            CONFIG_WATCHER_FAILED (1),
            STARTED (2),
            STOPPED (3),
            CONFIG_APPLIED (4),
            CONFIG_REJECTED (5)
        }

        struct EngineConfigWatcherFailedEx extends core::stream::Extension
        {
            string16 reason;
        }

        struct EngineStartedEx extends core::stream::Extension
        {
            string16 message;
        }

        struct EngineStoppedEx extends core::stream::Extension
        {
            string16 message;
        }

        struct EngineConfigAppliedEx extends core::stream::Extension
        {
            string16 etag = null;
        }

        struct EngineConfigRejectedEx extends core::stream::Extension
        {
            string16 etag = null;
            string16 reason;
        }

        union EngineEventEx switch (EngineEventType)
        {
            case CONFIG_WATCHER_FAILED: EngineConfigWatcherFailedEx configWatcherFailed;
            case STARTED: EngineStartedEx started;
            case STOPPED: EngineStoppedEx stopped;
            case CONFIG_APPLIED: EngineConfigAppliedEx configApplied;
            case CONFIG_REJECTED: EngineConfigRejectedEx configRejected;
        }
    }
}
