accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/responses")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"model\":\"gpt-4\",\"stream\":true,\"tools\":[{\"type\":\"image_generation\",\"quality\":\"low\",\"size\":\"1024x1024\"}],\"input\":[{\"role\":\"user\",\"content\":\"Draw a small red circle on a white background.\"}],\"stream_options\":{\"include_obfuscation\":false}}"

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "text/event-stream")
                            .build()}
write flush

write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.created")
                           .build()}
write "{\"type\":\"response.created\",\"response\":{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":0}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.in_progress")
                           .build()}
write "{\"type\":\"response.in_progress\",\"response\":{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":1}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_item.added")
                           .build()}
write "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"ig_1\",\"type\":\"image_generation_call\",\"status\":\"in_progress\"},\"output_index\":0,\"sequence_number\":2}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.image_generation_call.in_progress")
                           .build()}
write "{\"type\":\"response.image_generation_call.in_progress\",\"item_id\":\"ig_1\",\"output_index\":0,\"sequence_number\":3}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.image_generation_call.generating")
                           .build()}
write "{\"type\":\"response.image_generation_call.generating\",\"item_id\":\"ig_1\",\"output_index\":0,\"sequence_number\":4}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.image_generation_call.partial_image")
                           .build()}
write "{\"type\":\"response.image_generation_call.partial_image\",\"background\":\"opaque\",\"item_id\":\"ig_1\",\"output_format\":\"png\",\"output_index\":0,\"partial_image_b64\":\""
      ${core:randomBase64(40000)}
      "\",\"partial_image_index\":0,\"quality\":\"low\",\"size\":\"1024x1024\",\"sequence_number\":5}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.image_generation_call.completed")
                           .build()}
write "{\"type\":\"response.image_generation_call.completed\",\"item_id\":\"ig_1\",\"output_index\":0,\"sequence_number\":6}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_item.done")
                           .build()}
write "{\"type\":\"response.output_item.done\",\"item\":{\"id\":\"ig_1\",\"type\":\"image_generation_call\",\"status\":\"completed\",\"action\":\"generate\",\"background\":\"opaque\",\"output_format\":\"png\",\"quality\":\"low\",\"result\":\""
      ${core:randomBase64(40000)}
      "\",\"revised_prompt\":\"A small red circle\",\"size\":\"1024x1024\"},\"output_index\":0,\"sequence_number\":7}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_item.added")
                           .build()}
write "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"msg_2\",\"type\":\"message\",\"status\":\"in_progress\",\"content\":[],\"role\":\"assistant\"},\"output_index\":1,\"sequence_number\":8}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.content_part.added")
                           .build()}
write "{\"type\":\"response.content_part.added\",\"content_index\":0,\"item_id\":\"msg_2\",\"output_index\":1,\"part\":{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"\"},\"sequence_number\":9}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_text.delta")
                           .build()}
write "{\"type\":\"response.output_text.delta\",\"content_index\":0,\"delta\":\"Here is a small red circle.\",\"item_id\":\"msg_2\",\"logprobs\":[],\"output_index\":1,\"sequence_number\":10}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_text.done")
                           .build()}
write "{\"type\":\"response.output_text.done\",\"content_index\":0,\"item_id\":\"msg_2\",\"logprobs\":[],\"output_index\":1,\"sequence_number\":11,\"text\":\"Here is a small red circle.\"}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.content_part.done")
                           .build()}
write "{\"type\":\"response.content_part.done\",\"content_index\":0,\"item_id\":\"msg_2\",\"output_index\":1,\"part\":{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Here is a small red circle.\"},\"sequence_number\":12}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_item.done")
                           .build()}
write "{\"type\":\"response.output_item.done\",\"item\":{\"id\":\"msg_2\",\"type\":\"message\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Here is a small red circle.\"}],\"role\":\"assistant\"},\"output_index\":1,\"sequence_number\":13}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.completed")
                           .build()}
write "{\"type\":\"response.completed\",\"response\":{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"output\":[{\"id\":\"ig_1\",\"type\":\"image_generation_call\",\"status\":\"completed\",\"action\":\"generate\",\"background\":\"opaque\",\"output_format\":\"png\",\"quality\":\"low\",\"result\":\""
      ${core:randomBase64(40000)}
      "\",\"revised_prompt\":\"A small red circle\",\"size\":\"1024x1024\"},{\"id\":\"msg_2\",\"type\":\"message\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Here is a small red circle.\"}],\"role\":\"assistant\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}},\"sequence_number\":14}"
write close
