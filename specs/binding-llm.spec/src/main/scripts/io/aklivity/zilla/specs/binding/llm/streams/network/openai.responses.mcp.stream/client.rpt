connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"stream\":true,\"tools\":[{\"type\":\"mcp\",\"server_label\":\"deepwiki\",\"server_url\":\"https://mcp.deepwiki.com/mcp\",\"require_approval\":\"never\"}],\"input\":[{\"role\":\"user\",\"content\":\"Use deepwiki to say in one word the main programming language of aklivity/zilla.\"}],\"stream_options\":{\"include_obfuscation\":false}}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "text/event-stream")
                           .build()}

read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.created")
                          .build()}
read "{\"type\":\"response.created\",\"response\":{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":0}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.in_progress")
                          .build()}
read "{\"type\":\"response.in_progress\",\"response\":{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":1}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.added")
                          .build()}
read "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"mcpl_1\",\"type\":\"mcp_list_tools\",\"status\":\"in_progress\"},\"output_index\":0,\"sequence_number\":2}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.mcp_list_tools.in_progress")
                          .build()}
read "{\"type\":\"response.mcp_list_tools.in_progress\",\"item_id\":\"mcpl_1\",\"output_index\":0,\"sequence_number\":3}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.mcp_list_tools.completed")
                          .build()}
read "{\"type\":\"response.mcp_list_tools.completed\",\"item_id\":\"mcpl_1\",\"output_index\":0,\"sequence_number\":4}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.done")
                          .build()}
read "{\"type\":\"response.output_item.done\",\"item\":{\"id\":\"mcpl_1\",\"type\":\"mcp_list_tools\",\"status\":\"completed\",\"server_label\":\"deepwiki\",\"tools\":[{\"annotations\":{\"read_only\":false},\"description\":\"Ask a question about a repository\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\"}},\"required\":[\"question\"]},\"name\":\"ask_wiki_question\"}]},\"output_index\":0,\"sequence_number\":5}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.added")
                          .build()}
read "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"mcp_2\",\"type\":\"mcp_call\",\"status\":\"in_progress\",\"arguments\":\"\",\"name\":\"ask_wiki_question\"},\"output_index\":1,\"sequence_number\":6}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.mcp_call.in_progress")
                          .build()}
read "{\"type\":\"response.mcp_call.in_progress\",\"item_id\":\"mcp_2\",\"output_index\":1,\"sequence_number\":7}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.mcp_call_arguments.delta")
                          .build()}
read "{\"type\":\"response.mcp_call_arguments.delta\",\"delta\":\"{\\\"question\\\":\",\"item_id\":\"mcp_2\",\"output_index\":1,\"sequence_number\":8}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.mcp_call_arguments.delta")
                          .build()}
read "{\"type\":\"response.mcp_call_arguments.delta\",\"delta\":\"\\\"main language?\\\"}\",\"item_id\":\"mcp_2\",\"output_index\":1,\"sequence_number\":9}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.mcp_call_arguments.done")
                          .build()}
read "{\"type\":\"response.mcp_call_arguments.done\",\"arguments\":\"{\\\"question\\\":\\\"main language?\\\"}\",\"item_id\":\"mcp_2\",\"output_index\":1,\"sequence_number\":10}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.mcp_call.completed")
                          .build()}
read "{\"type\":\"response.mcp_call.completed\",\"item_id\":\"mcp_2\",\"output_index\":1,\"sequence_number\":11}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.done")
                          .build()}
read "{\"type\":\"response.output_item.done\",\"item\":{\"id\":\"mcp_2\",\"type\":\"mcp_call\",\"status\":\"completed\",\"arguments\":\"{\\\"question\\\":\\\"main language?\\\"}\",\"approval_request_id\":null,\"name\":\"ask_wiki_question\",\"error\":null,\"output\":\"Java\",\"server_label\":\"deepwiki\"},\"output_index\":1,\"sequence_number\":12}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.added")
                          .build()}
read "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"msg_3\",\"type\":\"message\",\"status\":\"in_progress\",\"content\":[],\"role\":\"assistant\"},\"output_index\":2,\"sequence_number\":13}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.content_part.added")
                          .build()}
read "{\"type\":\"response.content_part.added\",\"content_index\":0,\"item_id\":\"msg_3\",\"output_index\":2,\"part\":{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"\"},\"sequence_number\":14}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_text.delta")
                          .build()}
read "{\"type\":\"response.output_text.delta\",\"content_index\":0,\"delta\":\"Java\",\"item_id\":\"msg_3\",\"logprobs\":[],\"output_index\":2,\"sequence_number\":15}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_text.done")
                          .build()}
read "{\"type\":\"response.output_text.done\",\"content_index\":0,\"item_id\":\"msg_3\",\"logprobs\":[],\"output_index\":2,\"sequence_number\":16,\"text\":\"Java\"}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.content_part.done")
                          .build()}
read "{\"type\":\"response.content_part.done\",\"content_index\":0,\"item_id\":\"msg_3\",\"output_index\":2,\"part\":{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Java\"},\"sequence_number\":17}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.done")
                          .build()}
read "{\"type\":\"response.output_item.done\",\"item\":{\"id\":\"msg_3\",\"type\":\"message\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Java\"}],\"role\":\"assistant\"},\"output_index\":2,\"sequence_number\":18}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.completed")
                          .build()}
read "{\"type\":\"response.completed\",\"response\":{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"output\":[{\"id\":\"mcpl_1\",\"type\":\"mcp_list_tools\",\"status\":\"completed\",\"server_label\":\"deepwiki\",\"tools\":[{\"annotations\":{\"read_only\":false},\"description\":\"Ask a question about a repository\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\"}},\"required\":[\"question\"]},\"name\":\"ask_wiki_question\"}]},{\"id\":\"mcp_2\",\"type\":\"mcp_call\",\"status\":\"completed\",\"arguments\":\"{\\\"question\\\":\\\"main language?\\\"}\",\"approval_request_id\":null,\"name\":\"ask_wiki_question\",\"error\":null,\"output\":\"Java\",\"server_label\":\"deepwiki\"},{\"id\":\"msg_3\",\"type\":\"message\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Java\"}],\"role\":\"assistant\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}},\"sequence_number\":19}"

read closed
