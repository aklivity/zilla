property model "gpt-4"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .build()}

connected

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write "{\"model\":\""
      ${model}
      "\",\"messages\":[{\"role\":\"assistant\",\"content\":null,\"tool_calls\":["
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_CALL")
                          .message(0)
                          .attribute("tool-name", "get_weather")
                          .attribute("tool-call-id", "call_1")
                          .build()}
write "{\"arguments\":{\"query\":\"say \\\"hi\\\" \\\\ done\\nnext\",\"text\":\"café ✓ 😀\",\"nested\":{\"items\":[1,2.5,true,null,{\"k\":\"v\"}],\"empty\":{},\"list\":[]}}}"
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
write "]}]}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .id("chatcmpl_2")
                           .build()}

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
read "{\"id\":\"chatcmpl_2\",\"object\":\"chat.completion\",\"model\":\""
     ${model}
     "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "{\"text\":\"Hello! How can I help you today?\"}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":25,\"completion_tokens\":15,\"total_tokens\":40}}"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(25)
                            .outputTokens(15)
                            .totalTokens(40)
                            .finishReason("stop")
                            .build()}

read closed

write close
