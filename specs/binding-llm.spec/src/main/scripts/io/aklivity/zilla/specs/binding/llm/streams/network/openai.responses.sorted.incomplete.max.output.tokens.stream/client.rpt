connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"stream\":true,\"input\":[{\"role\":\"user\",\"content\":\"Hello\"}],\"max_output_tokens\":16}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "text/event-stream")
                           .build()}

read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":0,\"type\":\"response.created\"}"
read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":1,\"type\":\"response.in_progress\"}"
read "{\"item\":{\"content\":[],\"id\":\"msg_1\",\"role\":\"assistant\",\"status\":\"in_progress\",\"type\":\"message\"},\"output_index\":0,\"sequence_number\":2,\"type\":\"response.output_item.added\"}"
read "{\"content_index\":0,\"item_id\":\"msg_1\",\"output_index\":0,\"part\":{\"annotations\":[],\"logprobs\":[],\"text\":\"\",\"type\":\"output_text\"},\"sequence_number\":3,\"type\":\"response.content_part.added\"}"
read "{\"content_index\":0,\"delta\":\"The history of the\",\"item_id\":\"msg_1\",\"logprobs\":[],\"obfuscation\":\"abcdefghij\",\"output_index\":0,\"sequence_number\":4,\"type\":\"response.output_text.delta\"}"
read "{\"content_index\":0,\"delta\":\" printing press\",\"item_id\":\"msg_1\",\"logprobs\":[],\"obfuscation\":\"abcdefghij\",\"output_index\":0,\"sequence_number\":5,\"type\":\"response.output_text.delta\"}"
read "{\"content_index\":0,\"item_id\":\"msg_1\",\"logprobs\":[],\"output_index\":0,\"sequence_number\":6,\"text\":\"The history of the printing press\",\"type\":\"response.output_text.done\"}"
read "{\"content_index\":0,\"item_id\":\"msg_1\",\"output_index\":0,\"part\":{\"annotations\":[],\"logprobs\":[],\"text\":\"The history of the printing press\",\"type\":\"output_text\"},\"sequence_number\":7,\"type\":\"response.content_part.done\"}"
read "{\"item\":{\"content\":[{\"annotations\":[],\"logprobs\":[],\"text\":\"The history of the printing press\",\"type\":\"output_text\"}],\"id\":\"msg_1\",\"role\":\"assistant\",\"status\":\"incomplete\",\"type\":\"message\"},\"output_index\":0,\"sequence_number\":8,\"type\":\"response.output_item.done\"}"
read "{\"response\":{\"id\":\"resp_1\",\"incomplete_details\":{\"reason\":\"max_output_tokens\"},\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[{\"content\":[{\"annotations\":[],\"logprobs\":[],\"text\":\"The history of the printing press\",\"type\":\"output_text\"}],\"id\":\"msg_1\",\"role\":\"assistant\",\"status\":\"incomplete\",\"type\":\"message\"}],\"status\":\"incomplete\",\"usage\":{\"input_tokens\":22,\"output_tokens\":16,\"total_tokens\":38}},\"sequence_number\":9,\"type\":\"response.incomplete\"}"

read closed
