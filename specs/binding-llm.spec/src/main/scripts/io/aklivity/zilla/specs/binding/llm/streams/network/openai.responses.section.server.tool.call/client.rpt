connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"input\":[{\"role\":\"user\",\"content\":\"Search and compute\"},{\"type\":\"web_search_call\",\"id\":\"ws_1\",\"status\":\"completed\",\"action\":{\"type\":\"search\",\"query\":\"weather\"}},{\"type\":\"code_interpreter_call\",\"id\":\"ci_1\",\"status\":\"completed\",\"code\":\"1 + 1\",\"container_id\":\"cntr_1\",\"outputs\":[{\"type\":\"logs\",\"logs\":\"2\"}]},{\"type\":\"mcp_call\",\"id\":\"mcp_1\",\"status\":\"completed\",\"arguments\":\"{\\\"q\\\":1}\",\"approval_request_id\":null,\"name\":\"ask\",\"error\":null,\"output\":\"ok\",\"server_label\":\"deepwiki\"},{\"type\":\"custom_tool_call\",\"input\":\"print(1)\",\"call_id\":\"call_1\",\"name\":\"code_exec\"},{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_1\",\"output\":\"1\\n\"}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}

read "{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"output\":[{\"id\":\"msg_1\",\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"Hello there\",\"annotations\":[],\"logprobs\":[]}],\"role\":\"assistant\",\"status\":\"completed\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}}"

read closed
