property model "gpt-4"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .build()}

connected

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write "{\"model\":\""
      ${model}
      "\",\"messages\":[{\"role\":\"assistant\",\"content\":"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Let me check\"}"
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write ",\"tool_calls\":["
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_CALL")
                          .message(0)
                          .attribute("tool-name", "get_weather")
                          .attribute("tool-call-id", "call_1")
                          .build()}
write "{\"arguments\":{\"city\":\"Paris\"}}"
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
write "]}]}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .id("chatcmpl_3")
                           .build()}

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
read "{\"id\":\"chatcmpl_3\",\"object\":\"chat.completion\",\"model\":\""
     ${model}
     "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "{\"text\":\"Let me check both cities.\"}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
read ",\"tool_calls\":[{\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"arguments\":"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_CALL")
                          .message(0)
                          .attribute("tool-name", "get_weather")
                          .attribute("tool-call-id", "call_1")
                          .build()}
read "{\"arguments\":{\"city\":\"Paris\"}}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
read "}},{\"id\":\"call_2\",\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"arguments\":"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_CALL")
                          .message(0)
                          .attribute("tool-name", "get_weather")
                          .attribute("tool-call-id", "call_2")
                          .build()}
read "{\"arguments\":{\"city\":\"London\"}}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":30,\"completion_tokens\":25,\"total_tokens\":55,\"prompt_tokens_details\":{\"cached_tokens\":10},\"completion_tokens_details\":{\"reasoning_tokens\":2}}}"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(30)
                            .cacheReadTokens(10)
                            .outputTokens(25)
                            .reasoningTokens(2)
                            .totalTokens(55)
                            .finishReason("tool-call")
                            .build()}

read closed

write close
