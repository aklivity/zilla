property target "target"
property model "model"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model(model)
                           .build()}

connected

write advised zilla:challenge ${llm:matchChallengeEx()
                                    .typeId(zilla:id("llm"))
                                    .dialect(target)
                                    .build()}

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "web_search")
                          .build()}
write "{\"type\":\"web_search_20250305\",\"name\":\"web_search\"}"
write flush

read zilla:reset.ext ${llm:matchResetEx()
                           .typeId(zilla:id("llm"))
                           .status(400)
                           .type("invalid_request_error")
                           .message("server-tool-definition cannot be converted from anthropic to %s".formatted(target))
                           .build()}

write aborted
