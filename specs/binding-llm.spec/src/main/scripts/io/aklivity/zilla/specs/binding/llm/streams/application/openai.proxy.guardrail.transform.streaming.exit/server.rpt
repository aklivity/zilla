write option zilla:flags "init"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"the sec"
write flush

write option zilla:flags "none"
write "ret is"
write flush

write option zilla:flags "fin"
write "\"}"
write flush
