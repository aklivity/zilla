connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"model\",\"input\":[{\"role\":\"user\",\"content\":\"Hello\"}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "text/event-stream")
                           .build()}

read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.created")
                          .build()}
read "{\"type\":\"response.created\",\"response\":{\"id\":\"id_1\",\"object\":\"response\",\"model\":\"model\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":0}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.in_progress")
                          .build()}
read "{\"type\":\"response.in_progress\",\"response\":{\"id\":\"id_1\",\"object\":\"response\",\"model\":\"model\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":1}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.added")
                          .build()}
read "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"msg_1\",\"type\":\"message\",\"status\":\"in_progress\",\"content\":[],\"role\":\"assistant\"},\"output_index\":0,\"sequence_number\":2}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.content_part.added")
                          .build()}
read "{\"type\":\"response.content_part.added\",\"content_index\":0,\"item_id\":\"msg_1\",\"output_index\":0,\"part\":{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"\"},\"sequence_number\":3}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_text.delta")
                          .build()}
read "{\"type\":\"response.output_text.delta\",\"content_index\":0,\"delta\":\"Hello\",\"item_id\":\"msg_1\",\"logprobs\":[],\"output_index\":0,\"sequence_number\":4}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "error")
                          .build()}
read "{\"type\":\"error\",\"code\":\"overloaded_error\",\"message\":\"Overloaded\",\"param\":null,\"sequence_number\":5}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.failed")
                          .build()}
read "{\"type\":\"response.failed\",\"response\":{\"id\":\"id_1\",\"object\":\"response\",\"model\":\"model\",\"output\":[],\"status\":\"failed\",\"error\":{\"code\":\"overloaded_error\",\"message\":\"Overloaded\"}},\"sequence_number\":6}"

read closed
