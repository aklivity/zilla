accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/responses")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"model\":\"gpt-4\",\"stream\":true,\"tools\":[{\"type\":\"function\",\"name\":\"get_weather\",\"description\":\"Get the current weather for a city\",\"parameters\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"],\"additionalProperties\":false},\"strict\":true}],\"input\":[{\"role\":\"user\",\"content\":\"What is the weather in Paris and London?\"}],\"stream_options\":{\"include_obfuscation\":false}}"

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "text/event-stream")
                            .build()}
write flush

write "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":0,\"type\":\"response.created\"}"
write "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":1,\"type\":\"response.in_progress\"}"
write "{\"item\":{\"arguments\":\"\",\"call_id\":\"call_1\",\"id\":\"fc_1\",\"name\":\"get_weather\",\"status\":\"in_progress\",\"type\":\"function_call\"},\"output_index\":0,\"sequence_number\":2,\"type\":\"response.output_item.added\"}"
write "{\"delta\":\"{\\\"city\\\":\",\"item_id\":\"fc_1\",\"output_index\":0,\"sequence_number\":3,\"type\":\"response.function_call_arguments.delta\"}"
write "{\"delta\":\"\\\"Paris\\\"}\",\"item_id\":\"fc_1\",\"output_index\":0,\"sequence_number\":4,\"type\":\"response.function_call_arguments.delta\"}"
write "{\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\",\"item_id\":\"fc_1\",\"output_index\":0,\"sequence_number\":5,\"type\":\"response.function_call_arguments.done\"}"
write "{\"item\":{\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\",\"call_id\":\"call_1\",\"id\":\"fc_1\",\"name\":\"get_weather\",\"status\":\"completed\",\"type\":\"function_call\"},\"output_index\":0,\"sequence_number\":6,\"type\":\"response.output_item.done\"}"
write "{\"item\":{\"arguments\":\"\",\"call_id\":\"call_2\",\"id\":\"fc_2\",\"name\":\"get_weather\",\"status\":\"in_progress\",\"type\":\"function_call\"},\"output_index\":1,\"sequence_number\":7,\"type\":\"response.output_item.added\"}"
write "{\"delta\":\"{\\\"city\\\":\",\"item_id\":\"fc_2\",\"output_index\":1,\"sequence_number\":8,\"type\":\"response.function_call_arguments.delta\"}"
write "{\"delta\":\"\\\"London\\\"}\",\"item_id\":\"fc_2\",\"output_index\":1,\"sequence_number\":9,\"type\":\"response.function_call_arguments.delta\"}"
write "{\"arguments\":\"{\\\"city\\\":\\\"London\\\"}\",\"item_id\":\"fc_2\",\"output_index\":1,\"sequence_number\":10,\"type\":\"response.function_call_arguments.done\"}"
write "{\"item\":{\"arguments\":\"{\\\"city\\\":\\\"London\\\"}\",\"call_id\":\"call_2\",\"id\":\"fc_2\",\"name\":\"get_weather\",\"status\":\"completed\",\"type\":\"function_call\"},\"output_index\":1,\"sequence_number\":11,\"type\":\"response.output_item.done\"}"
write "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[{\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\",\"call_id\":\"call_1\",\"id\":\"fc_1\",\"name\":\"get_weather\",\"status\":\"completed\",\"type\":\"function_call\"},{\"arguments\":\"{\\\"city\\\":\\\"London\\\"}\",\"call_id\":\"call_2\",\"id\":\"fc_2\",\"name\":\"get_weather\",\"status\":\"completed\",\"type\":\"function_call\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}},\"sequence_number\":12,\"type\":\"response.completed\"}"
write close
