accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/responses")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"model\":\"gpt-4\",\"input\":[{\"role\":\"user\",\"content\":\"Hello\"}]}"

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "application/json")
                            .build()}

write option zilla:flags "init"
write "{\"id\":\"resp_1\",\"object\":\"respons"
write flush
write option zilla:flags "none"
write "e\",\"model\":\"gpt-4\",\"output\":[{\"i"
write flush
write option zilla:flags "none"
write "d\":\"msg_1\",\"type\":\"message\",\"con"
write flush
write option zilla:flags "none"
write "tent\":[{\"type\":\"output_text\",\"te"
write flush
write option zilla:flags "none"
write "xt\":\"Hello there\",\"annotations\":"
write flush
write option zilla:flags "none"
write "[],\"logprobs\":[]}],\"role\":\"assis"
write flush
write option zilla:flags "none"
write "tant\",\"status\":\"completed\"}],\"st"
write flush
write option zilla:flags "none"
write "atus\":\"completed\",\"usage\":{\"inpu"
write flush
write option zilla:flags "none"
write "t_tokens\":25,\"output_tokens\":15,"
write flush
write option zilla:flags "fin"
write "\"total_tokens\":40}}"
write flush
write close
