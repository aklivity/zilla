connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"tools\":[{\"type\":\"mcp\",\"server_label\":\"deepwiki\",\"server_url\":\"https://mcp.deepwiki.com/mcp\",\"require_approval\":\"never\"}],\"input\":[{\"role\":\"user\",\"content\":\"Use deepwiki to say in one word the main programming language of aklivity/zilla.\"}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}

read "{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[{\"id\":\"mcpl_1\",\"server_label\":\"deepwiki\",\"status\":\"completed\",\"tools\":[{\"annotations\":{\"read_only\":false},\"description\":\"Ask a question about a repository\",\"input_schema\":{\"properties\":{\"question\":{\"type\":\"string\"}},\"required\":[\"question\"],\"type\":\"object\"},\"name\":\"ask_wiki_question\"}],\"type\":\"mcp_list_tools\"},{\"approval_request_id\":null,\"arguments\":\"{\\\"question\\\":\\\"main language?\\\"}\",\"error\":null,\"id\":\"mcp_2\",\"name\":\"ask_wiki_question\",\"output\":\"Java\",\"server_label\":\"deepwiki\",\"status\":\"completed\",\"type\":\"mcp_call\"},{\"content\":[{\"annotations\":[],\"logprobs\":[],\"text\":\"Java\",\"type\":\"output_text\"}],\"id\":\"msg_3\",\"role\":\"assistant\",\"status\":\"completed\",\"type\":\"message\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}}"

read closed
