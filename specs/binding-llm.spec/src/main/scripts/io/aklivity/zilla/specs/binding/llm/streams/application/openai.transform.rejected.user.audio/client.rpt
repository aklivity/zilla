property target "target"
property model "model"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_AUDIO")
                          .message(0)
                          .attribute("media-type", "audio/wav")
                          .attribute("source", "inline")
                          .build()}
write "{\"type\":\"input_audio\",\"input_audio\":{\"data\":\"UklGRg==\",\"format\":\"wav\"}}"
write flush

read zilla:reset.ext ${llm:matchResetEx()
                           .typeId(zilla:id("llm"))
                           .status(400)
                           .type("invalid_request_error")
                           .message("user-audio cannot be converted from openai to %s".formatted(target))
                           .build()}

write aborted
