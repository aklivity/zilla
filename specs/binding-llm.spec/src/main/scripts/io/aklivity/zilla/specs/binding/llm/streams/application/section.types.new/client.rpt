connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/ccs")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_PREDICTION")
                          .message(0)
                          .build()}
write "{\"text\":\"predicted\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_COMPACTION")
                          .message(1)
                          .build()}
write "{\"text\":\"compacted\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_IMAGE")
                          .message(2)
                          .build()}
write "{\"type\":\"image\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_AUDIO")
                          .message(3)
                          .build()}
write "{\"type\":\"audio\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_VIDEO")
                          .message(4)
                          .build()}
write "{\"type\":\"video\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_DOCUMENT")
                          .message(5)
                          .build()}
write "{\"type\":\"document\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_RESULT_IMAGE")
                          .message(6)
                          .build()}
write "{\"type\":\"image\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_RESULT_DOCUMENT")
                          .message(7)
                          .build()}
write "{\"type\":\"document\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_CITATIONS")
                          .message(8)
                          .build()}
write "[{\"title\":\"source\"}]"
write flush

write close

read closed
