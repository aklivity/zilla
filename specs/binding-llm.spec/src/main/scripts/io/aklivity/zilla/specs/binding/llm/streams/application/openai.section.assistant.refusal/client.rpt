property model "gpt-4"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_REFUSAL")
                          .message(0)
                          .build()}
write "{\"text\":\"I cannot help with that\"}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .id("chatcmpl_4")
                           .build()}

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_REFUSAL")
                          .message(0)
                          .build()}
read "{\"text\":\"I cannot help with that.\"}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:usage\":{\"prompt_tokens\":12,\"completion_tokens\":6,\"total_tokens\":18}}"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(12)
                            .outputTokens(6)
                            .totalTokens(18)
                            .finishReason("stop")
                            .build()}

read closed

write close
