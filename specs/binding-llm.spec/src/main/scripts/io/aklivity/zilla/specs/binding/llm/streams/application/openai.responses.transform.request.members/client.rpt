property model "model"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/rs")
                           .model(model)
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Hello\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"x:temperature\":0.2,\"openai:store\":false,\"openai:metadata\":{\"k\":\"v\"},\"x:tool_choice\":\"auto\",\"openai/rs:include\":[\"reasoning.encrypted_content\"],\"x:parallel_tool_calls\":true,\"openai/rs:truncation\":\"auto\",\"x:reasoning_effort\":\"low\",\"x:response_format\":{\"type\":\"text\"}}"
write flush

write advise zilla:flush

read zilla:reset.ext ${llm:matchResetEx()
                          .typeId(zilla:id("llm"))
                          .status(400)
                          .type("invalid_request_error")
                          .message("Invalid request")
                          .build()}

write aborted
