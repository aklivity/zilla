property source "source"
property target "target"
property model "model"

accept "zilla://streams/app0"
       option zilla:window 0
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect(source)
                          .model(model)
                          .build()}

connected

read option zilla:window 8192

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"stream\":true}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
read "{\"text\":\"Hello\"}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"stream_options\":{\"include_usage\":true}}"

read advised zilla:flush

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect(target)
                           .model(model)
                           .id("id_1")
                           .build()}
write flush

write option zilla:flags "init"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Let me check"
write flush
write option zilla:flags "fin"
write "\"}"
write flush

write option zilla:flags "init"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_CALL")
                          .message(0)
                          .attribute("tool-name", "get_weather")
                          .attribute("tool-call-id", "call_1")
                          .build()}
write zilla:data.empty
write flush
write option zilla:flags "none"
write "{\"arguments\":{\"city\":"
write flush
write option zilla:flags "none"
write "\"Paris\"}}"
write flush
write option zilla:flags "fin"
write zilla:data.empty
write flush

write zilla:end.ext ${llm:endEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(25)
                            .outputTokens(15)
                            .finishReason("tool-call")
                            .build()}

write close

read closed
