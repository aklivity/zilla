accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/chat/completions")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"model\":\"gpt-4\",\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}]}"
read closed

write zilla:begin.ext ${http:beginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}
write flush

write option zilla:flags "init"
write "{\"id\":\"chatcmpl_2\",\"object\":\"cha"
write flush
write option zilla:flags "none"
write "t.completion\",\"model\":\"gpt-4\",\"c"
write flush
write option zilla:flags "none"
write "hoices\":[{\"index\":0,\"message\":{\""
write flush
write option zilla:flags "none"
write "role\":\"assistant\",\"content\":\"Hel"
write flush
write option zilla:flags "none"
write "lo! How can I help you today?\"},"
write flush
write option zilla:flags "none"
write "\"finish_reason\":\"stop\"}],\"usage\""
write flush
write option zilla:flags "none"
write ":{\"prompt_tokens\":25,\"completion"
write flush
write option zilla:flags "fin"
write "_tokens\":15,\"total_tokens\":40}}"
write flush

write close
