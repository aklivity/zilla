connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write "{\"model\":\"gpt-4\",\"messages\":[{\"role\":\"user\",\"content\":"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Hello\"}"
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
write "}]}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .id("chatcmpl_2")
                           .build()}

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "{\"id\":\"chatcmpl_2\",\"model\":\"gpt-4\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"},\"finish_reason\":null}]}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
read "{\"choices\":[{\"index\":0,\"delta\":{\"content\":"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "{\"text\":\""
     ${core:randomBase64(100000)}
     "\"}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "},\"finish_reason\":null}]}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "{\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "{\"choices\":[],\"usage\":{\"prompt_tokens\":25,\"completion_tokens\":15}}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "[DONE]"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(25)
                            .outputTokens(15)
                            .finishReason("stop")
                            .build()}

read closed

write close
