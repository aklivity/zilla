connect "zilla://streams/net1"
        option zilla:window 8192
        option zilla:transmission "duplex"

connected

write "POST /v1/chat/completions HTTP/1.1\r\n"
write "Host: example.com:8080\r\n"
write "Content-Type: application/json\r\n"
write "Transfer-Encoding: chunked\r\n"
write "\r\n"
write "2b\r\n"
write "{\"model\":\"gpt-a\",\"messages\":[{\"role\":\"user\"\r\n"
write "15\r\n"
write ",\"content\":\"Hello\"}]}\r\n"
write "0\r\n"
write "\r\n"

read "HTTP/1.1 429 Too Many Requests\r\n"
read "Content-Type: application/json" "\r\n"
read "Retry-After: 30" "\r\n"
read "Content-Length: 112" "\r\n"
read "\r\n"
read "{\"error\":{\"message\":\"Rate limit reached for gpt-a\",\"type\":\"requests\",\"param\":null,\"code\":\"rate_limit_exceeded\"}}"

write "POST /v1/chat/completions HTTP/1.1\r\n"
write "Host: example.com:8080\r\n"
write "Content-Type: application/json\r\n"
write "Transfer-Encoding: chunked\r\n"
write "\r\n"
write "2b\r\n"
write "{\"model\":\"gpt-b\",\"messages\":[{\"role\":\"user\"\r\n"
write "15\r\n"
write ",\"content\":\"Hello\"}]}\r\n"
write "0\r\n"
write "\r\n"

read "HTTP/1.1 200 OK\r\n"
read "Content-Type: application/json" "\r\n"
read "Content-Length: 255" "\r\n"
read "\r\n"
read "{\"id\":\"chatcmpl_2\",\"object\":\"chat.completion\",\"model\":\"gpt-b\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Hello! How can I help you today?\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":25,\"completion_tokens\":15,\"total_tokens\":40}}"
