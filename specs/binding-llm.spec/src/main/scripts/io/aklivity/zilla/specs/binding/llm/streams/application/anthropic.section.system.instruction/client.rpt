property model "claude-3-opus-20240229"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model(model)
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SYSTEM_INSTRUCTION")
                          .message(-1)
                          .build()}
write "{\"text\":\"You are helpful.\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Hello\"}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model(model)
                           .id("msg_01")
                           .build()}

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "{\"text\":\"Hello! How can I help you today?\"}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"anthropic:stop_sequence\":null}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"anthropic:usage\":{\"input_tokens\":25,\"output_tokens\":15}}"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(25)
                            .outputTokens(15)
                            .finishReason("stop")
                            .build()}

read closed

write close
