accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/rs")
                          .model("gpt-4")
                          .build()}

connected

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"stream\":true}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("TOOL_DEFINITION")
                         .message(-1)
                         .attribute("tool-name", "get_weather")
                         .build()}
read "{\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"description\":\"Get the current weather for a city\",\"parameters\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"],\"additionalProperties\":false},\"strict\":true}}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("USER_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"What is the weather in Paris and London?\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"stream_options\":{\"openai:include_obfuscation\":false,\"include_usage\":true}}"

read advised zilla:flush

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/rs")
                           .model("gpt-4")
                           .id("resp_1")
                           .build()}
write flush

write zilla:abort.ext ${llm:abortEx()
                           .typeId(zilla:id("llm"))
                           .type("server_error")
                           .message("Object exceeds the supported bound before its type.")
                           .build()}

write abort

read closed
