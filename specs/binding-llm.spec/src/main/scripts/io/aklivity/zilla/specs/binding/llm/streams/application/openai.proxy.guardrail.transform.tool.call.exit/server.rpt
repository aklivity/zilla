write option zilla:flags "init"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"the sec"
write flush

write option zilla:flags "none"
write "ret is"
write flush

write option zilla:flags "fin"
write "\"}"
write flush

write await TEXT_DELIVERED

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_CALL")
                          .message(0)
                          .attribute("tool-name", "get_weather")
                          .attribute("tool-call-id", "call_1")
                          .build()}
write "{\"arguments\":{\"city\":\"Paris\"}}"
write flush
