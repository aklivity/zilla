property source "source"
property target "target"
property model "model"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect(source)
                           .model(model)
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Hello\"}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect(target)
                          .model(model)
                          .id("id_1")
                          .build()}

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("ASSISTANT_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"ok\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:usage\":{\"input_tokens\":4019,\"input_tokens_details\":{\"cache_write_tokens\":0,\"cached_tokens\":3840},\"output_tokens\":2,\"output_tokens_details\":{\"reasoning_tokens\":0},\"total_tokens\":4021}}"

read zilla:end.ext ${llm:matchEndEx()
                        .typeId(zilla:id("llm"))
                        .inputTokens(4019)
                        .cacheWriteTokens(0)
                        .cacheReadTokens(3840)
                        .outputTokens(2)
                        .reasoningTokens(0)
                        .totalTokens(4021)
                        .finishReason("stop")
                        .build()}

read closed

write close
