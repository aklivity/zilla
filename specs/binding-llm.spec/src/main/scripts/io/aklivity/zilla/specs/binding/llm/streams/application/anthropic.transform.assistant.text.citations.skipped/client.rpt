property target "target"
property model "model"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model(model)
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Sky colour?\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(1)
                          .build()}
write "{\"text\":\"The sky is blue.\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CITATIONS")
                          .message(1)
                          .build()}
write "[{\"anthropic:type\":\"char_location\",\"anthropic:cited_text\":\"blue\",\"anthropic:document_index\":0,\"anthropic:start_char_index\":0,\"anthropic:end_char_index\":4}]"
write flush

write advise zilla:flush

read zilla:reset.ext ${llm:matchResetEx()
                           .typeId(zilla:id("llm"))
                           .status(429)
                           .type("rate_limit_error")
                           .message("Rate limit exceeded")
                           .build()}

write aborted
