connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/responses")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SYSTEM_INSTRUCTION")
                          .message(0)
                          .build()}
write "{\"text\":\"You answer in one short sentence.\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"openai:store\":false}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SYSTEM_INSTRUCTION")
                          .message(1)
                          .build()}
write "{\"text\":\"Always end with the word done.\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(2)
                          .build()}
write "{\"text\":\"What is the capital of France?\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(3)
                          .build()}
write "{\"text\":\"Paris, done.\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(4)
                          .build()}
write "{\"text\":\"And of Italy?\"}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/responses")
                          .model("gpt-4")
                          .id("resp_1")
                          .build()}

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("ASSISTANT_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"Rome, done.\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai:usage\":{\"input_tokens\":52,\"output_tokens\":5,\"total_tokens\":57}}"

read zilla:end.ext ${llm:matchEndEx()
                        .typeId(zilla:id("llm"))
                        .inputTokens(52)
                        .outputTokens(5)
                        .totalTokens(57)
                        .finishReason("stop")
                        .build()}

read closed

write close
