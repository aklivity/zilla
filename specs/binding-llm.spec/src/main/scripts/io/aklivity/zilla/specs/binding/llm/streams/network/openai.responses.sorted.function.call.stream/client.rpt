connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"stream\":true,\"tools\":[{\"type\":\"function\",\"name\":\"get_weather\",\"description\":\"Get the current weather for a city\",\"parameters\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"],\"additionalProperties\":false},\"strict\":true}],\"input\":[{\"role\":\"user\",\"content\":\"What is the weather in Paris?\"}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "text/event-stream")
                           .build()}

read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":0,\"type\":\"response.created\"}"
read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":1,\"type\":\"response.in_progress\"}"
read "{\"item\":{\"arguments\":\"\",\"call_id\":\"call_1\",\"id\":\"fc_1\",\"name\":\"get_weather\",\"status\":\"in_progress\",\"type\":\"function_call\"},\"output_index\":0,\"sequence_number\":2,\"type\":\"response.output_item.added\"}"
read "{\"delta\":\"{\\\"city\\\":\",\"item_id\":\"fc_1\",\"obfuscation\":\"abcdefghij\",\"output_index\":0,\"sequence_number\":3,\"type\":\"response.function_call_arguments.delta\"}"
read "{\"delta\":\"\\\"Paris\\\"}\",\"item_id\":\"fc_1\",\"obfuscation\":\"abcdefghij\",\"output_index\":0,\"sequence_number\":4,\"type\":\"response.function_call_arguments.delta\"}"
read "{\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\",\"item_id\":\"fc_1\",\"output_index\":0,\"sequence_number\":5,\"type\":\"response.function_call_arguments.done\"}"
read "{\"item\":{\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\",\"call_id\":\"call_1\",\"id\":\"fc_1\",\"name\":\"get_weather\",\"status\":\"completed\",\"type\":\"function_call\"},\"output_index\":0,\"sequence_number\":6,\"type\":\"response.output_item.done\"}"
read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[{\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\",\"call_id\":\"call_1\",\"id\":\"fc_1\",\"name\":\"get_weather\",\"status\":\"completed\",\"type\":\"function_call\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}},\"sequence_number\":7,\"type\":\"response.completed\"}"

read closed
