connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"i"
write flush
write "nput\":[{\"role\":\"use"
write flush
write "r\",\"content\":\"Hello"
write flush
write "\"}],\"text\":{\"format"
write flush
write "\":{\"type\":\"json_sch"
write flush
write "ema\",\"name\":\"answer"
write flush
write "\",\"description\":\"St"
write flush
write "ructured answer\",\"s"
write flush
write "chema\":{\"type\":\"obj"
write flush
write "ect\",\"properties\":{"
write flush
write "\"answer\":{\"type\":\"s"
write flush
write "tring\"}},\"required\""
write flush
write ":[\"answer\"],\"additi"
write flush
write "onalProperties\":fal"
write flush
write "se},\"strict\":true}}"
write flush
write "}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "429")
                           .header("content-type", "application/json")
                           .build()}

read "{\"error\":{\"message\":\"Rate limit reached for gpt-4\",\"type\":\"requests\",\"param\":null,\"code\":\"rate_limit_exceeded\"}}"

read closed
