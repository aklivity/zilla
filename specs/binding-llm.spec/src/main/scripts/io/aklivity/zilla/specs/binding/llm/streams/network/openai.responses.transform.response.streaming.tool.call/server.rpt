accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/responses")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"model\":\"model\",\"stream\":true,\"input\":[{\"role\":\"user\",\"content\":\"Hello\"}],\"stream_options\":{\"include_obfuscation\":false}}"

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "text/event-stream")
                            .build()}
write flush

write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.created")
                           .build()}
write "{\"type\":\"response.created\",\"response\":{\"id\":\"id_1\",\"object\":\"response\",\"model\":\"model\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":0}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.in_progress")
                           .build()}
write "{\"type\":\"response.in_progress\",\"response\":{\"id\":\"id_1\",\"object\":\"response\",\"model\":\"model\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":1}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_item.added")
                           .build()}
write "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"msg_1\",\"type\":\"message\",\"status\":\"in_progress\",\"content\":[],\"role\":\"assistant\"},\"output_index\":0,\"sequence_number\":2}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.content_part.added")
                           .build()}
write "{\"type\":\"response.content_part.added\",\"content_index\":0,\"item_id\":\"msg_1\",\"output_index\":0,\"part\":{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"\"},\"sequence_number\":3}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_text.delta")
                           .build()}
write "{\"type\":\"response.output_text.delta\",\"content_index\":0,\"delta\":\"Let me check\",\"item_id\":\"msg_1\",\"logprobs\":[],\"output_index\":0,\"sequence_number\":4}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_text.done")
                           .build()}
write "{\"type\":\"response.output_text.done\",\"content_index\":0,\"item_id\":\"msg_1\",\"logprobs\":[],\"output_index\":0,\"sequence_number\":5,\"text\":\"Let me check\"}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.content_part.done")
                           .build()}
write "{\"type\":\"response.content_part.done\",\"content_index\":0,\"item_id\":\"msg_1\",\"output_index\":0,\"part\":{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Let me check\"},\"sequence_number\":6}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_item.done")
                           .build()}
write "{\"type\":\"response.output_item.done\",\"item\":{\"id\":\"msg_1\",\"type\":\"message\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Let me check\"}],\"role\":\"assistant\"},\"output_index\":0,\"sequence_number\":7}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_item.added")
                           .build()}
write "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"fc_2\",\"type\":\"function_call\",\"status\":\"in_progress\",\"arguments\":\"\",\"call_id\":\"call_1\",\"name\":\"get_weather\"},\"output_index\":1,\"sequence_number\":8}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.function_call_arguments.delta")
                           .build()}
write "{\"type\":\"response.function_call_arguments.delta\",\"delta\":\"{\\\"city\\\":\",\"item_id\":\"fc_2\",\"output_index\":1,\"sequence_number\":9}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.function_call_arguments.delta")
                           .build()}
write "{\"type\":\"response.function_call_arguments.delta\",\"delta\":\"\\\"Paris\\\"}\",\"item_id\":\"fc_2\",\"output_index\":1,\"sequence_number\":10}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.function_call_arguments.done")
                           .build()}
write "{\"type\":\"response.function_call_arguments.done\",\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\",\"item_id\":\"fc_2\",\"output_index\":1,\"sequence_number\":11}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_item.done")
                           .build()}
write "{\"type\":\"response.output_item.done\",\"item\":{\"id\":\"fc_2\",\"type\":\"function_call\",\"status\":\"completed\",\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\",\"call_id\":\"call_1\",\"name\":\"get_weather\"},\"output_index\":1,\"sequence_number\":12}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.completed")
                           .build()}
write "{\"type\":\"response.completed\",\"response\":{\"id\":\"id_1\",\"object\":\"response\",\"model\":\"model\",\"output\":[{\"id\":\"msg_1\",\"type\":\"message\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Let me check\"}],\"role\":\"assistant\"},{\"id\":\"fc_2\",\"type\":\"function_call\",\"status\":\"completed\",\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\",\"call_id\":\"call_1\",\"name\":\"get_weather\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}},\"sequence_number\":13}"
write close
