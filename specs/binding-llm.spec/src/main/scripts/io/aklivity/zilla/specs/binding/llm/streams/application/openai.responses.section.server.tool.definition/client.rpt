connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/responses")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "code_exec")
                          .build()}
write "{\"type\":\"custom\",\"name\":\"code_exec\",\"description\":\"Executes arbitrary python code\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "web_search")
                          .build()}
write "{\"type\":\"web_search\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "mcp")
                          .build()}
write "{\"type\":\"mcp\",\"server_label\":\"deepwiki\",\"server_url\":\"https://mcp.deepwiki.com/mcp\",\"require_approval\":\"never\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "get_weather")
                          .build()}
write "{\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"description\":\"Get the current weather for a city\",\"parameters\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"],\"additionalProperties\":false},\"strict\":true}}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Search\"}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/responses")
                          .model("gpt-4")
                          .id("resp_1")
                          .build()}

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("ASSISTANT_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"Hello there\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai:usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}}"

read zilla:end.ext ${llm:matchEndEx()
                        .typeId(zilla:id("llm"))
                        .inputTokens(25)
                        .outputTokens(15)
                        .totalTokens(40)
                        .finishReason("stop")
                        .build()}

read closed

write close
