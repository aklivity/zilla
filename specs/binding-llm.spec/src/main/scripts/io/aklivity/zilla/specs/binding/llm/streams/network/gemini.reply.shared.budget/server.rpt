accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1beta/models/gemini-3.6-flash:generateContent")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"Hello\"}]}]}"

read closed

write zilla:begin.ext ${http:beginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}

write option zilla:flags "init"
write "{\"candidates\":[{\"content\":{\"part"
write flush
write option zilla:flags "none"
write "s\":[{\"text\":\"Hello! How can I he"
write flush
write option zilla:flags "none"
write "lp you today?\"}],\"role\":\"model\"}"
write flush
write option zilla:flags "none"
write ",\"finishReason\":\"STOP\",\"index\":0"
write flush
write option zilla:flags "none"
write "}],\"usageMetadata\":{\"promptToken"
write flush
write option zilla:flags "none"
write "Count\":8,\"candidatesTokenCount\":"
write flush
write option zilla:flags "none"
write "9,\"totalTokenCount\":17},\"modelVe"
write flush
write option zilla:flags "none"
write "rsion\":\"gemini-3.6-flash\",\"respo"
write flush
write option zilla:flags "fin"
write "nseId\":\"resp_01\"}"
write flush
write close
