accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/responses")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"model\":\"gpt-4\",\"tools\":[{\"type\":\"code_interpreter\",\"container\":{\"type\":\"auto\"}}],\"input\":[{\"role\":\"user\",\"content\":\"Use python to compute 17 * 23 and tell me the result.\"}]}"

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "application/json")
                            .build()}

write "{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[{\"code\":\"result = 17 * 23\\nresult\",\"container_id\":\"cntr_1\",\"id\":\"ci_1\",\"outputs\":[{\"logs\":\"391\",\"type\":\"logs\"}],\"status\":\"completed\",\"type\":\"code_interpreter_call\"},{\"content\":[{\"annotations\":[],\"logprobs\":[],\"text\":\"The result of 17 multiplied by 23 is 391.\",\"type\":\"output_text\"}],\"id\":\"msg_2\",\"role\":\"assistant\",\"status\":\"completed\",\"type\":\"message\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}}"
write close
