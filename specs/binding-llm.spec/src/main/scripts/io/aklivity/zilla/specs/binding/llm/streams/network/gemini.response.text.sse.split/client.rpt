connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1beta/models/gemini-3.6-flash:streamGenerateContent?alt=sse")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"Hello\"}]}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "text/event-stream")
                           .build()}
read option zilla:flags "init"
read "{\"ca"
read option zilla:flags "none"
read "ndidates\":[{\"content\":{\"parts\":[{\"text\":\"Hello \\"
read option zilla:flags "none"
read [0x22 0x74 0x68 0x65 0x72 0x65 0x5c 0x22 0x20 0xc3]
read option zilla:flags "fin"
read [0xa9 0x22 0x7d 0x5d 0x2c 0x22 0x72 0x6f 0x6c 0x65 0x22 0x3a 0x22 0x6d 0x6f 0x64 0x65 0x6c 0x22 0x7d 0x2c 0x22 0x69 0x6e 0x64 0x65 0x78 0x22 0x3a 0x30 0x7d 0x5d 0x2c 0x22 0x6d 0x6f 0x64 0x65 0x6c 0x56 0x65 0x72 0x73 0x69 0x6f 0x6e 0x22 0x3a 0x22 0x67 0x65 0x6d 0x69 0x6e 0x69 0x2d 0x33 0x2e 0x36 0x2d 0x66 0x6c 0x61 0x73 0x68 0x22 0x2c 0x22 0x72 0x65 0x73 0x70 0x6f 0x6e 0x73 0x65 0x49 0x64 0x22 0x3a 0x22 0x72 0x65 0x73 0x70 0x5f 0x30 0x31 0x22 0x7d]
read "{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"世 🌍\\n\"}],\"role\":\"model\"},\"index\":0}],\"modelVersion\":\"gemini-3.6-flash\",\"responseId\":\"resp_01\"}"
read "{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"end\"}],\"role\":\"model\"},\"index\":0}],\"modelVersion\":\"gemini-3.6-flash\",\"responseId\":\"resp_01\"}"
read option zilla:flags "init"
read "{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"\"}],\"role\":\"model\"},\"finishReason\":\"STOP\",\"index\":0}],\"usa"
read option zilla:flags "fin"
read "geMetadata\":{\"promptTokenCount\":8,\"candidatesTokenCount\":9,\"totalTokenCount\":17},\"modelVersion\":\"gemini-3.6-flash\",\"responseId\":\"resp_01\"}"

read closed
