connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/responses")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Hello\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"openai:temperature\":99}"
write flush

write advise zilla:flush

read zilla:reset.ext ${llm:matchResetEx()
                          .typeId(zilla:id("llm"))
                          .status(400)
                          .type("invalid_request_error")
                          .param("temperature")
                          .code("decimal_above_max_value")
                          .message("Invalid 'temperature': decimal above maximum value. Expected a value <= 2.0, but got 99 instead.")
                          .build()}

write aborted
