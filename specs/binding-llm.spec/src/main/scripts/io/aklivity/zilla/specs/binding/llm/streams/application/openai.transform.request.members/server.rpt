property source "source"
property target "target"
property model "model"

accept "zilla://streams/app0"
       option zilla:window 0
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect(source)
                           .model(model)
                           .build()}

connected

read advise zilla:challenge ${llm:challengeEx()
                                .typeId(zilla:id("llm"))
                                .dialect(target)
                                .build()}

read option zilla:window 8192

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
read "{\"text\":\"Hello\"}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:temperature\":0.7}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:top_p\":0.9}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:seed\":42}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:stop\":[\"END\"]}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:store\":true}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:service_tier\":\"auto\"}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:logprobs\":true}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:top_logprobs\":3}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:n\":2}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"openai:audio\":{\"voice\":\"alloy\",\"format\":\"wav\"}}"

read advised zilla:flush

write zilla:reset.ext ${llm:resetEx()
                            .typeId(zilla:id("llm"))
                            .status(400)
                            .type("invalid_request_error")
                            .message("Invalid request")
                            .build()}

read abort
