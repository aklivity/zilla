accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/responses")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"model\":\"gpt-4\",\"stream\":true,\"input\":[{\"role\":\"user\",\"content\":\"Think about it\"}]}"

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "text/event-stream")
                            .build()}
write flush

write "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":0,\"type\":\"response.created\"}"
write "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":1,\"type\":\"response.in_progress\"}"
write "{\"item\":{\"id\":\"rs_1\",\"summary\":[],\"type\":\"reasoning\"},\"output_index\":0,\"sequence_number\":2,\"type\":\"response.output_item.added\"}"
write "{\"item_id\":\"rs_1\",\"output_index\":0,\"part\":{\"text\":\"\",\"type\":\"summary_text\"},\"sequence_number\":3,\"summary_index\":0,\"type\":\"response.reasoning_summary_part.added\"}"
write "{\"delta\":\"Counting\",\"item_id\":\"rs_1\",\"obfuscation\":\"abcdefghij\",\"output_index\":0,\"sequence_number\":4,\"summary_index\":0,\"type\":\"response.reasoning_summary_text.delta\"}"
write "{\"delta\":\" multiples\",\"item_id\":\"rs_1\",\"obfuscation\":\"abcdefghij\",\"output_index\":0,\"sequence_number\":5,\"summary_index\":0,\"type\":\"response.reasoning_summary_text.delta\"}"
write "{\"item_id\":\"rs_1\",\"output_index\":0,\"sequence_number\":6,\"summary_index\":0,\"text\":\"Counting multiples\",\"type\":\"response.reasoning_summary_text.done\"}"
write "{\"item_id\":\"rs_1\",\"output_index\":0,\"part\":{\"text\":\"Counting multiples\",\"type\":\"summary_text\"},\"sequence_number\":7,\"summary_index\":0,\"type\":\"response.reasoning_summary_part.done\"}"
write "{\"item_id\":\"rs_1\",\"output_index\":0,\"part\":{\"text\":\"\",\"type\":\"summary_text\"},\"sequence_number\":8,\"summary_index\":1,\"type\":\"response.reasoning_summary_part.added\"}"
write "{\"delta\":\"Final\",\"item_id\":\"rs_1\",\"obfuscation\":\"abcdefghij\",\"output_index\":0,\"sequence_number\":9,\"summary_index\":1,\"type\":\"response.reasoning_summary_text.delta\"}"
write "{\"delta\":\" answer\",\"item_id\":\"rs_1\",\"obfuscation\":\"abcdefghij\",\"output_index\":0,\"sequence_number\":10,\"summary_index\":1,\"type\":\"response.reasoning_summary_text.delta\"}"
write "{\"item_id\":\"rs_1\",\"output_index\":0,\"sequence_number\":11,\"summary_index\":1,\"text\":\"Final answer\",\"type\":\"response.reasoning_summary_text.done\"}"
write "{\"item_id\":\"rs_1\",\"output_index\":0,\"part\":{\"text\":\"Final answer\",\"type\":\"summary_text\"},\"sequence_number\":12,\"summary_index\":1,\"type\":\"response.reasoning_summary_part.done\"}"
write "{\"item\":{\"encrypted_content\":\"gAAAAABq1ouh2zy2x7xA\",\"id\":\"rs_1\",\"summary\":[{\"text\":\"Counting multiples\",\"type\":\"summary_text\"},{\"text\":\"Final answer\",\"type\":\"summary_text\"}],\"type\":\"reasoning\"},\"output_index\":0,\"sequence_number\":13,\"type\":\"response.output_item.done\"}"
write "{\"item\":{\"content\":[],\"id\":\"msg_2\",\"role\":\"assistant\",\"status\":\"in_progress\",\"type\":\"message\"},\"output_index\":1,\"sequence_number\":14,\"type\":\"response.output_item.added\"}"
write "{\"content_index\":0,\"item_id\":\"msg_2\",\"output_index\":1,\"part\":{\"annotations\":[],\"logprobs\":[],\"text\":\"\",\"type\":\"output_text\"},\"sequence_number\":15,\"type\":\"response.content_part.added\"}"
write "{\"content_index\":0,\"delta\":\"Hello\",\"item_id\":\"msg_2\",\"logprobs\":[],\"obfuscation\":\"abcdefghij\",\"output_index\":1,\"sequence_number\":16,\"type\":\"response.output_text.delta\"}"
write "{\"content_index\":0,\"delta\":\" there\",\"item_id\":\"msg_2\",\"logprobs\":[],\"obfuscation\":\"abcdefghij\",\"output_index\":1,\"sequence_number\":17,\"type\":\"response.output_text.delta\"}"
write "{\"content_index\":0,\"item_id\":\"msg_2\",\"logprobs\":[],\"output_index\":1,\"sequence_number\":18,\"text\":\"Hello there\",\"type\":\"response.output_text.done\"}"
write "{\"content_index\":0,\"item_id\":\"msg_2\",\"output_index\":1,\"part\":{\"annotations\":[],\"logprobs\":[],\"text\":\"Hello there\",\"type\":\"output_text\"},\"sequence_number\":19,\"type\":\"response.content_part.done\"}"
write "{\"item\":{\"content\":[{\"annotations\":[],\"logprobs\":[],\"text\":\"Hello there\",\"type\":\"output_text\"}],\"id\":\"msg_2\",\"role\":\"assistant\",\"status\":\"completed\",\"type\":\"message\"},\"output_index\":1,\"sequence_number\":20,\"type\":\"response.output_item.done\"}"
write "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[{\"id\":\"rs_1\",\"summary\":[{\"text\":\"Counting multiples\",\"type\":\"summary_text\"},{\"text\":\"Final answer\",\"type\":\"summary_text\"}],\"type\":\"reasoning\"},{\"content\":[{\"annotations\":[],\"logprobs\":[],\"text\":\"Hello there\",\"type\":\"output_text\"}],\"id\":\"msg_2\",\"role\":\"assistant\",\"status\":\"completed\",\"type\":\"message\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}},\"sequence_number\":21,\"type\":\"response.completed\"}"
write close
