property clientAddress "zilla://streams/app0"
property model "gpt-a"

connect ${clientAddress}
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .build()}

connected

write option zilla:flags "init"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Hello, "
write flush
write option zilla:flags "none"
write "this section "
write flush
write option zilla:flags "fin"
write "is fine\"}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .build()}

read option zilla:flags "init"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "{\"text\":\"Hi, "
read option zilla:flags "fin"
read "how can I help?\"}"

read closed

write close
