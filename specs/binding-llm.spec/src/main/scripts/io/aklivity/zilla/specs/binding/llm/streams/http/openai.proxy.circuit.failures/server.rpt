accept "zilla://streams/net1"
       option zilla:window 8192
       option zilla:transmission "duplex"

accepted
connected

read "POST /v1/chat/completions HTTP/1.1\r\n"
read "Host: example.com:8080\r\n"
read "Content-Type: application/json\r\n"
read "Transfer-Encoding: chunked\r\n"
read "\r\n"
read "2b\r\n"
read "{\"model\":\"gpt-a\",\"messages\":[{\"role\":\"user\"\r\n"
read "15\r\n"
read ",\"content\":\"Hello\"}]}\r\n"
read "0\r\n"
read "\r\n"

write "HTTP/1.1 429 Too Many Requests\r\n"
write "Content-Type: application/json" "\r\n"
write "Content-Length: 112" "\r\n"
write "\r\n"
write "{\"error\":{\"message\":\"Rate limit reached for gpt-a\",\"type\":\"requests\",\"param\":null,\"code\":\"rate_limit_exceeded\"}}"

read "POST /v1/chat/completions HTTP/1.1\r\n"
read "Host: example.com:8080\r\n"
read "Content-Type: application/json\r\n"
read "Transfer-Encoding: chunked\r\n"
read "\r\n"
read "2b\r\n"
read "{\"model\":\"gpt-a\",\"messages\":[{\"role\":\"user\"\r\n"
read "15\r\n"
read ",\"content\":\"Hello\"}]}\r\n"
read "0\r\n"
read "\r\n"

write "HTTP/1.1 429 Too Many Requests\r\n"
write "Content-Type: application/json" "\r\n"
write "Content-Length: 112" "\r\n"
write "\r\n"
write "{\"error\":{\"message\":\"Rate limit reached for gpt-a\",\"type\":\"requests\",\"param\":null,\"code\":\"rate_limit_exceeded\"}}"

read "POST /v1/chat/completions HTTP/1.1\r\n"
read "Host: example.com:8080\r\n"
read "Content-Type: application/json\r\n"
read "Transfer-Encoding: chunked\r\n"
read "\r\n"
read "2b\r\n"
read "{\"model\":\"gpt-b\",\"messages\":[{\"role\":\"user\"\r\n"
read "15\r\n"
read ",\"content\":\"Hello\"}]}\r\n"
read "0\r\n"
read "\r\n"

write "HTTP/1.1 200 OK\r\n"
write "Content-Type: application/json" "\r\n"
write "Content-Length: 255" "\r\n"
write "\r\n"
write "{\"id\":\"chatcmpl_2\",\"object\":\"chat.completion\",\"model\":\"gpt-b\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Hello! How can I help you today?\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":25,\"completion_tokens\":15,\"total_tokens\":40}}"
