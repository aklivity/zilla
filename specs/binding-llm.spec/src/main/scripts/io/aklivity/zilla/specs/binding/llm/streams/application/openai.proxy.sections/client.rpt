# Routing considers the begin extension (dialect and model) alone. Sections that no route anticipated, including
# types the exit's dialect cannot represent, are relayed unchanged and never prune or change the resolved route.

property clientAddress "zilla://streams/app0"
property model "gpt-a"

connect ${clientAddress}
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "web_search")
                          .build()}
write "{\"type\":\"web_search_20250305\",\"name\":\"web_search\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_AUDIO")
                          .message(0)
                          .attribute("media-type", "audio/wav")
                          .attribute("source", "inline")
                          .build()}
write "{\"type\":\"input_audio\",\"input_audio\":{\"data\":\"UklGRg==\",\"format\":\"wav\"}}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Hello\"}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .build()}

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "{\"text\":\"Hello! How can I help you today?\"}"

read closed

write close
