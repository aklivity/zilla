connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1beta/models/gemini-3.6-flash:generateContent")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"Hello\"}]}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}

read "{\"cand"
read "idates\":[{\"content\":{\"parts\":[{\"text\":\"Hello \\"
read [0x22 0x74 0x68 0x65 0x72 0x65 0x5c 0x22 0x20 0xc3]
read [0xa9 0xe4 0xb8 0x96 0x20 0xf0 0x9f]
read [0x8c 0x8d 0x5c 0x6e 0x65 0x6e 0x64 0x22 0x7d 0x5d 0x2c 0x22 0x72 0x6f 0x6c 0x65 0x22 0x3a 0x22 0x6d 0x6f 0x64 0x65 0x6c 0x22 0x7d 0x2c 0x22 0x66 0x69 0x6e 0x69 0x73 0x68 0x52 0x65 0x61 0x73 0x6f 0x6e 0x22 0x3a 0x22 0x53 0x54 0x4f 0x50 0x22 0x2c 0x22 0x69 0x6e 0x64 0x65 0x78 0x22 0x3a 0x30 0x7d 0x5d 0x2c 0x22 0x75]
read "sageMetadata\":{\"promptTokenCount\":8,\"candidatesTokenCount\":9,\"totalTokenCount\":17},\"modelVersion\":\"gemini-3.6-flash\",\"responseId\":\"resp_01\"}"

read closed
