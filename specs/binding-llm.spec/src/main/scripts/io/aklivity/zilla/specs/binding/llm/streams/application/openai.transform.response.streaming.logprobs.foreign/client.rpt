# Logprobs: when the request asks for logprobs, each fragment of the text the upstream delivers is a section of its own,
# announced by the follow marker on the section data extension, and followed by an after block carrying the logprobs of
# that fragment. The after block is a single frame with the init and fin flags, owned by the section (the default owner),
# and has an empty payload when the upstream reported no logprobs for the fragment.

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai")
                          .model("gpt-4")
                          .build()}

connected

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write "{\"model\":\"gpt-4\",\"messages\":[{\"role\":\"user\",\"content\":\""
write flush

write zilla:data.ext ${llm:dataEx()
                         .typeId(zilla:id("llm"))
                         .type("USER_TEXT")
                         .message(0)
                         .build()}
write "Hello"
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
write "\"}],\"logprobs\":true,\"stream\":true,\"stream_options\":{\"include_usage\":true}}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                         .typeId(zilla:id("llm"))
                         .dialect("anthropic")
                         .model("gpt-4")
                         .id("chatcmpl_1")
                         .build()}

read zilla:data.ext ${llm:matchDataEx()
                        .typeId(zilla:id("llm"))
                        .type("ASSISTANT_TEXT")
                        .message(0)
                        .build()}
read "Hello"

read zilla:data.ext ${llm:matchDataEx()
                        .typeId(zilla:id("llm"))
                        .type("ASSISTANT_TEXT")
                        .message(0)
                        .build()}
read " there"

read zilla:data.ext ${llm:matchDataEx()
                        .typeId(zilla:id("llm"))
                        .type("ASSISTANT_TEXT")
                        .message(0)
                        .build()}
read "!"

read zilla:end.ext ${llm:matchEndEx()
                          .typeId(zilla:id("llm"))
                          .inputTokens(25)
                          .outputTokens(15)
                          .totalTokens(40)
                          .finishReason("stop")
                          .build()}

read closed

write close
