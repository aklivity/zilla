accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/responses")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"model\":\"gpt-4\",\"stream\":true,\"tools\":[{\"type\":\"custom\",\"name\":\"code_exec\",\"description\":\"Executes arbitrary python code\"}],\"input\":[{\"role\":\"user\",\"content\":\"Use the code_exec tool to print the word hello.\"}],\"stream_options\":{\"include_obfuscation\":false}}"

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "text/event-stream")
                            .build()}
write flush

write "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":0,\"type\":\"response.created\"}"
write "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":1,\"type\":\"response.in_progress\"}"
write "{\"item\":{\"call_id\":\"call_1\",\"id\":\"ctc_1\",\"input\":\"\",\"name\":\"code_exec\",\"status\":\"in_progress\",\"type\":\"custom_tool_call\"},\"output_index\":0,\"sequence_number\":2,\"type\":\"response.output_item.added\"}"
write "{\"delta\":\"print(\",\"item_id\":\"ctc_1\",\"output_index\":0,\"sequence_number\":3,\"type\":\"response.custom_tool_call_input.delta\"}"
write "{\"delta\":\"\\\"hello\\\")\\n\",\"item_id\":\"ctc_1\",\"output_index\":0,\"sequence_number\":4,\"type\":\"response.custom_tool_call_input.delta\"}"
write "{\"input\":\"print(\\\"hello\\\")\\n\",\"item_id\":\"ctc_1\",\"output_index\":0,\"sequence_number\":5,\"type\":\"response.custom_tool_call_input.done\"}"
write "{\"item\":{\"call_id\":\"call_1\",\"id\":\"ctc_1\",\"input\":\"print(\\\"hello\\\")\\n\",\"name\":\"code_exec\",\"status\":\"completed\",\"type\":\"custom_tool_call\"},\"output_index\":0,\"sequence_number\":6,\"type\":\"response.output_item.done\"}"
write "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[{\"call_id\":\"call_1\",\"id\":\"ctc_1\",\"input\":\"print(\\\"hello\\\")\\n\",\"name\":\"code_exec\",\"status\":\"completed\",\"type\":\"custom_tool_call\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}},\"sequence_number\":7,\"type\":\"response.completed\"}"
write close
