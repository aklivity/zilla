connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"stream\":true,\"tools\":[{\"type\":\"mcp\",\"server_label\":\"deepwiki\",\"server_url\":\"https://mcp.deepwiki.com/mcp\",\"require_approval\":\"never\"}],\"input\":[{\"role\":\"user\",\"content\":\"Use deepwiki to say in one word the main programming language of aklivity/zilla.\"}],\"stream_options\":{\"include_obfuscation\":false}}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "text/event-stream")
                           .build()}

read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":0,\"type\":\"response.created\"}"
read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":1,\"type\":\"response.in_progress\"}"
read "{\"item\":{\"id\":\"mcpl_1\",\"status\":\"in_progress\",\"type\":\"mcp_list_tools\"},\"output_index\":0,\"sequence_number\":2,\"type\":\"response.output_item.added\"}"
read "{\"item_id\":\"mcpl_1\",\"output_index\":0,\"sequence_number\":3,\"type\":\"response.mcp_list_tools.in_progress\"}"
read "{\"item_id\":\"mcpl_1\",\"output_index\":0,\"sequence_number\":4,\"type\":\"response.mcp_list_tools.completed\"}"
read "{\"item\":{\"id\":\"mcpl_1\",\"server_label\":\"deepwiki\",\"status\":\"completed\",\"tools\":[{\"annotations\":{\"read_only\":false},\"description\":\"Ask a question about a repository\",\"input_schema\":{\"properties\":{\"question\":{\"type\":\"string\"}},\"required\":[\"question\"],\"type\":\"object\"},\"name\":\"ask_wiki_question\"}],\"type\":\"mcp_list_tools\"},\"output_index\":0,\"sequence_number\":5,\"type\":\"response.output_item.done\"}"
read "{\"item\":{\"arguments\":\"\",\"id\":\"mcp_2\",\"name\":\"ask_wiki_question\",\"status\":\"in_progress\",\"type\":\"mcp_call\"},\"output_index\":1,\"sequence_number\":6,\"type\":\"response.output_item.added\"}"
read "{\"item_id\":\"mcp_2\",\"output_index\":1,\"sequence_number\":7,\"type\":\"response.mcp_call.in_progress\"}"
read "{\"delta\":\"{\\\"question\\\":\",\"item_id\":\"mcp_2\",\"output_index\":1,\"sequence_number\":8,\"type\":\"response.mcp_call_arguments.delta\"}"
read "{\"delta\":\"\\\"main language?\\\"}\",\"item_id\":\"mcp_2\",\"output_index\":1,\"sequence_number\":9,\"type\":\"response.mcp_call_arguments.delta\"}"
read "{\"arguments\":\"{\\\"question\\\":\\\"main language?\\\"}\",\"item_id\":\"mcp_2\",\"output_index\":1,\"sequence_number\":10,\"type\":\"response.mcp_call_arguments.done\"}"
read "{\"item_id\":\"mcp_2\",\"output_index\":1,\"sequence_number\":11,\"type\":\"response.mcp_call.completed\"}"
read "{\"item\":{\"approval_request_id\":null,\"arguments\":\"{\\\"question\\\":\\\"main language?\\\"}\",\"error\":null,\"id\":\"mcp_2\",\"name\":\"ask_wiki_question\",\"output\":\"Java\",\"server_label\":\"deepwiki\",\"status\":\"completed\",\"type\":\"mcp_call\"},\"output_index\":1,\"sequence_number\":12,\"type\":\"response.output_item.done\"}"
read "{\"item\":{\"content\":[],\"id\":\"msg_3\",\"role\":\"assistant\",\"status\":\"in_progress\",\"type\":\"message\"},\"output_index\":2,\"sequence_number\":13,\"type\":\"response.output_item.added\"}"
read "{\"content_index\":0,\"item_id\":\"msg_3\",\"output_index\":2,\"part\":{\"annotations\":[],\"logprobs\":[],\"text\":\"\",\"type\":\"output_text\"},\"sequence_number\":14,\"type\":\"response.content_part.added\"}"
read "{\"content_index\":0,\"delta\":\"Java\",\"item_id\":\"msg_3\",\"logprobs\":[],\"output_index\":2,\"sequence_number\":15,\"type\":\"response.output_text.delta\"}"
read "{\"content_index\":0,\"item_id\":\"msg_3\",\"logprobs\":[],\"output_index\":2,\"sequence_number\":16,\"text\":\"Java\",\"type\":\"response.output_text.done\"}"
read "{\"content_index\":0,\"item_id\":\"msg_3\",\"output_index\":2,\"part\":{\"annotations\":[],\"logprobs\":[],\"text\":\"Java\",\"type\":\"output_text\"},\"sequence_number\":17,\"type\":\"response.content_part.done\"}"
read "{\"item\":{\"content\":[{\"annotations\":[],\"logprobs\":[],\"text\":\"Java\",\"type\":\"output_text\"}],\"id\":\"msg_3\",\"role\":\"assistant\",\"status\":\"completed\",\"type\":\"message\"},\"output_index\":2,\"sequence_number\":18,\"type\":\"response.output_item.done\"}"
read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[{\"id\":\"mcpl_1\",\"server_label\":\"deepwiki\",\"status\":\"completed\",\"tools\":[{\"annotations\":{\"read_only\":false},\"description\":\"Ask a question about a repository\",\"input_schema\":{\"properties\":{\"question\":{\"type\":\"string\"}},\"required\":[\"question\"],\"type\":\"object\"},\"name\":\"ask_wiki_question\"}],\"type\":\"mcp_list_tools\"},{\"approval_request_id\":null,\"arguments\":\"{\\\"question\\\":\\\"main language?\\\"}\",\"error\":null,\"id\":\"mcp_2\",\"name\":\"ask_wiki_question\",\"output\":\"Java\",\"server_label\":\"deepwiki\",\"status\":\"completed\",\"type\":\"mcp_call\"},{\"content\":[{\"annotations\":[],\"logprobs\":[],\"text\":\"Java\",\"type\":\"output_text\"}],\"id\":\"msg_3\",\"role\":\"assistant\",\"status\":\"completed\",\"type\":\"message\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}},\"sequence_number\":19,\"type\":\"response.completed\"}"

read closed
