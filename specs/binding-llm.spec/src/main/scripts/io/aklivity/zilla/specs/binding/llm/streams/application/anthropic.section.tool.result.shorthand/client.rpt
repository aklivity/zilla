property model "claude-3-opus-20240229"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model(model)
                           .build()}

connected

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write "{\"model\":\""
      ${model}
      "\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_1\",\"content\":"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_RESULT")
                          .message(0)
                          .attribute("tool-call-id", "toolu_1")
                          .build()}
write "{\"text\":\"sunny\"}"
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
write "}]}],\"max_tokens\":1024}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model(model)
                           .id("msg_01")
                           .build()}

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
read "{\"id\":\"msg_01\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\""
     ${model}
     "\",\"content\":[{\"type\":\"text\",\"text\":"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "{\"text\":\"Hello! How can I help you today?\"}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "}],\"stop_reason\":\"end_turn\",\"stop_sequence\":null,\"usage\":{\"input_tokens\":25,\"output_tokens\":15}}"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(25)
                            .outputTokens(15)
                            .finishReason("stop")
                            .build()}

read closed

write close
