accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/responses")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"model\":\"model\",\"input\":[{\"role\":\"user\",\"content\":\"Hello\"}]}"

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "text/event-stream")
                            .build()}
write flush

write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.created")
                           .build()}
write "{\"type\":\"response.created\",\"response\":{\"id\":\"id_1\",\"object\":\"response\",\"model\":\"model\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":0}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.in_progress")
                           .build()}
write "{\"type\":\"response.in_progress\",\"response\":{\"id\":\"id_1\",\"object\":\"response\",\"model\":\"model\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":1}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.output_item.added")
                           .build()}
write "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"fc_1\",\"type\":\"function_call\",\"status\":\"in_progress\",\"arguments\":\"\",\"call_id\":\"call_1\",\"name\":\"get_weather\"},\"output_index\":0,\"sequence_number\":2}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.function_call_arguments.delta")
                           .build()}
write "{\"type\":\"response.function_call_arguments.delta\",\"delta\":\"{\\\"city\\\":\",\"item_id\":\"fc_1\",\"output_index\":0,\"sequence_number\":3}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "error")
                           .build()}
write "{\"type\":\"error\",\"code\":\"overloaded_error\",\"message\":\"Overloaded\",\"param\":null,\"sequence_number\":4}"
write zilla:data.ext ${http:dataEx()
                           .typeId(zilla:id("http"))
                           .header("type", "response.failed")
                           .build()}
write "{\"type\":\"response.failed\",\"response\":{\"id\":\"id_1\",\"object\":\"response\",\"model\":\"model\",\"output\":[],\"status\":\"failed\",\"error\":{\"code\":\"overloaded_error\",\"message\":\"Overloaded\"}},\"sequence_number\":5}"
write close
