accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/responses")
                          .model("gpt-4")
                          .build()}

connected

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("USER_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"Hello\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai:temperature\":99}"

read advised zilla:flush

write zilla:reset.ext ${llm:resetEx()
                           .typeId(zilla:id("llm"))
                           .status(400)
                           .type("invalid_request_error")
                           .param("temperature")
                           .code("decimal_above_max_value")
                           .message("Invalid 'temperature': decimal above maximum value. Expected a value <= 2.0, but got 99 instead.")
                           .build()}

read abort
