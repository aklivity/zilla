connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/chat/completions")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}],\"stream\":true,\"stream_options\":{\"include_obfuscation\":false,\"include_usage\":true}}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "text/event-stream")
                           .build()}

read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"},\"finish_reason\":null}]}"
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"created\":1700000001,\"service_tier\":\"default\",\"m01\":1,\"m02\":\"two\",\"m03\":[3],\"m04\":true,\"m05\":null,\"m06\":{\"k\":\"v\"},\"m07\":7.5,\"m08\":\"eight\",\"m09\":9,\"m10\":\"ten\",\"m11\":11,\"m12\":\"twelve\",\"m13\":[13],\"m14\":false,\"m15\":15,\"m16\":\"sixteen\",\"big1\":\""
     ${core:randomBase64(1000)}
     "\",\"big2\":\""
     ${core:randomBase64(1001)}
     "\",\"big3\":\""
     ${core:randomBase64(1002)}
     "\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello\"},\"finish_reason\":null}]}"
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"created\":1700000001,\"service_tier\":\"default\",\"m01\":1,\"m02\":\"two\",\"m03\":[3],\"m04\":true,\"m05\":null,\"m06\":{\"k\":\"v\"},\"m07\":7.5,\"m08\":\"eight\",\"m09\":9,\"m10\":\"ten\",\"m11\":11,\"m12\":\"twelve\",\"m13\":[13],\"m14\":false,\"m15\":15,\"m16\":\"sixteen\",\"big1\":\""
     ${core:randomBase64(1000)}
     "\",\"big2\":\""
     ${core:randomBase64(1001)}
     "\",\"big3\":\""
     ${core:randomBase64(1002)}
     "\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\" there\"},\"finish_reason\":null}]}"
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"created\":1700000001,\"service_tier\":\"default\",\"m01\":1,\"m02\":\"two\",\"m03\":[3],\"m04\":true,\"m05\":null,\"m06\":{\"k\":\"v\"},\"m07\":7.5,\"m08\":\"eight\",\"m09\":9,\"m10\":\"ten\",\"m11\":11,\"m12\":\"twelve\",\"m13\":[13],\"m14\":false,\"m15\":15,\"m16\":\"sixteen\",\"big1\":\""
     ${core:randomBase64(1000)}
     "\",\"big2\":\""
     ${core:randomBase64(1001)}
     "\",\"big3\":\""
     ${core:randomBase64(1002)}
     "\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}"
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"created\":1700000001,\"service_tier\":\"default\",\"m01\":1,\"m02\":\"two\",\"m03\":[3],\"m04\":true,\"m05\":null,\"m06\":{\"k\":\"v\"},\"m07\":7.5,\"m08\":\"eight\",\"m09\":9,\"m10\":\"ten\",\"m11\":11,\"m12\":\"twelve\",\"m13\":[13],\"m14\":false,\"m15\":15,\"m16\":\"sixteen\",\"big1\":\""
     ${core:randomBase64(1000)}
     "\",\"big2\":\""
     ${core:randomBase64(1001)}
     "\",\"big3\":\""
     ${core:randomBase64(1002)}
     "\",\"choices\":[],\"usage\":{\"prompt_tokens\":25,\"completion_tokens\":15,\"total_tokens\":40}}"
read "[DONE]"

read closed
