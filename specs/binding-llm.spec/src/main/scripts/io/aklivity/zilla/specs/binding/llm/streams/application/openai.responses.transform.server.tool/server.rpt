property model "model"

accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/rs")
                          .model(model)
                          .build()}

connected

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("USER_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"Search\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("SERVER_TOOL_DEFINITION")
                         .message(-1)
                         .attribute("tool-name", "web_search")
                         .build()}
read "{\"type\":\"web_search\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("SERVER_TOOL_CALL")
                         .message(1)
                         .attribute("tool-name", "web_search")
                         .attribute("tool-call-id", "ws_1")
                         .extension("web_search_call")
                         .build()}
read "{\"arguments\":{\"action\":{\"type\":\"search\",\"query\":\"paris weather\"}}}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("SERVER_TOOL_RESULT")
                         .message(1)
                         .attribute("tool-call-id", "ws_1")
                         .extension("web_search_call")
                         .build()}
read "{\"status\":\"completed\"}"

read advised zilla:flush

write zilla:reset.ext ${llm:resetEx()
                           .typeId(zilla:id("llm"))
                           .status(429)
                           .type("rate_limit_error")
                           .message("Rate limit exceeded")
                           .build()}

read abort
