                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai:service_tier\":\"auto\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai:store\":false}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:temperature\":1.0}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:text\":{\"format\":{\"type\":\"text\"},\"verbosity\":\"medium\"}}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:tool_choice\":\"auto\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:tool_usage\":{\"image_gen\":{\"input_tokens\":0,\"input_tokens_details\":{\"image_tokens\":0,\"text_tokens\":0},\"output_tokens\":0,\"output_tokens_details\":{\"image_tokens\":0,\"text_tokens\":0},\"total_tokens\":0},\"web_search\":{\"num_requests\":0}}}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:tools\":[]}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:top_logprobs\":0}"

