connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/rs")
                           .model("gpt-4.1-mini")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"stream\":true}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Say hello in exactly five words.\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"openai:store\":false}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"stream_options\":{\"include_usage\":true}}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/rs")
                          .model("gpt-4.1-mini-2025-04-14")
                          .id("resp_1")
                          .build()}

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:created_at\":1792445324}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:access_programs\":null}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:background\":false}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:completed_at\":null}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:frequency_penalty\":0.0}"

