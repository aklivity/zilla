                         .message(-1)
                         .build()}
read "{\"openai/rs:max_tool_calls\":null}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:moderation\":null}"

