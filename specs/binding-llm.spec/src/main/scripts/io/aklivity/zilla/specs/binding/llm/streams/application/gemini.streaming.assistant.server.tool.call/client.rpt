connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("gemini")
                           .model("gemini-3.6-flash")
                           .extension("streamGenerateContent")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"stream\":true}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Hello\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"stream_options\":{\"include_usage\":true}}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("gemini")
                           .model("gemini-3.6-flash")
                           .id("resp_01")
                           .build()}

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_CALL")
                          .message(0)
                          .attribute("tool-name", "code_execution")
                          .attribute("tool-call-id", "call_0_0")
                          .build()}
read "{\"arguments\":{\"language\":\"PYTHON\",\"code\":\"print(17**13)\\n\",\"id\":\"call_55063\"}}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_RESULT")
                          .message(0)
                          .attribute("tool-call-id", "call_0_0")
                          .build()}
read "{\"codeExecutionResult\":{\"outcome\":\"OUTCOME_OK\",\"output\":\"9904578032905937\\n\",\"id\":\"call_55063\"}}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read option zilla:flags "init"
read "{\"text\":\"The answer"
read option zilla:flags "none"
read " is 9904578032905937."
read option zilla:flags "fin"
read "\"}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
read "{\"gemini:usageMetadata\":{\"promptTokenCount\":8,\"candidatesTokenCount\":9,\"totalTokenCount\":17}}"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(8)
                            .outputTokens(9)
                            .totalTokens(17)
                            .finishReason("stop")
                            .build()}

read closed

write close
