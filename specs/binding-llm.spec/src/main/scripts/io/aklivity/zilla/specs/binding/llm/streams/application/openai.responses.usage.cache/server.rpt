accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/rs")
                          .model("gpt-4")
                          .build()}

connected

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("USER_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"Hello\"}"

read advised zilla:flush

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/rs")
                           .model("gpt-4")
                           .id("resp_1")
                           .build()}
write flush

write option zilla:flags "init"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"o"
write flush

write option zilla:flags "none"
write "k"
write flush

write option zilla:flags "fin"
write "\"}"
write flush

write option zilla:flags "auto"

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"openai/rs:usage\":{\"input_tokens\":4019,\"input_tokens_details\":{\"cache_write_tokens\":0,\"cached_tokens\":3840},\"output_tokens\":2,\"output_tokens_details\":{\"reasoning_tokens\":0},\"total_tokens\":4021}}"
write flush

write zilla:end.ext ${llm:endEx()
                         .typeId(zilla:id("llm"))
                         .inputTokens(4019)
                         .cacheWriteTokens(0)
                         .cacheReadTokens(3840)
                         .outputTokens(2)
                         .reasoningTokens(0)
                         .totalTokens(4021)
                         .finishReason("stop")
                         .build()}

write close

read closed
