property model "gpt-4"

connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"input\":[{\"role\":\"user\",\"content\":\"Sky colour?\"},{\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"annotations\":[{\"type\":\"url_citation\",\"start_index\":0,\"end_index\":4,\"url\":\"https://example.com/"
      ${core:randomBase64(10000)}
      "\",\"title\":\"Example\"}],\"text\":\"The sky is blue.\",\"logprobs\":[]}]}]}"

write aborted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "400")
                           .header("content-type", "application/json")
                           .build()}

read "{\"error\":{\"message\":\"The 'annotations' of an output text part are too large.\",\"type\":\"invalid_request_error\",\"param\":null,\"code\":null}}"

read closed
