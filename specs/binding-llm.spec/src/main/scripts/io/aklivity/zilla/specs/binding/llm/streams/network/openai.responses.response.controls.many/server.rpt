accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/responses")
                           .header("content-type", "application/json")
                           .build()}

connected

read "{\"model\":\"gpt-4\",\"input\":[{\"role\":\"user\",\"content\":\"Hello\"}]}"

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "application/json")
                            .build()}

write "{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"output\":[{\"id\":\"msg_1\",\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"Hello there\",\"annotations\":[],\"logprobs\":[]}],\"role\":\"assistant\",\"status\":\"completed\"}],\"status\":\"completed\",\"created_at\":1700000000,\"service_tier\":\"default\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40},\"m01\":1,\"m02\":\"two\",\"m03\":[3],\"m04\":true,\"m05\":null,\"m06\":{\"k\":\"v\"},\"m07\":7.5,\"m08\":\"eight\",\"m09\":9,\"m10\":\"ten\",\"m11\":11,\"m12\":\"twelve\",\"m13\":[13],\"m14\":false,\"m15\":15,\"m16\":\"sixteen\",\"big1\":\""
     ${core:randomBase64(1000)}
     "\",\"big2\":\""
     ${core:randomBase64(1001)}
     "\",\"big3\":\""
     ${core:randomBase64(1002)}
     "\"}"
write close
