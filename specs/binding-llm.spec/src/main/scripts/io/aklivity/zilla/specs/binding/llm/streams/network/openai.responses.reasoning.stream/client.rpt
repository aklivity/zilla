connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"stream\":true,\"input\":[{\"role\":\"user\",\"content\":\"Think about it\"}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "text/event-stream")
                           .build()}

read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.created")
                          .build()}
read "{\"type\":\"response.created\",\"response\":{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":0}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.in_progress")
                          .build()}
read "{\"type\":\"response.in_progress\",\"response\":{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"status\":\"in_progress\",\"output\":[]},\"sequence_number\":1}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.added")
                          .build()}
read "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"rs_1\",\"type\":\"reasoning\",\"summary\":[]},\"output_index\":0,\"sequence_number\":2}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.reasoning_summary_part.added")
                          .build()}
read "{\"type\":\"response.reasoning_summary_part.added\",\"item_id\":\"rs_1\",\"output_index\":0,\"part\":{\"type\":\"summary_text\",\"text\":\"\"},\"sequence_number\":3,\"summary_index\":0}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.reasoning_summary_text.delta")
                          .build()}
read /..type...response.reasoning_summary_text.delta...delta...Counting...item_id...rs_1...obfuscation...[A-Za-z0-9]+...output_index..0..sequence_number..4..summary_index..0./
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.reasoning_summary_text.delta")
                          .build()}
read /..type...response.reasoning_summary_text.delta...delta....multiples...item_id...rs_1...obfuscation...[A-Za-z0-9]+...output_index..0..sequence_number..5..summary_index..0./
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.reasoning_summary_text.done")
                          .build()}
read "{\"type\":\"response.reasoning_summary_text.done\",\"item_id\":\"rs_1\",\"output_index\":0,\"sequence_number\":6,\"summary_index\":0,\"text\":\"Counting multiples\"}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.reasoning_summary_part.done")
                          .build()}
read "{\"type\":\"response.reasoning_summary_part.done\",\"item_id\":\"rs_1\",\"output_index\":0,\"part\":{\"type\":\"summary_text\",\"text\":\"Counting multiples\"},\"sequence_number\":7,\"summary_index\":0}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.reasoning_summary_part.added")
                          .build()}
read "{\"type\":\"response.reasoning_summary_part.added\",\"item_id\":\"rs_1\",\"output_index\":0,\"part\":{\"type\":\"summary_text\",\"text\":\"\"},\"sequence_number\":8,\"summary_index\":1}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.reasoning_summary_text.delta")
                          .build()}
read /..type...response.reasoning_summary_text.delta...delta...Final...item_id...rs_1...obfuscation...[A-Za-z0-9]+...output_index..0..sequence_number..9..summary_index..1./
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.reasoning_summary_text.delta")
                          .build()}
read /..type...response.reasoning_summary_text.delta...delta....answer...item_id...rs_1...obfuscation...[A-Za-z0-9]+...output_index..0..sequence_number..10..summary_index..1./
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.reasoning_summary_text.done")
                          .build()}
read "{\"type\":\"response.reasoning_summary_text.done\",\"item_id\":\"rs_1\",\"output_index\":0,\"sequence_number\":11,\"summary_index\":1,\"text\":\"Final answer\"}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.reasoning_summary_part.done")
                          .build()}
read "{\"type\":\"response.reasoning_summary_part.done\",\"item_id\":\"rs_1\",\"output_index\":0,\"part\":{\"type\":\"summary_text\",\"text\":\"Final answer\"},\"sequence_number\":12,\"summary_index\":1}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.done")
                          .build()}
read "{\"type\":\"response.output_item.done\",\"item\":{\"type\":\"reasoning\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"Counting multiples\"},{\"type\":\"summary_text\",\"text\":\"Final answer\"}],\"id\":\"rs_1\",\"encrypted_content\":\"gAAAAABq1ouh2zy2x7xA\"},\"output_index\":0,\"sequence_number\":13}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.added")
                          .build()}
read "{\"type\":\"response.output_item.added\",\"item\":{\"id\":\"msg_2\",\"type\":\"message\",\"status\":\"in_progress\",\"content\":[],\"role\":\"assistant\"},\"output_index\":1,\"sequence_number\":14}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.content_part.added")
                          .build()}
read "{\"type\":\"response.content_part.added\",\"content_index\":0,\"item_id\":\"msg_2\",\"output_index\":1,\"part\":{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"\"},\"sequence_number\":15}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_text.delta")
                          .build()}
read /..type...response.output_text.delta...content_index..0..delta...Hello...item_id...msg_2...logprobs......obfuscation...[A-Za-z0-9]+...output_index..1..sequence_number..16./
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_text.delta")
                          .build()}
read /..type...response.output_text.delta...content_index..0..delta....there...item_id...msg_2...logprobs......obfuscation...[A-Za-z0-9]+...output_index..1..sequence_number..17./
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_text.done")
                          .build()}
read "{\"type\":\"response.output_text.done\",\"content_index\":0,\"item_id\":\"msg_2\",\"logprobs\":[],\"output_index\":1,\"sequence_number\":18,\"text\":\"Hello there\"}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.content_part.done")
                          .build()}
read "{\"type\":\"response.content_part.done\",\"content_index\":0,\"item_id\":\"msg_2\",\"output_index\":1,\"part\":{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Hello there\"},\"sequence_number\":19}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.output_item.done")
                          .build()}
read "{\"type\":\"response.output_item.done\",\"item\":{\"id\":\"msg_2\",\"type\":\"message\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Hello there\"}],\"role\":\"assistant\"},\"output_index\":1,\"sequence_number\":20}"
read zilla:data.ext ${http:matchDataEx()
                          .typeId(zilla:id("http"))
                          .header("type", "response.completed")
                          .build()}
read "{\"type\":\"response.completed\",\"response\":{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"output\":[{\"type\":\"reasoning\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"Counting multiples\"},{\"type\":\"summary_text\",\"text\":\"Final answer\"}],\"id\":\"rs_1\"},{\"id\":\"msg_2\",\"type\":\"message\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Hello there\"}],\"role\":\"assistant\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}},\"sequence_number\":21}"

read closed
