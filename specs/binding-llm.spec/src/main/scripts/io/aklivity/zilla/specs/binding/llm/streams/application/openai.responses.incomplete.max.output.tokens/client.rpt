connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/responses")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Hello\"}"
write flush

write advise zilla:flush ${llm:dialectFlushEx()
                              .typeId(zilla:id("llm"))
                              .maxOutputTokens(16)
                              .build()}

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/responses")
                          .model("gpt-4")
                          .id("resp_1")
                          .build()}

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("ASSISTANT_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"The history of the printing press\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai:usage\":{\"input_tokens\":22,\"output_tokens\":16,\"total_tokens\":38}}"

read zilla:end.ext ${llm:matchEndEx()
                        .typeId(zilla:id("llm"))
                        .inputTokens(22)
                        .outputTokens(16)
                        .totalTokens(38)
                        .finishReason("length")
                        .build()}

read closed

write close
