accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/responses")
                          .model("gpt-4")
                          .build()}

connected

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("SERVER_TOOL_DEFINITION")
                         .message(-1)
                         .attribute("tool-name", "mcp")
                         .build()}
read "{\"type\":\"mcp\",\"server_label\":\"deepwiki\",\"server_url\":\"https://mcp.deepwiki.com/mcp\",\"require_approval\":\"never\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("USER_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"Use deepwiki to say in one word the main programming language of aklivity/zilla.\"}"

read advised zilla:flush

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/responses")
                           .model("gpt-4")
                           .id("resp_1")
                           .build()}
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_CALL")
                          .message(0)
                          .attribute("tool-name", "mcp_list_tools")
                          .attribute("tool-call-id", "mcpl_1")
                          .extension("mcp_list_tools")
                          .build()}
write "{\"arguments\":{\"server_label\":\"deepwiki\",\"tools\":[{\"annotations\":{\"read_only\":false},\"description\":\"Ask a question about a repository\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\"}},\"required\":[\"question\"]},\"name\":\"ask_wiki_question\"}]}}"
write flush

write option zilla:flags "init"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_CALL")
                          .message(0)
                          .attribute("tool-name", "ask_wiki_question")
                          .attribute("tool-call-id", "mcp_2")
                          .extension("mcp_call")
                          .build()}
write "{\"arguments\":{\"arguments\":\"{\\\"question\\\":"
write flush

write option zilla:flags "fin"
write "\\\"main language?\\\"}\",\"approval_request_id\":null}}"
write flush

write option zilla:flags "auto"

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_RESULT")
                          .message(0)
                          .attribute("tool-call-id", "mcp_2")
                          .extension("mcp_call")
                          .build()}
write "{\"error\":null,\"output\":\"Java\",\"server_label\":\"deepwiki\"}"
write flush

write option zilla:flags "init"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Java"
write flush

write option zilla:flags "fin"
write "\"}"
write flush

write option zilla:flags "auto"

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"openai:usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}}"
write flush

write zilla:end.ext ${llm:endEx()
                         .typeId(zilla:id("llm"))
                         .inputTokens(25)
                         .outputTokens(15)
                         .totalTokens(40)
                         .finishReason("stop")
                         .build()}

write close

read closed
