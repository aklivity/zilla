connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"stream\":true,\"tools\":[{\"type\":\"web_search\"}],\"input\":[{\"role\":\"user\",\"content\":\"In one sentence, what is one recent headline in technology news?\"}],\"stream_options\":{\"include_obfuscation\":false}}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "text/event-stream")
                           .build()}

read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":0,\"type\":\"response.created\"}"
read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[],\"status\":\"in_progress\"},\"sequence_number\":1,\"type\":\"response.in_progress\"}"
read "{\"item\":{\"id\":\"ws_1\",\"status\":\"in_progress\",\"type\":\"web_search_call\"},\"output_index\":0,\"sequence_number\":2,\"type\":\"response.output_item.added\"}"
read "{\"item_id\":\"ws_1\",\"output_index\":0,\"sequence_number\":3,\"type\":\"response.web_search_call.in_progress\"}"
read "{\"item_id\":\"ws_1\",\"output_index\":0,\"sequence_number\":4,\"type\":\"response.web_search_call.searching\"}"
read "{\"item_id\":\"ws_1\",\"output_index\":0,\"sequence_number\":5,\"type\":\"response.web_search_call.completed\"}"
read "{\"item\":{\"action\":{\"queries\":[\"latest technology news headline\"],\"query\":\"latest technology news headline\",\"type\":\"search\"},\"id\":\"ws_1\",\"status\":\"completed\",\"type\":\"web_search_call\"},\"output_index\":0,\"sequence_number\":6,\"type\":\"response.output_item.done\"}"
read "{\"item\":{\"content\":[],\"id\":\"msg_2\",\"role\":\"assistant\",\"status\":\"in_progress\",\"type\":\"message\"},\"output_index\":1,\"sequence_number\":7,\"type\":\"response.output_item.added\"}"
read "{\"content_index\":0,\"item_id\":\"msg_2\",\"output_index\":1,\"part\":{\"annotations\":[],\"logprobs\":[],\"text\":\"\",\"type\":\"output_text\"},\"sequence_number\":8,\"type\":\"response.content_part.added\"}"
read "{\"content_index\":0,\"delta\":\"Apple and Meta announced a partnership.\",\"item_id\":\"msg_2\",\"logprobs\":[],\"output_index\":1,\"sequence_number\":9,\"type\":\"response.output_text.delta\"}"
read "{\"content_index\":0,\"item_id\":\"msg_2\",\"logprobs\":[],\"output_index\":1,\"sequence_number\":10,\"text\":\"Apple and Meta announced a partnership.\",\"type\":\"response.output_text.done\"}"
read "{\"content_index\":0,\"item_id\":\"msg_2\",\"output_index\":1,\"part\":{\"annotations\":[],\"logprobs\":[],\"text\":\"Apple and Meta announced a partnership.\",\"type\":\"output_text\"},\"sequence_number\":11,\"type\":\"response.content_part.done\"}"
read "{\"item\":{\"content\":[{\"annotations\":[],\"logprobs\":[],\"text\":\"Apple and Meta announced a partnership.\",\"type\":\"output_text\"}],\"id\":\"msg_2\",\"role\":\"assistant\",\"status\":\"completed\",\"type\":\"message\"},\"output_index\":1,\"sequence_number\":12,\"type\":\"response.output_item.done\"}"
read "{\"response\":{\"id\":\"resp_1\",\"model\":\"gpt-4\",\"object\":\"response\",\"output\":[{\"action\":{\"queries\":[\"latest technology news headline\"],\"query\":\"latest technology news headline\",\"type\":\"search\"},\"id\":\"ws_1\",\"status\":\"completed\",\"type\":\"web_search_call\"},{\"content\":[{\"annotations\":[],\"logprobs\":[],\"text\":\"Apple and Meta announced a partnership.\",\"type\":\"output_text\"}],\"id\":\"msg_2\",\"role\":\"assistant\",\"status\":\"completed\",\"type\":\"message\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}},\"sequence_number\":13,\"type\":\"response.completed\"}"

read closed
