property source "source"
property target "target"
property model "model"

accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect(source)
                           .model(model)
                           .build()}

connected

read advise zilla:challenge ${llm:challengeEx()
                                .typeId(zilla:id("llm"))
                                .dialect(target)
                                .build()}

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
read "{\"text\":\"Hello\"}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "get_weather")
                          .build()}
read "{\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"description\":\"Get the weather\"}}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("SYSTEM_INSTRUCTION")
                          .message(-1)
                          .build()}
read "{\"text\":\"You are helpful.\"}"

write zilla:reset.ext ${llm:resetEx()
                            .typeId(zilla:id("llm"))
                            .status(400)
                            .type("invalid_request_error")
                            .message("system-instruction cannot be converted from %s to %s after tool-definition".formatted(source, target))
                            .build()}

read abort
