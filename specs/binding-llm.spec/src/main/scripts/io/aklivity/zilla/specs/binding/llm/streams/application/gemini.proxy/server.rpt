property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"
accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("gemini")
                          .build()}

connected

read '{"contents":[{"role":"user","parts":[{"text":"Hello"}]}]}'

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("gemini")
                           .contentType("application/json")
                           .build()}
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write '{"candidates":[{"content":{"parts":[{"text":"Hello! How can I help you today?"}],"role":"model"},"finishReason":"STOP","index":0}],"usageMetadata":{"promptTokenCount":25,"candidatesTokenCount":15,"totalTokenCount":40},"modelVersion":"gemini-a","responseId":"resp_02"}'
write flush

write close

read closed
