connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/rs")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"stream\":true}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "code_interpreter")
                          .build()}
write "{\"type\":\"code_interpreter\",\"container\":{\"type\":\"auto\"}}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Use python to compute 17 * 23 and tell me the result.\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("CONTROL")
                          .message(-1)
                          .build()}
write "{\"stream_options\":{\"openai:include_obfuscation\":false,\"include_usage\":true}}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/rs")
                          .model("gpt-4")
                          .id("resp_1")
                          .build()}

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("SERVER_TOOL_CALL")
                         .message(0)
                         .attribute("tool-name", "code_interpreter")
                         .attribute("tool-call-id", "ci_1")
                         .extension("code_interpreter_call")
                         .build()}
read "{\"arguments\":{\"code\":\"result = 17 * 23\\nresult\",\"container_id\":\"cntr_1\"}}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("SERVER_TOOL_RESULT")
                         .message(0)
                         .attribute("tool-call-id", "ci_1")
                         .extension("code_interpreter_call")
                         .build()}
read "{\"outputs\":[{\"logs\":\"391\",\"type\":\"logs\"}]}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("ASSISTANT_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"The result of 17 multiplied by 23 is 391.\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}}"

read zilla:end.ext ${llm:matchEndEx()
                        .typeId(zilla:id("llm"))
                        .inputTokens(25)
                        .outputTokens(15)
                        .totalTokens(40)
                        .finishReason("stop")
                        .build()}

read closed

write close
