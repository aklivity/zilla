property source "source"
property target "target"
property model "model"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect(source)
                           .model(model)
                           .build()}

connected

write advised zilla:challenge ${llm:matchChallengeEx()
                                    .typeId(zilla:id("llm"))
                                    .dialect(target)
                                    .build()}

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "get_weather")
                          .build()}
write "{\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"description\":\""
      ${core:randomBase64(100000)}
      "\",\"parameters\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}}}}}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "Weather in Paris?"
write flush

write advise zilla:flush

read zilla:reset.ext ${llm:matchResetEx()
                           .typeId(zilla:id("llm"))
                           .status(429)
                           .type("rate_limit_error")
                           .message("Rate limit exceeded")
                           .build()}

write aborted
