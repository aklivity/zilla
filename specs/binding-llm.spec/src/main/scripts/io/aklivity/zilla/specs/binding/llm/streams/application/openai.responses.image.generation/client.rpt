connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai/rs")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("SERVER_TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "image_generation")
                          .build()}
write "{\"type\":\"image_generation\",\"quality\":\"low\",\"size\":\"1024x1024\"}"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "{\"text\":\"Draw a small red circle on a white background.\"}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai/rs")
                          .model("gpt-4")
                          .id("resp_1")
                          .build()}

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("SERVER_TOOL_CALL")
                         .message(0)
                         .attribute("tool-name", "image_generation")
                         .attribute("tool-call-id", "ig_1")
                         .extension("image_generation_call")
                         .build()}
read "{\"arguments\":{\"action\":\"generate\",\"background\":\"opaque\",\"output_format\":\"png\",\"quality\":\"low\",\"result\":\""
      ${core:randomBase64(40000)}
      "\",\"revised_prompt\":\"A small red circle\",\"size\":\"1024x1024\"}}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("ASSISTANT_TEXT")
                         .message(0)
                         .build()}
read "{\"text\":\"Here is a small red circle.\"}"

read zilla:data.ext ${llm:matchDataEx()
                         .typeId(zilla:id("llm"))
                         .type("CONTROL")
                         .message(-1)
                         .build()}
read "{\"openai/rs:usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}}"

read zilla:end.ext ${llm:matchEndEx()
                        .typeId(zilla:id("llm"))
                        .inputTokens(25)
                        .outputTokens(15)
                        .totalTokens(40)
                        .finishReason("stop")
                        .build()}

read closed

write close
