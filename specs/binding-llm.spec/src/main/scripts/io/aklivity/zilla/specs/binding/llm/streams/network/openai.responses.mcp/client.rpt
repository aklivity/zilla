connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/responses")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"gpt-4\",\"tools\":[{\"type\":\"mcp\",\"server_label\":\"deepwiki\",\"server_url\":\"https://mcp.deepwiki.com/mcp\",\"require_approval\":\"never\"}],\"input\":[{\"role\":\"user\",\"content\":\"Use deepwiki to say in one word the main programming language of aklivity/zilla.\"}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}

read "{\"id\":\"resp_1\",\"object\":\"response\",\"model\":\"gpt-4\",\"output\":[{\"id\":\"mcpl_1\",\"type\":\"mcp_list_tools\",\"server_label\":\"deepwiki\",\"tools\":[{\"annotations\":{\"read_only\":false},\"description\":\"Ask a question about a repository\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\"}},\"required\":[\"question\"]},\"name\":\"ask_wiki_question\"}],\"status\":\"completed\"},{\"id\":\"mcp_2\",\"type\":\"mcp_call\",\"arguments\":\"{\\\"question\\\":\\\"main language?\\\"}\",\"approval_request_id\":null,\"name\":\"ask_wiki_question\",\"error\":null,\"output\":\"Java\",\"server_label\":\"deepwiki\",\"status\":\"completed\"},{\"id\":\"msg_3\",\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"logprobs\":[],\"text\":\"Java\"}],\"role\":\"assistant\",\"status\":\"completed\"}],\"status\":\"completed\",\"usage\":{\"input_tokens\":25,\"output_tokens\":15,\"total_tokens\":40}}"

read closed
