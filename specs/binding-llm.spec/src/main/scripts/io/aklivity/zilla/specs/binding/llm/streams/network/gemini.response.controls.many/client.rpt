connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1beta/models/gemini-3.6-flash:generateContent")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"Hello\"}]}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}

read "{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"Hello! How can I help you today?\"}],\"role\":\"model\"},\"finishReason\":\"STOP\",\"finishMessage\":\"Done.\",\"index\":0}],\"usageMetadata\":{\"promptTokenCount\":8,\"candidatesTokenCount\":9,\"totalTokenCount\":17},\"promptFeedback\":{\"blockReason\":\"OTHER\"},\"m01\":1,\"m02\":\"two\",\"m03\":[3],\"m04\":true,\"m05\":null,\"m06\":{\"k\":\"v\"},\"m07\":7.5,\"m08\":\"eight\",\"m09\":9,\"m10\":\"ten\",\"m11\":11,\"m12\":\"twelve\",\"m13\":[13],\"m14\":false,\"m15\":15,\"m16\":\"sixteen\",\"big1\":\""
     ${core:randomBase64(1000)}
     "\",\"big2\":\""
     ${core:randomBase64(1001)}
     "\",\"big3\":\""
     ${core:randomBase64(1002)}
     "\",\"modelVersion\":\"gemini-3.6-flash\",\"responseId\":\"resp_01\"}"

read closed
