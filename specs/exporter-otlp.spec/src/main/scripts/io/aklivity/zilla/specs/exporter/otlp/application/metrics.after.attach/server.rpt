accept "http://localhost:4318/v1/metrics"
accepted
connected

read http:method "POST"
read http:version "HTTP/1.1"
read http:header "Host" "localhost:4318"
read http:header "Content-Length" /(?<length>.*)/
read '{"resourceMetrics":[{"resource":{"attributes":[{"key":"service.namespace","value":{"stringValue":"example"}}]},'
read /.*/
read closed

write http:status "200" "OK"
write close
