connect "http://localhost:4318/v1/metrics"
connected

write http:method "POST"
write http:version "HTTP/1.1"
write http:header "Host" "localhost:4318"
write http:header "Content-Length" "204"
write '{"resourceMetrics":[{"resource":{"attributes":[{"key":"service.namespace","value":{"stringValue":"example"}}]},"scopeMetrics":[{"scope":{"name":"OtlpMetricsSerializer","version":"1.0.0"},"metrics":[]}]}]}'
write close

read http:status "200" "OK"
