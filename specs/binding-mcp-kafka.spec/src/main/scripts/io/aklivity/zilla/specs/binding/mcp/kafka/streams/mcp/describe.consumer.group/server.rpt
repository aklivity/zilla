property serverAddress "zilla://streams/mcp0"
property authorization 0L

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"
       option zilla:authorization ${authorization}

accepted

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .build()
                          .build()}

connected

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .sessionId("session-1")
                               .build()
                           .build()}
write flush

accepted

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .toolsCall()
                              .sessionId("session-1")
                              .name("describe_consumer_group")
                              .contentLength(70)
                              .build()
                          .build()}

connected

read '{"name":"describe_consumer_group","arguments":{"group_id":"my-group"}}'

write flush

write '{"structuredContent":{"group_id":"my-group","state":"Stable","members":'
      '[{"member_id":"consumer-1-abc","client_id":"consumer-1","assignments":'
      '[{"topic":"my-topic","partition":0}]}]},'
      '"content":[{"type":"text","text":"Consumer group my-group is Stable"}],"isError":false}'
write flush

write close

read closed
