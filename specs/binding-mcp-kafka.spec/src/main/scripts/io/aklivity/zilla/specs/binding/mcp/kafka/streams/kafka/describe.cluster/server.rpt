property serverAddress "zilla://streams/kafka0"

accept ${serverAddress}
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(3)
                                 .api(60)
                                 .version(0)
                                 .clientId("zilla")
                                 .build()
                                .build()}

connected

read  [0x00]                            # tagged fields
      [0x01]                            # include authorized operations
      [0x00]                            # tagged fields

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(70)
                                 .version(0)
                                 .build()
                                .build()}

write [0x00]                             # tagged fields
      0                                  # throttle time ms
      0s                                 # error code
      [0x00]                             # error message
      [0x0a] "cluster-1"                 # cluster id
      1                                  # controller id
      [0x03]                             # brokers
        1                                 # broker id
        [0x08] "broker1"                  # host
        9092                              # port
        [0x00]                            # rack
        [0x00]                            # tagged fields
        2                                 # broker id
        [0x08] "broker2"                  # host
        9093                              # port
        [0x07] "rack-a"                   # rack
        [0x00]                            # tagged fields
      3                                  # cluster authorized operations
      [0x00]                             # tagged fields

write flush

read closed
write close
