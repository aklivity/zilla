connect "zilla://streams/kafka0"
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(15)
                                 .api(29)
                                 .version(2)
                                 .clientId("zilla")
                                 .build()
                                .build()}

write advised zilla:challenge ${kafka:matchChallengeEx()
                                  .typeId(zilla:id("kafka"))
                                  .apiChallenge()
                                      .versions(0, 2)
                                      .build()
                                  .build()}

connected

write advise zilla:flush ${kafka:flushEx()
                              .typeId(zilla:id("kafka"))
                              .apiFlush()
                                  .version(2)
                                  .build()
                              .build()}

write [0x00]                            # tagged fields
      [0x02]                            # resource type filter (topic)
      [0x07] "events"                   # resource name filter
      [0x01]                            # pattern type filter (any)
      [0x00]                            # principal filter (null)
      [0x00]                            # host filter (null)
      [0x01]                            # operation (any)
      [0x01]                            # permission type (any)
      [0x00]                            # tagged fields

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(51)
                                 .version(2)
                                 .build()
                                .build()}

read  [0x00]                             # tagged fields
      0                                  # throttle time ms
      0s                                 # error code
      [0x00]                             # error message
      [0x02]                             # resources
        [0x02]                           # resource type (topic)
        [0x07] "events"                  # resource name
        [0x03]                           # pattern type (literal)
        [0x03]                           # acls
          [0x0b] "User:alice"             # principal
          [0x02] "*"                      # host
          [0x03]                          # operation (read)
          [0x03]                          # permission type (allow)
          [0x00]                          # tagged fields (acl)
          [0x09] "User:bob"               # principal
          [0x02] "*"                      # host
          [0x04]                          # operation (write)
          [0x02]                          # permission type (deny)
          [0x00]                          # tagged fields (acl)
        [0x00]                            # tagged fields (resource)
      [0x00]                              # tagged fields

write close
read closed
