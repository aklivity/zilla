connect "zilla://streams/kafka0"
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(6)
                                 .api(3)
                                 .version(9)
                                 .clientId("zilla")
                                 .build()
                                .build()}

write advised zilla:challenge ${kafka:matchChallengeEx()
                                  .typeId(zilla:id("kafka"))
                                  .apiChallenge()
                                      .versions(0, 9)
                                      .build()
                                  .build()}

connected

write advise zilla:flush ${kafka:flushEx()
                              .typeId(zilla:id("kafka"))
                              .apiFlush()
                                  .version(9)
                                  .build()
                              .build()}

write [0x00]                            # tagged fields
      [0x00]                            # topic count (null = all topics)
      [0x00]                            # allow auto topic creation
      [0x00]                            # include cluster authorized operations
      [0x00]                            # include topic authorized operations
      [0x00]                            # tagged fields

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(91)
                                 .version(9)
                                 .build()
                                .build()}

read  [0x00]                            # tagged fields
      0                                 # throttle time ms
      [0x02]                            # broker count
        1                               # node id
        [0x0a] "localhost"              # host
        9092                            # port
        [0x00]                          # rack (null)
        [0x00]                          # tagged fields
      [0x0d] "test-cluster"             # cluster id
      1                                 # controller id
      [0x02]                            # topic count
        0s                              # error code
        [0x07] "events"                 # topic name
        [0x00]                          # is internal
        [0x02]                          # partition count
          0s                            # error code
          0                             # partition id
          1                             # leader
          0                             # leader epoch
          [0x02]                        # replica count
            1                           # replica
          [0x02]                        # isr count
            1                           # isr
          [0x01]                        # offline replica count
          [0x00]                        # tagged fields
        0                               # topic authorized operations
        [0x00]                          # tagged fields
      0                                 # cluster authorized operations
      [0x00]                            # tagged fields

write close
read closed
