connect "zilla://streams/kafka0"
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(53)
                                 .api(2)
                                 .version(6)
                                 .clientId("zilla")
                                 .build()
                                .build()}

connected

write [0x00]                            # request header tagged fields
      [0xff 0xff 0xff 0xff]             # replica id (-1, consumer)
      [0x00]                            # isolation level (read uncommitted)
      [0x02]                            # topics
        [0x09] "my-topic"               # topic name
        [0x03]                          # partitions
          [0x00 0x00 0x00 0x00]                        # partition index 0
          [0xff 0xff 0xff 0xff]                        # current leader epoch (-1)
          [0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff]    # timestamp (-1, latest)
          [0x00]                                       # partition tagged fields
          [0x00 0x00 0x00 0x01]                        # partition index 1
          [0xff 0xff 0xff 0xff]                        # current leader epoch (-1)
          [0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff]    # timestamp (-1, latest)
          [0x00]                                       # partition tagged fields
        [0x00]                          # topic tagged fields
      [0x00]                            # tagged fields

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(72)
                                 .version(6)
                                 .build()
                                .build()}

read  [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x02]                             # topics
        [0x09] "my-topic"                # topic name
        [0x03]                           # partitions
          [0x00 0x00 0x00 0x00]                        # partition index 0
          0s                                           # error code
          [0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff]    # timestamp (-1)
          [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x64]    # end offset 100
          [0x00 0x00 0x00 0x05]                        # leader epoch 5
          [0x00]                                       # partition tagged fields
          [0x00 0x00 0x00 0x01]                        # partition index 1
          0s                                           # error code
          [0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff]    # timestamp (-1)
          [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x3c]    # end offset 60
          [0x00 0x00 0x00 0x05]                        # leader epoch 5
          [0x00]                                       # partition tagged fields
        [0x00]                           # topic tagged fields
      [0x00]                             # tagged fields

write close
read closed
