property serverAddress "zilla://streams/mcp0"
property authorization 0L

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"
       option zilla:authorization ${authorization}

accepted

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .build()
                          .build()}

connected

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .sessionId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                               .build()
                           .build()}
write flush

accepted

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .toolsCall()
                              .sessionId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                              .name("reset_offsets")
                              .contentLength(106)
                              .build()
                          .build()}

connected

read '{"name":"reset_offsets","arguments":{"group_id":"my-group","topic":"my-topic","partition":0,"offset":100}}'

write flush

write '{"structuredContent":{"group_id":"my-group","topic":"my-topic","partition":0,"offset":100,"reset":false},'
      '"content":[{"type":"text","text":"Group coordinator not found for my-group (error 15)"}],'
      '"isError":true}'
write flush

write close

read closed
