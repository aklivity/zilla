connect "zilla://streams/kafka0"
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(15)
                                 .api(32)
                                 .version(4)
                                 .clientId("zilla")
                                 .build()
                                .build()}

connected

write [0x00]                            # tagged fields
      [0x02]                            # resource count
        [0x02]                          # type (topic)
        [0x07] "events"                 # name
        [0x00]                          # config names (null = all)
        [0x00]                          # tagged fields
      [0x00]                            # include synonyms
      [0x00]                            # include documentation
      [0x00]                            # tagged fields

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(49)
                                 .version(4)
                                 .build()
                                .build()}

read  [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x02]                             # resources
        0s                               # error code
        [0x00]                           # error message
        [0x02]                           # type (topic)
        [0x07] "events"                  # name
        [0x02]                           # configs
          [0x0f] "cleanup.policy"         # config name
          [0x07] "delete"                 # config value
          [0x00]                          # read only
          [0x05]                          # config source (default)
          [0x01]                          # is sensitive
          [0x01]                          # synonyms
          [0x01]                          # config type (string)
          [0x00]                          # documentation
          [0x00]                          # tagged fields (config)
        [0x00]                            # tagged fields (resource)
      [0x00]                              # tagged fields

write close
read closed
