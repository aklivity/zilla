property serverAddress "zilla://streams/kafka0"

accept ${serverAddress}
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(27)
                                 .api(31)
                                 .version(2)
                                 .clientId("zilla")
                                 .build()
                                .build()}

read advise zilla:challenge ${kafka:challengeEx()
                                    .typeId(zilla:id("kafka"))
                                    .apiChallenge()
                                        .versions(0, 2)
                                        .build()
                                    .build()}

connected

read advised zilla:flush ${kafka:matchFlushEx()
                               .typeId(zilla:id("kafka"))
                               .apiFlush()
                                   .version(2)
                                   .build()
                               .build()}

read  [0x00]                            # tagged fields
      [0x02]                            # filters
        [0x02]                          # resource type filter (topic)
        [0x07] "events"                 # resource name filter
        [0x01]                          # pattern type filter (any)
        [0x0b] "User:alice"             # principal filter
        [0x00]                          # host filter (null)
        [0x01]                          # operation (any)
        [0x01]                          # permission type (any)
        [0x00]                          # tagged fields (filter)
      [0x00]                            # tagged fields

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(40)
                                 .version(2)
                                 .build()
                                .build()}

write [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x02]                             # filter results
        0s                               # error code
        [0x00]                           # error message
        [0x02]                           # matching acls
          0s                             # error code
          [0x00]                         # error message
          [0x02]                         # resource type (topic)
          [0x07] "events"                # resource name
          [0x03]                         # pattern type (literal)
          [0x0b] "User:alice"            # principal
          [0x02] "*"                     # host
          [0x03]                         # operation (read)
          [0x03]                         # permission type (allow)
          [0x00]                         # tagged fields (matching acl)
        [0x00]                           # tagged fields (filter result)
      [0x00]                             # tagged fields

write flush

read closed
write close
