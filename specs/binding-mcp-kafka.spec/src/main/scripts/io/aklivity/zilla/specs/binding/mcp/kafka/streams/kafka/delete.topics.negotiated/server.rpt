property serverAddress "zilla://streams/kafka0"

accept ${serverAddress}
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(58)
                                 .api(20)
                                 .version(6)
                                 .clientId("zilla")
                                 .build()
                                .build()}

read advise zilla:challenge ${kafka:challengeEx()
                                    .typeId(zilla:id("kafka"))
                                    .apiChallenge()
                                        .versions(0, 6)
                                        .build()
                                    .build()}

connected

read advised zilla:flush ${kafka:matchFlushEx()
                               .typeId(zilla:id("kafka"))
                               .apiFlush()
                                   .version(6)
                                   .build()
                               .build()}

read  [0x00]                            # tagged fields
      [0x03]                            # topic count
        [0x07] "events"                 # name
        [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00] # topic id
        [0x00]                          # tagged fields
        [0x0a] "snapshots"              # name
        [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00] # topic id
        [0x00]                          # tagged fields
      30000                             # timeout
      [0x00]                            # tagged fields

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(64)
                                 .version(6)
                                 .build()
                                .build()}

write [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x03]                             # topics
        [0x07] "events"                  # name
        [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00] # topic id
        0s                                # error code
        [0x00]                            # error message
        [0x00]                            # tagged fields
        [0x0a] "snapshots"                # name
        [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00] # topic id
        0s                                # error code
        [0x00]                            # error message
        [0x00]                            # tagged fields
      [0x00]                              # tagged fields

write flush

read closed
write close
