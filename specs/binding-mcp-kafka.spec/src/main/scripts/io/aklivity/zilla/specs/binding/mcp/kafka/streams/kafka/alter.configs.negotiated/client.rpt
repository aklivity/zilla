connect "zilla://streams/kafka0"
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(37)
                                 .api(33)
                                 .version(2)
                                 .clientId("zilla")
                                 .build()
                                .build()}

write advised zilla:challenge ${kafka:matchChallengeEx()
                                  .typeId(zilla:id("kafka"))
                                  .apiChallenge()
                                      .versions(0, 2)
                                      .build()
                                  .build()}

connected

write advise zilla:flush ${kafka:flushEx()
                              .typeId(zilla:id("kafka"))
                              .apiFlush()
                                  .version(2)
                                  .build()
                              .build()}

write [0x00]                            # tagged fields
      [0x02]                            # resource count
        [0x02]                          # type (topic)
        [0x07] "events"                 # name
        [0x02]                          # config count
          [0x0f] "cleanup.policy"        # config name
          [0x07] "delete"                # config value
          [0x00]                         # tagged fields
        [0x00]                           # tagged fields
      [0x00]                             # validate only
      [0x00]                             # tagged fields

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(19)
                                 .version(2)
                                 .build()
                                .build()}

read  [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x02]                             # resources
        0s                               # error code
        [0x00]                           # error message
        [0x02]                           # type (topic)
        [0x07] "events"                  # name
        [0x00]                           # tagged fields
      [0x00]                             # tagged fields

write close
read closed
