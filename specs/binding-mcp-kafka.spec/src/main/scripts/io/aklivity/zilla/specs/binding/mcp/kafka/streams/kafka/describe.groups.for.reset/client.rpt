connect "zilla://streams/kafka0"
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(12)
                                 .api(15)
                                 .version(5)
                                 .clientId("zilla")
                                 .build()
                                .build()}

connected

write [0x02]                            # group count
      [0x09] "my-group"                 # group id
      [0x00]                            # include authorized operations
      [0x00]                            # tagged fields

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(32)
                                 .version(5)
                                 .build()
                                .build()}

read  [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x02]                             # groups
        0s                               # error code
        [0x09] "my-group"                # group id
        [0x06] "Empty"                   # group state (no active members)
        [0x01]                           # protocol type (empty)
        [0x01]                           # protocol data (empty)
        [0x01]                           # members (none)
        [0xff 0xff 0xff 0xff]           # authorized operations (-1)
        [0x00]                           # group tagged fields
      [0x00]                             # tagged fields

write close
read closed
