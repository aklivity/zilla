connect "zilla://streams/kafka0"
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(12)
                                 .api(9)
                                 .version(6)
                                 .clientId("zilla")
                                 .build()
                                .build()}

connected

write [0x00]                            # request header tagged fields
      [0x09] "my-group"                 # group id
      [0x00]                            # topic count (null, all topics)
      [0x00]                            # tagged fields

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(60)
                                 .version(6)
                                 .build()
                                .build()}

read  [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x02]                             # topics
        [0x09] "my-topic"                # topic name
        [0x03]                           # partitions
          [0x00 0x00 0x00 0x00]                        # partition index 0
          [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x2a]    # committed offset 42
          [0x00 0x00 0x00 0x03]                        # committed leader epoch 3
          [0x00]                                       # metadata (null)
          0s                                           # error code
          [0x00]                                       # partition tagged fields
          [0x00 0x00 0x00 0x01]                        # partition index 1
          [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x0a]    # committed offset 10
          [0x00 0x00 0x00 0x03]                        # committed leader epoch 3
          [0x00]                                       # metadata (null)
          0s                                           # error code
          [0x00]                                       # partition tagged fields
        [0x00]                           # topic tagged fields
      0s                                 # group error code
      [0x00]                             # tagged fields

write close
read closed
