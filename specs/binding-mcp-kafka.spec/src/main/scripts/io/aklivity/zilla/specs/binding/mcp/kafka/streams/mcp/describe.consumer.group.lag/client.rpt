property authorization 0L

connect "zilla://streams/mcp0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .build()
                           .build()}

connected

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .sessionId("session-1")
                              .build()
                          .build()}

read notify LIFECYCLE_INITIALIZED

connect await LIFECYCLE_INITIALIZED
        "zilla://streams/mcp0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .toolsCall()
                               .sessionId("session-1")
                               .name("describe_consumer_group_lag")
                               .contentLength(74)
                               .build()
                           .build()}

connected

write '{"name":"describe_consumer_group_lag","arguments":{"group_id":"my-group"}}'

read '{"structuredContent":{"group_id":"my-group","partitions":'
     '[{"topic":"my-topic","partition":0,"committed_offset":42,"end_offset":100,"lag":58},'
     '{"topic":"my-topic","partition":1,"committed_offset":10,"end_offset":60,"lag":50}]},'
     '"content":[{"type":"text","text":"Consumer group my-group has total lag 108"}],"isError":false}'
read closed

write close
