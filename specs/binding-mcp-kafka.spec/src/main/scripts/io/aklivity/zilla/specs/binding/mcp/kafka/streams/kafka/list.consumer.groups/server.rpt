property serverAddress "zilla://streams/kafka0"

accept ${serverAddress}
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(3)
                                 .api(16)
                                 .version(4)
                                 .clientId("zilla")
                                 .build()
                                .build()}

connected

read  [0x00]                            # request header tagged fields
      [0x01]                            # states filter (empty compact array)
      [0x00]                            # tagged fields

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(35)
                                 .version(4)
                                 .build()
                                .build()}

write [0x00]                             # tagged fields
      0                                  # throttle time ms
      0s                                 # error code
      [0x02]                             # groups
        [0x09] "my-group"                # group id
        [0x09] "consumer"                # protocol type
        [0x07] "Stable"                  # group state
        [0x00]                           # tagged fields
      [0x00]                             # tagged fields

write flush

read closed
write close
