connect "zilla://streams/kafka0"
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(34)
                                 .api(33)
                                 .version(2)
                                 .clientId("zilla")
                                 .build()
                                .build()}

connected

write [0x00]                            # tagged fields
      [0x02]                            # resource count
        [0x04]                          # type (broker)
        [0x02] "0"                      # name
        [0x02]                          # config count
          [0x14] "log.retention.hours"   # config name
          [0x04] "168"                   # config value
          [0x00]                         # tagged fields
        [0x00]                           # tagged fields
      [0x00]                             # validate only
      [0x00]                             # tagged fields

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .apiResponse()
                                 .length(14)
                                 .version(2)
                                 .build()
                                .build()}

read  [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x02]                             # resources
        0s                               # error code
        [0x00]                           # error message
        [0x04]                           # type (broker)
        [0x02] "0"                       # name
        [0x00]                           # tagged fields
      [0x00]                             # tagged fields

write close
read closed
