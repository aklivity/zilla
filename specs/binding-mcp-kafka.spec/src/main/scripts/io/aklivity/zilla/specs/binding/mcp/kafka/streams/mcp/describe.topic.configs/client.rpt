property authorization 0L

connect "zilla://streams/mcp0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .lifecycle()
                               .build()
                           .build()}

connected

read zilla:begin.ext ${mcp:matchBeginEx()
                          .typeId(zilla:id("mcp"))
                          .lifecycle()
                              .sessionId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                              .build()
                          .build()}

read notify LIFECYCLE_INITIALIZED

connect await LIFECYCLE_INITIALIZED
        "zilla://streams/mcp0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${mcp:beginEx()
                           .typeId(zilla:id("mcp"))
                           .toolsCall()
                               .sessionId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                               .name("describe_topic_configs")
                               .contentLength(64)
                               .build()
                           .build()}

connected

write '{"name":"describe_topic_configs","arguments":{"topic":"events"}}'

read '{"structuredContent":{"configs":[{"name":"cleanup.policy","value":"delete","is_default":true,"is_sensitive":true}]},'
     '"content":[{"type":"text","text":"Described 1 config(s)"}],"isError":false}'
read closed

write close
