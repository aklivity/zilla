accept "http://localhost:3000/analyze"

accepted
connected

read http:method "POST"
read http:version "HTTP/1.1"
read http:header "Authorization" "Bearer test-key"
read http:header "Content-Type" "application/json"
read '{"text":"hello there, nothing sensitive here","language":"en","entities":["PERSON","EMAIL_ADDRESS"],"score_threshold":0.6}'
read closed

write http:status "200" "OK"
write http:header "Content-Type" "application/json"
write http:content-length
write '[]'
write close
