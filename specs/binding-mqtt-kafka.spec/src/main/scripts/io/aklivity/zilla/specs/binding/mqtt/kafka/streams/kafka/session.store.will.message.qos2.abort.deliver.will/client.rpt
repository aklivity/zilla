connect "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("PRODUCE_AND_FETCH")
                                .topic("mqtt-sessions")
                                .filter()
                                    .header("type", "will-signal")
                                    .build()
                                .filter()
                                    .header("type", "expiry-signal")
                                    .build()
                                .build()
                            .build()}

connected

write notify KAFKA_1

read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .fetch()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#will")
                               .header("type", "will-signal")
                               .build()
                           .build()}
read ${mqtt:sessionSignal()
           .will()
               .instanceId("zilla-1")
               .clientId("client-1")
               .delay(1000)
               .deliverAt(-1)
               .lifetimeId("1e6a1eb5-810a-459d-a12c-a6fa08f228d1")
               .willId("d252a6bd-abb5-446a-b0f7-d0a3d8c012e2")
               .build()
           .build()}

read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .fetch()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#will")
                               .header("type", "will-signal")
                               .build()
                           .build()}
read ${mqtt:sessionSignal()
           .will()
               .instanceId("zilla-1")
               .clientId("client-1")
               .delay(1000)
               .deliverAt(2000)
               .lifetimeId("1e6a1eb5-810a-459d-a12c-a6fa08f228d1")
               .willId("d252a6bd-abb5-446a-b0f7-d0a3d8c012e2")
               .build()
           .build()}

# cleanup will message and will signal, once the will message has been delivered
write await KAFKA_WILL_DELIVERED
write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#will-1e6a1eb5-810a-459d-a12c-a6fa08f228d1")
                               .hashKey("client-1")
                               .build()
                           .build()}
write zilla:data.null
write flush

write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#will")
                               .hashKey("client-1")
                               .header("type", "will-signal")
                               .build()
                           .build()}
write zilla:data.null
write flush


connect await KAFKA_1
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .describe()
                                .topic("mqtt-retained")
                                .config("cleanup.policy")
                                .build()
                            .build()}

read zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .describe()
                                .topic("mqtt-retained")
                                .config("cleanup.policy")
                                .build()
                            .build()}

connected

write notify KAFKA_2

read zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .describe()
                               .config("cleanup.policy", "compact")
                               .build()
                           .build()}

write close


connect await KAFKA_2
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("PRODUCE_AND_FETCH")
                                .topic("mqtt-sessions")
                                .filter()
                                    .key("client-1#will")
                                    .build()
                                .build()
                            .build()}

connected

write notify KAFKA_3

write close
read closed


connect await KAFKA_3
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .meta()
                                   .topic("mqtt-messages")
                                   .build()
                               .build()}

connected

write notify KAFKA_4

read zilla:data.ext ${kafka:dataEx()
                             .typeId(zilla:id("kafka"))
                             .meta()
                                 .partition(0, -2)
                                 .partition(1, -2)
                                 .build()
                             .build()}

write close


connect await KAFKA_4
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .meta()
                                   .topic("mqtt-retained")
                                   .build()
                               .build()}

connected

write notify KAFKA_5

read zilla:data.ext ${kafka:dataEx()
                             .typeId(zilla:id("kafka"))
                             .meta()
                                 .partition(0, -2)
                                 .build()
                             .build()}

write close


connect await KAFKA_5
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"
         option zilla:affinity 0x0000000000000000L

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .apiRequest()
                                .length(29)
                                .api(10)
                                .version(3)
                                .clientId("zilla")
                                .build()
                            .build()}

read zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .apiResponse()
                                .length(25)
                                .version(3)
                                .build()
                            .build()}

connected

write notify KAFKA_7

write [0x00]                                    # request header tagged fields
      [0x1a] "zilla:test-mqtt0-client-1"       # group id (key)
      [0x00]                                    # key type (group)
      [0x00]                                    # tagged fields
write flush

read [0x00]                                     # tagged fields
      [0x00 0x00 0x00 0x00]                     # throttle time ms
      [0x00 0x00]                               # error code
      [0x00]                                    # message (null)
      [0x00 0x00 0x00 0x02]                     # node id
      [0x08] "broker2"                          # host
      [0x00 0x00 0x23 0x84]                     # port
      [0x00]                                    # tagged fields

write close
read closed


connect await KAFKA_7
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .initProducerId()
                                .producerId(0)
                                .producerEpoch(0)
                                .build()
                            .build()}

read zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .initProducerId()
                                .producerId(1)
                                .producerEpoch(1)
                                .build()
                            .build()}

connected

write notify KAFKA_8

write close
read closed


connect await KAFKA_8
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"
         option zilla:affinity 0x0000000000000002L

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .apiRequest()
                                .length(81)
                                .api(47)
                                .version(0)
                                .clientId("zilla")
                                .build()
                            .build()}

read zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .apiResponse()
                                .length(66)
                                .version(0)
                                .build()
                            .build()}

connected

write notify KAFKA_9

write [0x00 0x19] "zilla:test-mqtt0-client-1"  # group id
      [0x00 0x00 0x00 0x02]                     # topic count
        [0x00 0x0d] "mqtt-messages"             # topic name
        [0x00 0x00 0x00 0x02]                   # partition count
          [0x00 0x00 0x00 0x00]                 # partition index
          [0x00 0x00 0x00 0x01]                 # partition index
        [0x00 0x0d] "mqtt-retained"             # topic name
        [0x00 0x00 0x00 0x01]                   # partition count
          [0x00 0x00 0x00 0x00]                 # partition index
write flush

read [0x00 0x00]                                # error code
      [0x00 0x00 0x00 0x00]                     # throttle time ms
      [0x00 0x00 0x00 0x02]                     # topic count
        [0x00 0x0d] "mqtt-messages"             # topic name
        [0x00 0x00 0x00 0x02]                   # partition count
          [0x00 0x00 0x00 0x00] [0x00 0x00]     # partition index, error code
          [0x00 0x00 0x00 0x01] [0x00 0x00]     # partition index, error code
        [0x00 0x0d] "mqtt-retained"             # topic name
        [0x00 0x00 0x00 0x01]                   # partition count
          [0x00 0x00 0x00 0x00] [0x00 0x00]     # partition index, error code

write close
read closed


connect await KAFKA_9
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("PRODUCE_ONLY")
                                .topic("mqtt-sessions")
                                .filter()
                                    .key("client-1")
                                    .build()
                                .build()
                            .build()}

connected

write notify KAFKA_10

# will message for client-1
write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#will-1e6a1eb5-810a-459d-a12c-a6fa08f228d1")
                               .hashKey("client-1")
                               .build()
                           .build()}
write ${mqtt:will()
            .topic("obituaries")
            .delay(1)
            .expiryInterval(15)
            .format("TEXT")
            .responseTopic("responses/client1")
            .lifetimeId("1e6a1eb5-810a-459d-a12c-a6fa08f228d1")
            .willId("d252a6bd-abb5-446a-b0f7-d0a3d8c012e2")
            .correlation("info")
            .payloadSize(30)
      .build()}
write "client-1 disconnected abruptly"
write flush

# will signal for client-1, deliver later
write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#will")
                               .hashKey("client-1")
                               .header("type", "will-signal")
                               .build()
                           .build()}
write ${mqtt:sessionSignal()
            .will()
                .instanceId("zilla-1")
                .clientId("client-1")
                .delay(1000)
                .deliverAt(-1)
                .lifetimeId("1e6a1eb5-810a-459d-a12c-a6fa08f228d1")
                .willId("d252a6bd-abb5-446a-b0f7-d0a3d8c012e2")
                .build()
            .build()}
write flush

# will signal for client-1, deliver at (now + delay)
write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#will")
                               .hashKey("client-1")
                               .header("type", "will-signal")
                               .build()
                           .build()}
write ${mqtt:sessionSignal()
            .will()
                .instanceId("zilla-1")
                .clientId("client-1")
                .delay(1000)
                .deliverAt(2000)
                .lifetimeId("1e6a1eb5-810a-459d-a12c-a6fa08f228d1")
                .willId("d252a6bd-abb5-446a-b0f7-d0a3d8c012e2")
                .build()
            .build()}
write flush

write close
read closed


connect await KAFKA_10
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("FETCH_ONLY")
                                .topic("mqtt-sessions")
                                .filter()
                                    .key("client-1#will-1e6a1eb5-810a-459d-a12c-a6fa08f228d1")
                                    .build()
                                .build()
                            .build()}

connected

write notify KAFKA_11

read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .fetch()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#will-1e6a1eb5-810a-459d-a12c-a6fa08f228d1")
                               .build()
                           .build()}
read ${mqtt:will()
           .topic("obituaries")
           .delay(1)
           .expiryInterval(15)
           .format("TEXT")
           .responseTopic("responses/client1")
           .lifetimeId("1e6a1eb5-810a-459d-a12c-a6fa08f228d1")
           .willId("d252a6bd-abb5-446a-b0f7-d0a3d8c012e2")
           .correlation("info")
           .payloadSize(30)
       .build()}
read "client-1 disconnected abruptly"

write close
read closed


connect await KAFKA_11
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("PRODUCE_ONLY")
                                .topic("mqtt-messages")
                                .partition(-1, -2)
                                .ackMode("NONE")
                                .build()
                            .build()}

connected

# deliver will message for client-1
write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("obituaries")
                               .header("zilla:filter", "obituaries")
                               .headerInt("zilla:expiry", 15)
                               .header("zilla:format", "TEXT")
                               .header("zilla:reply-to", "mqtt-messages")
                               .header("zilla:reply-key", "responses/client1")
                               .header("zilla:reply-filter", "responses")
                               .header("zilla:reply-filter", "client1")
                               .header("zilla:correlation-id", "info")
                               .header("zilla:qos", "0")
                               .build()
                           .build()}
write "client-1 disconnected abruptly"
write flush
write notify KAFKA_WILL_DELIVERED

write close
read closed
