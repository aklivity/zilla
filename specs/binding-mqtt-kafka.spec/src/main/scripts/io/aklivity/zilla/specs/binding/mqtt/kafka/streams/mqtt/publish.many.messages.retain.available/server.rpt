accept "zilla://streams/mqtt0"
        option zilla:window 8192
        option zilla:transmission "duplex"

accepted

read zilla:begin.ext ${mqtt:matchBeginEx()
                             .typeId(zilla:id("mqtt"))
                             .publish()
                               .clientId("client")
                               .topic("sensor/one")
                               .flags("RETAIN")
                               .build()
                             .build()}

connected

read zilla:data.ext ${mqtt:matchDataEx()
                            .typeId(zilla:id("mqtt"))
                            .publish()
                              .format("TEXT")
                              .build()
                            .build()}

read ""

