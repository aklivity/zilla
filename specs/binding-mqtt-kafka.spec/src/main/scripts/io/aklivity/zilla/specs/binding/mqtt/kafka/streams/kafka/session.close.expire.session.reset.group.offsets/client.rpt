connect "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("PRODUCE_AND_FETCH")
                                .topic("mqtt-sessions")
                                .filter()
                                    .header("type", "will-signal")
                                    .build()
                                .filter()
                                    .header("type", "expiry-signal")
                                    .build()
                                .build()
                            .build()}

connected

read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .fetch()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
read zilla:data.null

read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .fetch()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
read ${mqtt:sessionSignal()
            .expiry()
                .instanceId("zilla-1")
                .clientId("client-1")
                .delay(0)
                .expireAt(-1)
                .build()
            .build()}

read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .fetch()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
read ${mqtt:sessionSignal()
            .expiry()
                .instanceId("zilla-1")
                .clientId("client-1")
                .delay(0)
                .expireAt(1000)
                .build()
            .build()}

read notify RECEIVED_WILL_DELIVER_AT_SIGNAL

write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1")
                               .hashKey("client-1")
                               .build()
                           .build()}
write flush

write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#offsets")
                               .hashKey("client-1")
                               .build()
                           .build()}
write flush
write notify RESET_STARTED


connect
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .describe()
                                .topic("mqtt-retained")
                                .config("cleanup.policy")
                                .build()
                            .build()}

read zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .describe()
                                .topic("mqtt-retained")
                                .config("cleanup.policy")
                                .build()
                            .build()}

connected

read zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .describe()
                               .config("cleanup.policy", "compact")
                               .build()
                           .build()}

write close


connect
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("PRODUCE_AND_FETCH")
                                .topic("mqtt-sessions")
                                .filter()
                                    .key("client-1")
                                    .build()
                                .build()
                            .build()}

connected

# will delivery cancellation signal for client-1
write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#will")
                               .hashKey("client-1")
                               .header("type", "will-signal")
                               .build()
                           .build()}
write flush

write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .hashKey("client-1")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
write flush

write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .hashKey("client-1")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
write ${mqtt:sessionSignal()
            .expiry()
                .instanceId("zilla-1")
                .clientId("client-1")
                .delay(0)
                .expireAt(-1)
                .build()
            .build()}

# no will signals
# no session state
read advised zilla:flush

write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .hashKey("client-1")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
write ${mqtt:sessionSignal()
            .expiry()
               .instanceId("zilla-1")
               .clientId("client-1")
               .delay(0)
               .expireAt(1000)
               .build()
            .build()}
write flush

write close
read closed



connect await RESET_STARTED
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .meta()
                                   .topic("mqtt-messages")
                                   .build()
                               .build()}
connected

read zilla:data.ext ${kafka:dataEx()
                              .typeId(zilla:id("kafka"))
                              .meta()
                                  .partition(0, -2)
                                  .partition(1, -2)
                                  .build()
                              .build()}
read notify RECEIVED_MESSAGES_PARTITIONS

write close


connect await RECEIVED_MESSAGES_PARTITIONS
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .meta()
                                   .topic("mqtt-retained")
                                   .build()
                               .build()}
connected

read zilla:data.ext ${kafka:dataEx()
                              .typeId(zilla:id("kafka"))
                              .meta()
                                  .partition(0, -2)
                                  .build()
                              .build()}
read notify RECEIVED_PARTITION_METADATA

write close


connect await RECEIVED_PARTITION_METADATA
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .apiRequest()
                                .length(29)
                                .api(10)
                                .version(3)
                                .clientId("zilla")
                                .build()
                            .build()}

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .apiResponse()
                                .length(25)
                                .version(3)
                                .build()
                            .build()}

write advised zilla:challenge ${kafka:matchChallengeEx()
                                  .typeId(zilla:id("kafka"))
                                  .apiChallenge()
                                      .versions(0, 3)
                                      .build()
                                  .build()}

connected

write advise zilla:flush ${kafka:flushEx()
                              .typeId(zilla:id("kafka"))
                              .apiFlush()
                                  .version(3)
                                  .build()
                              .build()}

write [0x00]                                    # request header tagged fields
      [0x1a] "zilla:test-mqtt0-client-1"       # group id (key)
      [0x00]                                    # key type (group)
      [0x00]                                    # tagged fields

read [0x00]                                    # tagged fields
      [0x00 0x00 0x00 0x00]                     # throttle time ms
      [0x00 0x00]                               # error code
      [0x00]                                    # message (null)
      [0x00 0x00 0x00 0x02]                     # node id
      [0x08] "broker2"                          # host
      [0x00 0x00 0x23 0x84]                     # port
      [0x00]                                    # tagged fields
read notify RECEIVED_COORDINATOR

write close
read closed


connect await RECEIVED_COORDINATOR
        "zilla://streams/kafka0"
         option zilla:window 8192
         option zilla:affinity 0x0000000000000002L
         option zilla:transmission "duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .apiRequest()
                                .length(81)
                                .api(47)
                                .version(0)
                                .clientId("zilla")
                                .build()
                            .build()}

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .apiResponse()
                                .length(66)
                                .version(0)
                                .build()
                            .build()}

write advised zilla:challenge ${kafka:matchChallengeEx()
                                  .typeId(zilla:id("kafka"))
                                  .apiChallenge()
                                      .versions(0, 0)
                                      .build()
                                  .build()}

connected

write advise zilla:flush ${kafka:flushEx()
                              .typeId(zilla:id("kafka"))
                              .apiFlush()
                                  .version(0)
                                  .build()
                              .build()}

write [0x00 0x19] "zilla:test-mqtt0-client-1"  # group id
      [0x00 0x00 0x00 0x02]                     # topic count
        [0x00 0x0d] "mqtt-messages"             # topic name
        [0x00 0x00 0x00 0x02]                   # partition count
          [0x00 0x00 0x00 0x00]                 # partition index
          [0x00 0x00 0x00 0x01]                 # partition index
        [0x00 0x0d] "mqtt-retained"             # topic name
        [0x00 0x00 0x00 0x01]                   # partition count
          [0x00 0x00 0x00 0x00]                 # partition index

read [0x00 0x00]                               # error code
      [0x00 0x00 0x00 0x00]                     # throttle time ms
      [0x00 0x00 0x00 0x02]                     # topic count
        [0x00 0x0d] "mqtt-messages"             # topic name
        [0x00 0x00 0x00 0x02]                   # partition count
          [0x00 0x00 0x00 0x00] [0x00 0x00]     # partition index, error code
          [0x00 0x00 0x00 0x01] [0x00 0x00]     # partition index, error code
        [0x00 0x0d] "mqtt-retained"             # topic name
        [0x00 0x00 0x00 0x01]                   # partition count
          [0x00 0x00 0x00 0x00] [0x00 0x00]     # partition index, error code
read notify RECEIVED_GROUP_OFFSETS_RESET

write close
read closed