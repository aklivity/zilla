accept "zilla://streams/kafka0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .groupId("zilla.test-mqtt0.share.consumers.c2Vuc29yL29uZQ.0")
                                .topic("mqtt-messages")
                                .filter()
                                    .headers("zilla:filter")
                                        .sequence("sensor")
                                        .sequence("one")
                                        .build()
                                    .build()
                                .build()
                            .build()}

connected

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .groupId("zilla.test-mqtt0.share.consumers.c2Vuc29yL29uZQ.0")
                                .topic("mqtt-messages")
                                .host("broker1.example.com")
                                .port(9092)
                                .build()
                            .build()}
write flush

read closed
write close

accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("FETCH_ONLY")
                                .topic("mqtt-messages")
                                .partition(0, 5, -2)
                                .build()
                            .build()}

connected

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("FETCH_ONLY")
                                .topic("mqtt-messages")
                                .partition(0, 5, 6, 6)
                                .build()
                            .build()}
write flush

write option zilla:flags "init"
write zilla:data.ext ${kafka:dataEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .fetch()
                                    .deferred(3)
                                    .timestamp(kafka:timestamp())
                                    .partition(0, 5, 6)
                                    .key("sensor/one")
                                    .header("zilla:filter", "sensor")
                                    .header("zilla:filter", "one")
                                    .header("zilla:format", "TEXT")
                                    .header("zilla:qos", "2")
                                    .build()
                                .build()}
write "mess"
write flush

write option zilla:flags "fin"
write zilla:data.ext ${kafka:dataEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .fetch()
                                    .header("zilla:filter", "sensor")
                                    .header("zilla:filter", "one")
                                    .header("zilla:format", "TEXT")
                                    .header("zilla:qos", "2")
                                    .build()
                                .build()}
write "age"
write flush

read closed
write aborted
