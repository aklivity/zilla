accept "zilla://streams/kafka0"
        option zilla:window 8192
        option zilla:transmission "duplex"


accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("PRODUCE_AND_FETCH")
                                .topic("mqtt-sessions")
                                .filter()
                                    .header("type", "will-signal")
                                    .build()
                                .filter()
                                    .header("type", "expiry-signal")
                                    .build()
                                .build()
                            .build()}

connected

# expiry signal for client-1, expire at (now + delay)
write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .fetch()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
write ${mqtt:sessionSignal()
            .expiry()
                .instanceId("zilla-1")
                .clientId("client-1")
                .delay(0)
                .expireAt(1000)
                .build()
            .build()}
write flush

# cleanup session state
read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1")
                               .hashKey("client-1")
                               .build()
                           .build()}
read zilla:data.null

# cleanup session offsets
read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#offsets")
                               .hashKey("client-1")
                               .build()
                           .build()}
read zilla:data.null



accepted

read zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .meta()
                                   .topic("mqtt-messages")
                                   .build()
                               .build()}

connected

write zilla:data.ext ${kafka:dataEx()
                             .typeId(zilla:id("kafka"))
                             .meta()
                                 .partition(0, -2)
                                 .partition(1, -2)
                                 .build()
                             .build()}
write flush

read closed
write close


accepted

read zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .meta()
                                   .topic("mqtt-retained")
                                   .build()
                               .build()}

connected

write zilla:data.ext ${kafka:dataEx()
                             .typeId(zilla:id("kafka"))
                             .meta()
                                 .partition(0, -2)
                                 .build()
                             .build()}
write flush

read closed
write close


accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .apiRequest()
                                .length(29)
                                .api(10)
                                .version(3)
                                .clientId("zilla")
                                .build()
                            .build()}

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .apiResponse()
                                .length(25)
                                .version(3)
                                .build()
                            .build()}

read advise zilla:challenge ${kafka:challengeEx()
                                  .typeId(zilla:id("kafka"))
                                  .apiChallenge()
                                      .versions(0, 3)
                                      .build()
                                  .build()}

connected

read option zilla:affinity 0x0000000000000000L
read advised zilla:flush ${kafka:matchFlushEx()
                              .typeId(zilla:id("kafka"))
                              .apiFlush()
                                  .version(3)
                                  .build()
                              .build()}

read [0x00]                                    # request header tagged fields
      [0x1a] "zilla:test-mqtt0-client-1"       # group id (key)
      [0x00]                                    # key type (group)
      [0x00]                                    # tagged fields

write [0x00]                                    # tagged fields
      [0x00 0x00 0x00 0x00]                     # throttle time ms
      [0x00 0x00]                               # error code
      [0x00]                                    # message (null)
      [0x00 0x00 0x00 0x02]                     # node id
      [0x08] "broker2"                          # host
      [0x00 0x00 0x23 0x84]                     # port
      [0x00]                                    # tagged fields

write flush

read closed
write close


accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .apiRequest()
                                .length(81)
                                .api(47)
                                .version(0)
                                .clientId("zilla")
                                .build()
                            .build()}

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .apiResponse()
                                .length(66)
                                .version(0)
                                .build()
                            .build()}

read advise zilla:challenge ${kafka:challengeEx()
                                  .typeId(zilla:id("kafka"))
                                  .apiChallenge()
                                      .versions(0, 0)
                                      .build()
                                  .build()}

connected

read option zilla:affinity 0x0000000000000002L
read advised zilla:flush ${kafka:matchFlushEx()
                              .typeId(zilla:id("kafka"))
                              .apiFlush()
                                  .version(0)
                                  .build()
                              .build()}

read [0x00 0x19] "zilla:test-mqtt0-client-1"  # group id
      [0x00 0x00 0x00 0x02]                     # topic count
        [0x00 0x0d] "mqtt-messages"             # topic name
        [0x00 0x00 0x00 0x02]                   # partition count
          [0x00 0x00 0x00 0x00]                 # partition index
          [0x00 0x00 0x00 0x01]                 # partition index
        [0x00 0x0d] "mqtt-retained"             # topic name
        [0x00 0x00 0x00 0x01]                   # partition count
          [0x00 0x00 0x00 0x00]                 # partition index
read notify OFFSET_DELETE_RECEIVED

write await CONNECT_SENT
write [0x00 0x00]                               # error code
      [0x00 0x00 0x00 0x00]                     # throttle time ms
      [0x00 0x00 0x00 0x02]                     # topic count
        [0x00 0x0d] "mqtt-messages"             # topic name
        [0x00 0x00 0x00 0x02]                   # partition count
          [0x00 0x00 0x00 0x00] [0x00 0x00]     # partition index, error code
          [0x00 0x00 0x00 0x01] [0x00 0x00]     # partition index, error code
        [0x00 0x0d] "mqtt-retained"             # topic name
        [0x00 0x00 0x00 0x01]                   # partition count
          [0x00 0x00 0x00 0x00] [0x00 0x00]     # partition index, error code

write flush

read closed
write close


accepted

read zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .describe()
                                .topic("mqtt-retained")
                                .config("cleanup.policy")
                                .build()
                            .build()}

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .describe()
                                .topic("mqtt-retained")
                                .config("cleanup.policy")
                                .build()
                            .build()}

connected

write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .describe()
                               .config("cleanup.policy", "compact")
                               .build()
                           .build()}
write flush

read closed
write close


accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("PRODUCE_AND_FETCH")
                                .topic("mqtt-sessions")
                                .filter()
                                    .key("client-1")
                                    .build()
                                .build()
                            .build()}

connected

# will delivery cancellation signal for client-1
read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#will")
                               .hashKey("client-1")
                               .header("type", "will-signal")
                               .build()
                           .build()}
read zilla:data.null
read notify RECEIVED_WILL_CANCELLATION_SIGNAL


# session expiry cancellation signal for client-1
read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .hashKey("client-1")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
read zilla:data.null
read notify RECEIVED_EXPIRY_CANCELLATION_SIGNAL

# expiry signal for client-1, deliver later
read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .hashKey("client-1")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
read ${mqtt:sessionSignal()
           .expiry()
               .instanceId("zilla-1")
               .clientId("client-1")
               .delay(0)
               .expireAt(-1)
               .build()
           .build()}


# no session state
# no migrate signals
write await CLOCK_RESET
write advise zilla:flush

# expiry signal for client-1, expire at (now + delay)
read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .hashKey("client-1")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
read ${mqtt:sessionSignal()
           .expiry()
               .instanceId("zilla-1")
               .clientId("client-1")
               .delay(0)
               .expireAt(1000)
               .build()
           .build()}

write notify RECEIVED_EXPIRE_AT_SIGNAL

read closed
write close
