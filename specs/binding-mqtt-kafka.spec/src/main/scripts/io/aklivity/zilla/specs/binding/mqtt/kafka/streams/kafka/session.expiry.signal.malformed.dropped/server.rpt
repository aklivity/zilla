property delayRemote 500L
property expireAtRemote ${mqtt:timestamp() + delayRemote}

accept "zilla://streams/kafka0"
        option zilla:window 8192
        option zilla:transmission "duplex"

accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("PRODUCE_AND_FETCH")
                                .topic("mqtt-sessions")
                                .filter()
                                    .header("type", "will-signal")
                                    .build()
                                .filter()
                                    .header("type", "expiry-signal")
                                    .build()
                                .build()
                            .build()}

connected

# malformed signal, instance id length overruns the record: dropped
write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .fetch()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-1#expiry")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
write [0x01 0xff 0x7f] "zilla-"
write flush

write option zilla:flags "auto"
write zilla:data.ext ${kafka:dataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .fetch()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-2#expiry")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
write ${mqtt:sessionSignal()
            .expiry()
                .instanceId("zilla-2")
                .clientId("client-2")
                .delay(500)
                .expireAt(expireAtRemote)
                .build()
            .build()}
write flush

# cleanup client-2
read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-2")
                               .hashKey("client-2")
                               .build()
                           .build()}
read zilla:data.null

read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-2#offsets")
                               .hashKey("client-2")
                               .build()
                           .build()}
read zilla:data.null

read zilla:data.ext ${kafka:matchDataEx()
                           .typeId(zilla:id("kafka"))
                           .merged()
                             .produce()
                               .deferred(0)
                               .partition(-1, -1)
                               .key("client-2#expiry")
                               .hashKey("client-2")
                               .header("type", "expiry-signal")
                               .build()
                           .build()}
read zilla:data.null
