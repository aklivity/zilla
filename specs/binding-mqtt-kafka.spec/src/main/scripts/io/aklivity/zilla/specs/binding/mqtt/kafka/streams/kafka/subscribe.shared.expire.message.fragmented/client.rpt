property deltaMillis 1000L
property timestamp ${kafka:timestamp() - deltaMillis}

connect "zilla://streams/kafka0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .groupId("zilla:test-mqtt0:share:consumers:c2Vuc29yL29uZQ:0")
                                .topic("mqtt-messages")
                                .filter()
                                    .headers("zilla:filter")
                                        .sequence("sensor")
                                        .sequence("one")
                                        .build()
                                    .build()
                                .build()
                            .build()}

connected

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .groupId("zilla:test-mqtt0:share:consumers:c2Vuc29yL29uZQ:0")
                                .topic("mqtt-messages")
                                .host("broker1.example.com")
                                .port(9092)
                                .build()
                            .build()}

read option zilla:flags "init"
read zilla:data.ext ${kafka:matchDataEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .deferred(2)
                                .partition(0, 5)
                                .key("sensor/one")
                                .build()
                            .build()}
read "expir"

read option zilla:flags "fin"
read zilla:data.ext ${kafka:matchDataEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .partition(0, 5)
                                .build()
                            .build()}
read "ed"

read option zilla:flags "auto"
read zilla:data.ext ${kafka:matchDataEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .partition(0, 6)
                                .key("sensor/one")
                                .header("zilla:filter", "sensor")
                                .header("zilla:filter", "one")
                                .header("zilla:format", "TEXT")
                                .build()
                            .build()}
read "message"

write advise zilla:flush ${kafka:flushEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .partition(0, 5)
                                .type("ACCEPT")
                                .build()
                            .build()}

write advise zilla:flush ${kafka:flushEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .partition(0, 6)
                                .type("ACCEPT")
                                .build()
                            .build()}

write close
read closed
