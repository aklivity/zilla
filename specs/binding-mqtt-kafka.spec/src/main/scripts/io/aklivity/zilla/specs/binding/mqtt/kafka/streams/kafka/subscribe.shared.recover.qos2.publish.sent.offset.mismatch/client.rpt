connect "zilla://streams/kafka0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .groupId("zilla.test-mqtt0.share.consumers.c2Vuc29yL29uZQ.0")
                                .topic("mqtt-messages")
                                .filter()
                                    .headers("zilla:filter")
                                        .sequence("sensor")
                                        .sequence("one")
                                        .build()
                                    .build()
                                .build()
                            .build()}

connected

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .groupId("zilla.test-mqtt0.share.consumers.c2Vuc29yL29uZQ.0")
                                .topic("mqtt-messages")
                                .host("broker1.example.com")
                                .port(9092)
                                .build()
                            .build()}
read notify SHARE_OPENED

read zilla:data.ext ${kafka:matchDataEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .partition(0, 6)
                                .key("sensor/one")
                                .header("zilla:filter", "sensor")
                                .header("zilla:filter", "one")
                                .header("zilla:format", "TEXT")
                                .header("zilla:qos", "2")
                                .build()
                            .build()}
read "update"

write advise zilla:flush ${kafka:flushEx()
                            .typeId(zilla:id("kafka"))
                            .share()
                                .partition(0, 6)
                                .type("ACCEPT")
                                .build()
                            .build()}

write close
read closed

connect await SHARE_OPENED "zilla://streams/kafka0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${kafka:beginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("FETCH_ONLY")
                                .topic("mqtt-messages")
                                .partition(0, 5)
                                .build()
                            .build()}

connected

read zilla:begin.ext ${kafka:matchBeginEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .capabilities("FETCH_ONLY")
                                .topic("mqtt-messages")
                                .partition(0, 5, 8, 8)
                                .build()
                            .build()}

read zilla:data.ext ${kafka:matchDataEx()
                            .typeId(zilla:id("kafka"))
                            .merged()
                                .fetch()
                                    .partition(0, 7, 8)
                                    .key("sensor/one")
                                    .header("zilla:filter", "sensor")
                                    .header("zilla:filter", "one")
                                    .header("zilla:format", "TEXT")
                                    .header("zilla:qos", "2")
                                    .build()
                                .build()}
read "message"

write close
read abort
