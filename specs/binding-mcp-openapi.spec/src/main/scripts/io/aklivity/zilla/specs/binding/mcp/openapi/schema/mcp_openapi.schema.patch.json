[
    {
        "op": "add",
        "path": "/$defs/binding/properties/type/enum/-",
        "value": "mcp_openapi"
    },
    {
        "op": "add",
        "path": "/$defs/binding/allOf/-",
        "value":
        {
            "if":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "mcp_openapi"
                    }
                }
            },
            "then":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "mcp_openapi"
                    },
                    "kind":
                    {
                        "enum": [ "client", "proxy" ]
                    },
                    "vault": false,
                    "entry": false,
                    "options":
                    {
                        "properties":
                        {
                            "authorization":
                            {
                                "title": "Authorization",
                                "type": "object",
                                "patternProperties":
                                {
                                    "^[A-Za-z0-9_-]+$":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "credentials":
                                            {
                                                "title": "Credentials",
                                                "type": "object",
                                                "properties":
                                                {
                                                    "headers":
                                                    {
                                                        "title": "Headers",
                                                        "type": "object",
                                                        "patternProperties":
                                                        {
                                                            "^[A-Za-z0-9:-]+$":
                                                            {
                                                                "type": "string"
                                                            }
                                                        },
                                                        "additionalProperties": false
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "additionalProperties": false,
                                "maxProperties": 1
                            },
                            "specs":
                            {
                                "title": "Specs",
                                "type": "object",
                                "patternProperties":
                                {
                                    "^[a-zA-Z]+[a-zA-Z0-9\\._\\-]*$":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "server":
                                            {
                                                "title": "Server",
                                                "type": "string"
                                            },
                                            "catalog":
                                            {
                                                "title": "Catalog",
                                                "type": "object",
                                                "patternProperties":
                                                {
                                                    "^[a-zA-Z]+[a-zA-Z0-9\\._\\-]*$":
                                                    {
                                                        "type": "object",
                                                        "properties":
                                                        {
                                                            "subject":
                                                            {
                                                                "type": "string"
                                                            },
                                                            "version":
                                                            {
                                                                "type": "string",
                                                                "default": "latest"
                                                            }
                                                        },
                                                        "required":
                                                        [
                                                            "subject"
                                                        ],
                                                        "additionalProperties": false
                                                    },
                                                    "additionalProperties": false
                                                }
                                            },
                                            "security":
                                            {
                                                "title": "Security",
                                                "type": "object",
                                                "patternProperties":
                                                {
                                                    "^[a-zA-Z0-9_\\-]+$":
                                                    {
                                                        "type": "string"
                                                    }
                                                },
                                                "additionalProperties": false
                                            },
                                            "overlay":
                                            {
                                                "title": "Overlay",
                                                "type": "object",
                                                "patternProperties":
                                                {
                                                    "^[a-zA-Z]+[a-zA-Z0-9\\._\\-]*$":
                                                    {
                                                        "type": "object",
                                                        "properties":
                                                        {
                                                            "subject":
                                                            {
                                                                "type": "string"
                                                            },
                                                            "version":
                                                            {
                                                                "type": "string",
                                                                "default": "latest"
                                                            }
                                                        },
                                                        "required":
                                                        [
                                                            "subject"
                                                        ],
                                                        "additionalProperties": false
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                }
                            },
                            "tools":
                            {
                                "title": "Tools",
                                "type": "object",
                                "patternProperties":
                                {
                                    "^[A-Za-z0-9_-]+$":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "description":
                                            {
                                                "title": "Tool Description",
                                                "type": "string"
                                            },
                                            "summary":
                                            {
                                                "title": "Tool Summary",
                                                "type": "string"
                                            },
                                            "output":
                                            {
                                                "title": "Output Schema",
                                                "$ref": "#/$defs/models"
                                            },
                                            "input":
                                            {
                                                "title": "Input Schema",
                                                "$ref": "#/$defs/models"
                                            },
                                            "annotations":
                                            {
                                                "title": "Annotations",
                                                "type": "object",
                                                "properties":
                                                {
                                                    "title":
                                                    {
                                                        "title": "Title",
                                                        "type": "string"
                                                    },
                                                    "readOnlyHint":
                                                    {
                                                        "title": "Read-Only Hint",
                                                        "type": "boolean"
                                                    },
                                                    "destructiveHint":
                                                    {
                                                        "title": "Destructive Hint",
                                                        "type": "boolean"
                                                    },
                                                    "idempotentHint":
                                                    {
                                                        "title": "Idempotent Hint",
                                                        "type": "boolean"
                                                    },
                                                    "openWorldHint":
                                                    {
                                                        "title": "Open-World Hint",
                                                        "type": "boolean"
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "additionalProperties": false
                            },
                            "resources":
                            {
                                "title": "Resources",
                                "type": "object",
                                "patternProperties":
                                {
                                    "^.+$":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "description":
                                            {
                                                "title": "Resource Description",
                                                "type": "string"
                                            },
                                            "mimeType":
                                            {
                                                "title": "MIME Type",
                                                "type": "string"
                                            },
                                            "output":
                                            {
                                                "title": "Output Schema",
                                                "$ref": "#/$defs/models"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "additionalProperties": false
                    },
                    "routes":
                    {
                        "title": "Routes",
                        "type": "array",
                        "minItems": 1,
                        "items":
                        {
                            "type": "object",
                            "properties":
                            {
                                "when":
                                {
                                    "title": "When",
                                    "type": "array",
                                    "items":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "tool":
                                            {
                                                "title": "Tool",
                                                "type": "string"
                                            },
                                            "resource":
                                            {
                                                "title": "Resource",
                                                "type": "string"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "with":
                                {
                                    "title": "With",
                                    "type": "object",
                                    "properties":
                                    {
                                        "spec":
                                        {
                                            "title": "Spec",
                                            "type": "string"
                                        },
                                        "operation":
                                        {
                                            "title": "Operation Id or glob pattern",
                                            "type": "string"
                                        },
                                        "tag":
                                        {
                                            "title": "Tag",
                                            "type": "string"
                                        },
                                        "params":
                                        {
                                            "title": "Parameter Bindings",
                                            "type": "object",
                                            "additionalProperties":
                                            {
                                                "type": "string"
                                            }
                                        },
                                        "body":
                                        {
                                            "title": "Body Template",
                                            "type": "object",
                                            "additionalProperties":
                                            {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "required": [ "spec" ],
                                    "additionalProperties": false,
                                    "not":
                                    {
                                        "required": [ "tag", "operation" ]
                                    }
                                },
                                "guarded":
                                {
                                    "title": "Guarded",
                                    "type": "object",
                                    "patternProperties":
                                    {
                                        "^[a-zA-Z]+[a-zA-Z0-9\\._\\-]*$":
                                        {
                                            "title": "Roles",
                                            "type": "array",
                                            "items": { "title": "Role", "type": "string" }
                                        }
                                    }
                                },
                                "exit":
                                {
                                    "title": "Exit",
                                    "type": "string"
                                }
                            },
                            "required": [ "with" ],
                            "additionalProperties": false,
                            "if":
                            {
                                "properties":
                                {
                                    "with":
                                    {
                                        "required": [ "operation" ],
                                        "properties":
                                        {
                                            "operation":
                                            {
                                                "pattern": "^[^*]*$"
                                            }
                                        }
                                    }
                                }
                            },
                            "else":
                            {
                                "properties":
                                {
                                    "when":
                                    {
                                        "items":
                                        {
                                            "not":
                                            {
                                                "anyOf":
                                                [
                                                    { "required": [ "tool" ] },
                                                    { "required": [ "resource" ] }
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "required": [ "routes" ],
                "oneOf":
                [
                    {
                        "properties":
                        {
                            "kind":
                            {
                                "const": "client"
                            },
                            "exit": false,
                            "routes":
                            {
                                "items":
                                {
                                    "properties":
                                    {
                                        "exit": false
                                    }
                                }
                            }
                        }
                    },
                    {
                        "properties":
                        {
                            "kind":
                            {
                                "const": "proxy"
                            }
                        },
                        "anyOf":
                        [
                            {
                                "required":
                                [
                                    "exit"
                                ]
                            },
                            {
                                "properties":
                                {
                                    "routes":
                                    {
                                        "items":
                                        {
                                            "if":
                                            {
                                                "required": [ "with" ]
                                            },
                                            "then":
                                            {
                                                "required": [ "exit" ]
                                            }
                                        }
                                    }
                                },
                                "required":
                                [
                                    "routes"
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    }
]
