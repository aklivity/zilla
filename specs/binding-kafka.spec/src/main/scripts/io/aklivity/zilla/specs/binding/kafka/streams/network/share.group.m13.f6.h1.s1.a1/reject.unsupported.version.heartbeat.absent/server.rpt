accept "zilla://streams/net0"
  option zilla:window 8192
  option zilla:transmission "duplex"
  option zilla:byteorder "network"

accepted

connected

read  15                                             # size
      18s                                            # api versions
      0s                                             # v0
      (int:requestId)                                # correlation id
      5s "zilla"                                     # client id

write 22                                             # size
      ${requestId}                                   # correlation id
      0s                                             # error code
      2                                              # api key count
        3s                                           # api key
        0s                                           # min version
        13s                                          # max version
        10s                                          # api key
        0s                                           # min version
        6s                                           # max version

read  42                                             # size
      3s                                             # metadata
      13s                                            # v13
      (int:requestId)                                # correlation id
      5s "zilla"                                     # client id
      [0x00]                                         # tagged fields
      [0x02]                                         # topics
        [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00] # topic id
        [0x05] "test"                                # name
        [0x00]                                       # tagged fields
      [0x00]                                         # allow auto topic creation
      [0x00]                                         # include topic authorized operations
      [0x00]                                         # tagged fields

write 144                                            # size
      ${requestId}                                   # correlation id
      [0x00]                                         # tagged fields
      0                                              # throttle time ms
      [0x03]                                         # brokers
        0xb1                                         # node id
        [0x14] "broker1.example.com"                 # host
        9092                                         # port
        [0x00]                                       # rack
        [0x00]                                       # tagged fields
        0xb2                                         # node id
        [0x14] "broker2.example.com"                 # host
        9092                                         # port
        [0x00]                                       # rack
        [0x00]                                       # tagged fields
      [0x0a] "cluster 1"                             # cluster id
      0xb1                                           # controller id
      [0x02]                                         # topics
        0s                                           # error code
        [0x05] "test"                                # name
        [0x20 0x36 0xc8 0x4b 0xed 0x06 0x49 0xa5 0xba 0xbb 0x7a 0x50 0x61 0xd6 0xd8 0xb0] # topic id
        [0x00]                                       # is internal
        [0x02]                                       # partitions
          0s                                         # error code
          0                                          # partition index
          0xb2                                       # leader id
          0                                          # leader epoch
          [0x02]                                     # replica nodes
          0xb2                                       # node id
          [0x02]                                     # isr nodes
          0xb2                                       # node id
          [0x01]                                     # offline replicas
          [0x00]                                     # tagged fields
        -2147483648                                  # topic authorized operations
        [0x00]                                       # tagged fields
      0s                                             # error code
      [0x00]                                         # tagged fields

read  24                                             # size
      10s                                            # find coordinator
      6s                                             # v6
      (int:requestId)                                # correlation id
      5s "zilla"                                     # client id
      [0x00]                                         # tagged fields
      [0x00]                                         # key type (group)
      [0x02]                                         # coordinator keys
        [0x05] "test"                                # key
      [0x00]                                         # tagged fields

write 48                                             # size
      ${requestId}                                   # correlation id
      [0x00]                                         # tagged fields
      0                                              # throttle time ms
      [0x02]                                         # coordinators
        [0x05] "test"                                # key
        0xb1                                         # node id
        [0x14] "broker1.example.com"                 # host
        9092                                         # port
        0s                                           # error code
        [0x01]                                       # error message
        [0x00]                                       # tagged fields
      [0x00]                                         # tagged fields

accepted

read zilla:begin.ext ${proxy:matchBeginEx()
                              .typeId(zilla:id("proxy"))
                              .addressInet()
                                .protocol("stream")
                                .source("0.0.0.0")
                                .destination("broker1.example.com")
                                .sourcePort(0)
                                .destinationPort(9092)
                                .build()
                              .info()
                                .authority("broker1.example.com")
                                .build()
                              .build()}

connected

read  15                                             # size
      18s                                            # api versions
      0s                                             # v0
      (int:requestId)                                # correlation id
      5s "zilla"                                     # client id

write 22                                             # size
      ${requestId}                                   # correlation id
      0s                                             # error code
      2                                              # api key count
        3s                                           # api key
        0s                                           # min version
        13s                                          # max version
        10s                                          # api key
        0s                                           # min version
        6s                                           # max version
