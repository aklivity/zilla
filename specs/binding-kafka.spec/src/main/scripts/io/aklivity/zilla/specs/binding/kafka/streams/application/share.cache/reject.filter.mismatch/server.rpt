property serverAddress "zilla://streams/app0"

property authorization 0L

accept ${serverAddress}
    option zilla:authorization ${authorization}
    option zilla:window 8192
    option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .share()
                                   .groupId("test")
                                   .topic("test")
                                   .filter()
                                       .key("match")
                                       .build()
                                   .build()
                               .build()}

connected

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .share()
                                   .groupId("test")
                                   .topic("test")
                                   .host("broker1.example.com")
                                   .port(9092)
                                   .build()
                               .build()}
write flush

write notify S2_REJECTED

read closed

write close

accepted

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .share()
                                   .groupId("test")
                                   .topic("test")
                                   .filter()
                                       .key("other")
                                       .build()
                                   .build()
                               .build()}

connected

write zilla:reset.ext ${kafka:resetEx()
                           .typeId(zilla:id("kafka"))
                           .error(42)
                           .build()}
read abort
