property networkConnectWindow 8192

property newRequestId ${kafka:newRequestId()}

connect "zilla://streams/net0"
  option zilla:window ${networkConnectWindow}
  option zilla:transmission "duplex"
  option zilla:byteorder "network"

connected

write 15                                             # size
      18s                                            # api versions
      0s                                             # v0
      ${newRequestId}                                # correlation id
      5s "zilla"                                     # client id

read  40                                             # size
      (int:newRequestId)                             # correlation id
      0s                                             # error code
      5                                              # api key count
        3s                                           # api key
        0s                                           # min version
        13s                                          # max version
        10s                                          # api key
        0s                                           # min version
        6s                                           # max version
        76s                                          # api key
        1s                                           # min version
        1s                                           # max version
        78s                                          # api key
        1s                                           # min version
        1s                                           # max version
        79s                                          # api key
        1s                                           # min version
        1s                                           # max version

write 42                                             # size
      3s                                             # metadata
      13s                                            # v13
      ${newRequestId}                                # correlation id
      5s "zilla"                                     # client id
      [0x00]                                         # tagged fields
      [0x02]                                         # topics
        [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00] # topic id
        [0x05] "test"                                # name
        [0x00]                                       # tagged fields
      [0x00]                                         # allow auto topic creation
      [0x00]                                         # include topic authorized operations
      [0x00]                                         # tagged fields

read  118                                            # size
      (int:newRequestId)                             # correlation id
      [0x00]                                         # tagged fields
      0                                              # throttle time ms
      [0x03]                                         # brokers
        0xb1                                         # node id
        [0x14] "broker1.example.com"                 # host
        9092                                         # port
        [0x00]                                       # rack
        [0x00]                                       # tagged fields
        0xb2                                         # node id
        [0x14] "broker2.example.com"                 # host
        9092                                         # port
        [0x00]                                       # rack
        [0x00]                                       # tagged fields
      [0x0a] "cluster 1"                             # cluster id
      0xb1                                           # controller id
      [0x02]                                         # topics
        3s                                           # error code
        [0x05] "test"                                # name
        [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00] # topic id
        [0x00]                                       # is internal
        [0x01]                                       # partitions
        -2147483648                                  # topic authorized operations
        [0x00]                                       # tagged fields
      0s                                             # error code
      [0x00]                                         # tagged fields
