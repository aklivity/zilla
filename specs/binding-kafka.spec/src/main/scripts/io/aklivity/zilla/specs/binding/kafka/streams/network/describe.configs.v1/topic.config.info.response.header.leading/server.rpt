property networkAcceptWindow 8192

accept "zilla://streams/net0"
  option zilla:window ${networkAcceptWindow}
  option zilla:transmission "duplex"
  option zilla:byteorder "network"

accepted

connected

read 47                                 # size
     32s                                # describe configs
     1s                                 # v1
     (int:requestId1)
     5s "zilla"                         # client id
     1                                  # resources
       [0x02]                           # topic resource
       4s "test"                        # "test" topic
       1                                # configs
         14s "cleanup.policy"             # name
     [0x00]                             # include synonyms

read 47                                 # size
     32s                                # describe configs
     1s                                 # v1
     (int:requestId2)
     5s "zilla"                         # client id
     1                                  # resources
       [0x02]                           # topic resource
       4s "test"                        # "test" topic
       1                                # configs
         14s "cleanup.policy"             # name
     [0x00]                             # include synonyms

# first 3 bytes of the first response length in a frame of their own
write [0x00 0x00 0x00]                  # size, first 3 bytes

# rest of the first response length, the first response, and all of the second response in a single frame
write [0x3b]                            # size, last byte
      ${requestId1}
      0
      1                                 # resources
        0s                                # no error
        -1s                               # error message
        [0x02]                            # topic resource
        4s "test"                         # "test" topic
        1                                 # configs
          14s "cleanup.policy"              # name
          7s "compact"                      # value
         [0x00]                             # not read only
         [0x00]                             # config source
         [0x00]                             # not sensitive
         0                                  # synonyms
      59                                # size
      ${requestId2}
      0
      1                                 # resources
        0s                                # no error
        -1s                               # error message
        [0x02]                            # topic resource
        4s "test"                         # "test" topic
        1                                 # configs
          14s "cleanup.policy"              # name
          7s "compact"                      # value
         [0x00]                             # not read only
         [0x00]                             # config source
         [0x00]                             # not sensitive
         0                                  # synonyms
