property networkAcceptWindow 8192

accept "zilla://streams/net0"
  option zilla:window ${networkAcceptWindow}
  option zilla:transmission "duplex"
  option zilla:byteorder "network"

accepted

connected

read  30                                # size
      32s                               # describe configs
      4s                                # v4
      (int:newRequestId)
      5s "zilla"                        # client id
      [0x00]                            # tagged fields
      [0x02]                            # resource count
        [0x02]                          # type (topic)
        [0x07] "events"                 # name
        [0x00]                          # config names (null = all)
        [0x00]                          # tagged fields
      [0x00]                            # include synonyms
      [0x00]                            # include documentation
      [0x00]                            # tagged fields

write 53                                 # size
      ${newRequestId}
      [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x02]                             # resources
        0s                               # error code
        [0x00]                           # error message
        [0x02]                           # type (topic)
        [0x07] "events"                  # name
        [0x02]                           # configs
          [0x0f] "cleanup.policy"         # config name
          [0x07] "delete"                 # config value
          [0x00]                          # read only
          [0x05]                          # config source (default)
          [0x01]                          # is sensitive
          [0x01]                          # synonyms
          [0x01]                          # config type (string)
          [0x00]                          # documentation
          [0x00]                          # tagged fields (config)
        [0x00]                            # tagged fields (resource)
      [0x00]                              # tagged fields
