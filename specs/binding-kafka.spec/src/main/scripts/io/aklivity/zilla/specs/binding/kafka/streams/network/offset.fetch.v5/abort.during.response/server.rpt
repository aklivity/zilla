property networkAcceptWindow 8192

accept "zilla://streams/net0"
  option zilla:window ${networkAcceptWindow}
  option zilla:transmission "duplex"
  option zilla:byteorder "network"

accepted

read zilla:begin.ext ${proxy:matchBeginEx()
                              .typeId(zilla:id("proxy"))
                              .addressInet()
                                .protocol("stream")
                                .source("0.0.0.0")
                                .destination("broker1.example.com")
                                .sourcePort(0)
                                .destinationPort(9092)
                                .build()
                              .info()
                                .authority("broker1.example.com")
                                .build()
                              .build()}
connected

read  43                                # size
      9s                                # offset fetch
      5s                                # v0
      (int:firstRequestId)
      5s "zilla"                        # client id
      8s "client-1"                       # group id
      1                                 # topics
        4s "test"                       # "test" topic
        1                               # partitions
          0                             # partition

write 952                                # size
      ${firstRequestId}
      0                                  # throttle time ms
      1                                  # topics
        4s "test"                          # "test" topic
        32                                 # partitions
write notify RESPONSE_PARTIAL

write await APPLICATION_ABORTED

write 0                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 1                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 2                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 3                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 4                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 5                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 6                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 7                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 8                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 9                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 10                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 11                                 # partition index
