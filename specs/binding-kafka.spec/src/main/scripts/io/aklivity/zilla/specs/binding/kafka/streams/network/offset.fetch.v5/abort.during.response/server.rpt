write 30                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 31                                 # partition index
      2L                                  # committed offset
      0                                   # committed leader epoch
      9s "test-meta"                      # metadata
      0s                                  # no error
write 0s                                 # error code

read  43                                # size
      9s                                # offset fetch
      5s                                # v0
      (int:secondRequestId)
      5s "zilla"                        # client id
      8s "client-2"                       # group id
      1                                 # topics
        4s "test"                       # "test" topic
        1                               # partitions
          0                             # partition

write 53                                 # size
      ${secondRequestId}
      0                                  # throttle time ms
      1                                  # topics
        4s "test"                          # "test" topic
        1                                  # partitions
          0                                   # partition index
          2L                                  # committed offset
          0                                   # committed leader epoch
          9s "test-meta"                      # metadata
          0s                                  # no error
      0s                                 # error code
