read 30                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 31                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 0s                                 # error code

write 43                                # size
      9s                                # offset fetch
      5s                                # v0
      ${secondRequestId}
      5s "zilla"                        # client id
      8s "client-2"                        # group id
      1                                 # topics
        4s "test"                       # "test" topic
        1                               # partitions
          0                             # partition

read 53                                 # size
     (int:secondResponseId)
     0                                  # throttle time ms
     1                                  # topics
       4s "test"                          # "test" topic
       1                                  # partitions
         0                                   # partition index
         2L                                  # committed offset
         0                                   # committed leader epoch
         9s "test-meta"                      # metadata
         0s                                  # no error
     0s                                 # error code
