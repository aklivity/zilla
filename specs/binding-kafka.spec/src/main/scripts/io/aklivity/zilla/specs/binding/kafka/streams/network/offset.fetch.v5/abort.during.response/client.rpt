     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 26                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 27                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 28                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
