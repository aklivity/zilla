     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 12                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 13                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 14                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 15                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 16                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 17                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 18                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 19                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 20                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 21                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
