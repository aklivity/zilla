property networkConnectWindow 8192

property firstRequestId ${kafka:newRequestId()}
property secondRequestId ${kafka:newRequestId()}

connect "zilla://streams/net0"
  option zilla:window ${networkConnectWindow}
  option zilla:transmission "duplex"
  option zilla:byteorder "network"

write zilla:begin.ext ${proxy:beginEx()
                               .typeId(zilla:id("proxy"))
                               .addressInet()
                                 .protocol("stream")
                                 .source("0.0.0.0")
                                 .destination("broker1.example.com")
                                 .sourcePort(0)
                                 .destinationPort(9092)
                                 .build()
                               .info()
                                 .authority("broker1.example.com")
                                 .build()
                               .build()}
connected

write 43                                # size
      9s                                # offset fetch
      5s                                # v0
      ${firstRequestId}
      5s "zilla"                        # client id
      8s "client-1"                       # group id
      1                                 # topics
        4s "test"                       # "test" topic
        1                               # partitions
          0                             # partition

read 952                                # size
     (int:firstResponseId)
     0                                  # throttle time ms
     1                                  # topics
       4s "test"                          # "test" topic
       32                                 # partitions

read await RESPONSE_PARTIAL
read notify APPLICATION_ABORTED

read 0                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 1                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 2                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 3                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 4                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 5                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 6                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 7                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 8                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 9                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
read 10                                  # partition index
     2L                                 # committed offset
     0                                  # committed leader epoch
     9s "test-meta"                     # metadata
     0s                                 # no error
