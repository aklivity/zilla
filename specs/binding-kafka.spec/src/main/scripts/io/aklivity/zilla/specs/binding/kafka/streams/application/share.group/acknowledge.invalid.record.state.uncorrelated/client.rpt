property authorization 0L

connect "zilla://streams/app0"
    option zilla:authorization ${authorization}
    option zilla:window 8192
    option zilla:transmission "half-duplex"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .share()
                                   .groupId("test")
                                   .memberId("AAECAwQFBgcICQoLDA0ODw")
                                   .topic("test")
                                   .build()
                               .build()}

connected

read zilla:begin.ext ${kafka:matchBeginEx()
                               .typeId(zilla:id("kafka"))
                               .share()
                                   .groupId("test")
                                   .memberId("AAECAwQFBgcICQoLDA0ODw")
                                   .topic("test")
                                   .host("broker1.example.com")
                                   .port(9092)
                                   .build()
                               .build()}

read zilla:data.ext ${kafka:matchDataEx()
                             .typeId(zilla:id("kafka"))
                             .share()
                                 .partition(0, 5)
                                 .build()
                             .build()}
read "Hello, world"

# acquired ranges follow the records streamed for the partition
read advised zilla:flush ${kafka:matchFlushEx()
                             .typeId(zilla:id("kafka"))
                             .shareAcquired()
                                 .partition(0)
                                 .lockTimeoutMillis(30000)
                                 .range(5, 5, 1)
                                 .build()
                             .build()}

write advise zilla:flush ${kafka:flushEx()
                             .typeId(zilla:id("kafka"))
                             .share()
                                 .partition(0, 5)
                                 .type("RELEASE")
                                 .build()
                             .build()}

write notify APPLICATION_ACKNOWLEDGED

read await FETCH_OUTSTANDING

write close
write notify APPLICATION_LEFT
read closed
