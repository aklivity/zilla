property networkConnectWindow 8192

property newRequestId ${kafka:newRequestId()}

connect "zilla://streams/net0"
  option zilla:window ${networkConnectWindow}
  option zilla:transmission "duplex"
  option zilla:byteorder "network"

connected

write 15                                             # size
      18s                                            # api versions
      0s                                             # v0
      ${newRequestId}                                # correlation id
      5s "zilla"                                     # client id

read  40                                             # size
      (int:newRequestId)                             # correlation id
      0s                                             # error code
      5                                              # api key count
        3s                                           # api key
        14s                                          # min version
        15s                                          # max version
        10s                                          # api key
        0s                                           # min version
        6s                                           # max version
        76s                                          # api key
        1s                                           # min version
        1s                                           # max version
        78s                                          # api key
        1s                                           # min version
        1s                                           # max version
        79s                                          # api key
        1s                                           # min version
        1s                                           # max version
