property networkAcceptWindow 8192

accept "zilla://streams/net0"
  option zilla:window ${networkAcceptWindow}
  option zilla:transmission "duplex"
  option zilla:byteorder "network"

accepted

connected

read  52                                # size
      33s                               # alter configs
      2s                                # v2
      (int:newRequestId)
      5s "zilla"                        # client id
      [0x00]                            # tagged fields
      [0x02]                            # resource count
        [0x02]                          # type (topic)
        [0x07] "events"                 # name
        [0x02]                          # config count
          [0x0f] "cleanup.policy"        # config name
          [0x07] "delete"                # config value
          [0x00]                         # tagged fields
        [0x00]                           # tagged fields
      [0x00]                             # validate only
      [0x00]                             # tagged fields

write 23                                 # size
      ${newRequestId}
      [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x02]                             # resources
        0s                               # error code
        [0x00]                           # error message
        [0x02]                           # type (topic)
        [0x07] "events"                  # name
        [0x00]                           # tagged fields
      [0x00]                             # tagged fields
