property authorization 0L
property affinity 9L

connect "zilla://streams/app0"
    option zilla:authorization ${authorization}
    option zilla:window 8192
    option zilla:transmission "half-duplex"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .meta()
                                   .topic("test")
                                   .build()
                               .build()}

connected

read zilla:begin.ext ${kafka:beginEx()
                              .typeId(zilla:id("kafka"))
                              .meta()
                                  .topic("test")
                                  .build()
                              .build()}

read zilla:data.ext ${kafka:dataEx()
                             .typeId(zilla:id("kafka"))
                             .meta()
                                 .partition(0, 1)
                                 .partition(1, 2)
                                 .build()
                             .build()}

read notify BROKERS_LEARNED

connect await BROKERS_LEARNED
        "zilla://streams/app0"
    option zilla:authorization ${authorization}
    option zilla:affinity ${affinity}
    option zilla:window 8192
    option zilla:transmission "half-duplex"
    option zilla:byteorder "network"

write zilla:begin.ext ${kafka:beginEx()
                               .typeId(zilla:id("kafka"))
                               .apiRequest()
                                 .length(110)
                                 .api(19)
                                 .version(7)
                                 .clientId("zilla")
                                 .build()
                                .build()}

connect aborted
