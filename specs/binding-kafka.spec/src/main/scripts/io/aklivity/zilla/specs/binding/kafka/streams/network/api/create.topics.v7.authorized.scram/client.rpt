property authorization 0L
property networkConnectWindow 8192

property apiVersionsRequestId ${kafka:newRequestId()}
property saslHandshakeRequestId ${kafka:newRequestId()}
property saslAuthenticateRequestId ${kafka:newRequestId()}
property saslAuthenticateFinalRequestId ${kafka:newRequestId()}
property newRequestId ${kafka:newRequestId()}

connect "zilla://streams/net0"
  option zilla:authorization ${authorization}
  option zilla:window ${networkConnectWindow}
  option zilla:transmission "duplex"
  option zilla:byteorder "network"

connected

write 15                                # size
      18s                               # api_versions
      0s                                # v0
      ${apiVersionsRequestId}
      5s "zilla"                        # client id

read  28                                 # size
      (int:apiVersionsRequestId)
      0s                                 # error code
      3                                  # api key count
        19s                              # create topics
        0s                               # min version
        7s                               # max version
        17s                              # sasl handshake
        0s                               # min version
        1s                               # max version
        36s                              # sasl authenticate
        0s                               # min version
        1s                               # max version

write 28                                # size
      17s                               # sasl.handshake
      1s                                # v1
      ${saslHandshakeRequestId}
      5s "zilla"                        # client id
      11s "SCRAM-SHA-1"                 # mechanism

read  23                                 # size
      (int:saslHandshakeRequestId)
      0s                                 # error code
      1                                  # mechanisms
        11s "SCRAM-SHA-1"                # SCRAM-SHA-1

write 55                                # size
      36s                               # sasl.authenticate
      1s                                # v1
      ${saslAuthenticateRequestId}
      5s "zilla"                        # client id
      36                                # authentication bytes
      "n,,n=user,r=fyko+d2lbbFgONRv9qkxdawL"

read  90                                 # size
      (int:saslAuthenticateRequestId)
      0s                                 # error code
      -1s                                # error message
      70                                 # authentication bytes
      "r=fyko+d2lbbFgONRv9qkxdawL3rfcNHYJY1ZVvWVs7j,s=QSXCR+Q6sek8bf92,i=4096"
      0L                                 # session lifetime

write 101                               # size
      36s                               # sasl.authenticate
      1s                                # v1
      ${saslAuthenticateFinalRequestId}
      5s "zilla"                        # client id
      82                                # authentication bytes
      "c=biws,r=fyko+d2lbbFgONRv9qkxdawL3rfcNHYJY1ZVvWVs7j,p=v0X8v3Bz2T0CJGbJQyF0X+HI4Ts="

read  50                                 # size
      (int:saslAuthenticateFinalRequestId)
      0s                                 # error code
      -1s                                # error message
      30                                 # authentication bytes
      "v=rmF9pqV8S7suAoZWja4dJRkFsKQ="
      0L                                 # session lifetime

write 125                               # size
      19s                               # create topics
      7s                                # v7
      ${newRequestId}
      5s "zilla"                        # client id
      [0x00]                            # tagged fields
      [0x03]                            # topic count
        [0x07] "events"                 # name
        1                               # number of partitions
        1s                              # replication factor
        [0x02]                          # assignments
            0                           # partition index
            [0x02]                      # broker ids
                0                       # broker id
            [0x00]                      # tagged fields
        [0x02]                          # configs
            [0x0f] "cleanup.policy"     # name
            [0x07] "delete"             # value
            [0x00]                      # tagged fields
        [0x00]                          # tagged fields
        [0x0a] "snapshots"              # name
        1                               # number of partitions
        1s                              # replication factor
        [0x02]                          # assignments
            0                           # partition index
            [0x02]                      # broker ids
                0                       # broker id
            [0x00]                      # tagged fields
        [0x02]                          # configs
            [0x0f] "cleanup.policy"     # name
            [0x08] "compact"            # value
            [0x00]                      # tagged fields
        [0x00]                          # tagged fields
      0                                 # timeout
      [0x00]                            # validate only
      [0x00]                            # tagged fields

read  82                                 # size
      (int:newRequestId)
      [0x00]                             # tagged fields
      0                                  # throttle time ms
      [0x03]                             # topics
        [0x07] "events"                  # name
        [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00] # topic id
        0s                               # error code
        [0x00]                           # error message
        1                                # number of partitions
        1s                               # replication factor
        [0x01]                           # configs
        [0x00]                           # tagged fields
        [0x0a] "snapshots"                # name
        [0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00] # topic id
        0s                               # error code
        [0x00]                           # error message
        1                                # number of partitions
        1s                               # replication factor
        [0x01]                           # configs
        [0x00]                           # tagged fields
      [0x00]                             # tagged fields
