connect "zilla://streams/app0"
        option zilla:transmission "duplex"
        option zilla:window 8192
connected

write option zilla:flags "init"
write [0x00 0x0a 0x05 0x41 0x4c 0x49 0x43 0x45 0x12 0x00]
write option zilla:flags "none"
write [0x12 0x3e 0x0a 0x3c 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58]
write option zilla:flags "fin"
write [0x12 0x06 0x12 0x04 0x5a 0x49 0x4f 0x4e]
write close
