connect "zilla://streams/asyncapi0"
        option zilla:window 8192
        option zilla:transmission "duplex"
        option zilla:affinity 0x0000000000000002L

write zilla:begin.ext ${asyncapi:beginEx()
                             .typeId(zilla:id("asyncapi"))
                             .specId(2)
                             .extension(mqtt:beginEx()
                                            .compositeId(core:decodeLong("0x0000_0001_0000_0000"))
                                            .typeId(zilla:id("mqtt"))
                                            .session()
                                              .clientId("client")
                                              .build()
                                            .build())
                             .build()}

read zilla:begin.ext ${asyncapi:matchBeginEx()
                             .typeId(zilla:id("asyncapi"))
                             .extension(mqtt:matchBeginEx()
                                            .typeId(zilla:id("mqtt"))
                                            .session()
                                              .clientId("client")
                                              .build()
                                            .build())
                             .build()}

connected

read zilla:data.empty
