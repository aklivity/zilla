<?xml version="1.0" encoding="UTF-8"?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0 https://maven.apache.org/xsd/build-cache-config-1.4.0.xsd">
  <configuration>
    <enabled>true</enabled>
    <local>
      <maxBuildsCached>10</maxBuildsCached>
    </local>
  </configuration>
  <input>
    <plugins>
      <!-- engine's k3po plugin depends on its own jar, which checksum calculation reports as a cycle -->
      <plugin groupId="io.aklivity.k3po" artifactId="k3po-maven-plugin" excludeDependencies="true"/>
    </plugins>
  </input>
  <executionControl>
    <runAlways>
      <!-- a cache hit would otherwise skip install, leaving restored artifacts out of the local repository -->
      <plugins>
        <plugin artifactId="maven-install-plugin"/>
      </plugins>
    </runAlways>
  </executionControl>
</cache>
