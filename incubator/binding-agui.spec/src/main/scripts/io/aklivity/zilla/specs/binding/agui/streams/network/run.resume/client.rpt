connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                        .typeId(zilla:id("http"))
                        .header(":method", "POST")
                        .header(":scheme", "http")
                        .header(":authority", "localhost:8080")
                        .header(":path", "/agent")
                        .header("content-type", "application/json")
                        .header("accept", "text/event-stream")
                        .build()}

connected

write "{\"threadId\":\"thread-1\",\"runId\":\"run-2\",\"parentRunId\":\"run-0\",\"messages\":[],\"resume\":[{\"interruptId\":\"int-1\",\"status\":\"resolved\",\"payload\":{\"approved\":true}}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                       .typeId(zilla:id("http"))
                       .header(":status", "200")
                       .header("content-type", "text/event-stream")
                       .build()}

read "{\"type\":\"RUN_STARTED\",\"threadId\":\"thread-1\",\"runId\":\"run-2\",\"parentRunId\":\"run-0\"}"
read "{\"type\":\"RUN_FINISHED\",\"threadId\":\"thread-1\",\"runId\":\"run-2\"}"

read closed
