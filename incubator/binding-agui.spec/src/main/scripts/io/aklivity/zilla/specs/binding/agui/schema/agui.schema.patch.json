[
    {
        "op": "add",
        "path": "/$defs/binding/properties/type/enum/-",
        "value": "agui"
    },
    {
        "op": "add",
        "path": "/$defs/binding/allOf/-",
        "value": {
            "if": {
                "properties": {
                    "type": {
                        "const": "agui"
                    }
                }
            },
            "then": {
                "properties": {
                    "type": {
                        "const": "agui"
                    },
                    "kind": {
                        "enum": [ "server" ]
                    },
                    "catalog": false,
                    "vault": false,
                    "entry": false,
                    "options": {
                        "properties": {
                            "authorization": {
                                "title": "Authorization",
                                "type": "object",
                                "patternProperties": {
                                    "^[A-Za-z0-9_-]+$": {
                                        "type": "object",
                                        "properties": {
                                            "credentials": {
                                                "title": "Credentials",
                                                "type": "string",
                                                "pattern": ".*\\{credentials\\}.*",
                                                "default": "Bearer {credentials}"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "additionalProperties": false,
                                "maxProperties": 1
                            }
                        },
                        "additionalProperties": false
                    },
                    "routes": false
                }
            }
        }
    }
]
