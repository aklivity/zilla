[
    {
        "op": "add",
        "path": "/$defs/binding/properties/type/enum/-",
        "value": "agui"
    },
    {
        "op": "add",
        "path": "/$defs/binding/allOf/-",
        "value": {
            "if": {
                "properties": {
                    "type": {
                        "const": "agui"
                    }
                }
            },
            "then": {
                "properties": {
                    "type": {
                        "const": "agui"
                    },
                    "kind": {
                        "enum": [
                            "server",
                            "client"
                        ]
                    },
                    "catalog": false,
                    "vault": false,
                    "entry": false,
                    "routes": false
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "kind": {
                                    "const": "server"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "options": {
                                    "properties": {
                                        "authorization": {
                                            "title": "Authorization",
                                            "type": "object",
                                            "patternProperties": {
                                                "^[A-Za-z0-9_-]+$": {
                                                    "type": "object",
                                                    "properties": {
                                                        "credentials": {
                                                            "title": "Credentials",
                                                            "type": "string",
                                                            "pattern": ".*\\{credentials\\}.*",
                                                            "default": "Bearer {credentials}"
                                                        }
                                                    },
                                                    "additionalProperties": false
                                                }
                                            },
                                            "additionalProperties": false,
                                            "maxProperties": 1
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "kind": {
                                    "const": "client"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "options": {
                                    "properties": {
                                        "server": {
                                            "title": "Server",
                                            "type": "string",
                                            "format": "uri",
                                            "pattern": "^https?://"
                                        },
                                        "authorization": {
                                            "title": "Authorization",
                                            "type": "object",
                                            "patternProperties": {
                                                "^[A-Za-z0-9_-]+$": {
                                                    "type": "object",
                                                    "properties": {
                                                        "credentials": {
                                                            "title": "Credentials",
                                                            "type": "string",
                                                            "pattern": ".*\\{credentials\\}.*",
                                                            "default": "Bearer {credentials}"
                                                        }
                                                    },
                                                    "additionalProperties": false
                                                }
                                            },
                                            "additionalProperties": false,
                                            "maxProperties": 1
                                        }
                                    },
                                    "additionalProperties": false,
                                    "required": [
                                        "server"
                                    ]
                                }
                            },
                            "required": [
                                "exit",
                                "options"
                            ]
                        }
                    }
                ]
            }
        }
    }
]
