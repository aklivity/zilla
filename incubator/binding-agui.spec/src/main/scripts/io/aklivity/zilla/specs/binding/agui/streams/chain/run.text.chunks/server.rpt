property serverAddress "zilla://streams/net0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                       .typeId(zilla:id("http"))
                       .header(":method", "POST")
                       .header(":scheme", "http")
                       .header(":authority", "localhost:8080")
                       .header(":path", "/agent")
                       .header("content-type", "application/json")
                       .header("accept", "text/event-stream")
                       .build()}

connected

read "{\"threadId\":\"thread-1\",\"runId\":\"run-1\",\"messages\":[{\"id\":\"msg-1\",\"role\":\"user\",\"content\":\"Hello\"}],\"tools\":[],\"context\":[],\"forwardedProps\":{}}"

read closed

write zilla:begin.ext ${http:beginEx()
                        .typeId(zilla:id("http"))
                        .header(":status", "200")
                        .header("content-type", "text/event-stream")
                        .build()}
write flush

write "{\"type\":\"RUN_STARTED\",\"threadId\":\"thread-1\",\"runId\":\"run-1\"}"
write "{\"type\":\"TEXT_MESSAGE_START\",\"messageId\":\"msg-2\",\"role\":\"assistant\"}"
write "{\"type\":\"TEXT_MESSAGE_CONTENT\",\"messageId\":\"msg-2\",\"delta\":\"Hello\"}"
write "{\"type\":\"TEXT_MESSAGE_CONTENT\",\"messageId\":\"msg-2\",\"delta\":\" wor\"}"
write "{\"type\":\"TEXT_MESSAGE_CONTENT\",\"messageId\":\"msg-2\",\"delta\":\"ld\"}"
write "{\"type\":\"TEXT_MESSAGE_END\",\"messageId\":\"msg-2\"}"
write "{\"type\":\"RUN_FINISHED\",\"threadId\":\"thread-1\",\"runId\":\"run-1\"}"

write close
