connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                        .typeId(zilla:id("http"))
                        .header(":method", "POST")
                        .header(":scheme", "http")
                        .header(":authority", "localhost:8080")
                        .header(":path", "/agent")
                        .header("content-type", "application/json")
                        .header("accept", "text/event-stream")
                        .build()}

connected

write "{\"threadId\":\"thread-1\",\"runId\":\"run-1\",\"messages\":[{\"id\":\"msg-1\",\"role\":\"user\",\"content\":\"Hello\"}],\"tools\":[],\"context\":[],\"forwardedProps\":{}}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                       .typeId(zilla:id("http"))
                       .header(":status", "200")
                       .header("content-type", "text/event-stream")
                       .build()}

read "{\"type\":\"RUN_STARTED\",\"threadId\":\"thread-1\",\"runId\":\"run-1\"}"
read "{\"type\":\"SUBAGENT_STARTED\",\"subagentRunId\":\"sub-1\",\"name\":\"researcher\",\"description\":\"Finds sources\",\"parentToolCallId\":\"call-1\"}"
read "{\"type\":\"TEXT_MESSAGE_START\",\"messageId\":\"msg-2\",\"role\":\"assistant\",\"subagentRunId\":\"sub-1\"}"
read "{\"type\":\"TEXT_MESSAGE_CONTENT\",\"messageId\":\"msg-2\",\"delta\":\"Found it\",\"subagentRunId\":\"sub-1\"}"
read "{\"type\":\"TEXT_MESSAGE_END\",\"messageId\":\"msg-2\",\"subagentRunId\":\"sub-1\"}"
read "{\"type\":\"SUBAGENT_FINISHED\",\"subagentRunId\":\"sub-1\",\"result\":{\"found\":3},\"outcome\":{\"type\":\"success\"}}"
read "{\"type\":\"SUBAGENT_STARTED\",\"subagentRunId\":\"sub-2\",\"name\":\"writer\"}"
read "{\"type\":\"SUBAGENT_ERROR\",\"subagentRunId\":\"sub-2\",\"message\":\"boom\",\"code\":\"failed\"}"
read "{\"type\":\"RUN_FINISHED\",\"threadId\":\"thread-1\",\"runId\":\"run-1\"}"

read closed
