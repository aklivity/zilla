accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                       .typeId(zilla:id("http"))
                       .header(":method", "POST")
                       .header(":scheme", "http")
                       .header(":authority", "localhost:8080")
                       .header(":path", "/agent")
                       .header("content-type", "application/json")
                       .header("accept", "text/event-stream")
                       .build()}

connected

read "{\"threadId\":\"thread-1\",\"runId\":\"run-1\",\"messages\":[{\"id\":\"msg-1\",\"role\":\"user\",\"content\":\"Hello\"}],\"tools\":[],\"context\":[],\"forwardedProps\":{}}"

read closed

write zilla:begin.ext ${http:beginEx()
                        .typeId(zilla:id("http"))
                        .header(":status", "200")
                        .header("content-type", "text/event-stream")
                        .build()}
write flush

write "{\"type\":\"RUN_STARTED\",\"threadId\":\"thread-1\",\"runId\":\"run-1\"}"
write "{\"type\":\"TOOL_CALL_START\",\"toolCallId\":\"call-1\",\"toolCallName\":\"get_weather\",\"parentMessageId\":\"msg-2\"}"
write "{\"type\":\"TOOL_CALL_ARGS\",\"toolCallId\":\"call-1\",\"delta\":\"{}\"}"
write "{\"type\":\"TOOL_CALL_END\",\"toolCallId\":\"call-1\"}"
write option zilla:flags "init"
write "{\"type\":\"TOOL_CALL_RESULT\",\"messageId\":\"msg-3\",\"toolCallId\":\"call-1\",\"content\":[{\"type\":\"text\",\"text\":\"Sunny\"},"
write option zilla:flags "fin"
write "{\"type\":\"image\",\"source\":{\"type\":\"url\",\"value\":\"https://example.com/sun.png\",\"mimeType\":\"image/png\"}}]}"
write option zilla:flags "auto"
write "{\"type\":\"RUN_FINISHED\",\"threadId\":\"thread-1\",\"runId\":\"run-1\"}"

write close
