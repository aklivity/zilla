connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${agui:beginEx()
                        .typeId(zilla:id("agui"))
                        .threadId("thread-1")
                        .runId("run-1")
                        .build()}

connected

write "{\"threadId\":\"thread-1\",\"runId\":\"run-1\",\"messages\":[{\"id\":\"msg-1\",\"role\":\"user\",\"content\":\"Hello\"}],\"tools\":[],\"context\":[],\"forwardedProps\":{}}"
write close

read zilla:begin.ext ${agui:matchBeginEx()
                       .typeId(zilla:id("agui"))
                       .threadId("thread-1")
                       .runId("run-1")
                       .build()}

read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .toolCall()
                          .toolCallId("call-1")
                          .toolCallName("get_weather")
                          .parentMessageId("msg-2")
                          .build()
                      .build()}
read "{}"

read option zilla:flags "init"
read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .toolResult()
                          .messageId("msg-3")
                          .toolCallId("call-1")
                          .content("PARTS")
                          .build()
                      .build()}
read "[{\"type\":\"text\",\"text\":\"Sunny\"},"
read option zilla:flags "fin"
read "{\"type\":\"image\",\"source\":{\"type\":\"url\",\"value\":\"https://example.com/sun.png\",\"mimeType\":\"image/png\"}}]"

read zilla:end.ext ${agui:matchEndEx()
                     .typeId(zilla:id("agui"))
                     .build()}

read closed
