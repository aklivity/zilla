connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${agui:beginEx()
                        .typeId(zilla:id("agui"))
                        .threadId("thread-1")
                        .runId("run-1")
                        .build()}

connected

write "{\"threadId\":\"thread-1\",\"runId\":\"run-1\",\"messages\":[{\"id\":\"msg-1\",\"role\":\"user\",\"content\":\"Hello\"}],\"tools\":[],\"context\":[],\"forwardedProps\":{}}"
write close

read zilla:begin.ext ${agui:matchBeginEx()
                       .typeId(zilla:id("agui"))
                       .threadId("thread-1")
                       .runId("run-1")
                       .build()}

read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .subagent()
                          .type("STARTED")
                          .subagentRunId("sub-1")
                          .name("researcher")
                          .description("Finds sources")
                          .parentToolCallId("call-1")
                          .build()
                      .build()}
read zilla:data.empty

read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .text()
                          .subagent("sub-1")
                          .messageId("msg-2")
                          .role("ASSISTANT")
                          .build()
                      .build()}
read "Found it"

read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .subagent()
                          .type("FINISHED")
                          .subagentRunId("sub-1")
                          .outcome("SUCCESS")
                          .build()
                      .build()}
read "{\"found\":3}"

read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .subagent()
                          .type("STARTED")
                          .subagentRunId("sub-2")
                          .name("writer")
                          .build()
                      .build()}
read zilla:data.empty

read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .subagent()
                          .type("ERROR")
                          .subagentRunId("sub-2")
                          .code("failed")
                          .message("boom")
                          .build()
                      .build()}
read zilla:data.empty

read zilla:end.ext ${agui:matchEndEx()
                     .typeId(zilla:id("agui"))
                     .build()}

read closed
