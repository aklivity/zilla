accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${agui:matchBeginEx()
                       .typeId(zilla:id("agui"))
                       .threadId("thread-1")
                       .runId("run-1")
                       .build()}

connected

read "{\"threadId\":\"thread-1\",\"runId\":\"run-1\",\"messages\":[{\"id\":\"msg-1\",\"role\":\"user\",\"content\":\"Hello\"}],\"tools\":[],\"context\":[],\"forwardedProps\":{}}"

read closed

write zilla:begin.ext ${agui:beginEx()
                        .typeId(zilla:id("agui"))
                        .threadId("thread-1")
                        .runId("run-1")
                        .build()}
write flush

write zilla:data.ext ${agui:dataEx()
                       .typeId(zilla:id("agui"))
                       .subagent()
                           .type("STARTED")
                           .subagentRunId("sub-1")
                           .name("researcher")
                           .description("Finds sources")
                           .parentToolCallId("call-1")
                           .build()
                       .build()}
write zilla:data.empty
write flush

write zilla:data.ext ${agui:dataEx()
                       .typeId(zilla:id("agui"))
                       .text()
                           .subagent("sub-1")
                           .messageId("msg-2")
                           .role("ASSISTANT")
                           .build()
                       .build()}
write "Found it"
write flush

write zilla:data.ext ${agui:dataEx()
                       .typeId(zilla:id("agui"))
                       .subagent()
                           .type("FINISHED")
                           .subagentRunId("sub-1")
                           .build()
                       .build()}
write "{\"result\":{\"found\":3}}"
write flush

write zilla:data.ext ${agui:dataEx()
                       .typeId(zilla:id("agui"))
                       .subagent()
                           .type("STARTED")
                           .subagentRunId("sub-2")
                           .name("writer")
                           .build()
                       .build()}
write zilla:data.empty
write flush

write zilla:data.ext ${agui:dataEx()
                       .typeId(zilla:id("agui"))
                       .subagent()
                           .type("ERROR")
                           .subagentRunId("sub-2")
                           .code("failed")
                           .message("boom")
                           .build()
                       .build()}
write zilla:data.empty
write flush

write zilla:end.ext ${agui:endEx()
                      .typeId(zilla:id("agui"))
                      .build()}

write close
