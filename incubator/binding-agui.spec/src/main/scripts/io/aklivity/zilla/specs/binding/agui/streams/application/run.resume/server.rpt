accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${agui:matchBeginEx()
                       .typeId(zilla:id("agui"))
                       .threadId("thread-1")
                       .runId("run-2")
                       .parentRunId("run-0")
                       .build()}

connected

read "{\"threadId\":\"thread-1\",\"runId\":\"run-2\",\"parentRunId\":\"run-0\",\"messages\":[],\"resume\":[{\"interruptId\":\"int-1\",\"status\":\"resolved\",\"payload\":{\"approved\":true}}]}"

read closed

write zilla:begin.ext ${agui:beginEx()
                        .typeId(zilla:id("agui"))
                        .threadId("thread-1")
                        .runId("run-2")
                        .parentRunId("run-0")
                        .build()}
write flush

write zilla:end.ext ${agui:endEx()
                      .typeId(zilla:id("agui"))
                      .build()}

write close
