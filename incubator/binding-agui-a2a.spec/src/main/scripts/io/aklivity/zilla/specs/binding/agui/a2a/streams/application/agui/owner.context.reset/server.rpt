accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${agui:matchBeginEx()
                           .typeId(zilla:id("agui"))
                           .threadId("thread-1")
                           .runId("run-1")
                           .agent("weather")
                           .build()}

connected

read "{\"threadId\":\"thread-1\",\"runId\":\"run-1\",\"state\":{},\"messages\":[{\"id\":\"msg-1\",\"role\":\"user\",\"content\":\"Hello\"},{\"id\":\"msg-2\",\"role\":\"assistant\",\"content\":\"Hi\"},{\"id\":\"msg-3\",\"role\":\"user\",\"content\":\"Hello again\"}],\"tools\":[],\"context\":[],\"forwardedProps\":{}}"

read closed

write zilla:begin.ext ${agui:beginEx()
                            .typeId(zilla:id("agui"))
                            .threadId("thread-1")
                            .runId("run-1")
                            .build()}
write flush

write zilla:data.ext ${agui:dataEx()
                           .typeId(zilla:id("agui"))
                           .state()
                               .type("MESSAGES_SNAPSHOT")
                               .build()
                           .build()}
write "[{\"id\":\"msg-3\",\"role\":\"user\",\"content\":\"Hello again\"}]"
write flush

write option zilla:flags "init"
write zilla:data.ext ${agui:dataEx()
                           .typeId(zilla:id("agui"))
                           .text()
                               .messageId("a-1")
                               .role("ASSISTANT")
                               .build()
                           .build()}
write zilla:data.empty
write flush
write option zilla:flags "none"
write "ok"
write flush
write option zilla:flags "fin"
write zilla:data.empty
write flush

write zilla:end.ext ${agui:endEx()
                          .typeId(zilla:id("agui"))
                          .build()}

write close
