property authorization 0L

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .agentCard()
                               .agent("weather")
                               .build()
                           .build()}

connected

read '{"name":"Weather Agent","description":"Answers weather questions","supportedInterfaces":[{"url":"http://localhost:9090/a2a","protocolBinding":"JSONRPC","protocolVersion":"1.0"}],"version":"1.0.0","capabilities":{"streaming":true},"defaultInputModes":["text/plain"],"defaultOutputModes":["text/plain"],"skills":[{"id":"weather","name":"Weather","description":"Current weather","tags":["weather"]}]}'

read closed

write close

read notify STREAM_1

connect await STREAM_1
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageStream()
                               .agent("weather")
                               .contentLength(152)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"msg-1","role":"ROLE_USER","parts":[{"text":"Hello"}]},"configuration":{"historyLength":0,"acceptedOutputModes":["text/plain"]}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .task()
                             .taskId("t-1")
                             .contextId("c-1")
                             .state("SUBMITTED")
                             .build()
                         .build()}
read '{"task":{"id":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_SUBMITTED"}}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .artifactUpdate()
                             .taskId("t-1")
                             .contextId("c-1")
                             .artifactId("a-1")
                             .build()
                         .build()}
read '{"artifactUpdate":{"taskId":"t-1","contextId":"c-1","artifact":{"artifactId":"a-1","parts":[{"text":"ok"}]}}}'

write abort
read abort

read notify STREAM_2

connect await STREAM_2
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .tasksCancel()
                               .agent("weather")
                               .taskId("t-1")
                               .build()
                           .build()}

connected

read zilla:reset.ext ${a2a:matchResetEx()
                          .typeId(zilla:id("a2a"))
                          .error()
                              .code(-32002)
                              .message("Task cannot be canceled")
                              .build()
                          .build()}

write aborted
