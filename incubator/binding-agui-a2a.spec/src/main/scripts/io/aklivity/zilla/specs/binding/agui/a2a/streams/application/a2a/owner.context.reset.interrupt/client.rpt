property authorization 0L

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .agentCard()
                               .agent("weather")
                               .build()
                           .build()}

connected

read '{"name":"Weather Agent","description":"Answers weather questions","supportedInterfaces":[{"url":"http://localhost:9090/a2a","protocolBinding":"JSONRPC","protocolVersion":"1.0"}],"version":"1.0.0","capabilities":{"streaming":true},"defaultInputModes":["text/plain"],"defaultOutputModes":["text/plain"],"skills":[{"id":"weather","name":"Weather","description":"Current weather","tags":["weather"]}]}'

read closed

write close

read notify STREAM_1

connect await STREAM_1
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageStream()
                               .agent("weather")
                               .contentLength(158)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"msg-3","role":"ROLE_USER","parts":[{"text":"Hello again"}]},"configuration":{"historyLength":0,"acceptedOutputModes":["text/plain"]}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .task()
                             .taskId("t-1")
                             .contextId("c-1")
                             .state("SUBMITTED")
                             .build()
                         .build()}
read '{"task":{"id":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_SUBMITTED"}}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .statusUpdate()
                             .taskId("t-1")
                             .contextId("c-1")
                             .state("INPUT_REQUIRED")
                             .build()
                         .build()}
read '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_INPUT_REQUIRED","message":{"messageId":"m-2","role":"ROLE_AGENT","parts":[{"text":"Proceed?"}]}}}}'

read closed

write close
