property authorization 0L

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .agentCard()
                               .agent("weather")
                               .build()
                           .build()}

connected

read '{"name":"Weather Agent","description":"Answers weather questions","supportedInterfaces":[{"url":"http://localhost:9090/a2a","protocolBinding":"JSONRPC","protocolVersion":"1.0"}],"version":"1.0.0","capabilities":{"streaming":true,"extensions":[{"uri":"https://a2a.aklivity.io/ext/agui/v1","required":false,"params":{"features":["state"]}}]},"defaultInputModes":["text/plain","application/json"],"defaultOutputModes":["text/plain"],"skills":[{"id":"weather","name":"Weather","description":"Current weather","tags":["weather"]}]}'

read closed

write close

read notify STREAM_1

connect await STREAM_1
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageStream()
                               .agent("weather")
                               .extensions("https://a2a.aklivity.io/ext/agui/v1")
                               .contentLength(325)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"msg-1","role":"ROLE_USER","parts":[{"text":"Hello"},{"data":{"context":[{"description":"locale","value":"en-US"}]},"mediaType":"application/json","metadata":{"agui":{"part":"input"}}}],"metadata":{"agui":{"state":{"step":2}}}},"configuration":{"historyLength":0,"acceptedOutputModes":["text/plain"]}}'

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .messageStream()
                              .extensions("https://a2a.aklivity.io/ext/agui/v1")
                              .build()
                          .build()}

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .message()
                             .build()
                         .build()}
read '{"message":{"messageId":"m-2","role":"ROLE_AGENT","parts":[{"text":"ok"}]}}'

read closed

write close
