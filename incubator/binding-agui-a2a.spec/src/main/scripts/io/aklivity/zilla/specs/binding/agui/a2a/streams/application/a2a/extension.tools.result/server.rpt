property authorization 0L

property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"
       option zilla:authorization ${authorization}

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .agentCard()
                              .agent("weather")
                              .build()
                          .build()}

connected

write flush

write '{"name":"Weather Agent","description":"Answers weather questions","supportedInterfaces":[{"url":"http://localhost:9090/a2a","protocolBinding":"JSONRPC","protocolVersion":"1.0"}],"version":"1.0.0","capabilities":{"streaming":true,"extensions":[{"uri":"https://a2a.aklivity.io/ext/agui/v1","required":false,"params":{"features":["tools","toolCalls"]}}]},"defaultInputModes":["text/plain","application/json"],"defaultOutputModes":["text/plain"],"skills":[{"id":"weather","name":"Weather","description":"Current weather","tags":["weather"]}]}'
write flush

write close

read closed

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .messageStream()
                              .agent("weather")
                              .extensions("https://a2a.aklivity.io/ext/agui/v1")
                              .contentLength(450)
                              .build()
                          .build()}

connected

read '{"message":{"messageId":"run-1","role":"ROLE_USER","taskId":"t-1","parts":[{"data":{"type":"tool-result","toolCallId":"call-7","payload":"{\"lat\":40.7}"},"mediaType":"application/json","metadata":{"agui":{"event":"toolResult"}}}],"metadata":{"agui":{"tools":[{"name":"get_location","description":"Reads the device location","parameters":{"type":"object","properties":{}}}]}}},"configuration":{"historyLength":0,"acceptedOutputModes":["text/plain"]}}'

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageStream()
                               .extensions("https://a2a.aklivity.io/ext/agui/v1")
                               .build()
                           .build()}
write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .message()
                              .messageId("m-2")
                              .build()
                          .build()}
write '{"message":{"messageId":"m-2","role":"ROLE_AGENT","parts":[{"text":"ok"}]}}'
write flush

write close

read closed
