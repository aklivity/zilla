connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${agui:beginEx()
                            .typeId(zilla:id("agui"))
                            .threadId("thread-1")
                            .runId("run-1")
                            .agent("weather")
                            .build()}

connected

write "{\"threadId\":\"thread-1\",\"runId\":\"run-1\",\"state\":{},\"messages\":[{\"id\":\"msg-1\",\"role\":\"user\",\"content\":\"Delete it\"}],\"tools\":[],\"context\":[],\"forwardedProps\":{}}"
write close

read zilla:begin.ext ${agui:matchBeginEx()
                           .typeId(zilla:id("agui"))
                           .threadId("thread-1")
                           .runId("run-1")
                           .build()}

read zilla:end.ext ${agui:matchEndEx()
                         .typeId(zilla:id("agui"))
                         .outcome("INTERRUPT")
                         .build()}

read closed

read notify RUN_1

connect await RUN_1
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${agui:beginEx()
                            .typeId(zilla:id("agui"))
                            .threadId("thread-1")
                            .runId("run-2")
                            .parentRunId("run-1")
                            .agent("weather")
                            .build()}

connected

write "{\"threadId\":\"thread-1\",\"runId\":\"run-2\",\"parentRunId\":\"run-1\",\"state\":{},\"messages\":[{\"id\":\"msg-1\",\"role\":\"user\",\"content\":\"Delete it\"}],\"tools\":[],\"context\":[],\"forwardedProps\":{},\"resume\":[{\"interruptId\":\"h-1\",\"status\":\"resolved\",\"payload\":\"yes\"}]}"
write close

read zilla:begin.ext ${agui:matchBeginEx()
                           .typeId(zilla:id("agui"))
                           .threadId("thread-1")
                           .runId("run-2")
                           .parentRunId("run-1")
                           .build()}

read option zilla:flags "init"
read zilla:data.ext ${agui:matchDataEx()
                          .typeId(zilla:id("agui"))
                          .text()
                              .messageId("a-1")
                              .role("ASSISTANT")
                              .build()
                          .build()}
read "ok"
read option zilla:flags "fin"
read zilla:data.empty

read zilla:end.ext ${agui:matchEndEx()
                         .typeId(zilla:id("agui"))
                         .build()}

read closed
