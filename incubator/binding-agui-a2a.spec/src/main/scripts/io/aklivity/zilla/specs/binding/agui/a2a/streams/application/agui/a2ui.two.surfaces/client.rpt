connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${agui:beginEx()
                        .typeId(zilla:id("agui"))
                        .threadId("thread-1")
                        .runId("run-1")
                        .build()}

connected

write '{"threadId":"thread-1","runId":"run-1","messages":[{"id":"msg-1","role":"user","content":"Hello"}],"tools":[],"context":[],"forwardedProps":{"a2uiClientCapabilities":{"v0.9":{"supportedCatalogIds":["basic"]}}}}'

write close

read zilla:begin.ext ${agui:matchBeginEx()
                       .typeId(zilla:id("agui"))
                       .threadId("thread-1")
                       .runId("run-1")
                       .build()}

read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .activity()
                          .type("SNAPSHOT")
                          .messageId("s-1")
                          .activityType("a2ui-surface")
                          .build()
                      .build()}
read '{"a2ui_operations":[]}'

read option zilla:flags "init"
read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .activity()
                          .type("DELTA")
                          .messageId("s-1")
                          .activityType("a2ui-surface")
                          .build()
                      .build()}
read '[{"op":"add","path":"/a2ui_operations/-","value":'

read option zilla:flags "none"
read '{"version":"v0.9","createSurface":{"surfaceId":"s-1","catalogId":"basic"}}'

read option zilla:flags "fin"
read '}]'

read option zilla:flags "auto"
read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .activity()
                          .type("SNAPSHOT")
                          .messageId("s-2")
                          .activityType("a2ui-surface")
                          .build()
                      .build()}
read '{"a2ui_operations":[]}'

read option zilla:flags "init"
read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .activity()
                          .type("DELTA")
                          .messageId("s-2")
                          .activityType("a2ui-surface")
                          .build()
                      .build()}
read '[{"op":"add","path":"/a2ui_operations/-","value":'

read option zilla:flags "none"
read '{"version":"v0.9","createSurface":{"surfaceId":"s-2","catalogId":"basic"}}'

read option zilla:flags "fin"
read '}]'

read option zilla:flags "init"
read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .activity()
                          .type("DELTA")
                          .messageId("s-1")
                          .activityType("a2ui-surface")
                          .build()
                      .build()}
read '[{"op":"add","path":"/a2ui_operations/-","value":'

read option zilla:flags "none"
read '{"version":"v0.9","updateComponents":{"surfaceId":"s-1","components":[{"id":"root","component":"Text","text":"Hi"}]}}'

read option zilla:flags "fin"
read '}]'

read zilla:end.ext ${agui:matchEndEx()
                     .typeId(zilla:id("agui"))
                     .outcome("SUCCESS")
                     .build()}
read closed
