connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${agui:beginEx()
                        .typeId(zilla:id("agui"))
                        .threadId("thread-1")
                        .runId("run-1")
                        .build()}

connected

write '{"threadId":"thread-1","runId":"run-1","messages":[{"id":"msg-1","role":"user","content":"Hello"}],"tools":[],"context":[],"forwardedProps":{}}'

write close

read zilla:begin.ext ${agui:matchBeginEx()
                       .typeId(zilla:id("agui"))
                       .threadId("thread-1")
                       .runId("run-1")
                       .build()}

read option zilla:flags "init"
read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .text()
                          .subagent("sub-1")
                          .messageId("a-1")
                          .role("ASSISTANT")
                          .build()
                      .build()}
read 'Inside'

read option zilla:flags "fin"
read zilla:data.empty

read option zilla:flags "init"
read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .text()
                          .messageId("a-2")
                          .role("ASSISTANT")
                          .build()
                      .build()}
read 'Outside'

read option zilla:flags "fin"
read zilla:data.empty

read option zilla:flags "auto"
read zilla:data.ext ${agui:matchDataEx()
                      .typeId(zilla:id("agui"))
                      .state()
                          .subagent("sub-2")
                          .type("SNAPSHOT")
                          .build()
                      .build()}
read '{"units":"metric"}'

read zilla:end.ext ${agui:matchEndEx()
                     .typeId(zilla:id("agui"))
                     .outcome("SUCCESS")
                     .build()}
read closed
