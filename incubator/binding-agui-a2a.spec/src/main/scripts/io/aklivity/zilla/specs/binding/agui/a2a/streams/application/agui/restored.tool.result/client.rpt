connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${agui:beginEx()
                            .typeId(zilla:id("agui"))
                            .threadId("thread-1")
                            .runId("run-2")
                            .parentRunId("run-1")
                            .agent("weather")
                            .build()}

connected

write "{\"threadId\":\"thread-1\",\"runId\":\"run-2\",\"parentRunId\":\"run-1\",\"state\":{},\"messages\":[{\"id\":\"msg-1\",\"role\":\"user\",\"content\":\"Where am I\"},{\"id\":\"msg-2\",\"role\":\"assistant\",\"toolCalls\":[{\"id\":\"h-8\",\"type\":\"function\",\"function\":{\"name\":\"get_location\",\"arguments\":\"{}\"}}]},{\"id\":\"msg-3\",\"role\":\"tool\",\"toolCallId\":\"h-8\",\"content\":\"lat=40.7\"}],\"tools\":[{\"name\":\"get_location\",\"description\":\"Reads the device location\",\"parameters\":{\"type\":\"object\",\"properties\":{}}}],\"context\":[],\"forwardedProps\":{}}"
write close

read zilla:begin.ext ${agui:matchBeginEx()
                           .typeId(zilla:id("agui"))
                           .threadId("thread-1")
                           .runId("run-2")
                           .parentRunId("run-1")
                           .build()}

read option zilla:flags "init"
read zilla:data.ext ${agui:matchDataEx()
                          .typeId(zilla:id("agui"))
                          .text()
                              .messageId("a-1")
                              .role("ASSISTANT")
                              .build()
                          .build()}
read "ok"
read option zilla:flags "fin"
read zilla:data.empty

read zilla:end.ext ${agui:matchEndEx()
                         .typeId(zilla:id("agui"))
                         .build()}

read closed
