accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${agui:matchBeginEx()
                       .typeId(zilla:id("agui"))
                       .threadId("thread-1")
                       .runId("run-1")
                       .build()}

connected

read '{"threadId":"thread-1","runId":"run-1","messages":[{"id":"msg-1","role":"user","content":"Hello"}],"tools":[],"context":[],"forwardedProps":{"a2uiClientDataModel":{"version":"v0.9"}}}'

read closed

write zilla:begin.ext ${agui:beginEx()
                        .typeId(zilla:id("agui"))
                        .threadId("thread-1")
                        .runId("run-1")
                        .build()}
write flush

write zilla:data.ext ${agui:dataEx()
                       .typeId(zilla:id("agui"))
                       .custom()
                           .name("agent.data")
                           .build()
                       .build()}
write '[{"version":"v0.9","createSurface":{"surfaceId":"s-1","catalogId":"basic"}}]'
write flush

write zilla:end.ext ${agui:endEx()
                      .typeId(zilla:id("agui"))
                      .outcome("SUCCESS")
                      .build()}
write close
