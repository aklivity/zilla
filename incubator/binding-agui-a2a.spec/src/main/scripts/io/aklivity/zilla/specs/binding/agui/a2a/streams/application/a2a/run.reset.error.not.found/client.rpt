connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .agentCard()
                               .build()
                           .build()}

connected

read '{"name":"Weather Agent","description":"Answers weather questions","supportedInterfaces":[{"url":"http://localhost:9090/a2a","protocolBinding":"JSONRPC","protocolVersion":"1.0"}],"version":"1.0.0","capabilities":{"streaming":true,"pushNotifications":false},"defaultInputModes":["text/plain"],"defaultOutputModes":["text/plain"],"skills":[{"id":"weather","name":"Weather","description":"Current weather","tags":["weather"]}]}'

read notify CARD

read closed

write close

connect await CARD
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageStream()
                               .contentLength(152)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"msg-1","role":"ROLE_USER","parts":[{"text":"Hello"}]},"configuration":{"historyLength":0,"acceptedOutputModes":["text/plain"]}}'

read zilla:reset.ext ${a2a:matchResetEx()
                          .typeId(zilla:id("a2a"))
                          .error()
                              .code(404)
                              .message("Agent not found")
                              .build()
                          .build()}

write aborted
