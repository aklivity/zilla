connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .agentCard()
                               .agent("billing")
                               .build()
                           .build()}

connected

read '{"name":"Weather Agent","description":"Answers weather questions","supportedInterfaces":[{"url":"http://localhost:9090/a2a","protocolBinding":"JSONRPC","protocolVersion":"1.0"}],"version":"1.0.0","capabilities":{"streaming":true,"pushNotifications":false},"defaultInputModes":["text/plain"],"defaultOutputModes":["text/plain"],"skills":[{"id":"weather","name":"Weather","description":"Current weather","tags":["weather"]}]}'

read notify CARD

read closed

write close

connect await CARD
        "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageStream()
                               .agent("billing")
                               .contentLength(152)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"msg-1","role":"ROLE_USER","parts":[{"text":"Hello"}]},"configuration":{"historyLength":0,"acceptedOutputModes":["text/plain"]}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .artifactUpdate()
                             .taskId("t-1")
                             .contextId("c-1")
                             .artifactId("a-1")
                             .build()
                         .build()}
read '{"artifactUpdate":{"taskId":"t-1","contextId":"c-1","artifact":{"artifactId":"a-1","parts":[{"text":"Hello"}]},"append":false,"lastChunk":true}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .statusUpdate()
                             .taskId("t-1")
                             .contextId("c-1")
                             .state("COMPLETED")
                             .build()
                         .build()}
read '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}}'

read closed

write close
