accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${agui:matchBeginEx()
                       .typeId(zilla:id("agui"))
                       .threadId("thread-1")
                       .runId("run-1")
                       .build()}

connected

read '{"threadId":"thread-1","runId":"run-1","messages":[{"id":"msg-1","role":"user","content":"Hello"}],"tools":[],"context":[],"forwardedProps":{"a2uiClientCapabilities":{"v0.9":{"supportedCatalogIds":["basic"]}}}}'

read closed

write zilla:begin.ext ${agui:beginEx()
                        .typeId(zilla:id("agui"))
                        .threadId("thread-1")
                        .runId("run-1")
                        .build()}
write flush

write zilla:data.ext ${agui:dataEx()
                       .typeId(zilla:id("agui"))
                       .activity()
                           .type("SNAPSHOT")
                           .messageId("s-1")
                           .activityType("a2ui-surface")
                           .build()
                       .build()}
write '{"a2ui_operations":[]}'
write flush

write option zilla:flags "init"
write zilla:data.ext ${agui:dataEx()
                       .typeId(zilla:id("agui"))
                       .activity()
                           .type("DELTA")
                           .messageId("s-1")
                           .activityType("a2ui-surface")
                           .build()
                       .build()}
write '[{"op":"add","path":"/a2ui_operations/-","value":'
write flush

write option zilla:flags "none"
write '{"version":"v0.9","createSurface":{"surfaceId":"s-1","catalogId":"basic"}}'
write flush

write option zilla:flags "fin"
write '}]'
write flush

write option zilla:flags "init"
write zilla:data.ext ${agui:dataEx()
                       .typeId(zilla:id("agui"))
                       .activity()
                           .type("DELTA")
                           .messageId("s-1")
                           .activityType("a2ui-surface")
                           .build()
                       .build()}
write '[{"op":"add","path":"/a2ui_operations/-","value":'
write flush

write option zilla:flags "none"
write '{"version":"v0.9","updateComponents":{"surfaceId":"s-1","components":[{"id":"root","component":"Text","text":"Hi"}]}}'
write flush

write option zilla:flags "fin"
write '}]'
write flush

write option zilla:flags "auto"
write zilla:end.ext ${agui:endEx()
                      .typeId(zilla:id("agui"))
                      .outcome("SUCCESS")
                      .build()}
write close
