property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .agentCard()
                              .build()
                          .build()}

connected

write flush

write '{"name":"Weather Agent","description":"Answers weather questions","supportedInterfaces":[{"url":"http://localhost:9090/a2a","protocolBinding":"JSONRPC","protocolVersion":"1.0"}],"version":"1.0.0","capabilities":{"streaming":true,"pushNotifications":false},"defaultInputModes":["text/plain"],"defaultOutputModes":["text/plain"],"skills":[{"id":"weather","name":"Weather","description":"Current weather","tags":["weather"]}]}'
write flush

write close

read closed

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .messageStream()
                              .contentLength(152)
                              .build()
                          .build()}

connected

read '{"message":{"messageId":"msg-1","role":"ROLE_USER","parts":[{"text":"Hello"}]},"configuration":{"historyLength":0,"acceptedOutputModes":["text/plain"]}}'

write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .task()
                              .taskId("t-1")
                              .contextId("c-1")
                              .state("SUBMITTED")
                              .build()
                          .build()}
write '{"task":{"id":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_SUBMITTED"}}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .statusUpdate()
                              .taskId("t-1")
                              .contextId("c-1")
                              .state("INPUT_REQUIRED")
                              .build()
                          .build()}
write '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_INPUT_REQUIRED","message":{"messageId":"m-2","role":"ROLE_AGENT","parts":[{"text":"Which city?"}]}}}}'
write flush

write close

read closed
