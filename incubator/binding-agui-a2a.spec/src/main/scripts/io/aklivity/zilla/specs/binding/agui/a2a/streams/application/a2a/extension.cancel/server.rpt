property authorization 0L

property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"
       option zilla:authorization ${authorization}

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .agentCard()
                              .agent("weather")
                              .build()
                          .build()}

connected

write flush

write '{"name":"Weather Agent","description":"Answers weather questions","supportedInterfaces":[{"url":"http://localhost:9090/a2a","protocolBinding":"JSONRPC","protocolVersion":"1.0"}],"version":"1.0.0","capabilities":{"streaming":true,"extensions":[{"uri":"https://a2a.aklivity.io/ext/agui/v1","required":false,"params":{"features":["state","activity","reasoning","steps","toolCalls","custom"]}}]},"defaultInputModes":["text/plain"],"defaultOutputModes":["text/plain"],"skills":[{"id":"weather","name":"Weather","description":"Current weather","tags":["weather"]}]}'
write flush

write close

read closed

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .messageStream()
                              .agent("weather")
                              .extensions("https://a2a.aklivity.io/ext/agui/v1")
                              .contentLength(152)
                              .build()
                          .build()}

connected

read '{"message":{"messageId":"msg-1","role":"ROLE_USER","parts":[{"text":"Hello"}]},"configuration":{"historyLength":0,"acceptedOutputModes":["text/plain"]}}'

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageStream()
                               .extensions("https://a2a.aklivity.io/ext/agui/v1")
                               .build()
                           .build()}
write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .task()
                              .taskId("t-1")
                              .contextId("c-1")
                              .state("SUBMITTED")
                              .build()
                          .build()}
write '{"task":{"id":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_SUBMITTED"}}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .artifactUpdate()
                              .taskId("t-1")
                              .contextId("c-1")
                              .artifactId("a-1")
                              .build()
                          .build()}
write '{"artifactUpdate":{"taskId":"t-1","contextId":"c-1","artifact":{"artifactId":"a-1","parts":[{"text":"ok"}]}}}'
write flush

read aborted
write aborted

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .tasksCancel()
                              .agent("weather")
                              .extensions("https://a2a.aklivity.io/ext/agui/v1")
                              .taskId("t-1")
                              .build()
                          .build()}

connected

write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .task()
                              .taskId("t-1")
                              .contextId("c-1")
                              .state("CANCELED")
                              .build()
                          .build()}
write '{"id":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_CANCELED"}}'
write flush

write close

read closed
