connect "http://localhost:3000/analyze"
connected

write http:method "POST"
write http:version "HTTP/1.1"
write http:host
write http:header "Content-Type" "application/json"
write http:content-length
write '{"text":"reach out to jane.doe@example.com for details","language":"en","entities":["EMAIL_ADDRESS"]}'
write close

read http:status "200" "OK"
read http:header "Content-Type" "application/json"
read '[{"analysis_explanation":null,"end":33,"entity_type":"EMAIL_ADDRESS","score":0.99,"start":13}]'
read closed
