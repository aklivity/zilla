accept "zilla://streams/app0"
        option zilla:timestamps "false"
        option zilla:window 8192
        option zilla:transmission "duplex"

accepted

read zilla:begin.ext ${mqtt:matchBeginEx()
                             .typeId(zilla:id("mqtt"))
                             .session()
                                .flags("CLEAN_START")
                                .clientId("client")
                                .build()
                             .build()}

write zilla:begin.ext ${mqtt:beginEx()
                              .typeId(zilla:id("mqtt"))
                              .session()
                                .flags("CLEAN_START")
                                .subscribeQosMax(2)
                                .publishQosMax(2)
                                .packetSizeMax(66560)
                                .capabilities("RETAIN", "WILDCARD", "SUBSCRIPTION_IDS", "SHARED_SUBSCRIPTIONS")
                                .clientId("client")
                                .build()
                              .build()}

connected

write zilla:data.empty
write flush

read zilla:data.ext ${mqtt:dataEx()
                             .typeId(zilla:id("mqtt"))
                             .session()
                                .kind("STATE")
                                .build()
                             .build()}

read ${mqtt:session()
               .sharedSubscription("consumer1", "sensor/one", 1, "AT_LEAST_ONCE")
               .build()}

write ${mqtt:session()
               .sharedSubscription("consumer1", "sensor/one", 1, "AT_LEAST_ONCE")
               .build()}
write flush


read closed
write close

accepted

read zilla:begin.ext ${mqtt:matchBeginEx()
                             .typeId(zilla:id("mqtt"))
                             .subscribe()
                                 .clientId("client")
                                 .sharedFilter("consumer1", "sensor/one", 1, "AT_LEAST_ONCE", "SEND_RETAINED")
                                 .generation(1)
                                 .sharedPacket(7, "PUBLISH_SENT", "EXACTLY_ONCE", "consumer1", "sensor/one", "offset-7")
                                 .build()
                             .build()}

connected

write zilla:data.ext ${mqtt:dataEx()
                             .typeId(zilla:id("mqtt"))
                             .subscribe()
                                 .topic("sensor/one")
                                 .packetId(7)
                                 .qos("EXACTLY_ONCE")
                                 .subscriptionId(1)
                                 .format("TEXT")
                                 .metadata("offset-7")
                                 .build()
                             .build()}

write "message"
write flush

read advised zilla:flush ${mqtt:flushEx()
                                 .typeId(zilla:id("mqtt"))
                                 .subscribe()
                                     .qos("EXACTLY_ONCE")
                                     .packetId(7)
                                     .state("RECORDED")
                                     .build()
                                 .build()}

read closed
write close
