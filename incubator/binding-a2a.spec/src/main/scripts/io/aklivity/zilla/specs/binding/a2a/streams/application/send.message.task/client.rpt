property authorization 0L

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageSend()
                               .version("1.0")
                               .contentLength(104)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"What is the weather in New York?"}]}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .task()
                             .taskId("t-1")
                             .contextId("c-1")
                             .state("COMPLETED")
                             .build()
                         .build()}
read '{"task":{"id":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"},"artifacts":[{"artifactId":"a-1","parts":[{"text":"Partly cloudy, 72F"}]}]}}'

read closed

write close
