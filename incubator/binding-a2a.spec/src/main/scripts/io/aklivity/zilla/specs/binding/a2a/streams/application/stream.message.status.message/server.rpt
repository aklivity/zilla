property authorization 0L

property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"
       option zilla:authorization ${authorization}

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .messageStream()
                              .contentLength(104)
                              .build()
                          .build()}

connected

read '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"What is the weather in New York?"}]}}'

write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .task()
                              .taskId("t-1")
                              .contextId("c-1")
                              .state("SUBMITTED")
                              .build()
                          .build()}
write '{"task":{"id":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_SUBMITTED"}}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .statusUpdate()
                              .taskId("t-1")
                              .contextId("c-1")
                              .state("WORKING")
                              .build()
                          .build()}
write '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_WORKING"}}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .artifactUpdate()
                              .taskId("t-1")
                              .contextId("c-1")
                              .artifactId("a-1")
                              .build()
                          .build()}
write '{"artifactUpdate":{"taskId":"t-1","contextId":"c-1","artifact":{"artifactId":"a-1","parts":[{"text":"Partly cloudy, 72F"}]}}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .statusUpdate()
                              .taskId("t-1")
                              .contextId("c-1")
                              .state("COMPLETED")
                              .messageId("m-2")
                              .build()
                          .build()}
write '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED","message":{"messageId":"m-2","role":"ROLE_AGENT","parts":[{"text":"Partly cloudy, 72F"}]}}}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                          .typeId(zilla:id("a2a"))
                          .task()
                              .taskId("t-1")
                              .contextId("c-1")
                              .state("COMPLETED")
                              .messageId("m-2")
                              .build()
                          .build()}
write '{"task":{"id":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED","message":{"messageId":"m-2","role":"ROLE_AGENT","parts":[{"text":"Partly cloudy, 72F"}]}},"artifacts":[{"artifactId":"a-1","parts":[{"text":"Partly cloudy, 72F"}]}]}}'
write flush

write close

read closed
