property authorization 0L

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageStream()
                               .contentLength(104)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"What is the weather in New York?"}]}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .task()
                             .taskId("t-1")
                             .contextId("c-1")
                             .state("SUBMITTED")
                             .build()
                         .build()}
read '{"task":{"id":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_SUBMITTED"}}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .statusUpdate()
                             .taskId("t-1")
                             .contextId("c-1")
                             .state("WORKING")
                             .build()
                         .build()}
read '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_WORKING"}}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .statusUpdate()
                             .taskId("t-1")
                             .contextId("c-1")
                             .state("INPUT_REQUIRED")
                             .build()
                         .build()}
read '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_INPUT_REQUIRED","message":{"messageId":"m-2","role":"ROLE_AGENT","parts":[{"text":"Which New York?"}]}}}}'

read closed

write close
