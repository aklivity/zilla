property authorization 0L

property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"
       option zilla:authorization ${authorization}

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .pushNotify()
                              .taskId("t-1")
                              .url("https://client.example.com/hooks/1")
                              .token("tok-1")
                              .scheme("Bearer")
                              .credentials("cred-1")
                              .contentLength(93)
                              .build()
                          .build()}

connected

read '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}}'

write zilla:reset.ext ${a2a:resetEx()
                           .typeId(zilla:id("a2a"))
                           .error()
                               .code(502)
                               .message("Bad Gateway")
                               .build()
                           .build()}

read abort

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .pushNotify()
                              .taskId("t-1")
                              .url("https://client.example.com/hooks/1")
                              .token("tok-1")
                              .scheme("Bearer")
                              .credentials("cred-1")
                              .contentLength(93)
                              .build()
                          .build()}

connected

read abort

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .pushNotify()
                              .taskId("t-1")
                              .url("https://client.example.com/hooks/2")
                              .token("tok-1")
                              .scheme("Bearer")
                              .credentials("cred-1")
                              .contentLength(93)
                              .build()
                          .build()}

connected

read '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}}'

write zilla:reset.ext ${a2a:resetEx()
                           .typeId(zilla:id("a2a"))
                           .error()
                               .code(404)
                               .message("Not Found")
                               .build()
                           .build()}

read abort

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .pushNotify()
                              .taskId("t-1")
                              .url("https://client.example.com/hooks/1")
                              .token("tok-1")
                              .scheme("Bearer")
                              .credentials("cred-1")
                              .contentLength(93)
                              .build()
                          .build()}

connected

read '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}}'

write flush

write close

read closed

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .pushNotify()
                              .taskId("t-1")
                              .url("https://client.example.com/hooks/1")
                              .token("tok-1")
                              .scheme("Bearer")
                              .credentials("cred-1")
                              .contentLength(93)
                              .build()
                          .build()}

connected

read '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}}'

write flush

write close

read closed
