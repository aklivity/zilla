property authorization 0L

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageSend()
                               .agent("weather")
                               .contentLength(272)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"What is the weather in New York?"}]},"configuration":{"taskPushNotificationConfig":{"url":"https://client.example.com/webhook","token":"tok-1","authentication":{"scheme":"Bearer","credentials":"cred-1"}}}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .message()
                             .messageId("m-2")
                             .build()
                         .build()}
read '{"message":{"messageId":"m-2","role":"ROLE_AGENT","parts":[{"text":"Partly cloudy, 72F"}]}}'

read closed

write close
