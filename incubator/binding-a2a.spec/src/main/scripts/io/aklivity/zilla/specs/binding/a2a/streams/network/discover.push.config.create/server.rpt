accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "GET")
                           .header(":path", "/.well-known/agent-card.json")
                           .header("accept", "application/json")
                           .build()}

connected

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "application/json")
                            .header("etag", "\"v1\"")
                            .header("cache-control", "max-age=300")
                            .build()}
write flush

write '{"name":"Weather Agent","description":"Answers weather questions","supportedInterfaces":[{"url":"http://localhost:8080/a2a","protocolBinding":"JSONRPC","protocolVersion":"1.0"}],"version":"1.0.0","capabilities":{"streaming":true,"pushNotifications":true},"defaultInputModes":["text/plain"],"defaultOutputModes":["text/plain"],"skills":[{"id":"weather","name":"Weather","description":"Current weather","tags":["weather"]}]}'
write flush

write close

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":path", "/a2a")
                           .header("content-type", "application/json")
                           .header("accept", "application/json")
                           .header("a2a-version", "1.0")
                           .header("content-length", "241")
                           .build()}

connected

read '{"jsonrpc":"2.0","id":1,"method":"CreateTaskPushNotificationConfig","params":{"taskId":"t-1","configId":"c-1","config":{"url":"https://client.example.com/webhook","token":"tok-1","authentication":{"scheme":"Bearer","credentials":"cred-1"}}}}'
read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "application/json")
                            .build()}
write flush

write '{"jsonrpc":"2.0","id":1,"result":{"id":"c-1","taskId":"t-1","url":"https://client.example.com/webhook","token":"tok-1","authentication":{"scheme":"Bearer","credentials":"cred-1"}}}'
write flush

write close
