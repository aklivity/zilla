connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "localhost:8080")
                            .header(":path", "/a2a")
                            .header("content-type", "application/json")
                            .header("accept", "application/json")
                            .header("a2a-version", "1.0")
                            .header("content-length", "67")
                            .build()}

connected

write '{"jsonrpc":"2.0","id":1,"method":"GetTask","params":{"id":"t-404"}}'
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}

read '{"jsonrpc":"2.0","id":1,"error":{"code":-32001,"message":"Task not found","data":[{"@type":"type.googleapis.com/google.rpc.ErrorInfo","reason":"TASK_NOT_FOUND","domain":"a2a-protocol.org"}]}}'

read closed
