accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":path", "/a2a")
                           .header("content-type", "application/json")
                           .header("accept", "application/json")
                           .header("a2a-version", "0.3")
                           .header("content-length", "91")
                           .build()}

connected

read '{"jsonrpc":"2.0","id":1,"method":"tasks/pushNotificationConfig/list","params":{"id":"t-1"}}'
read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "application/json")
                            .build()}
write flush

write '{"jsonrpc":"2.0","id":1,"result":[{"taskId":"t-1","pushNotificationConfig":{"id":"c-1","url":"https://client.example.com/webhook","token":"tok-1","authentication":{"schemes":["Bearer"],"credentials":"cred-1"}}}]}'
write flush

write close
