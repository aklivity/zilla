property authorization 0L

property sealedUrl "http://localhost:8080/a2a/push/sealed-1"
property nonce "nonce-1"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .pushConfigGet()
                               .agent("weather")
                               .taskId("t-1")
                               .configId("c-1")
                               .build()
                           .build()}

connected

read '{"id":"c-1","taskId":"t-1","url":"' ${sealedUrl} '","token":"' ${nonce} '"}'

read closed

write close
