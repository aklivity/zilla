property authorization 0L

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .pushNotify()
                               .configId("sealed-1")
                               .token("tok-1")
                               .scheme("Bearer")
                               .credentials("cred-1")
                               .contentLength(93)
                               .build()
                           .build()}

connected

write '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}}'

read closed

write close
