accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "GET")
                           .header(":path", "/.well-known/agent-card.json")
                           .header("accept", "application/json")
                           .header("a2a-version", "0.3")
                           .build()}

connected

read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "application/json")
                            .header("etag", "\"v1\"")
                            .header("cache-control", "max-age=300")
                            .build()}
write flush

write '{"name":"Weather Agent","description":"Answers weather questions","url":"http://localhost:8080/a2a","preferredTransport":"JSONRPC","protocolVersion":"0.3.0","version":"1.0.0","capabilities":{"streaming":true,"pushNotifications":true},"defaultInputModes":["text/plain"],"defaultOutputModes":["text/plain"],"skills":[{"id":"weather","name":"Weather","description":"Current weather","tags":["weather"]}]}'
write flush

write close

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":path", "/a2a")
                           .header("content-type", "application/json")
                           .header("accept", "text/event-stream")
                           .header("a2a-version", "0.3")
                           .header("content-length", "190")
                           .build()}

connected

read '{"jsonrpc":"2.0","id":1,"method":"message/stream","params":{"message":{"kind":"message","messageId":"m-1","role":"user","parts":[{"kind":"text","text":"What is the weather in New York?"}]}}}'
read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .header("content-type", "text/event-stream")
                            .build()}
write flush

write '{"jsonrpc":"2.0","id":1,"result":{"kind":"task","id":"t-1","contextId":"c-1","status":{"state":"submitted"}}}'
write flush

write '{"jsonrpc":"2.0","id":1,"result":{"kind":"status-update","taskId":"t-1","contextId":"c-1","status":{"state":"working"},"final":false}}'
write flush

write '{"jsonrpc":"2.0","id":1,"result":{"kind":"artifact-update","taskId":"t-1","contextId":"c-1","artifact":{"artifactId":"a-1","parts":[{"kind":"text","text":"Partly cloudy, 72F"}]}}}'
write flush

write '{"jsonrpc":"2.0","id":1,"result":{"kind":"status-update","taskId":"t-1","contextId":"c-1","status":{"state":"completed"},"final":true}}'
write flush

write close
