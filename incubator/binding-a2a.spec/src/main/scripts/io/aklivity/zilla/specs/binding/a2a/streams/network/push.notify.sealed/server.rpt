property path "/a2a/push/sealed-1"
property token "nonce-1"
property authorizationHeader "Bearer agent-cred-1"
property taskId "t-1"

accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":path", path)
                           .header("content-type", "application/a2a+json")
                           .header("a2a-version", "1.0")
                           .header("x-a2a-notification-token", token)
                           .header("authorization", authorizationHeader)
                           .header("content-length", "93")
                           .build()}

connected

read '{"statusUpdate":{"taskId":"' ${taskId} '","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}}'
read closed

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":status", "200")
                            .build()}
write flush

write close
