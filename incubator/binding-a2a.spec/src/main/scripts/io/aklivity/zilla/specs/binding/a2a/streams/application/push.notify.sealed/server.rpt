property authorization 0L

property serverAddress "zilla://streams/app0"

property sealed "sealed-1"
property token "nonce-1"
property credentials "agent-cred-1"
property taskId "t-1"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"
       option zilla:authorization ${authorization}

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .pushNotify()
                              .configId(sealed)
                              .token(token)
                              .scheme("Bearer")
                              .credentials(credentials)
                              .contentLength(93)
                              .build()
                          .build()}

connected

read '{"statusUpdate":{"taskId":"' ${taskId} '","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}}'

write flush

write close

read closed
