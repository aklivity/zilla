connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "client.example.com")
                            .header(":path", "/hooks/1")
                            .header("content-type", "application/a2a+json")
                            .header("a2a-version", "1.0")
                            .header("x-a2a-notification-token", "tok-1")
                            .header("authorization", "Bearer cred-1")
                            .header("content-length", "91")
                            .build()}

connected

write '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_WORKING"}}}'
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "503")
                           .build()}

read closed
read notify ATTEMPT_1

connect await ATTEMPT_1
        "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "client.example.com")
                            .header(":path", "/hooks/1")
                            .header("content-type", "application/a2a+json")
                            .header("a2a-version", "1.0")
                            .header("x-a2a-notification-token", "tok-1")
                            .header("authorization", "Bearer cred-1")
                            .header("content-length", "91")
                            .build()}

connected

write '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_WORKING"}}}'
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .build()}

read closed
read notify ATTEMPT_2

connect await ATTEMPT_2
        "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "client.example.com")
                            .header(":path", "/hooks/1")
                            .header("content-type", "application/a2a+json")
                            .header("a2a-version", "1.0")
                            .header("x-a2a-notification-token", "tok-1")
                            .header("authorization", "Bearer cred-1")
                            .header("content-length", "93")
                            .build()}

connected

write '{"statusUpdate":{"taskId":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}}'
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .build()}

read closed
