property authorization 0L

property sealed "sealed-1"
property token "nonce-1"
property credentials "agent-cred-1"
property taskId "t-1"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .pushNotify()
                               .configId(sealed)
                               .token(token)
                               .scheme("Bearer")
                               .credentials(credentials)
                               .contentLength(93)
                               .build()
                           .build()}

connected

write '{"statusUpdate":{"taskId":"' ${taskId} '","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}}'

read zilla:reset.ext ${a2a:matchResetEx()
                          .typeId(zilla:id("a2a"))
                          .error()
                              .code(404)
                              .message("Not Found")
                              .build()
                          .build()}

write aborted
