property authorization 0L

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"
        option zilla:authorization ${authorization}

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageSend()
                               .agent("discovery")
                               .contentLength(80)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"forecast"}]}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .message()
                             .build()
                         .build()}
read '{"message":{"messageId":"discovery-m-1","role":"ROLE_AGENT","parts":[{"text":"Found 1 agent: weather"},{"data":{"agents":[{"agent":"weather","name":"Weather Agent","description":"Answers weather questions","skills":[{"id":"weather","name":"Weather"},{"id":"forecast","name":"Forecast"}],"protocolBinding":"JSONRPC","protocolVersion":"1.0","score":1.54}]}}]}}'

read closed

write close
