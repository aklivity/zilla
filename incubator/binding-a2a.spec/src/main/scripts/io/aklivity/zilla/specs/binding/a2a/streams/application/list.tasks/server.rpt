property authorization 0L

property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"
       option zilla:authorization ${authorization}

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .tasksList()
                              .contextId("c-1")
                              .contentLength(33)
                              .build()
                          .build()}

connected

read '{"contextId":"c-1","pageSize":10}'

write flush

write '{"tasks":[{"id":"t-1","contextId":"c-1","status":{"state":"TASK_STATE_COMPLETED"}}],"nextPageToken":"","pageSize":10,"totalSize":1}'
write flush

write close

read closed
