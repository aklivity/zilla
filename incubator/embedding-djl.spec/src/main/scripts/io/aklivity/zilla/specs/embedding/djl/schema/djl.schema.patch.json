[
    {
        "op": "add",
        "path": "/$defs/embedding/properties/type/enum/-",
        "value": "djl"
    },
    {
        "op": "add",
        "path": "/$defs/embedding/allOf/-",
        "value":
        {
            "if":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "djl"
                    }
                }
            },
            "then":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "djl"
                    },
                    "vault": false,
                    "options":
                    {
                        "type": "object",
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        }
    }
]
