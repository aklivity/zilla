property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .messageSend()
                              .contentLength(110)
                              .build()
                          .build()}

connected

read '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"Read an order"},{"data":{"orderId":"7"}}]}}'

write flush
write notify REQUEST_RECEIVED
write abort
