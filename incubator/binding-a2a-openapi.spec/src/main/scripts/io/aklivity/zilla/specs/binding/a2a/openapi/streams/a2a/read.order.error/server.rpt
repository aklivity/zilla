property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .messageSend()
                              .contentLength(110)
                              .build()
                          .build()}

connected

read '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"Read an order"},{"data":{"orderId":"7"}}]}}'

write flush

write zilla:data.ext ${a2a:dataEx()
                            .typeId(zilla:id("a2a"))
                            .task()
                                .taskId("cmVhZF9vcmRlcg.5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .state("FAILED")
                                .build()
                            .build()}
write '{"task":{"id":"cmVhZF9vcmRlcg.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","status":{"state":"TASK_STATE_FAILED","message":{"messageId":"cmVhZF9vcmRlcg.5ca1ab1e-c0de-4a11-5e55-000100000000-status","role":"ROLE_AGENT","taskId":"cmVhZF9vcmRlcg.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","parts":[{"text":"{\\"error\\":\\"not found\\"}"}]}}}}'
write flush

write close

read closed
