connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageSend()
                               .contentLength(85)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"Read an order"}]}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .task()
                             .taskId("cmVhZF9vcmRlcg.5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .state("INPUT_REQUIRED")
                             .build()
                         .build()}
read '{"task":{"id":"cmVhZF9vcmRlcg.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","status":{"state":"TASK_STATE_INPUT_REQUIRED","message":{"messageId":"cmVhZF9vcmRlcg.5ca1ab1e-c0de-4a11-5e55-000100000000-status","role":"ROLE_AGENT","taskId":"cmVhZF9vcmRlcg.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","parts":[{"text":"Input required for skill read_order: orderId"},{"data":{"schema":{"type":"object","properties":{"orderId":{"type":"string"}},"required":["orderId"]},"missing":["orderId"],"invalid":[]}}]}}}}'

read closed

write close
