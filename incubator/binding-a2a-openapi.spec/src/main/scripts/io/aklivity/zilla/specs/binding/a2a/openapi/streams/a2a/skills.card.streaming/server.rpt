property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .agentCard()
                              .build()
                          .build()}

connected

write flush

write '{"name":"GitHub","description":"GitHub REST API","version":"1.0.0","capabilities":{"streaming":true,"pushNotifications":false},"defaultInputModes":["text/plain","application/json"],"defaultOutputModes":["application/json","text/plain"],"skills":[{"id":"search_items","name":"Search items","description":"Search items","tags":["items"]},{"id":"read_order","name":"Read an order","description":"Read an order","tags":["orders"],"examples":["show me order 7"]},{"id":"create_pr","name":"Create a pull request","description":"Create a pull request","tags":["pulls"],"examples":["open a pull request"]}]}'
write flush

write close

read closed
