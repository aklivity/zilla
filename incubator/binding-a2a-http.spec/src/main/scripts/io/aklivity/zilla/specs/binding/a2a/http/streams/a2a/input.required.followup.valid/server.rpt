property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .messageSend()
                              .contentLength(83)
                              .build()
                          .build()}

connected

read '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"get item 42"}]}}'

write flush

write zilla:data.ext ${a2a:dataEx()
                            .typeId(zilla:id("a2a"))
                            .task()
                                .taskId("Z2V0X2l0ZW0.5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .state("INPUT_REQUIRED")
                                .build()
                            .build()}
write '{"task":{"id":"Z2V0X2l0ZW0.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","status":{"state":"TASK_STATE_INPUT_REQUIRED","message":{"messageId":"Z2V0X2l0ZW0.5ca1ab1e-c0de-4a11-5e55-000100000000-status","role":"ROLE_AGENT","taskId":"Z2V0X2l0ZW0.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","parts":[{"text":"Input required for skill get_item: id"},{"data":{"schema":{"type":"object","required":["id"],"properties":{"id":{"type":"integer"}}},"missing":["id"],"invalid":[]}}]}}}}'
write flush

write close

read closed

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .messageSend()
                              .contentLength(190)
                              .build()
                          .build()}

connected

read '{"message":{"messageId":"m-2","role":"ROLE_USER","taskId":"Z2V0X2l0ZW0.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","parts":[{"data":{"id":42}}]}}'

write flush

write zilla:data.ext ${a2a:dataEx()
                            .typeId(zilla:id("a2a"))
                            .task()
                                .taskId("Z2V0X2l0ZW0.5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .state("COMPLETED")
                                .build()
                            .build()}
write '{"task":{"id":"Z2V0X2l0ZW0.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","status":{"state":"TASK_STATE_COMPLETED"},"artifacts":[{"artifactId":"result","parts":[{"data":{"id":42,"name":"widget"}}]}]}}'
write flush

write close

read closed
