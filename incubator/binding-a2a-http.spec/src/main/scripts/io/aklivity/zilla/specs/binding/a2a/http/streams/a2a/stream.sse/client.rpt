connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageStream()
                               .contentLength(95)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"watch items"},{"data":{}}]}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .task()
                             .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .state("WORKING")
                             .build()
                         .build()}
read '{"task":{"id":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","status":{"state":"TASK_STATE_WORKING"}}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .artifactUpdate()
                             .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .artifactId("result")
                             .build()
                         .build()}
read '{"artifactUpdate":{"taskId":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","artifact":{"artifactId":"result","parts":[{"text":"one"}]},"append":false,"lastChunk":false}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .artifactUpdate()
                             .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .artifactId("result")
                             .build()
                         .build()}
read '{"artifactUpdate":{"taskId":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","artifact":{"artifactId":"result","parts":[{"text":"two"}]},"append":true,"lastChunk":false}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .artifactUpdate()
                             .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .artifactId("result")
                             .build()
                         .build()}
read '{"artifactUpdate":{"taskId":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","artifact":{"artifactId":"result","parts":[{"text":"three"}]},"append":true,"lastChunk":false}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .artifactUpdate()
                             .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .artifactId("result")
                             .build()
                         .build()}
read '{"artifactUpdate":{"taskId":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","artifact":{"artifactId":"result","parts":[]},"append":true,"lastChunk":true}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .statusUpdate()
                             .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .state("COMPLETED")
                             .build()
                         .build()}
read '{"statusUpdate":{"taskId":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","status":{"state":"TASK_STATE_COMPLETED"}}}'

read closed

write close
