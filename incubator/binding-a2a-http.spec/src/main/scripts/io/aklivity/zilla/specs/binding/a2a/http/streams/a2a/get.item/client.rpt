connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${a2a:beginEx()
                           .typeId(zilla:id("a2a"))
                           .messageSend()
                               .contentLength(102)
                               .build()
                           .build()}

connected

write '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"get item 42"},{"data":{"id":42}}]}}'

read zilla:data.ext ${a2a:matchDataEx()
                         .typeId(zilla:id("a2a"))
                         .task()
                             .taskId("Z2V0X2l0ZW0.5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                             .state("COMPLETED")
                             .build()
                         .build()}
read '{"task":{"id":"Z2V0X2l0ZW0.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","status":{"state":"TASK_STATE_COMPLETED"},"artifacts":[{"artifactId":"result","parts":[{"data":{"id":42,"name":"widget"}}]}]}}'

read closed

write close
