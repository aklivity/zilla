property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${a2a:matchBeginEx()
                          .typeId(zilla:id("a2a"))
                          .messageStream()
                              .contentLength(95)
                              .build()
                          .build()}

connected

read '{"message":{"messageId":"m-1","role":"ROLE_USER","parts":[{"text":"watch items"},{"data":{}}]}}'

write flush

write zilla:data.ext ${a2a:dataEx()
                            .typeId(zilla:id("a2a"))
                            .task()
                                .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .state("WORKING")
                                .build()
                            .build()}
write '{"task":{"id":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","status":{"state":"TASK_STATE_WORKING"}}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                            .typeId(zilla:id("a2a"))
                            .artifactUpdate()
                                .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .artifactId("result")
                                .build()
                            .build()}
write '{"artifactUpdate":{"taskId":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","artifact":{"artifactId":"result","parts":[{"text":"one"}]},"append":false,"lastChunk":false}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                            .typeId(zilla:id("a2a"))
                            .artifactUpdate()
                                .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .artifactId("result")
                                .build()
                            .build()}
write '{"artifactUpdate":{"taskId":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","artifact":{"artifactId":"result","parts":[{"text":"two"}]},"append":true,"lastChunk":false}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                            .typeId(zilla:id("a2a"))
                            .artifactUpdate()
                                .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .artifactId("result")
                                .build()
                            .build()}
write '{"artifactUpdate":{"taskId":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","artifact":{"artifactId":"result","parts":[{"text":"three"}]},"append":true,"lastChunk":false}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                            .typeId(zilla:id("a2a"))
                            .artifactUpdate()
                                .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .artifactId("result")
                                .build()
                            .build()}
write '{"artifactUpdate":{"taskId":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","artifact":{"artifactId":"result","parts":[]},"append":true,"lastChunk":true}}'
write flush

write zilla:data.ext ${a2a:dataEx()
                            .typeId(zilla:id("a2a"))
                            .statusUpdate()
                                .taskId("d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .contextId("5ca1ab1e-c0de-4a11-5e55-000100000000")
                                .state("COMPLETED")
                                .build()
                            .build()}
write '{"statusUpdate":{"taskId":"d2F0Y2hfaXRlbXM.5ca1ab1e-c0de-4a11-5e55-000100000000","contextId":"5ca1ab1e-c0de-4a11-5e55-000100000000","status":{"state":"TASK_STATE_COMPLETED"}}}'
write flush

write close

read closed
