<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.aklivity.zilla</groupId>
    <artifactId>zilla</artifactId>
    <version>2.4.0-rc32</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>incubator</artifactId>
  <packaging>pom</packaging>
  <name>zilla::incubator</name>

  <modules>
    <module>binding-amqp.spec</module>
    <module>binding-amqp.conf</module>
    <module>binding-pgsql.spec</module>
    <module>binding-pgsql.conf</module>
    <module>binding-pgsql-kafka.spec</module>
    <module>binding-pgsql-kafka.conf</module>
    <module>binding-risingwave.spec</module>
    <module>binding-risingwave.conf</module>
    <module>embedding-glove.spec</module>
    <module>embedding-glove.conf</module>
    <module>model-vector.spec</module>
    <module>model-vector.conf</module>

    <module>binding-amqp</module>
    <module>binding-pgsql</module>
    <module>binding-pgsql-kafka</module>
    <module>binding-risingwave</module>
    <module>embedding-glove</module>
    <module>model-vector</module>

    <module>command-log</module>
    <module>command-dump</module>
    <module>command-tune</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.aklivity.zilla</groupId>
        <artifactId>common-agrona</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>embedding-glove</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>embedding-glove.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>model-vector</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>model-vector.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-amqp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-amqp.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-pgsql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-pgsql.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-pgsql-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-pgsql-kafka.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-risingwave</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-risingwave.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>command-log</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>command-tune</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>command-dump</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jasig.maven</groupId>
        <artifactId>maven-notice-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
