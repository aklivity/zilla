<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.aklivity.zilla</groupId>
    <artifactId>zilla</artifactId>
    <version>develop-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>incubator</artifactId>
  <packaging>pom</packaging>
  <name>zilla::incubator</name>

  <modules>
    <module>binding-a2a.spec</module>
    <module>binding-a2a.conf</module>
    <module>binding-a2a-http.spec</module>
    <module>binding-a2a-http.conf</module>
    <module>binding-a2a-openapi.spec</module>
    <module>binding-a2a-openapi.conf</module>
    <module>binding-agui.spec</module>
    <module>binding-agui.conf</module>
    <module>binding-agui-a2a.spec</module>
    <module>binding-amqp.spec</module>
    <module>binding-amqp.conf</module>
    <module>binding-pgsql.spec</module>
    <module>binding-pgsql.conf</module>
    <module>binding-pgsql-kafka.spec</module>
    <module>binding-pgsql-kafka.conf</module>
    <module>binding-risingwave.spec</module>
    <module>binding-risingwave.conf</module>

    <module>binding-a2a</module>
    <module>binding-a2a-http</module>
    <module>binding-a2a-openapi</module>
    <module>binding-agui</module>
    <module>binding-amqp</module>
    <module>binding-pgsql</module>
    <module>binding-pgsql-kafka</module>
    <module>binding-risingwave</module>

    <module>command-log</module>
    <module>command-dump</module>
    <module>command-tune</module>
    <module>command-inspect</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.aklivity.zilla</groupId>
        <artifactId>common-agrona</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-a2a</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-a2a.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-a2a-http</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-a2a-http.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-a2a-openapi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-a2a-openapi.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-agui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-agui.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-amqp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-amqp.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-pgsql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-pgsql.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-pgsql-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-pgsql-kafka.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-risingwave</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>binding-risingwave.conf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>command-log</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>command-tune</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>command-dump</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>command-inspect</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-declared-plugin-dependencies</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireDeclaredPluginDependencies implementation="io.aklivity.zilla.build.enforcer.RequireDeclaredPluginDependencies">
                  <plugins>
                    <plugin>io.aklivity.k3po:k3po-maven-plugin</plugin>
                  </plugins>
                </requireDeclaredPluginDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>enforcer-rules</artifactId>
            <version>${project.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.jasig.maven</groupId>
        <artifactId>maven-notice-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
