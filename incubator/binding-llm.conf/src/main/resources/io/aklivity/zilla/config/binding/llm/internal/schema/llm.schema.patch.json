[
    {
        "op": "add",
        "path": "/$defs/binding/properties/type/enum/-",
        "value": "llm"
    },
    {
        "op": "add",
        "path": "/$defs/binding/allOf/-",
        "value":
        {
            "if":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "llm"
                    }
                }
            },
            "then":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "llm"
                    },
                    "kind":
                    {
                        "enum": [ "client", "server" ]
                    }
                },
                "allOf":
                [
                    {
                        "if":
                        {
                            "properties":
                            {
                                "kind":
                                {
                                    "const": "server"
                                }
                            }
                        },
                        "then":
                        {
                            "properties":
                            {
                                "options":
                                {
                                    "properties":
                                    {
                                        "dialect":
                                        {
                                            "title": "Dialect",
                                            "type": "string"
                                        },
                                        "server":
                                        {
                                            "title": "Server",
                                            "type": "string",
                                            "pattern": "([^\\:]+):(\\d+)"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            }
                        }
                    },
                    {
                        "if":
                        {
                            "properties":
                            {
                                "kind":
                                {
                                    "const": "client"
                                }
                            }
                        },
                        "then":
                        {
                            "properties":
                            {
                                "options":
                                {
                                    "properties":
                                    {
                                        "dialect":
                                        {
                                            "title": "Dialect",
                                            "type": "string"
                                        },
                                        "server":
                                        {
                                            "title": "Server",
                                            "type": "string",
                                            "pattern": "([^\\:]+):(\\d+)"
                                        }
                                    },
                                    "required": [ "dialect", "server" ],
                                    "additionalProperties": false
                                }
                            }
                        }
                    }
                ]
            }
        }
    }
]
