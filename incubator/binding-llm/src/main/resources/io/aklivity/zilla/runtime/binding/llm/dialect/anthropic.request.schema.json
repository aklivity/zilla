{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Anthropic Messages API request",
    "type": "object",
    "required": [
        "model",
        "messages"
    ],
    "properties": {
        "model": {
            "type": "string"
        },
        "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "role"
                ],
                "properties": {
                    "role": {
                        "type": "string"
                    },
                    "content": {}
                }
            }
        },
        "system": {},
        "max_tokens": {
            "type": "integer"
        },
        "temperature": {
            "type": "number"
        },
        "top_p": {
            "type": "number"
        },
        "top_k": {
            "type": "integer"
        },
        "stop_sequences": {
            "type": "array"
        },
        "stream": {
            "type": "boolean"
        },
        "tools": {
            "type": "array"
        },
        "tool_choice": {},
        "metadata": {
            "type": "object"
        }
    }
}
