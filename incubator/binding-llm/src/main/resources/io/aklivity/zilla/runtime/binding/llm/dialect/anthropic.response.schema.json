{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Anthropic Messages API response",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "type": {
            "type": "string"
        },
        "role": {
            "type": "string"
        },
        "model": {
            "type": "string"
        },
        "content": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "text": {},
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "input": {}
                }
            }
        },
        "stop_reason": {
            "type": [
                "string",
                "null"
            ]
        },
        "stop_sequence": {
            "type": [
                "string",
                "null"
            ]
        },
        "usage": {
            "type": "object",
            "properties": {
                "input_tokens": {
                    "type": "integer"
                },
                "output_tokens": {
                    "type": "integer"
                }
            }
        }
    }
}
