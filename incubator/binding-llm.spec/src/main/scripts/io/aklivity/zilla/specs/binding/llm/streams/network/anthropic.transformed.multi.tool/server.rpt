property model "claude-3-opus-20240229"
property id "msg_01"

accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/messages")
                           .header("content-type", "application/json")
                           .build()}

connected

read '{"model":"'
     ${model}
     '","messages":[{"role":"user","content":"What is the weather in San Francisco and New York?"}],"stream":false}'

read closed

write zilla:begin.ext ${http:beginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}

write '{"id":"'
      ${id}
      '","type":"message","role":"assistant","model":"'
      ${model}
      '","content":[{"type":"text","text":"Let me check both cities for you."},{"type":"tool_use","id":"toolu_01","name":"get_weather","input":{"city":"San Francisco"}},{"type":"tool_use","id":"toolu_02","name":"get_weather","input":{"city":"New York"}}],"stop_reason":"tool_use","usage":{"input_tokens":30,"output_tokens":25}}'
write close
