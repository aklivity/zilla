property model "gpt-4"
property id "chatcmpl_2"

accept "zilla://streams/net0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":method", "POST")
                           .header(":scheme", "http")
                           .header(":authority", "example.com:8080")
                           .header(":path", "/v1/chat/completions")
                           .header("content-type", "application/json")
                           .build()}

connected

read '{"model":"'
     ${model}
     '","messages":[{"role":"user","content":"Hello"}],"stream":false}'

read closed

write zilla:begin.ext ${http:beginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}

write '{"id":"'
      ${id}
      '","object":"chat.completion","model":"'
      ${model}
      '","choices":[{"index":0,"message":{"role":"assistant","content":"Hello! How can I help you today?","tool_calls":[{"id":"call_1","type":"function","function":{"name":"get_weather","arguments":"'
      "{\\\"city\\\":\\\"San Francisco\\\"}"
      '"}}]},"finish_reason":"tool_calls"}],"usage":{"prompt_tokens":25,"completion_tokens":15,"total_tokens":40}}'
write close
