property clientAddress "zilla://streams/app0"
property model "gpt-a"

connect ${clientAddress}
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .build()}

connected

write '{"model":"gpt-4","messages":[{"role":"user","content":"'
      ${core:randomBase64(10000)}
      '"}],"stream":false}'

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .contentType("application/json")
                           .build()}

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .typeNull()
                          .build()}
read '{"id":"chatcmpl_2","object":"chat.completion","model":"gpt-4","choices":[{"index":0,"message":{"role":"assistant","content":"'
read ${core:randomBase64(10000)}
read '"},"finish_reason":"stop"}],"usage":{"prompt_tokens":25,"completion_tokens":15,"total_tokens":40}}'

read closed

write close
