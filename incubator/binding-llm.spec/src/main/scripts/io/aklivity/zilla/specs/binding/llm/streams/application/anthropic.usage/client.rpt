connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("claude-haiku-4-5-20251001")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "Say hello in one sentence."
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("claude-haiku-4-5-20251001")
                           .id("msg_011CfFkXGJGvcevU8tu1qHAP")
                           .build()}

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "Hello! I'm happy to help you with whatever you need."

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("stop_sequence")
                          .build()}
read "null"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(13)
                            .cacheWriteTokens(0)
                            .cacheReadTokens(0)
                            .outputTokens(16)
                            .finishReason("stop")
                            .build()}

read closed

write close
