connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4o-mini")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "Say hello in one sentence."
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4o-mini-2024-07-18")
                           .id("chatcmpl-EQNL5kPFWGuGSBO2lca3rDUj9mrfi")
                           .build()}

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("created")
                          .build()}
read "1789954951"

read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("service_tier")
                          .build()}
read "\"default\""

read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("system_fingerprint")
                          .build()}
read "\"fp_c28ee603a6\""

read option zilla:flags "init"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "Hello"

read option zilla:flags "fin"
read zilla:data.empty

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(13)
                            .cacheReadTokens(0)
                            .outputTokens(9)
                            .reasoningTokens(0)
                            .totalTokens(22)
                            .finishReason("stop")
                            .build()}

read closed

write close
