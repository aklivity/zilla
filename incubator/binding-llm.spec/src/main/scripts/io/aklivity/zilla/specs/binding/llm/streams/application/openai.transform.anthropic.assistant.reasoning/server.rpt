accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("claude-3-opus-20240229")
                           .build()}

connected

read advise zilla:challenge ${llm:challengeEx()
                                .typeId(zilla:id("llm"))
                                .dialect("openai")
                                .build()}

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
read "Hi"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_REASONING")
                          .message(1)
                          .build()}
read "{\"type\":\"thinking\",\"thinking\":\"Let me think.\",\"signature\":\"sig-1\"}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(1)
                          .build()}
read "Hello!"

read advised zilla:flush

write zilla:reset.ext ${llm:resetEx()
                            .typeId(zilla:id("llm"))
                            .status(429)
                            .type("rate_limit_error")
                            .message("Rate limit exceeded")
                            .build()}

read abort
