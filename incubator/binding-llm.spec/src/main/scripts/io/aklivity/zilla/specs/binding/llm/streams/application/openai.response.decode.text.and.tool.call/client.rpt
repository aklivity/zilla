connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("user-text")
                          .message(0)
                          .build()}
write "What is the weather in Paris and London?"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .id("chatcmpl_3")
                           .build()}

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("assistant-text")
                          .message(0)
                          .build()}
read "Let me check both cities."

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("tool-call")
                          .message(0)
                          .attributes("get_weather")
                          .extension("call_1")
                          .build()}
read "{\"city\":\"Paris\"}"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("tool-call")
                          .message(0)
                          .attributes("get_weather")
                          .extension("call_2")
                          .build()}
read "{\"city\":\"London\"}"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(30)
                            .cacheReadTokens(10)
                            .outputTokens(25)
                            .reasoningTokens(2)
                            .totalTokens(55)
                            .finishReason("tool-call")
                            .build()}

read closed

write close
