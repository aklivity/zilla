connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "Do something harmful"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .id("chatcmpl_4")
                           .build()}

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_REFUSAL")
                          .message(0)
                          .build()}
read "I cannot help with that."

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectAfterBlockDataEx()
                        .typeId(zilla:id("llm"))
                        .block("finish_reason")
                        .build()}
read "\"stop\""

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(12)
                            .outputTokens(6)
                            .totalTokens(18)
                            .finishReason("stop")
                            .build()}

read closed

write close
