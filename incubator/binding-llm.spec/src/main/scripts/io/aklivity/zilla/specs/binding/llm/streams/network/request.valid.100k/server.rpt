property bigBlob ${core:randomBase64(100000)}

accept "zilla://streams/net0"
  option zilla:window 8192
  option zilla:transmission "half-duplex"
accepted

read zilla:begin.ext ${http:matchBeginEx()
                             .typeId(zilla:id("http"))
                             .header(":method", "POST")
                             .header(":scheme", "http")
                             .header(":authority", "localhost:8080")
                             .header(":path", "/v1/chat/completions")
                             .header("content-type", "application/vnd.zilla.test-permissive+json")
                             .build()}
connected

read '{"model":"gpt-x","prompt":"'
read ${bigBlob.substring(0, 8192)}
read ${bigBlob.substring(8192, 16384)}
read ${bigBlob.substring(16384, 24576)}
read ${bigBlob.substring(24576, 32768)}
read ${bigBlob.substring(32768, 40960)}
read ${bigBlob.substring(40960, 49152)}
read ${bigBlob.substring(49152, 57344)}
read ${bigBlob.substring(57344, 65536)}
read ${bigBlob.substring(65536, 73728)}
read ${bigBlob.substring(73728, 81920)}
read ${bigBlob.substring(81920, 90112)}
read ${bigBlob.substring(90112, 98304)}
read ${bigBlob.substring(98304, 106496)}
read ${bigBlob.substring(106496, 114688)}
read ${bigBlob.substring(114688, 122880)}
read ${bigBlob.substring(122880, 131072)}
read ${bigBlob.substring(131072, 133336)}
read '"}'

read closed

write '{"status":"ok"}'
write flush

write close
