property target "target"
property model "gpt-4"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model(model)
                           .build()}

connected

write advised zilla:challenge ${llm:matchChallengeEx()
                                    .typeId(zilla:id("llm"))
                                    .dialect(target)
                                    .build()}

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_IMAGE")
                          .message(0)
                          .attribute("source", "url")
                          .build()}
write "{\"type\":\"image_url\",\"image_url\":{\"url\":\"https://example.com/images/"
      ${core:randomBase64(100000)}
      "\"}}"
write flush

write advise zilla:flush

read zilla:reset.ext ${llm:matchResetEx()
                           .typeId(zilla:id("llm"))
                           .status(429)
                           .type("requests")
                           .message("Rate limit reached for gpt-4")
                           .build()}

write aborted
