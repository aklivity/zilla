connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write "{\"model\":\"gpt-4\",\"messages\":[{\"role\":\"user\",\"content\":\""
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "Hello"
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
write "\"}],\"temperature\":0.7,\"top_p\":0.9,\"max_tokens\":100,\"seed\":42,\"stop\":[\"END\"],\"store\":true,\"service_tier\":\"auto\",\"logprobs\":true,\"top_logprobs\":3,\"n\":2,\"audio\":{\"voice\":\"alloy\",\"format\":\"wav\"}}"
write flush
write advise zilla:flush ${llm:flushEx()
                               .typeId(zilla:id("llm"))
                               .maxOutputTokens(100)
                               .build()}

read zilla:reset.ext ${llm:matchResetEx()
                           .typeId(zilla:id("llm"))
                           .status(429)
                           .type("requests")
                           .message("Rate limit reached for gpt-4")
                           .build()}

write aborted
