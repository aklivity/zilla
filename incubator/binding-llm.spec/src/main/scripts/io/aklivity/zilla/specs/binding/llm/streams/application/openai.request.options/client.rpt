connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "Hello"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("temperature")
                           .build()}
write "0.7"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("top_p")
                           .build()}
write "0.9"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("max_tokens")
                           .build()}
write "100"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("seed")
                           .build()}
write "42"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("stop")
                           .build()}
write "[\"END\"]"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("store")
                           .build()}
write "true"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("service_tier")
                           .build()}
write "\"auto\""
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("logprobs")
                           .build()}
write "true"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("top_logprobs")
                           .build()}
write "3"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("n")
                           .build()}
write "2"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("audio")
                           .build()}
write "{\"voice\":\"alloy\",\"format\":\"wav\"}"
write flush
write advise zilla:flush

read zilla:reset.ext ${llm:matchResetEx()
                           .typeId(zilla:id("llm"))
                           .status(429)
                           .type("requests")
                           .message("Rate limit reached for gpt-4")
                           .build()}

write aborted
