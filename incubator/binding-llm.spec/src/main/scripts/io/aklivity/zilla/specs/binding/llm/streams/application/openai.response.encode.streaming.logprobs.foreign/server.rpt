# Logprobs: when the request asks for logprobs, each fragment of the text the upstream delivers is a section of its own,
# announced by the follow marker on the section data extension, and followed by an after block carrying the logprobs of
# that fragment. The after block is a single frame with the init and fin flags, owned by the section (the default owner),
# and has an empty payload when the upstream reported no logprobs for the fragment.

accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                         .typeId(zilla:id("llm"))
                         .dialect("openai")
                         .model("gpt-4")
                         .build()}

connected

read zilla:data.ext ${llm:matchDataEx()
                        .typeId(zilla:id("llm"))
                        .type("USER_TEXT")
                        .message(0)
                        .build()}
read "Hello"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                        .typeId(zilla:id("llm"))
                        .block("logprobs")
                        .build()}
read "true"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                        .typeId(zilla:id("llm"))
                        .block("stream")
                        .build()}
read "true"

read advised zilla:flush

write zilla:begin.ext ${llm:beginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("anthropic")
                          .model("gpt-4")
                          .id("chatcmpl_1")
                          .build()}
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dataEx()
                         .typeId(zilla:id("llm"))
                         .type("ASSISTANT_TEXT")
                         .message(0)
                         .follow("AFTER_BLOCK")
                         .build()}
write "Hello"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectAfterBlockDataEx()
                         .typeId(zilla:id("llm"))
                         .block("logprobs")
                         .build()}
write "{\"content\":[{\"token\":\"Hello\",\"logprob\":-0.5,\"bytes\":[72,101,108,108,111],\"top_logprobs\":[{\"token\":\"Hello\",\"logprob\":-0.5,\"bytes\":[72,101,108,108,111]}]}],\"refusal\":null}"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dataEx()
                         .typeId(zilla:id("llm"))
                         .type("ASSISTANT_TEXT")
                         .message(0)
                         .follow("AFTER_BLOCK")
                         .build()}
write " there"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectAfterBlockDataEx()
                         .typeId(zilla:id("llm"))
                         .block("logprobs")
                         .build()}
write zilla:data.empty
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dataEx()
                         .typeId(zilla:id("llm"))
                         .type("ASSISTANT_TEXT")
                         .message(0)
                         .follow("AFTER_BLOCK")
                         .build()}
write "!"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectAfterBlockDataEx()
                         .typeId(zilla:id("llm"))
                         .block("logprobs")
                         .build()}
write "{\"content\":[{\"token\":\"!\",\"logprob\":-1.25,\"bytes\":[33],\"top_logprobs\":[]}],\"refusal\":null}"
write flush

write zilla:end.ext ${llm:endEx()
                           .typeId(zilla:id("llm"))
                           .inputTokens(25)
                           .outputTokens(15)
                           .totalTokens(40)
                           .finishReason("stop")
                           .build()}

write close

read closed
