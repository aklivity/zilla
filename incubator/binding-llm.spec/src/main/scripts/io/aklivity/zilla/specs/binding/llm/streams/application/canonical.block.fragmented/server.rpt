accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai")
                          .model("gpt-4")
                          .build()}

connected

read option zilla:flags "init"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("user-text")
                          .message(0)
                          .extension("ext-user-text")
                          .build()}
read "Hello, "

read option zilla:flags "none"
read "this block "

read option zilla:flags "fin"
read "spans several frames"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .build()}
write flush

write option zilla:flags "init"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("assistant-text")
                          .message(0)
                          .extension("ext-assistant-text")
                          .build()}
write "Hi, "
write flush

write option zilla:flags "none"
write "and this one "
write flush

write option zilla:flags "fin"
write "does too"
write flush

write close

read closed
