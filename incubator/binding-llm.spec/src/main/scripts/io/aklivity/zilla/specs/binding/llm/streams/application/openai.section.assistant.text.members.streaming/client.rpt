# Streaming: the text deltas of an upstream stream are fragments of one assistant-text section, the init flag on the first
# and an empty fin on the last, once the stream moves on to something else or ends.

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write "{\"model\":\"gpt-4\",\"messages\":[{\"role\":\"user\",\"content\":\""
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "Hello"
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
write "\"}],\"stream\":true}"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("claude-3-opus-20240229")
                           .id("msg_01")
                           .build()}

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"},\"finish_reason\":null}]}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"choices\":[],\"created\":1700000001}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"choices\":[],\"service_tier\":\"default\"}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\""

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "Hello"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "\"},\"finish_reason\":null}]}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\""

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read " there"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "\"},\"finish_reason\":null}]}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"choices\":[],\"obfuscation\":\"abc\"}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "{\"id\":\"msg_01\",\"object\":\"chat.completion.chunk\",\"model\":\"claude-3-opus-20240229\",\"choices\":[],\"usage\":{\"prompt_tokens\":25,\"completion_tokens\":15,\"total_tokens\":40}}"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "[DONE]"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(25)
                            .outputTokens(15)
                            .totalTokens(40)
                            .finishReason("stop")
                            .build()}

read closed

write close
