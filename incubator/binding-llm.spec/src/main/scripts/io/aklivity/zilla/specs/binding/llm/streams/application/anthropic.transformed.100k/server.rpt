property model "claude-3-opus-20240229"
property id "msg_01"

accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("anthropic")
                          .build()}

connected

read '{"model":"'
     ${model}
     '","messages":[{"role":"user","content":"'
read ${core:randomBase64(100000)}
read '"}],"stream":false}'

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .contentType("application/json")
                           .build()}
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write '{"id":"'
      ${id}
      '","type":"message","role":"assistant","model":"'
      ${model}
      '","content":[{"type":"text","text":"Hello! How can I help you today?"}],"stop_reason":"end_turn","usage":{"input_tokens":25,"output_tokens":15}}'
write flush

write close

read closed
