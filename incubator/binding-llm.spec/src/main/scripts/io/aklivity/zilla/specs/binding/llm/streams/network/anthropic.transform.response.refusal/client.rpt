connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/messages")
                            .header("anthropic-version", "2023-06-01")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"model\":\"model\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Hello\"}]}]}"
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .header("content-type", "application/json")
                           .build()}

read "{\"id\":\"id_1\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"model\",\"content\":[{\"type\":\"text\",\"text\":\"I cannot help with that\"}],\"stop_reason\":\"refusal\",\"stop_sequence\":null,\"usage\":{\"input_tokens\":25,\"output_tokens\":15}}"

read closed
