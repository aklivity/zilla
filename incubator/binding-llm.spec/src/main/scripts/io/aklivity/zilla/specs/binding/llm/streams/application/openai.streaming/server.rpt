accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai")
                          .build()}

connected

read "{\"model\":\"gpt-4\",\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}],\"stream\":true}"

read closed

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .build()}

write "{\"id\":\"chatcmpl_1\",\"model\":\"gpt-4\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"},\"finish_reason\":null}]}"
write advise zilla:flush ${llm:flushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .build()
                               .build()}

write "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello\"},\"finish_reason\":null}]}"
write advise zilla:flush ${llm:flushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .build()
                               .build()}

write "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call_1\",\"function\":{\"name\":\"get_weather\",\"arguments\":\"\"}}]},\"finish_reason\":null}]}"
write advise zilla:flush ${llm:flushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .build()
                               .build()}

write "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"function\":{\"arguments\":\"{\\\"city\\\":\"}}]},\"finish_reason\":null}]}"
write advise zilla:flush ${llm:flushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .build()
                               .build()}

write "{\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}"
write advise zilla:flush ${llm:flushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .build()
                               .build()}

write "{\"choices\":[],\"usage\":{\"prompt_tokens\":25,\"completion_tokens\":15}}"
write advise zilla:flush ${llm:flushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .build()
                               .build()}

write "[DONE]"
write advise zilla:flush ${llm:flushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .build()
                               .build()}

write close
