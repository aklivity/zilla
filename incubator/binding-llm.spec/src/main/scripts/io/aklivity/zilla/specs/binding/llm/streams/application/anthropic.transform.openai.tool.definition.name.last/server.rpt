accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .build()}

connected

read option zilla:flags "init"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_DEFINITION")
                          .message(-1)
                          .build()}
read "{\"type\":\"function\",\"function\":{\"description\":\"\""
read notify FIRST_FRAME_READ
read option zilla:flags "fin"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .typeNull()
                          .attribute("tool-name", "get_weather")
                          .build()}
read ",\"name\":\"get_weather\"}}"

read advised zilla:flush

write zilla:reset.ext ${llm:resetEx()
                            .typeId(zilla:id("llm"))
                            .status(429)
                            .type("requests")
                            .message("Rate limit reached for gpt-4")
                            .build()}

read abort
