accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("claude-3-opus-20240229")
                           .build()}

connected

read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("model")
                          .build()}
read "\"claude-3-opus-20240229\""

read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("max_tokens")
                          .build()}
read "1024"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
read "Hello"

read advised zilla:flush

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .id("chatcmpl_2")
                           .build()}
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_REASONING")
                          .message(0)
                          .build()}
write "Let me think about it."
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
write "Hello!"
write flush

write zilla:end.ext ${llm:endEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(25)
                            .outputTokens(15)
                            .totalTokens(40)
                            .finishReason("stop")
                            .build()}

write close

read closed
