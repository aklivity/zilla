property serverAddress "zilla://streams/app0"

accept ${serverAddress}
       option zilla:window 8192
       option zilla:transmission "half-duplex"
accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("anthropic")
                          .build()}

connected

read '{"model":"claude-3-opus-20240229","max_tokens":1024,"messages":[{"role":"user","content":"'
read ${core:randomBase64(100000)}
read '"}],"stream":false}'

read closed

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .contentType("application/json")
                           .build()}

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write '{"id":"msg_01","type":"message","role":"assistant","model":"claude-3-opus-20240229","content":[{"type":"text","text":"'
      ${core:randomBase64(100000)}
      '"}],"stop_reason":"end_turn","stop_sequence":null,"usage":{"input_tokens":25,"output_tokens":15}}'

write close
