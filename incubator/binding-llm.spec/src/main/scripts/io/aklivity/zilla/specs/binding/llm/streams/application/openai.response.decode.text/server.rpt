# Canonical response contract (dialect-neutral).
#
# The response begin names the dialect that served the response (dialect), the served model (model) and the response
# identifier the upstream reported (id). The response is always sections, with no content type, whether or not the serving
# dialect is the request's own dialect. Detail a section cannot express is left to dialect extensions.
#
# A section is a run of data frames. The first has the init flag and the data extension (type, message and, for a tool call,
# the call id as extension and the tool name as attributes); the last has the fin flag, possibly with an empty payload.
# Fragment boundaries within a section are not significant. Sections are never interleaved.
#
# Section types: assistant-text, assistant-reasoning, assistant-refusal (utf-8 text) and tool-call (the arguments).
# The message is the index of the assistant message, 0 for the first.
#
# The end carries the usage and the finish reason (stop, length, tool-call or content-filter).
# A failure before the begin is a reset; a failure after it is an abort. Both carry the error.

accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("anthropic")
                          .model("gpt-4")
                          .build()}

connected

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
read "Hello"

read advised zilla:flush

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .id("chatcmpl_2")
                           .build()}
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write "{\"id\":\"chatcmpl_2\",\"object\":\"chat.completion\",\"model\":\"gpt-4\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\""
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
write "Hello! How can I help you today?"
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write "\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":25,\"completion_tokens\":15,\"total_tokens\":40}}"
write flush

write zilla:end.ext ${llm:endEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(25)
                            .outputTokens(15)
                            .totalTokens(40)
                            .finishReason("stop")
                            .build()}

write close

read closed
