connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4o-mini")
                           .build()}

connected

write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("model")
                           .build()}
write "\"gpt-4o-mini\""
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "Say hello in one sentence."
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4o-mini-2024-07-18")
                           .id("chatcmpl-EQNKhNLHHohc7KwUHH83164mX3IMA")
                           .build()}

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("created")
                          .build()}
read "1789954927"

read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("model")
                          .build()}
read "\"gpt-4o-mini-2024-07-18\""

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read "Hello! How can I assist you today?"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectAfterBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .owner("CONTAINER")
                          .block("refusal")
                          .build()}
read "null"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectAfterBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .owner("CONTAINER")
                          .block("annotations")
                          .build()}
read "[]"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectAfterBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("logprobs")
                          .build()}
read "null"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectAfterBlockDataEx()
                        .typeId(zilla:id("llm"))
                        .block("finish_reason")
                        .build()}
read "\"stop\""

read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("usage")
                          .build()}
read "{\"prompt_tokens\":13,\"completion_tokens\":9,\"total_tokens\":22,\"prompt_tokens_details\":{\"cached_tokens\":0,\"audio_tokens\":0},\"completion_tokens_details\":{\"reasoning_tokens\":0,\"audio_tokens\":0,\"accepted_prediction_tokens\":0,\"rejected_prediction_tokens\":0}}"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("service_tier")
                          .build()}
read "\"default\""

read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("system_fingerprint")
                          .build()}
read "\"fp_c28ee603a6\""

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(13)
                            .cacheReadTokens(0)
                            .outputTokens(9)
                            .reasoningTokens(0)
                            .totalTokens(22)
                            .finishReason("stop")
                            .build()}

read closed

write close
