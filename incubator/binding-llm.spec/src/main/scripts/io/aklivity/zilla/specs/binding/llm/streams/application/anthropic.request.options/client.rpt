connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("claude-3-opus-20240229")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "Hello"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectDataEx()
                           .typeId(zilla:id("llm"))
                           .block("temperature")
                           .build()}
write "0.5"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectDataEx()
                           .typeId(zilla:id("llm"))
                           .block("top_p")
                           .build()}
write "0.9"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectDataEx()
                           .typeId(zilla:id("llm"))
                           .block("top_k")
                           .build()}
write "40"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectDataEx()
                           .typeId(zilla:id("llm"))
                           .block("max_tokens")
                           .build()}
write "1024"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectDataEx()
                           .typeId(zilla:id("llm"))
                           .block("stop_sequences")
                           .build()}
write "[\"END\"]"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectDataEx()
                           .typeId(zilla:id("llm"))
                           .block("thinking")
                           .build()}
write "{\"type\":\"enabled\",\"budget_tokens\":2048}"
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectDataEx()
                           .typeId(zilla:id("llm"))
                           .block("container_id")
                           .build()}
write "\"ctr_1\""
write flush
write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectDataEx()
                           .typeId(zilla:id("llm"))
                           .block("mcp_servers")
                           .build()}
write "[{\"type\":\"url\",\"url\":\"https://mcp.example.com\",\"name\":\"example\"}]"
write flush
write advise zilla:flush

read zilla:reset.ext ${llm:matchResetEx()
                           .typeId(zilla:id("llm"))
                           .status(429)
                           .type("rate_limit_error")
                           .message("Rate limit exceeded")
                           .build()}

write aborted
