accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai")
                          .model("gpt-4")
                          .build()}

connected

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
read "Do something harmful"

read advised zilla:flush

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .id("chatcmpl_4")
                           .build()}
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
write "{\"id\":\"chatcmpl_4\",\"object\":\"chat.completion\",\"model\":\"gpt-4\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":null,\"refusal\":\""
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_REFUSAL")
                          .message(0)
                          .build()}
write "I cannot help with that."
write flush

write zilla:data.ext ${llm:dialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
write "\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":12,\"completion_tokens\":6,\"total_tokens\":18}}"
write flush

write zilla:end.ext ${llm:endEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(12)
                            .outputTokens(6)
                            .totalTokens(18)
                            .finishReason("stop")
                            .build()}

write close

read closed
