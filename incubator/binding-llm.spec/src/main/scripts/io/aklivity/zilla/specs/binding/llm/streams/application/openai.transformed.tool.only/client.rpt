property model "gpt-4"
property id "chatcmpl_2"

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .build()}

connected

write '{"model":"'
      ${model}
      '","messages":[{"role":"user","content":"What is the weather in San Francisco?"}],"stream":false}'

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .contentType("application/json")
                           .build()}

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .typeNull()
                          .build()}
read '{"object":"chat.completion","id":"'
     ${id}
     '","model":"'
     ${model}
     '","choices":[{"index":0,"message":{"role":"assistant","content":null,"tool_calls":[{"id":"toolu_01","type":"function","function":{"name":"get_weather","arguments":"'
     "{\\\"city\\\":\\\"San Francisco\\\"}"
     '"}}]},"finish_reason":"tool_calls"}],"usage":{"prompt_tokens":25,"completion_tokens":15}}'

read closed

write close
