# Logprobs: a non-streaming response carries the logprobs of the choice as an after block following the text section.

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai")
                          .model("gpt-4")
                          .build()}

connected

write zilla:data.ext ${llm:dataEx()
                         .typeId(zilla:id("llm"))
                         .type("USER_TEXT")
                         .message(0)
                         .build()}
write "Hello"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                         .typeId(zilla:id("llm"))
                         .block("logprobs")
                         .build()}
write "true"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                         .typeId(zilla:id("llm"))
                         .dialect("openai")
                         .model("gpt-4")
                         .id("chatcmpl_1")
                         .build()}

read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("model")
                          .build()}
read "\"gpt-4\""

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                        .typeId(zilla:id("llm"))
                        .type("ASSISTANT_TEXT")
                        .message(0)
                        .build()}
read "Hello!"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectAfterBlockDataEx()
                        .typeId(zilla:id("llm"))
                        .block("logprobs")
                        .build()}
read "{\"content\":[{\"token\":\"Hello\",\"logprob\":-0.5,\"bytes\":[72,101,108,108,111],\"top_logprobs\":[]},{\"token\":\"!\",\"logprob\":-1.25e-1,\"bytes\":[33],\"top_logprobs\":[]}],\"refusal\":null}"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectAfterBlockDataEx()
                        .typeId(zilla:id("llm"))
                        .block("finish_reason")
                        .build()}
read "\"stop\""

read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("usage")
                          .build()}
read "{\"prompt_tokens\":25,\"completion_tokens\":15,\"total_tokens\":40}"

read zilla:end.ext ${llm:matchEndEx()
                          .typeId(zilla:id("llm"))
                          .inputTokens(25)
                          .outputTokens(15)
                          .totalTokens(40)
                          .finishReason("stop")
                          .build()}

read closed

write close
