connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("test-conditional")
                           .build()}

connected

write "{\"model\":\"x\",\"stream\":true}"

write close

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("test-conditional")
                           .build()}

read "hi"

read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .typeNull()
                                   .payloadNull()
                                   .build()
                               .build()}

read closed
