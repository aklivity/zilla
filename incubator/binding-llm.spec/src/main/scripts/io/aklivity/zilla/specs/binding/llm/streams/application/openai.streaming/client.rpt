connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .build()}

connected

write "{\"model\":\"gpt-4\",\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}],\"stream\":true}"

write close

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .build()}

read "{\"id\":\"chatcmpl_1\",\"model\":\"gpt-4\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"},\"finish_reason\":null}]}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .typeNull()
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello\"},\"finish_reason\":null}]}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .typeNull()
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call_1\",\"function\":{\"name\":\"get_weather\",\"arguments\":\"\"}}]},\"finish_reason\":null}]}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .typeNull()
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"function\":{\"arguments\":\"{\\\"city\\\":\"}}]},\"finish_reason\":null}]}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .typeNull()
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .typeNull()
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"choices\":[],\"usage\":{\"prompt_tokens\":25,\"completion_tokens\":15}}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .typeNull()
                                   .payloadNull()
                                   .build()
                               .build()}

read "[DONE]"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .typeNull()
                                   .payloadNull()
                                   .build()
                               .build()}

read closed
