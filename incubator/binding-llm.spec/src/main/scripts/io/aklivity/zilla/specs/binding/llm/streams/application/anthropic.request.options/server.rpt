accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("claude-3-opus-20240229")
                           .build()}

connected

read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("model")
                          .build()}
read "\"claude-3-opus-20240229\""

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
read "Hello"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("temperature")
                          .build()}
read "0.5"
read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("top_p")
                          .build()}
read "0.9"
read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("top_k")
                          .build()}
read "40"
read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("max_tokens")
                          .build()}
read "1024"
read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("stop_sequences")
                          .build()}
read "[\"END\"]"
read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("thinking")
                          .build()}
read "{\"type\":\"enabled\",\"budget_tokens\":2048}"
read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("container_id")
                          .build()}
read "\"ctr_1\""
read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("mcp_servers")
                          .build()}
read "[{\"type\":\"url\",\"url\":\"https://mcp.example.com\",\"name\":\"example\"}]"

read advised zilla:flush

write zilla:reset.ext ${llm:resetEx()
                            .typeId(zilla:id("llm"))
                            .status(429)
                            .type("rate_limit_error")
                            .message("Rate limit exceeded")
                            .build()}

read abort
