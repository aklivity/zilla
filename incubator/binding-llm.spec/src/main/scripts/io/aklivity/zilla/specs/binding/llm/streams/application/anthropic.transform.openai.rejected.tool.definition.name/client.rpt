connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("tool-definition")
                          .message(-1)
                          .build()}
write "{\"type\":\"function\",\"function\":{\"description\":\"Get the weather\"}}"
write flush

read zilla:reset.ext ${llm:matchResetEx()
                           .typeId(zilla:id("llm"))
                           .status(400)
                           .type("invalid_request_error")
                           .message("Invalid request section.")
                           .build()}

write aborted
