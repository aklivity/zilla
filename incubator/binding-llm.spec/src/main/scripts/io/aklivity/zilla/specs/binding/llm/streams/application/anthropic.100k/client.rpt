property clientAddress "zilla://streams/app0"

connect ${clientAddress}
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("gpt-b")
                           .build()}

connected

write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("model")
                           .build()}
write "\"gpt-b\""
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write ${core:randomBase64(100000)}
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("claude-3-opus-20240229")
                           .id("msg_01")
                           .build()}

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
read ${core:randomBase64(100000)}

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("stop_reason")
                          .build()}
read "\"end_turn\""

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectBlockDataEx()
                          .typeId(zilla:id("llm"))
                          .block("stop_sequence")
                          .build()}
read "null"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(25)
                            .outputTokens(15)
                            .finishReason("stop")
                            .build()}

read closed

write close
