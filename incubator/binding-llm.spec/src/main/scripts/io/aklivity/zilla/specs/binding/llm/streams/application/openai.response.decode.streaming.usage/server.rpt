accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("anthropic")
                          .model("gpt-4o-mini")
                          .build()}

connected

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
read "Say hello in one sentence."

read advised zilla:flush

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4o-mini-2024-07-18")
                           .id("chatcmpl-EQNL5kPFWGuGSBO2lca3rDUj9mrfi")
                           .build()}
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("created")
                           .build()}
write "1789954951"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("service_tier")
                           .build()}
write "\"default\""
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("system_fingerprint")
                           .build()}
write "\"fp_c28ee603a6\""
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("obfuscation")
                           .build()}
write "\"HHHL8bgoj\""
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("created")
                           .build()}
write "1789954951"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("service_tier")
                           .build()}
write "\"default\""
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("system_fingerprint")
                           .build()}
write "\"fp_c28ee603a6\""
write flush

write option zilla:flags "init"
write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("ASSISTANT_TEXT")
                          .message(0)
                          .build()}
write "Hello"
write flush

write option zilla:flags "fin"
write zilla:data.empty
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("obfuscation")
                           .build()}
write "\"wruix7\""
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("created")
                           .build()}
write "1789954951"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("service_tier")
                           .build()}
write "\"default\""
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("system_fingerprint")
                           .build()}
write "\"fp_c28ee603a6\""
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("obfuscation")
                           .build()}
write "\"0N4dN\""
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("created")
                           .build()}
write "1789954951"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("service_tier")
                           .build()}
write "\"default\""
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("system_fingerprint")
                           .build()}
write "\"fp_c28ee603a6\""
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("obfuscation")
                           .build()}
write "\"TM5m3oG3ttJ\""
write flush

write zilla:end.ext ${llm:endEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(13)
                            .cacheReadTokens(0)
                            .outputTokens(9)
                            .reasoningTokens(0)
                            .totalTokens(22)
                            .finishReason("stop")
                            .build()}

write close

read closed
