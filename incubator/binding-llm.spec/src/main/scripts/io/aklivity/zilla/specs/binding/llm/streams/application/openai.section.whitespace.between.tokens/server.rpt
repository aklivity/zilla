accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .build()}

connected

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
read "{\n\t\"model\" : \"gpt-4\" ,\n\t\"messages\" : [\n\t\t{ \"role\" : \"system\" , \"content\" : \""

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("SYSTEM_INSTRUCTION")
                          .message(0)
                          .build()}
read "Be brief"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .build()}
read "\" } ,\n\t\t{\t\"role\"\t:\t\"user\"\t,\n\t\t  \"content\" : \""

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(1)
                          .build()}
read "Hello  there"

read zilla:data.ext ${llm:matchDialectDataEx()
                          .typeId(zilla:id("llm"))
                          .complete(true)
                          .build()}
read "\" }\n\t]\n}"

read advised zilla:flush

write zilla:reset.ext ${llm:resetEx()
                            .typeId(zilla:id("llm"))
                            .status(429)
                            .type("requests")
                            .message("Rate limit reached for gpt-4")
                            .build()}

read abort
