connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("claude-3-opus-20240229")
                           .build()}

connected

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("user-text")
                          .message(0)
                          .build()}
write "Hello"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("claude-3-opus-20240229")
                           .id("msg_01")
                           .extension(llm_anthropic:responseEx()
                                          .containerId("container_1")
                                          .build())
                           .build()}

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("assistant-text")
                          .message(0)
                          .build()}
read "Hello! How can I help you today?"

read zilla:end.ext ${llm:matchEndEx()
                            .typeId(zilla:id("llm"))
                            .inputTokens(25)
                            .outputTokens(15)
                            .finishReason("stop")
                            .extension(llm_anthropic:responseEx()
                                           .stopSequence("END")
                                           .build())
                            .build()}

read closed

write close
