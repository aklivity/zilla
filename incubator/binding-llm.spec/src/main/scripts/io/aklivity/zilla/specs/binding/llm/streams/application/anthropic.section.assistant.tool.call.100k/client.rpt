connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model("claude-3-opus-20240229")
                           .build()}

connected

write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("model")
                           .build()}
write "\"claude-3-opus-20240229\""
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("USER_TEXT")
                          .message(0)
                          .build()}
write "Weather in Paris?"
write flush

write zilla:data.ext ${llm:dataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_CALL")
                          .message(1)
                          .attribute("tool-name", "get_weather")
                          .attribute("tool-call-id", "toolu_1")
                          .build()}
write "{\"type\":\"tool_use\",\"id\":\"toolu_1\",\"name\":\"get_weather\",\"input\":{\"city\":\""
      ${core:randomBase64(100000)}
      "\"}}"
write flush

write advise zilla:flush

read zilla:reset.ext ${llm:matchResetEx()
                           .typeId(zilla:id("llm"))
                           .status(429)
                           .type("rate_limit_error")
                           .message("Rate limit exceeded")
                           .build()}

write aborted
