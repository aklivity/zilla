connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("test")
                           .build()}

connected

write "this is an opaque json payload for test"

write advise zilla:flush ${llm:flushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .build()
                               .build()}

write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "200")
                           .build()}

read "response body"

read closed
