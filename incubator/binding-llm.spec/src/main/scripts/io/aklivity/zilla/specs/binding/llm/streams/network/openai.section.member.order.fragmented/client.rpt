write ":\"user\""
write flush
write "}],\"mod"
write flush
write "el\":\"gp"
write flush
write "t-4\"}"
write flush
write close

read zilla:begin.ext ${http:matchBeginEx()
                           .typeId(zilla:id("http"))
                           .header(":status", "429")
                           .header("content-type", "application/json")
                           .build()}

read "{\"error\":{\"message\":\"Rate limit reached for gpt-4\",\"type\":\"requests\",\"param\":null,\"code\":\"rate_limit_exceeded\"}}"

read closed
