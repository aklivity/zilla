connect "zilla://streams/net0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "example.com:8080")
                            .header(":path", "/v1/chat/completions")
                            .header("content-type", "application/json")
                            .build()}

connected

write "{\"tools"
write flush
write "\":[{\"ty"
write flush
write "pe\":\"fu"
write flush
write "nction\""
write flush
write ",\"funct"
write flush
write "ion\":{\""
write flush
write "name\":\""
write flush
write "get_wea"
write flush
write "ther\",\""
write flush
write "paramet"
write flush
write "ers\":{\""
write flush
write "type\":\""
write flush
write "object\""
write flush
write ",\"prope"
write flush
write "rties\":"
write flush
write "{\"city\""
write flush
write ":{\"type"
write flush
write "\":\"stri"
write flush
write "ng\"}}}}"
write flush
write "}],\"mes"
write flush
write "sages\":"
write flush
write "[{\"cont"
write flush
write "ent\":\"s"
write flush
write "unny\",\""
write flush
write "tool_ca"
write flush
write "ll_id\":"
write flush
write "\"call_1"
write flush
