property target "target"
property model "claude-3-opus-20240229"

accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .model(model)
                           .build()}

connected

read advise zilla:challenge ${llm:challengeEx()
                                .typeId(zilla:id("llm"))
                                .dialect(target)
                                .build()}

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("TOOL_DEFINITION")
                          .message(-1)
                          .attribute("tool-name", "web_search")
                          .build()}
read "{\"type\":\"web_search_20250305\",\"name\":\"web_search\"}"

write zilla:reset.ext ${llm:resetEx()
                            .typeId(zilla:id("llm"))
                            .status(400)
                            .type("invalid_request_error")
                            .message("tool-definition cannot be converted from anthropic to %s".formatted(target))
                            .build()}

read abort
