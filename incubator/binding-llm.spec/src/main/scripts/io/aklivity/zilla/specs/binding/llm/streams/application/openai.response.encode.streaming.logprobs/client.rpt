# Logprobs: when the request asks for logprobs, each fragment of the text the upstream delivers is a section of its own,
# announced by the follow marker on the section data extension, and followed by an after block carrying the logprobs of
# that fragment. The after block is a single frame with the init and fin flags, owned by the section (the default owner),
# and has an empty payload when the upstream reported no logprobs for the fragment.

connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                          .typeId(zilla:id("llm"))
                          .dialect("openai")
                          .model("gpt-4")
                          .build()}

connected

write zilla:data.ext ${llm:dialectBlockDataEx()
                           .typeId(zilla:id("llm"))
                           .block("model")
                           .build()}
write "\"gpt-4\""
write flush

write zilla:data.ext ${llm:dataEx()
                         .typeId(zilla:id("llm"))
                         .type("USER_TEXT")
                         .message(0)
                         .build()}
write "Hello"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                         .typeId(zilla:id("llm"))
                         .block("logprobs")
                         .build()}
write "true"
write flush

write option zilla:flags "init fin"
write zilla:data.ext ${llm:dialectBlockDataEx()
                         .typeId(zilla:id("llm"))
                         .block("stream")
                         .build()}
write "true"
write flush

write advise zilla:flush

read zilla:begin.ext ${llm:matchBeginEx()
                         .typeId(zilla:id("llm"))
                         .dialect("openai")
                         .model("gpt-4")
                         .id("chatcmpl_1")
                         .build()}

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                        .typeId(zilla:id("llm"))
                        .type("ASSISTANT_TEXT")
                        .message(0)
                        .follow("AFTER_BLOCK")
                        .build()}
read "Hello"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectAfterBlockDataEx()
                        .typeId(zilla:id("llm"))
                        .block("logprobs")
                        .build()}
read "{\"content\":[{\"token\":\"Hello\",\"logprob\":-0.5,\"bytes\":[72,101,108,108,111],\"top_logprobs\":[{\"token\":\"Hello\",\"logprob\":-0.5,\"bytes\":[72,101,108,108,111]}]}],\"refusal\":null}"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                        .typeId(zilla:id("llm"))
                        .type("ASSISTANT_TEXT")
                        .message(0)
                        .follow("AFTER_BLOCK")
                        .build()}
read " there"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectAfterBlockDataEx()
                        .typeId(zilla:id("llm"))
                        .block("logprobs")
                        .build()}
read zilla:data.empty

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDataEx()
                        .typeId(zilla:id("llm"))
                        .type("ASSISTANT_TEXT")
                        .message(0)
                        .follow("AFTER_BLOCK")
                        .build()}
read "!"

read option zilla:flags "init fin"
read zilla:data.ext ${llm:matchDialectAfterBlockDataEx()
                        .typeId(zilla:id("llm"))
                        .block("logprobs")
                        .build()}
read "{\"content\":[{\"token\":\"!\",\"logprob\":-1.25,\"bytes\":[33],\"top_logprobs\":[]}],\"refusal\":null}"

read zilla:end.ext ${llm:matchEndEx()
                          .typeId(zilla:id("llm"))
                          .inputTokens(25)
                          .outputTokens(15)
                          .totalTokens(40)
                          .finishReason("stop")
                          .build()}

read closed

write close
