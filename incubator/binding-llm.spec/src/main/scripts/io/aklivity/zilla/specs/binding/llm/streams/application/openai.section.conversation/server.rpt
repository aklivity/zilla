accept "zilla://streams/app0"
       option zilla:window 8192
       option zilla:transmission "half-duplex"

accepted

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("openai")
                           .model("gpt-4")
                           .build()}

connected

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("system-instruction")
                          .message(0)
                          .build()}
read "Be brief"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("user-text")
                          .message(1)
                          .build()}
read "Weather in Paris?"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("tool-call")
                          .message(2)
                          .build()}
read "{\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\"}}"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("tool-result")
                          .message(3)
                          .extension("call_1")
                          .build()}
read "sunny"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("user-text")
                          .message(4)
                          .build()}
read "And in London?"

read zilla:data.ext ${llm:matchDataEx()
                          .typeId(zilla:id("llm"))
                          .type("tool-definition")
                          .message(-1)
                          .build()}
read "{\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"parameters\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}}}}}"

write zilla:reset.ext ${llm:resetEx()
                            .typeId(zilla:id("llm"))
                            .status(429)
                            .type("requests")
                            .message("Rate limit reached for gpt-4")
                            .build()}

read abort
