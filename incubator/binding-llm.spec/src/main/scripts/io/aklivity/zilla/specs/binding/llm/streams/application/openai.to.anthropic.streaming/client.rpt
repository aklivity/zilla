connect "zilla://streams/app0"
        option zilla:window 8192
        option zilla:transmission "half-duplex"

write zilla:begin.ext ${llm:beginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .build()}

connected

write "{\"model\":\"gpt-4\",\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}],\"stream\":true}"

write close

read zilla:begin.ext ${llm:matchBeginEx()
                           .typeId(zilla:id("llm"))
                           .dialect("anthropic")
                           .contentType("text/event-stream")
                           .build()}

read "{\"type\":\"message_start\",\"message\":{\"id\":\"chatcmpl_1\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"gpt-4\",\"content\":[],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .type("message_start")
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .type("content_block_start")
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"Hello\"}}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .type("content_block_delta")
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"type\":\"content_block_stop\",\"index\":0}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .type("content_block_stop")
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"type\":\"content_block_start\",\"index\":1,\"content_block\":{\"type\":\"tool_use\",\"id\":\"call_1\",\"name\":\"get_weather\"}}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .type("content_block_start")
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"city\\\":\"}}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .type("content_block_delta")
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"type\":\"content_block_stop\",\"index\":1}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .type("content_block_stop")
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"end_turn\"},\"usage\":{\"output_tokens\":0}}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .type("message_delta")
                                   .payloadNull()
                                   .build()
                               .build()}

read "{\"type\":\"message_stop\"}"
read advised zilla:flush ${llm:matchFlushEx()
                               .typeId(zilla:id("llm"))
                               .raw()
                                   .choiceIndex(0)
                                   .type("message_stop")
                                   .payloadNull()
                                   .build()
                               .build()}

read closed
