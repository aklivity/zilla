property bigBlob ${core:randomBase64(100000)}

connect "zilla://streams/net0"
  option zilla:window 8192
  option zilla:transmission "half-duplex"

write zilla:begin.ext ${http:beginEx()
                            .typeId(zilla:id("http"))
                            .header(":method", "POST")
                            .header(":scheme", "http")
                            .header(":authority", "localhost:8080")
                            .header(":path", "/v1/chat/completions")
                            .header("content-type", "application/vnd.zilla.test-permissive+json")
                            .build()}
connected

write "{\"model\":\"gpt-x\",\"prompt\":\"hi\"}"
write flush

write close

read '{"result":"'
read ${bigBlob.substring(0, 40000)}
read ${bigBlob.substring(40000, 80000)}
read ${bigBlob.substring(80000, 120000)}
read ${bigBlob.substring(120000, 133336)}
read '"}'

read closed
