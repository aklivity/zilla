scope llm_anthropic
{
    scope stream
    {
        struct LlmAnthropicRequestEx
        {
            string16 stream = null;
            string16 temperature = null;
            string16 topP = null;
            string16 topK = null;
            string16 maxTokens = null;
            string16 stopSequences = null;
        }

        struct LlmAnthropicResponseEx
        {
            string16 stopSequence = null;
            string16 containerId = null;
        }
    }
}
