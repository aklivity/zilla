scope llm_openai
{
    scope stream
    {
        struct LlmOpenaiRequestEx
        {
            string16 stream = null;
            string16 streamOptions = null;
            string16 temperature = null;
            string16 topP = null;
            string16 maxTokens = null;
            string16 seed = null;
            string16 stop = null;
        }

        struct LlmOpenaiResponseEx
        {
            string16 created = null;
            string16 serviceTier = null;
            string16 systemFingerprint = null;
        }
    }
}
