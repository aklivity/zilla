scope llm_ollama
{
    scope stream
    {
        struct LlmOllamaRequestEx
        {
            string16 stream = null;
            string16 options = null;
            string16 format = null;
            string16 think = null;
            string16 keepAlive = null;
        }

        struct LlmOllamaResponseEx
        {
            string16 createdAt = null;
            string16 totalDuration = null;
            string16 loadDuration = null;
        }
    }
}
