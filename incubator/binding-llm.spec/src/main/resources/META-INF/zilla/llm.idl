scope llm
{
    scope stream
    {
        struct LlmBeginEx extends core::stream::Extension
        {
            string16 dialect;
            string16 contentType = null;
            string16 model = null;
        }

        // content is carried in the DATA frame's own payload octets, and INIT/FIN
        // in its existing flags; every structural/metadata signal (native event
        // name, usage) rides the same DATA frame's extension instead of a separate
        // FLUSH, so a purely structural event (finish/usage/keepalive) is just a
        // DATA frame with a type but no payload. type carries the source dialect's
        // own native event name (or null), unchanged in meaning from the union's
        // former raw case. logProbability is the one piece of per-delta detail the
        // canonical vocabulary carries here rather than deferring to native: a
        // dialect that exposes per-token detail (e.g. OpenAI logprobs) sets it on
        // the DATA frame that carries the token it describes; a dialect that
        // doesn't (e.g. Anthropic, structurally) leaves it null. logProbability
        // never survives a cross-dialect route to Anthropic. inputTokens/
        // outputTokens are decoupled from any other event so they can arrive
        // whenever the source dialect discloses them: early (Anthropic's
        // message_start.usage) or only in a terminal chunk (OpenAI, which never
        // reveals prompt_tokens before then)
        struct LlmDataEx extends core::stream::Extension
        {
            string16 type = null;
            string16 logProbability = null;
            int32 inputTokens = -1;
            int32 outputTokens = -1;
        }
    }
}
