scope llm
{
    scope stream
    {
        struct LlmBeginEx extends core::stream::Extension
        {
            string16 dialect;
        }

        // content is carried in the DATA frame's own payload octets, and INIT/FIN
        // in its existing flags; no metadata survives once block identity moves to FLUSH
        struct LlmDataEx extends core::stream::Extension
        {
        }

        union LlmFlushEx switch (uint8) extends core::stream::Extension
        {
            case 0: llm::stream::LlmMessageStartFlushEx messageStart;
            case 1: llm::stream::LlmBlockStartFlushEx   blockStart;
            case 2: llm::stream::LlmBlockEndFlushEx     blockEnd;
            case 3: llm::stream::LlmFinishFlushEx       finish;
            case 4: llm::stream::LlmUsageFlushEx        usage;
            case 5: llm::stream::LlmKeepaliveFlushEx    keepalive;
            case 6: llm::stream::LlmNativeFlushEx       raw;
        }

        struct LlmMessageStartFlushEx
        {
            string16 id;
            string16 model = null;
            string16 role = null;
        }

        enum LlmBlockType (uint8)
        {
            TEXT(0),
            TOOL_CALL(1),
            THINKING(2)
        }

        struct LlmBlockStartFlushEx
        {
            int32 blockId;
            LlmBlockType type;
            string16 toolId = null;
            string16 toolName = null;
        }

        struct LlmBlockEndFlushEx
        {
            int32 blockId;
        }

        enum LlmFinishReason (uint8)
        {
            STOP(0),
            LENGTH(1),
            TOOL_CALL(2),
            CONTENT_FILTER(3),
            ERROR(4)
        }

        struct LlmFinishFlushEx
        {
            LlmFinishReason reason;
        }

        struct LlmUsageFlushEx
        {
            int32 inputTokens = -1;
            int32 outputTokens = -1;
        }

        struct LlmKeepaliveFlushEx
        {
        }

        struct LlmNativeFlushEx
        {
            string16 type = null;
            int32 length;
            octets[length] payload = null;
        }
    }
}
