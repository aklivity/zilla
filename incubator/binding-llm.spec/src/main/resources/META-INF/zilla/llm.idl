scope llm
{
    scope stream
    {
        struct LlmBeginEx extends core::stream::Extension
        {
            string16 dialect;
            string16 contentType = null;
            string16 model = null;
            string16 id = null;
            varint32 extensionLength;
            octets[extensionLength] extension = null;
        }

        struct LlmAttribute
        {
            string8 name;
            string16 value;
        }

        enum LlmSectionType (uint8)
        {
            NONE(0),
            SYSTEM_INSTRUCTION(1),
            USER_TEXT(2),
            USER_IMAGE(3),
            USER_DOCUMENT(4),
            USER_AUDIO(5),
            ASSISTANT_TEXT(6),
            ASSISTANT_REFUSAL(7),
            ASSISTANT_REASONING(8),
            TOOL_DEFINITION(9),
            TOOL_CALL(10),
            TOOL_RESULT(11),
            SERVER_TOOL_RESULT(12),
            CITATIONS(13),
            UNKNOWN(14)
        }

        enum LlmFollow (uint8)
        {
            NONE(0),
            AFTER_BLOCK(1)
        }

        struct LlmSectionDataEx
        {
            LlmSectionType type = NONE;
            int32 message = -1;
            LlmAttribute[] attributes;
            varint32 extensionLength;
            octets[extensionLength] extension = null;
            LlmFollow follow = NONE;
        }

        enum LlmBlockOwner (uint8)
        {
            SECTION(0),
            CONTAINER(1)
        }

        struct LlmDialectBlockDataEx
        {
            string16 block;
        }

        struct LlmDialectBeforeBlockDataEx
        {
            LlmSectionType type;
            int32 message = -1;
            LlmAttribute[] attributes;
            LlmBlockOwner owner = SECTION;
            string16 block;
        }

        struct LlmDialectAfterBlockDataEx
        {
            LlmBlockOwner owner = SECTION;
            string16 block;
        }

        union LlmDataEx switch (uint8) extends core::stream::Extension
        {
            case 0: llm::stream::LlmSectionDataEx section;
            case 1: llm::stream::LlmDialectBlockDataEx block;
            case 2: llm::stream::LlmDialectBeforeBlockDataEx before;
            case 3: llm::stream::LlmDialectAfterBlockDataEx after;
        }

        struct LlmUsage
        {
            int32 inputTokens = -1;
            int32 cacheWriteTokens = -1;
            int32 cacheReadTokens = -1;
            int32 outputTokens = -1;
            int32 reasoningTokens = -1;
            int32 totalTokens = -1;
            string16 nativeUsage = null;
        }

        struct LlmError
        {
            int32 status = -1;
            string16 type = null;
            string16 param = null;
            string16 message = null;
        }

        struct LlmEndEx extends core::stream::Extension
        {
            LlmUsage usage;
            string16 finishReason = null;
        }

        struct LlmAbortEx extends core::stream::Extension
        {
            LlmUsage usage;
            LlmError error;
        }

        struct LlmResetEx extends core::stream::Extension
        {
            LlmError error;
        }
    }
}
