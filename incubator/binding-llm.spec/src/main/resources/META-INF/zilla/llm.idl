scope llm
{
    scope stream
    {
        struct LlmBeginEx extends core::stream::Extension
        {
            string16 dialect;
            string16 contentType = null;
            string16 model = null;
            string16 id = null;
            varint32 extensionLength;
            octets[extensionLength] extension = null;
        }

        struct LlmAttribute
        {
            string8 name;
            string16 value;
        }

        struct LlmSectionDataEx
        {
            string16 type = null;
            int32 message = -1;
            LlmAttribute[] attributes;
            varint32 extensionLength;
            octets[extensionLength] extension = null;
        }

        struct LlmDialectDataEx
        {
            string16 block;
        }

        struct LlmDialectPreSectionDataEx
        {
            string16 type;
            string16 block;
        }

        struct LlmDialectPostSectionDataEx
        {
            string16 block;
        }

        union LlmDataEx switch (uint8) extends core::stream::Extension
        {
            case 0: llm::stream::LlmSectionDataEx section;
            case 1: llm::stream::LlmDialectDataEx dialect;
            case 2: llm::stream::LlmDialectPreSectionDataEx preSection;
            case 3: llm::stream::LlmDialectPostSectionDataEx postSection;
        }

        struct LlmUsage
        {
            int32 inputTokens = -1;
            int32 cacheWriteTokens = -1;
            int32 cacheReadTokens = -1;
            int32 outputTokens = -1;
            int32 reasoningTokens = -1;
            int32 totalTokens = -1;
            string16 nativeUsage = null;
        }

        struct LlmError
        {
            int32 status = -1;
            string16 type = null;
            string16 param = null;
            string16 message = null;
        }

        struct LlmEndEx extends core::stream::Extension
        {
            LlmUsage usage;
            string16 finishReason = null;
        }

        struct LlmAbortEx extends core::stream::Extension
        {
            LlmUsage usage;
            LlmError error;
        }

        struct LlmResetEx extends core::stream::Extension
        {
            LlmError error;
        }
    }
}
