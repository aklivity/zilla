[
    {
        "op": "add",
        "path": "/$defs/binding/properties/type/enum/-",
        "value": "llm"
    },
    {
        "op": "add",
        "path": "/$defs/binding/allOf/-",
        "value":
        {
            "if":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "llm"
                    }
                }
            },
            "then":
            {
                "properties":
                {
                    "type":
                    {
                        "const": "llm"
                    },
                    "kind":
                    {
                        "enum": [ "client", "server", "proxy" ]
                    },
                    "catalog": false,
                    "vault": false
                },
                "allOf":
                [
                    {
                        "if":
                        {
                            "properties":
                            {
                                "kind":
                                {
                                    "const": "server"
                                }
                            }
                        },
                        "then":
                        {
                            "properties":
                            {
                                "options":
                                {
                                    "properties":
                                    {
                                        "dialect":
                                        {
                                            "title": "Dialect",
                                            "description": "Fixes the dialect assumed for inbound requests instead of detecting it automatically. Accepts the name of any dialect registered with the binding, for example openai, anthropic or gemini.",
                                            "$ref": "#/$defs/binding-ext/llm/dialect"
                                        },
                                        "authorization":
                                        {
                                            "title": "Authorization",
                                            "description": "Guard used to validate inbound request credentials, keyed by guard name. Credentials is a template matched against the request header the resolved dialect expects credentials in (for example Authorization for openai, x-api-key for anthropic, x-goog-api-key for gemini), with {credentials} standing in for the extracted token.",
                                            "$ref": "#/$defs/binding-ext/llm/authorization"
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                "routes":
                                {
                                    "title": "Routes",
                                    "type": "array",
                                    "items":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "when": false,
                                            "with": false
                                        }
                                    }
                                }
                            }
                        }
                    },
                    {
                        "if":
                        {
                            "properties":
                            {
                                "kind":
                                {
                                    "const": "client"
                                }
                            }
                        },
                        "then":
                        {
                            "properties":
                            {
                                "options":
                                {
                                    "properties":
                                    {
                                        "dialect":
                                        {
                                            "title": "Dialect",
                                            "description": "The dialect this client speaks to the large language model server named by server. Accepts the name of any dialect registered with the binding, for example openai, anthropic or gemini. When it differs from the dialect resolved on the paired server side, requests and responses are translated between the two dialects automatically, subject to each dialect's own capabilities.",
                                            "$ref": "#/$defs/binding-ext/llm/dialect"
                                        },
                                        "server":
                                        {
                                            "title": "Server",
                                            "description": "Base URL of the large language model server this client connects to, mirroring the base_url convention of the official SDKs: the whole origin plus a shared path prefix (for example https://aicomp.ai/v1), with the resolved dialect appending only its own fixed operation suffix on top (/chat/completions for openai, /messages for anthropic, /models/{model}:generateContent or :streamGenerateContent for gemini). The path defaults to /v1 when omitted (for example https://aicomp.ai resolves the same as https://aicomp.ai/v1), except for the gemini dialect where it defaults to /v1beta.",
                                            "type": "string",
                                            "format": "uri",
                                            "pattern": "^https?://"
                                        },
                                        "authorization":
                                        {
                                            "title": "Authorization",
                                            "description": "Guard used to resolve outbound request credentials, keyed by guard name. Credentials is a template used to build the request header the resolved dialect sends credentials in (for example Authorization for openai, x-api-key for anthropic, x-goog-api-key for gemini), with {credentials} standing in for the resolved token. When {credentials} resolves to the authorization already granted to the inbound request, the caller's own credentials are forwarded upstream unchanged.",
                                            "$ref": "#/$defs/binding-ext/llm/authorization"
                                        }
                                    },
                                    "required": [ "dialect", "server" ],
                                    "additionalProperties": false
                                },
                                "routes":
                                {
                                    "title": "Routes",
                                    "type": "array",
                                    "items":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "when": false,
                                            "with": false
                                        }
                                    }
                                }
                            },
                            "required": [ "options" ]
                        }
                    },
                    {
                        "if":
                        {
                            "properties":
                            {
                                "kind":
                                {
                                    "const": "proxy"
                                }
                            }
                        },
                        "then":
                        {
                            "properties":
                            {
                                "options":
                                {
                                    "properties":
                                    {
                                        "guardrails":
                                        {
                                            "title": "Guardrails",
                                            "description": "Models applied to the payload of each request or response section, keyed by the model name the request resolves to. The stages for the resolved model apply in order to each matching section, and a fallback model's stages apply after the requested model's stages.",
                                            "$ref": "#/$defs/binding-ext/llm/guardrails"
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                "routes":
                                {
                                    "title": "Routes",
                                    "type": "array",
                                    "items":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "when":
                                            {
                                                "title": "When",
                                                "type": "array",
                                                "items":
                                                {
                                                    "type": "object",
                                                    "properties":
                                                    {
                                                        "dialect":
                                                        {
                                                            "title": "Dialect",
                                                            "description": "Matches when the request's resolved dialect equals this value.",
                                                            "$ref": "#/$defs/binding-ext/llm/dialect"
                                                        },
                                                        "model":
                                                        {
                                                            "title": "Model",
                                                            "description": "Matches when the request's extracted model is admitted by this allow-set. Accepts exact model names or * glob patterns.",
                                                            "type": "array",
                                                            "items":
                                                            {
                                                                "type": "string"
                                                            }
                                                        }
                                                    },
                                                    "additionalProperties": false
                                                }
                                            },
                                            "with":
                                            {
                                                "title": "With",
                                                "type": "object",
                                                "properties":
                                                {
                                                    "fallback":
                                                    {
                                                        "title": "Fallback",
                                                        "description": "Ordered models to try when the route's exit resets the stream before sending a window. Each model is routed through this binding's routes, and a model that matches no authorized route is skipped. The path is resolved at the start of the stream and locks once the exit sends a window.",
                                                        "type": "array",
                                                        "minItems": 1,
                                                        "items":
                                                        {
                                                            "type": "string",
                                                            "pattern": "^[^*]+$"
                                                        }
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                ]
            }
        }
    },
    {
        "op": "add",
        "path": "/$defs/binding-ext/llm",
        "value":
        {
            "dialect":
            {
                "title": "Dialect",
                "type": "string",
                "enum": [ "openai", "anthropic", "gemini" ]
            },
            "section":
            {
                "title": "Section",
                "type": "string",
                "enum":
                [
                    "system-instruction",
                    "user-text",
                    "user-image",
                    "user-document",
                    "user-audio",
                    "user-video",
                    "assistant-text",
                    "assistant-reasoning",
                    "assistant-refusal",
                    "tool-definition",
                    "tool-call",
                    "tool-result",
                    "server-tool-definition",
                    "server-tool-call",
                    "server-tool-result",
                    "citations"
                ]
            },
            "guardrail-stages":
            {
                "title": "Stages",
                "type": "array",
                "items":
                {
                    "type": "object",
                    "properties":
                    {
                        "section":
                        {
                            "title": "Section",
                            "description": "The section type, or section types, this stage applies to.",
                            "oneOf":
                            [
                                {
                                    "$ref": "#/$defs/binding-ext/llm/section"
                                },
                                {
                                    "type": "array",
                                    "minItems": 1,
                                    "items":
                                    {
                                        "$ref": "#/$defs/binding-ext/llm/section"
                                    }
                                }
                            ]
                        },
                        "value":
                        {
                            "title": "Value",
                            "description": "The model the section payload is passed through.",
                            "$ref": "#/$defs/models"
                        }
                    },
                    "required": [ "section", "value" ],
                    "additionalProperties": false
                }
            },
            "guardrails":
            {
                "type": "object",
                "patternProperties":
                {
                    "^[^*]+$":
                    {
                        "type": "object",
                        "properties":
                        {
                            "request":
                            {
                                "title": "Request",
                                "description": "Stages applied, in order, to the sections of a request.",
                                "$ref": "#/$defs/binding-ext/llm/guardrail-stages"
                            },
                            "response":
                            {
                                "title": "Response",
                                "description": "Stages applied, in order, to the sections of a response.",
                                "$ref": "#/$defs/binding-ext/llm/guardrail-stages"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            },
            "authorization":
            {
                "type": "object",
                "patternProperties":
                {
                    "^[A-Za-z0-9_-]+$":
                    {
                        "type": "object",
                        "properties":
                        {
                            "credentials":
                            {
                                "title": "Credentials",
                                "type": "string",
                                "pattern": ".*\\{credentials\\}.*",
                                "default": "Bearer {credentials}"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false,
                "maxProperties": 1
            }
        }
    }
]
