{
    "$ref": "#/$defs/schema",
    "$defs": {
        "schema": {
            "propertyNames": {
                "not": {
                    "enum": [
                        "minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf", "minLength", "maxLength",
                        "maxItems", "uniqueItems", "contains", "minContains", "maxContains"
                    ]
                }
            },
            "items": { "$ref": "#/$defs/schema" },
            "properties": {
                "$ref": { "pattern": "^#." },
                "minItems": { "minimum": 0, "maximum": 1, "multipleOf": 1 },
                "properties": { "$ref": "#/$defs/map" },
                "patternProperties": { "$ref": "#/$defs/map" },
                "$defs": { "$ref": "#/$defs/map" },
                "definitions": { "$ref": "#/$defs/map" },
                "dependentSchemas": { "$ref": "#/$defs/map" },
                "items": { "$ref": "#/$defs/schema" },
                "additionalProperties": { "$ref": "#/$defs/schema" },
                "not": { "$ref": "#/$defs/schema" },
                "if": { "$ref": "#/$defs/schema" },
                "then": { "$ref": "#/$defs/schema" },
                "else": { "$ref": "#/$defs/schema" },
                "propertyNames": { "$ref": "#/$defs/schema" },
                "unevaluatedItems": { "$ref": "#/$defs/schema" },
                "unevaluatedProperties": { "$ref": "#/$defs/schema" },
                "additionalItems": { "$ref": "#/$defs/schema" },
                "contentSchema": { "$ref": "#/$defs/schema" },
                "allOf": { "$ref": "#/$defs/list" },
                "anyOf": { "$ref": "#/$defs/list" },
                "oneOf": { "$ref": "#/$defs/list" },
                "prefixItems": { "$ref": "#/$defs/list" }
            }
        },
        "map": {
            "additionalProperties": { "$ref": "#/$defs/schema" }
        },
        "list": {
            "items": { "$ref": "#/$defs/schema" }
        }
    }
}
