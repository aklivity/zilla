{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "OpenAI Chat Completions request",
    "type": "object",
    "required": [
        "model",
        "messages"
    ],
    "properties": {
        "model": {
            "type": "string"
        },
        "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "role"
                ],
                "properties": {
                    "role": {
                        "type": "string"
                    },
                    "content": {},
                    "name": {
                        "type": "string"
                    },
                    "tool_calls": {
                        "type": "array"
                    },
                    "tool_call_id": {
                        "type": "string"
                    }
                }
            }
        },
        "stream": {
            "type": "boolean"
        },
        "max_tokens": {
            "type": "integer"
        },
        "temperature": {
            "type": "number"
        },
        "top_p": {
            "type": "number"
        },
        "n": {
            "type": "integer"
        },
        "stop": {},
        "presence_penalty": {
            "type": "number"
        },
        "frequency_penalty": {
            "type": "number"
        },
        "logit_bias": {
            "type": "object"
        },
        "user": {
            "type": "string"
        },
        "seed": {
            "type": "integer"
        },
        "tools": {
            "type": "array"
        },
        "tool_choice": {},
        "response_format": {
            "type": "object"
        },
        "logprobs": {
            "type": "boolean"
        },
        "top_logprobs": {
            "type": "integer"
        }
    }
}
