scope internal
{
    scope queue
    {
        struct LlmQueueEntry
        {
            int32 extensionLength;
            octets[extensionLength] extension = null;
            int64 traceId;
            int64 authorization;
            int64 budgetId;
            int32 reserved;
            uint8 flags = 3;
            int32 payloadLength;
            octets[payloadLength] payload = null;
        }
    }
}
